+    // Advance the dialogue typewriter by one frame.
+    //
+    // The original reveals a dialogue line one character at a time; the
+    // runtime calls this once per frame while the script waits for input.
+    [[nodiscard]] bool advance_typewriter()
+    {
+        if(_phase != battle_scene_phase::script_blocked)
+        {
+            return false;
+        }
+        return _script.advance_typewriter();
+    }
