    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError("CFG consumed-literal ROM identity changed")\n\n    segments = atomize_claims(len(rom), baseline)\n    segment_starts = [segment["range"][0] for segment in segments]\n\n    def require_unknown(start: int, end: int) -> None:\n        index = bisect.bisect_right(segment_starts, start) - 1\n        if index < 0:\n            raise ValueError("CFG consumed-literal range escaped coverage")\n        segment = segments[index]\n        if (\n            segment.get("primary_class") != "unknown"\n            or segment["range"][0] > start\n            or end > segment["range"][1]\n        ):\n            raise ValueError("CFG consumed-literal range is not complete current unknown or overlaps an owner")\n\n    claims: list[dict[str, Any]] = []\n    for config in configs:\n        artifact = _checked_artifact_directory(\n            root,\n            config["artifact"],\n            {"manifest.json", config["payload_name"]},\n            label=f"CFG consumed-literal {config[\'label\']} artifact",\n        )\n        for path_key, sha_key, label in (\n            ("exporter", "exporter_sha256", "exporter"),\n            ("verifier", "verifier_sha256", "verifier"),\n            ("test", "test_sha256", "exporter test"),\n            ("verifier_test", "verifier_test_sha256", "verifier test"),\n        ):\n            _checked_repository_file(\n                root,\n                config[path_key],\n                config[sha_key],\n                label=f"CFG consumed-literal {config[\'label\']} {label}",\n            )\n        manifest_raw = (artifact / "manifest.json").read_bytes()\n        payload_raw = (artifact / config["payload_name"]).read_bytes()\n        if (\n            len(manifest_raw) != config["manifest_size"]\n            or _sha256(manifest_raw) != config["manifest_sha256"]\n            or len(payload_raw) != config["payload_size"]\n            or _sha256(payload_raw) != config["payload_sha256"]\n        ):\n            raise ValueError(f"CFG consumed-literal {config[\'label\']} artifact identity changed")\n        try:\n            manifest = json.loads(manifest_raw)\n            payload = json.loads(payload_raw)\n        except json.JSONDecodeError as error:\n            raise ValueError("CFG consumed-literal artifact JSON is invalid") from error\n        if manifest_raw != _canonical_json_bytes(manifest) or payload_raw != _canonical_json_bytes(payload):\n            raise ValueError("CFG consumed-literal artifact JSON is not canonical")\n        report = config["verify"](root, artifact)\n        denominator_key = config.get("denominator_key", "literal_denominator")\n        denominator = payload.get(denominator_key)\n        if (\n            report.get("contract_ok") is not True\n            or report.get(denominator_key) != denominator\n            or (\n                denominator_key == "literal_denominator"\n                and report.get("summary") != payload.get("summary")\n            )\n        ):\n            raise ValueError(f"CFG consumed-literal {config[\'label\']} independent verification failed")\n        promotion = payload.get("promotion", {})\n        ranges = promotion.get("ranges")\n        records = promotion.get("range_records")\n        summary = payload.get("summary", denominator if denominator_key == "denominator" else {})\n        expected_file = {\n            config["payload_name"]: {\n                "sha256": config["payload_sha256"],\n                "size": config["payload_size"],\n            }\n        }\n        if (\n            manifest.get("schema") != "git-artifact-promotion-v1"\n            or manifest.get("artifact_schema") != config["artifact_schema"]\n            or manifest.get("artifact_status") != "accepted"\n            or manifest.get("files") != expected_file\n            or payload.get("schema") != config["payload_schema"]\n            or (\n                manifest.get("summary") != summary\n                if denominator_key == "literal_denominator"\n                else manifest.get("denominator") != denominator\n            )\n            or manifest.get("promotion") != promotion\n            or promotion.get("promotion_batch") != config["batch"]\n            or promotion.get("primary_class") != config["primary_class"]\n            or promotion.get("claim_kind") != config["claim_kind"]\n            or not isinstance(ranges, list)\n            or not isinstance(records, list)\n            or len(ranges) != config["claim_count"]\n            or len(records) != config["claim_count"]\n            or summary.get("merged_target_range_count") != config["claim_count"]\n            or summary.get("target_bytes") != config["target_bytes"]\n        ):\n            raise ValueError(f"CFG consumed-literal {config[\'label\']} promotion contract changed")\n        target_words = payload.get("target_words")\n        if not isinstance(target_words, list):\n            raise ValueError("CFG consumed-literal target denominator changed")\n        report_sha256 = _sha256(_canonical_json_bytes(report))\n        for index, (interval, record) in enumerate(zip(ranges, records, strict=True)):\n            if (\n                not isinstance(interval, list)\n                or len(interval) != 2\n                or not all(isinstance(value, int) for value in interval)\n                or record.get("range") != interval\n            ):\n                raise ValueError("CFG consumed-literal range record changed")\n            start, end = interval\n            if start >= end or record.get("bytes_sha256") != _sha256(rom[start:end]):\n                raise ValueError("CFG consumed-literal range bytes changed")\n            require_unknown(start, end)\n            covered_words = [\n                row\n                for row in target_words\n                if start <= row.get("target_file_offset", -1) < end\n            ]\n            if len(covered_words) * 4 != end - start:\n                raise ValueError("CFG consumed-literal target/range projection changed")\n            claims.append(\n                {\n                    "id": f"cfg-{config[\'label\']}-consumed-literal-{index:04d}-{start:06x}",\n                    "range": [start, end],\n                    "role": "primary",\n                    "primary_class": config["primary_class"],\n                    "claim_kind": config["claim_kind"],\n                    "promotion_batch": config["batch"],\n                    "promoted_from_primary_class": "unknown",\n                    "baseline_unknown_only": True,\n                    "bytes_sha256": record["bytes_sha256"],\n                    "target_word_count": len(covered_words),\n                    "source_instruction_reference_count": sum(\n                        len(row.get("source_file_offsets", row.get("sources", [])))\n                        for row in covered_words\n                    ),\n                    "literal_denominator": denominator,\n                    "evidence_path": (config["artifact"] / config["payload_name"]).as_posix(),\n                    "evidence_sha256": config["payload_sha256"],\n                    "evidence_selector": f"/promotion/range_records/{index}",\n                    "promotion_manifest_path": (config["artifact"] / "manifest.json").as_posix(),\n                    "promotion_manifest_sha256": config["manifest_sha256"],\n                    "independent_verifier_path": config["verifier"].as_posix(),\n                    "independent_verifier_sha256": config["verifier_sha256"],\n                    "independent_verifier_report_sha256": report_sha256,\n                    "exporter_path": config["exporter"].as_posix(),\n                    "exporter_sha256": config["exporter_sha256"],\n                    "upstream_test_path": config["test"].as_posix(),\n                    "upstream_test_sha256": config["test_sha256"],\n                    "verifier_test_path": config["verifier_test"].as_posix(),\n                    "verifier_test_sha256": config["verifier_test_sha256"],\n                    "runtime_reachability_claimed": False,\n                    "loaded_value_semantics_claimed": False,\n                    "adjacent_bytes_claimed": False,\n                    "editing_writeback_relocation_safe_claimed": False,\n                    "free_or_allocatable_space_claimed": False,\n                    "non_claims": [\n                        *payload.get("non_claims", []),\n                        *(\n                            ["No global all-consumer literal denominator is claimed."]\n                            if len(payload.get("non_claims", [])) < 4\n                            else []\n                        ),\n                    ],\n                    "limitations": [\n                        *payload.get("non_claims", []),\n                        *(\n                            ["No global all-consumer literal denominator is claimed."]\n                            if len(payload.get("non_claims", [])) < 4\n                            else []\n                        ),\n                    ],\n                }\n            )\n    claims.sort(key=lambda claim: (claim["range"], claim["id"]))\n    if (\n        len(claims) != 1_220\n        or sum(claim["range"][1] - claim["range"][0] for claim in claims) != 14_492\n    ):\n        raise ValueError("CFG consumed-literal combined projection changed")\n    for previous, current in zip(claims, claims[1:]):\n        if previous["range"][1] > current["range"][0]:\n            raise ValueError("CFG consumed-literal packets overlap")\n    return claims\n\n\nACCEPTED_CONSUMER_CODE_SLICE_PACKET_SPECS = (\n    ("rom-profile-selector-code-slices-v1", "rom-profile-selector-code-slices.json", "4c109e5c8d6e8bbf121a1d0208df752a841c3634be7e07ab866024470f2d61b2", "29f2138de43ff74321833e65bff34e6e28bf30342808d53582dac6d1585eb236", "tools/verify_rom_profile_selector_code_slices.py", "94312dd1ef481306c4f37772becd96fc07f4e7a82dbc5da90fab6f34511bbf76", verify_rom_profile_selector_code_slices),\n    ("rom-chapter-selector-code-slice-v1", "rom-chapter-selector-code-slice.json", "e32e734834e39ef9600f6dbe44d3b5f0402f50027e85cec9a5497026d7e0b9e8", "77d3f9715dc0ff556bb268171b945b8550a8057a8ee45f592d1fa113dbf37bd5", "tools/verify_rom_chapter_selector_code_slice.py", "c76e40b765ff5e466639a08dad74abb216b1f0941a8177e9848055cb660bf7a5", verify_rom_chapter_selector_code_slice),\n    ("rom-sprite-loader-tail-v1", "rom-sprite-loader-tail.json", "4fd97b56d91631e393e1962c2c4556f5b9b8001617afeb142941b5436762b1c2", "6c4b35b130164e215b6e57f01c42708ea91b38c8e989c39003b0f1300b5b3a6f", "tools/verify_rom_sprite_loader_tail.py", "4bbb8db3fc86d8f8789151b6661988196862e238a015f9f0162115cd55a64691", verify_rom_sprite_loader_tail),\n    ("rom-battle-status-bar-caller-slice-v1", "rom-battle-status-bar-caller-slice.json", "088c165400327abf3c2fa79054a237917b99fdf8ec5c8d80671b07f909abf39c", "7cc1af7fad6573a0901bda847e3c3a2665229e60623fae2426a679ace83e1217", "tools/verify_rom_battle_status_bar_caller_slice.py", "5b27ae1a234383cef2b2feb49b2afb8155d2344b512e6bf27df072bb4ad74c25", verify_rom_battle_status_bar_caller_slice),\n)\n\n\ndef _accepted_consumer_code_slice_packet_claims(\n    root: Path, rom: bytes, existing_claims: Iterable[dict[str, Any]]\n) -> list[dict[str, Any]]:\n    baseline = list(existing_claims)\n    segments = atomize_claims(len(rom), baseline)\n    existing_ids = {claim["id"] for claim in baseline}\n    existing_batches = {claim.get("promotion_batch") for claim in baseline}\n    claims: list[dict[str, Any]] = []\n    for batch, payload_name, manifest_sha, payload_sha, verifier_name, verifier_sha, verifier in ACCEPTED_CONSUMER_CODE_SLICE_PACKET_SPECS:\n        if batch in existing_batches:\n            raise ValueError(f"duplicate consumer code-slice promotion batch: {batch}")\n        artifact = root / "artifacts" / batch\n        manifest_path, payload_path = artifact / "manifest.json", artifact / payload_name\n        verifier_path = root / verifier_name\n        if _sha256_file(manifest_path) != manifest_sha or _sha256_file(payload_path) != payload_sha or _sha256_file(verifier_path) != verifier_sha:\n            raise ValueError(f"consumer code-slice packet identity changed: {batch}")\n        report = verifier(root, artifact)\n        if report.get("verified") is not True or report.get("errors", []) != []:\n            raise ValueError(f"consumer code-slice independent verification failed: {batch}")\n        payload = json.loads(payload_path.read_text(encoding="utf-8"))\n        if payload.get("schema") != batch or payload.get("artifact_status") != "accepted" or payload.get("coverage", {}).get("sha256") != "24cf30aa8049f961ce71737ca9cacfa42c63771643e8bb6784a8a834ee097987":\n            raise ValueError(f"consumer code-slice payload contract changed: {batch}")\n        records = payload.get("ranges") if isinstance(payload.get("ranges"), list) else [payload.get("range")]\n        for index, record in enumerate(records):\n            if not isinstance(record, dict):\n                raise ValueError(f"consumer code-slice record missing: {batch}")\n            claim_contract = record.get("claim", record)\n            start, end = record.get("range", [0, 0])\n            if claim_contract.get("primary_class") != "consumer_code_slice" or claim_contract.get("claim_kind") != "consumer_code_slice" or claim_contract.get("promotion_batch") != batch:\n                raise ValueError(f"consumer code-slice record semantics changed: {batch}")\n            if end <= start or record.get("size") != end - start or _sha256(rom[start:end]) != record.get("bytes_sha256"):\n                raise ValueError(f"consumer code-slice raw range changed: {batch}")\n            owners = [s for s in segments if s["range"][0] < end and start < s["range"][1]]\n            if not owners or owners[0]["range"][0] > start or owners[-1]["range"][1] < end or any(s["primary_class"] != "unknown" or s["primary_claim_ids"] or s["secondary_claim_ids"] for s in owners):\n                raise ValueError(f"consumer code-slice target is not current unknown: {batch}")\n            claim_id = record["id"]\n            if claim_id in existing_ids or any(c["id"] == claim_id for c in claims):\n                raise ValueError(f"consumer code-slice claim id collision: {claim_id}")\n            claims.append({\n                "id": claim_id, "range": [start, end], "role": "primary",\n                "primary_class": "consumer_code_slice", "claim_kind": "consumer_code_slice",\n                "promotion_batch": batch, "promoted_from_primary_class": "unknown",\n                "baseline_unknown_only": True, "bytes_sha256": record["bytes_sha256"],\n                "artifact_record_id": record["id"], "evidence_path": f"artifacts/{batch}/{payload_name}",\n                "evidence_sha256": payload_sha, "evidence_selector": f"/ranges/{index}" if "ranges" in payload else "/range",\n                "promotion_manifest_path": f"artifacts/{batch}/manifest.json", "promotion_manifest_sha256": manifest_sha,\n                "independent_verifier_path": verifier_name, "independent_verifier_sha256": verifier_sha,\n                "independent_verifier_report_sha256": _sha256(_canonical_json_bytes(report)),\n                "instruction_only_claimed": False, "runtime_reachability_claimed": False,\n                "safe_editing": False, "allocatable": False, "limitations": payload.get("limitations", []),\n            })\n    if len(claims) != 5 or sum(c["range"][1] - c["range"][0] for c in claims) != 2120:\n        raise ValueError("consumer code-slice packet denominator changed")\n    return claims\n\n\nFAST_AUDIT_FOUR_PACKET_SPECS = (\n    ("rom-event-handler-cfg-v1", "rom-event-handler-cfg.json", 37061, "c665fe39c92124717ea851822542b883803a8957fe0d4b5bacaac0a47ed6a906", 34133, "577fb65f3d73ba0f797fa9cdc306165b60941de4f88e13dede0eac7e573f8892", "tools/ver