T_EXPORTER_TEST,\n            U8_TRIPLET_EXPORTER_TEST_SHA256,\n            "u8 triplet exporter test",\n        ),\n        (\n            U8_TRIPLET_VERIFIER_TEST,\n            U8_TRIPLET_VERIFIER_TEST_SHA256,\n            "u8 triplet verifier test",\n        ),\n    ):\n        _checked_repository_file(root, path, expected_sha, label=label)\n\n    manifest_raw = manifest_path.read_bytes()\n    payload_raw = payload_path.read_bytes()\n    try:\n        manifest = json.loads(manifest_raw)\n        payload = json.loads(payload_raw)\n    except (UnicodeDecodeError, json.JSONDecodeError) as error:\n        raise ValueError("u8 triplet artifact JSON is invalid") from error\n    if (\n        not isinstance(manifest, dict)\n        or not isinstance(payload, dict)\n        or manifest_raw != _canonical_json_bytes(manifest)\n        or payload_raw != _canonical_json_bytes(payload)\n    ):\n        raise ValueError("u8 triplet artifact JSON is not canonical")\n\n    expected_implementation = {\n        "exporter": {\n            "path": U8_TRIPLET_EXPORTER.as_posix(),\n            "sha256": U8_TRIPLET_EXPORTER_SHA256,\n        },\n        "exporter_tests": {\n            "path": U8_TRIPLET_EXPORTER_TEST.as_posix(),\n            "sha256": U8_TRIPLET_EXPORTER_TEST_SHA256,\n        },\n        "verifier": {\n            "path": U8_TRIPLET_VERIFIER.as_posix(),\n            "sha256": U8_TRIPLET_VERIFIER_SHA256,\n        },\n        "verifier_tests": {\n            "path": U8_TRIPLET_VERIFIER_TEST.as_posix(),\n            "sha256": U8_TRIPLET_VERIFIER_TEST_SHA256,\n        },\n    }\n    projection = manifest.get("coverage_projection")\n    payload_projection = payload.get("coverage_projection")\n    if (\n        manifest.get("schema") != "git-artifact-promotion-v1"\n        or manifest.get("artifact_schema") != U8_TRIPLET_BATCH\n        or manifest.get("artifact_status") != "accepted"\n        or manifest.get("files")\n        != {\n            U8_TRIPLET_BINARY_NAME: {\n                "sha256": U8_TRIPLET_BINARY_SHA256,\n                "size": U8_TRIPLET_BINARY_SIZE,\n            },\n            U8_TRIPLET_PAYLOAD_NAME: {\n                "sha256": U8_TRIPLET_PAYLOAD_SHA256,\n                "size": U8_TRIPLET_PAYLOAD_SIZE,\n            },\n        }\n        or manifest.get("implementation") != expected_implementation\n        or payload.get("implementation") != expected_implementation\n        or payload.get("schema") != U8_TRIPLET_BATCH\n        or manifest.get("rom") != payload.get("rom")\n        or manifest.get("coverage_baseline") != payload.get("coverage_baseline")\n        or manifest.get("promotion") != payload.get("promotion")\n        or manifest.get("scope") != payload.get("scope")\n        or manifest.get("non_claims") != payload.get("non_claims")\n        or not isinstance(projection, dict)\n        or projection.get("claim_count") != 2\n        or projection.get("byte_count") != U8_TRIPLET_BINARY_SIZE\n        or projection.get("range_vector_sha256")\n        != U8_TRIPLET_RANGE_VECTOR_SHA256\n        or projection.get("packed_bytes_sha256")\n        != U8_TRIPLET_BINARY_SHA256\n        or projection.get("claim_denominator_sha256")\n        != U8_TRIPLET_CLAIM_DENOMINATOR_SHA256\n        or not isinstance(payload_projection, dict)\n        or payload_projection.get("baseline")\n        != payload.get("coverage_baseline")\n        or payload_projection.get("promoted_byte_size")\n        != U8_TRIPLET_BINARY_SIZE\n        or payload_projection.get("promoted_ranges")\n        != [list(spec[1]) for spec in U8_TRIPLET_CLAIM_SPECS]\n        or payload_projection.get("expected_delta")\n        != {"classified": 19, "unknown": -19, "claims": 2, "segments": 2}\n        or payload_projection.get("current_unknown_only") is not True\n        or payload_projection.get("code_repromotion") is not False\n        or payload_projection.get("literal_pools_claimed") is not False\n        or payload_projection.get("right_gap_claimed") is not False\n    ):\n        raise ValueError("u8 triplet promotion contract changed")\n\n    try:\n        report = verify_rom_u8_indexed_u8_triplet_lookup_bundle(root, artifact)\n    except Exception as error:\n        raise ValueError(\n            f"u8 triplet independent verification failed: {error}"\n        ) from error\n    verification = manifest.get("verification")\n    expected_report = (\n        verification.get("report") if isinstance(verification, dict) else None\n    )\n    if (\n        not isinstance(report, dict)\n        or report.get("schema")\n        != "rom-u8-indexed-u8-triplet-lookup-bundle-verification-v1"\n        or report.get("verified") is not True\n        or report.get("errors") != []\n        or report.get("artifact_schema") != U8_TRIPLET_BATCH\n        or report.get("artifact_status") != "accepted"\n        or report.get("artifact_bundle_verified") is not True\n        or report.get("legacy_receipt_verified") is not True\n        or report.get("live_coverage_verified") is not False\n        or report.get("rom_sha256") != ROM_SHA256\n        or report.get("promotion_bytes") != U8_TRIPLET_BINARY_SIZE\n        or report.get("promotion_claim_count") != 2\n        or report.get("promotion_range_count") != 2\n        or report.get("promotion_range_vector_sha256")\n        != U8_TRIPLET_RANGE_VECTOR_SHA256\n        or report.get("promotion_packed_sha256")\n        != U8_TRIPLET_BINARY_SHA256\n        or report.get("consumer_instruction_count") != 134\n        or report.get("consumer_block_count") != 28\n        or report.get("consumer_frontier_count") != 0\n        or report.get("table_record_count") != 5\n        or report.get("legacy_verifier_sha256") != U8_TRIPLET_VERIFIER_SHA256\n        or report.get("bundle_verifier_sha256")\n        != U8_TRIPLET_BUNDLE_VERIFIER_SHA256\n        or report.get("legacy_report") != expected_report\n        or manifest.get("verifier") != verification\n        or not isinstance(verification, dict)\n        or verification.get("exit_code") != 0\n        or verification.get("verifier_sha256") != U8_TRIPLET_VERIFIER_SHA256\n    ):\n        raise ValueError(\n            f"u8 triplet independent verification failed: {report}"\n        )\n\n    promotion = payload.get("promotion")\n    expected_ranges = [list(spec[1]) for spec in U8_TRIPLET_CLAIM_SPECS]\n    if (\n        not isinstance(promotion, dict)\n        or promotion.get("ranges") != expected_ranges\n        or promotion.get("byte_size") != U8_TRIPLET_BINARY_SIZE\n        or promotion.get("range_vector_sha256")\n        != U8_TRIPLET_RANGE_VECTOR_SHA256\n        or promotion.get("packed_sha256") != U8_TRIPLET_BINARY_SHA256\n        or [row.get("range") for row in promotion.get("claims", [])]\n        != expected_ranges\n    ):\n        raise ValueError("u8 triplet promotion denominator changed")\n    packed = b"".join(\n        rom[start:end] for start, end in map(tuple, expected_ranges)\n    )\n    if (\n        binary_path.read_bytes() != packed\n        or _sha256(packed) != U8_TRIPLET_BINARY_SHA256\n    ):\n        raise ValueError("u8 triplet binary denominator changed")\n\n    try:\n        claims = expected_rom_u8_indexed_u8_triplet_lookup_claims(\n            payload,\n            manifest,\n            manifest_sha256=U8_TRIPLET_MANIFEST_SHA256,\n        )\n    except Exception as error:\n        raise ValueError(\n            f"u8 triplet coverage projection failed: {error}"\n        ) from error\n    projected = [\n        (\n            claim.get("id"),\n            tuple(claim.get("range", [])),\n            claim.get("primary_class"),\n            claim.get("claim_kind"),\n            claim.get("mode"),\n        )\n        for claim in claims\n    ]\n    if projected != list(U8_TRIPLET_CLAIM_SPECS):\n        raise ValueError("u8 triplet coverage claim denominator changed")\n    if any(\n        claim.get("limitations") != [U8_TRIPLET_COVERAGE_LIMITATION]\n        for claim in claims\n    ):\n        raise ValueError("u8 triplet coverage limitations changed")\n\n    primary = [claim for claim in baseline if claim.get("role") == "primary"]\n    for claim in claims:\n        start, end = _validated_range(claim, len(rom))\n        if claim.get("bytes_sha256") != _sha256(rom[start:end]):\n            raise ValueError(f"u8 triplet claim bytes changed: {claim.get(\'id\')}")\n        if any(\n            other_start < end and start < other_end\n            for other in primary\n            for other_start, other_end in [_validated_range(other, len(rom))]\n        ):\n            raise ValueError(\n                f"u8 triplet unknown projection overlap: {claim.get(\'id\')}"\n            )\n    return claims\n\n\ndef _bounded_cgb_cfg_contract(label: str) -> dict[str, Any]:\n    """Return one frozen accepted CGB CFG contract without reading live coverage."""\n\n    if label == "helper":\n        return {\n            "label": "CGB helper bounded CFG",\n            "batch": CGB_HELPER_BOUNDED_BATCH,\n            "artifact": CGB_HELPER_BOUNDED_ARTIFACT,\n            "payload_name": CGB_HELPER_BOUNDED_PAYLOAD_NAME,\n            "binary_name": CGB_HELPER_BOUNDED_BINARY_NAME,\n            "manifest_sha256": CGB_HELPER_BOUNDED_MANIFEST_SHA256,\n            "payload_sha256": CGB_HELPER_BOUNDED_PAYLOAD_SHA256,\n            "binary_sha256": CGB_HELPER_BOUNDED_BINARY_SHA256,\n            "manifest_size": CGB_HELPER_BOUNDED_MANIFEST_SIZE,\n            "payload_size": CGB_HELPER_BOUNDED_PAYLOAD_SIZE,\n            "binary_size": CGB_HELPER_BOUNDED_BINARY_SIZE,\n            "contract_sha256": CGB_HELPER_BOUNDED_CONTRACT_SHA256,\n            "candidate_manifest_sha256": (\n                CGB_HELPER_BOUNDED_CANDIDATE_MANIFEST_SHA256\n            ),\n            "candidate_path": (\n                "build/experiments/active/cgb-helper-bounded-cfg-20260829/"\n                "candidate-r2"\n            ),\n            "range_vector_sha256": CGB_HELPER_BOUNDED_RANGE_VECTOR_SHA256,\n            "claim_specs": CGB_HELPER_BOUNDED_CLAIM_SPECS,\n            "excluded_ranges": CGB_HELPER_BOUNDED_EXCLUDED_RANGES,\n            "scope": CGB_HELPER_BOUNDED_SCOPE,\n            "code_bytes": 164,\n            "literal_bytes": 16,\n            "exporter": CGB_HELPER_BOUNDED_EXPORTER,\n            "exporter_sha256": CGB_HELPER_BOUNDED_EXPORTER_SHA256,\n            "verifier": CGB_HELPER_BOUNDED_VERIFIER,\n            "verifier_sha256": CGB_HELPER_BOUNDED_VERIFIER_SHA256,\n            "verifier_schema": "rom-cgb-helper-bounded-cfg-verification-v1",\n            "exporter_test": CGB_HELPER_BOUNDED_EXPORTER_TEST,\n            "exporter_test_sha256": CGB_HELPER_BOUNDED_EXPORTER_TEST_SHA256,\n            "verifier_test": CGB_HELPER_BOUNDED_VERIFIER_TEST,\n            "verifier_test_sha256": CGB_HELPER_BOUNDED_VERIFIER_TEST_SHA256,\n            "limitation": CGB_HELPER_BOUNDED_COVERAGE_LIMITATION,\n            "coverage_projection": {\n                "claim_delta": 9,\n                "classified_delta": 180,\n                "post_if_applied_alone": {\n                    "claim_count": 14_516,\n                    "classified_bytes": 6_124_781,\n                    "segment_count": 16_628,\n                    "unknown_bytes": 166_675,\n                },\n                "segment_delta": 11,\n                "unknown_delta": -180,\n            },\n        }\n    if label == "cgbsound":\n        return {\n            "label": "CgbSound bounded CFG",\n            "batch": CGBSOUND_BOUNDED_BATCH,\n            "artifact": CGBSOUND_BOUNDED_ARTIFACT,\n            "payload_name": CGBSOUND_BOUNDED_PAYLOAD_NAME,\n            "binary_name": CGBSOUND_BOUNDED_BINARY_NAME,\n            "manifest_sha256": CGBSOUND_BOUNDED_MANIFEST_SHA256,\n            "payload_sha256": CGBSOUND_BOUNDED_PAYLOAD_SHA256,\n            "binary_sha256": CGBSOUND_BOUNDED_BINARY_SHA256,\n            "manifest_size": CGBSOUND_BOUNDED_MANIFEST_SIZE,\n            "payload_size": CGBSOUND_BOUNDED_PAYLOAD_SIZE,\n            "binary_size": CGBSOUND_BOUNDED_BINARY_SIZE,\n            "contract_sha256": CGBSOUND_BOUNDED_CONTRACT_SHA256,\n            "candidate_manifest_sha256": (\n                CGBSOUND_BOUNDED_CANDIDATE_MANIFEST_SHA256\n            ),\n            "candidate_path": (\n                "build/experiments/active/cgbsound-bounded-cfg-20260829/"\n                "candidate"\n            ),\n            "range_vector_sha256": CGBSOUND_BOUNDED_RANGE_VECTOR_SHA256,\n            "claim_specs": CGBSOUND_BOUNDED_CLAIM_SPECS,\n            "excluded_ranges": CGBSOUND_BOUNDED_EXCLUDED_RANGES,\n            "scope": CGBSOUND_BOUNDED_SCOPE,\n            "code_bytes": 1_008,\n            "literal_bytes": 76,\n            "exporter": CGBSOUND_BOUNDED_EXPORTER,\n            "exporter_sha256": CGBSOUND_BOUNDED_EXPORTER_SHA256,\n            "verifier": CGBSOUND_BOUNDED_VERIFIER,\n            "verifier_sha256": CGBSOUND_BOUNDED_VERIFIER_SHA256,\n            "verifier_schema": "rom-cgbsound-bounded-cfg-verification-v1",\n            "exporter_test": CGBSOUND_BOUNDED_EXPORTER_TEST,\n            "exporter_test_sha256": CGBSOUND_BOUNDED_EXPORTER_TEST_SHA256,\n            "verifier_test": CGBSOUND_BOUNDED_VERIFIER_TEST,\n            "verifier_test_sha256": CGBSOUND_BOUNDED_VERIFIER_TEST_SHA256,\n            "limitation": CGBSOUND_BOUNDED_COVERAGE_LIMITATION,\n            "coverage_projection": {\n                "claim_delta": 19,\n                "classified_delta": 1_084,\n                "post_if_applied_alone": {\n                    "claim_count": 14_526,\n                    "classified_bytes": 6_125_685,\n                    "segment_count": 16_644,\n                    "unknown_bytes": 165_771,\n                },\n                "segment_delta": 27,\n                "unknown_delta": -1_084,\n            },\n        }\n    raise ValueError(f"unknown bounded CGB CFG contract: {label}")\n\n\ndef _bounded_cgb_cfg_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n    *,\n    contract_label: str,\n    verifier,\n) -> list[dict[str, Any]]:\n    """Promote one immutable accepted CGB code/literal denominator."""\n\n    root = Path(root).resolve(strict=True)\n    spec = _bounded_cgb_cfg_contract(contract_label)\n    baseline = list(existing_claims)\n    claim_specs = spec["claim_specs"]\n    claim_ids = {row[0] for row in claim_specs}\n    claim_kinds = {row[2] for row in claim_specs}\n    if any(\n        claim.get("promotion_batch") == spec["batch"]\n        or claim.get("id") in claim_ids\n        or claim.get("claim_kind") in claim_kinds\n        for claim in baseline\n    ):\n        raise ValueError(\n            f"{spec[\'label\']} claims require a pre-promotion baseline; "\n            "batch is already present"\n        )\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError(f"{spec[\'label\']} ROM identity changed")\n\n    identifiers = [claim.get("id") for claim in baseline]\n    if any(not isinstance(identifier, str) or not identifier for identifier in identifiers):\n        raise ValueError(f"{spec[\'label\']} baseline has an invalid id")\n    if len(set(identifiers)) != len(identifiers):\n        raise ValueError(f"{spec[\'label\']} baseline ids are not unique")\n    primary: list[dict[str, Any]] = []\n    for claim in baseline:\n        if not isinstance(claim, dict) or claim.get("role") not in {\n            "primary",\n            "secondary",\n        }:\n            raise ValueError(f"{spec[\'label\']} baseline role is invalid")\n        _validated_range(claim, len(rom))\n        if claim.get("role") == "primary":\n            primary.append(claim)\n\n    artifact = _checked_artifact_directory(\n        root,\n        spec["artifact"],\n        {"manifest.json", spec["payload_name"], spec["binary_name"]},\n        label=f"{spec[\'label\']} accepted artifact",\n    )\n    manifest_path = _checked_repository_file(\n        root,\n        spec["artifact