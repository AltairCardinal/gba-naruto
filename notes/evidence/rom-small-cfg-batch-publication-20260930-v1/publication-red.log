aseline replay verifier",\n    )\n    replay_report = verify_replay(root)\n    if (\n        replay_report.get("verified") is not True\n        or replay_report.get("packet_count") != 4\n        or replay_report.get("promotion_bytes") != 7_140\n        or replay_report.get("promotion_claim_count") != 116\n    ):\n        raise ValueError(\n            f"fast-audit immutable-baseline replay failed: {replay_report}"\n        )\n\n    def require_unknown(start: int, end: int) -> None:\n        index = bisect.bisect_right(starts, start) - 1\n        if index < 0:\n            raise ValueError("fast-audit packet escaped coverage")\n        while start < end:\n            segment = segments[index]\n            if segment["primary_class"] != "unknown" or segment["range"][0] > start:\n                raise ValueError("fast-audit packet is not current unknown")\n            start = min(end, segment["range"][1])\n            index += 1\n\n    claims: list[dict[str, Any]] = []\n    for batch, payload_name, manifest_size, manifest_sha, payload_size, payload_sha, verifier_name, verifier_sha in FAST_AUDIT_FOUR_PACKET_SPECS:\n        expected_files = {"manifest.json", payload_name}\n        if batch == "rom-sprite-component-source-v1":\n            expected_files.add("rom-sprite-component-source.bin")\n        artifact = _checked_artifact_directory(root, Path("artifacts") / batch, expected_files, label=f"fast-audit {batch}")\n        _checked_repository_file(root, Path(verifier_name), verifier_sha, label=f"fast-audit {batch} verifier")\n        manifest_raw = (artifact / "manifest.json").read_bytes()\n        payload_raw = (artifact / payload_name).read_bytes()\n        if len(manifest_raw) != manifest_size or _sha256(manifest_raw) != manifest_sha or len(payload_raw) != payload_size or _sha256(payload_raw) != payload_sha:\n            raise ValueError(f"fast-audit {batch} identity changed")\n        payload = json.loads(payload_raw)\n        packet_report = replay_report.get("packets", {}).get(batch)\n        if not isinstance(packet_report, dict) or packet_report.get("verified") is not True:\n            raise ValueError(f"fast-audit {batch} replay result is missing")\n        report_sha = packet_report.get("report_sha256")\n        if not isinstance(report_sha, str) or len(report_sha) != 64:\n            raise ValueError(f"fast-audit {batch} replay report identity is invalid")\n        # Selectors address original payload records, not the temporary projection.\n        selector_prefix = {\n            "rom-event-handler-cfg-v1": "/promotion/semantic_ranges",\n            "rom-sprite-component-source-v1": "/classified_ranges",\n            "rom-cfg-proven-roots-v16": "/promotion/ranges",\n            "rom-cfg-proven-roots-v16-consumed-literals-v1": "/promotion/claims",\n        }[batch]\n        records: list[tuple[str, list[int], str, str, str]] = []\n        if batch == "rom-event-handler-cfg-v1":\n            for index, (start, end, kind) in enumerate(payload["promotion"]["semantic_ranges"]):\n                primary = "armv4t_event_handler_reachable_thumb_code" if kind == "reachable_thumb_code" else "armv4t_event_handler_consumed_literal_word"\n                claim_kind = "event_handler_reachable_instruction_bytes" if kind == "reachable_thumb_code" else "armv4t_event_handler_consumed_literal_word_bytes"\n                records.append((f"event-handler-cfg-{index:03d}-{start:06x}", [start, end], primary, claim_kind, _sha256(rom[start:end])))\n        elif batch == "rom-sprite-component-source-v1":\n            for row in payload["classified_ranges"]:\n                records.append((row["id"], row["range"], row["primary_class"], row["claim_kind"], row["bytes_sha256"]))\n        elif batch == "rom-cfg-proven-roots-v16":\n            for index, interval in enumerate(payload["promotion"]["ranges"]):\n                start, end = interval\n                records.append((f"cfg-proven-roots-v16-code-{index:03d}-{start:06x}", interval, "armv4t_cfg_proven_roots_v16_reachable_thumb_code", "cfg_proven_roots_v16_reachable_instruction_bytes", _sha256(rom[start:end])))\n        else:\n            promotion = payload["promotion"]\n            for row in promotion["claims"]:\n                records.append((row["id"], row["range"], promotion["primary_class"], promotion["claim_kind"], row["bytes_sha256"]))\n        for index, (claim_id, interval, primary, claim_kind, bytes_sha) in enumerate(records):\n            start, end = interval\n            if start >= end or _sha256(rom[start:end]) != bytes_sha:\n                raise ValueError(f"fast-audit {batch} range bytes changed")\n            require_unknown(start, end)\n            claims.append({\n                "id": claim_id, "range": [start, end], "role": "primary",\n                "primary_class": primary, "claim_kind": claim_kind,\n                "promotion_batch": batch, "promoted_from_primary_class": "unknown",\n                "baseline_unknown_only": True, "bytes_sha256": bytes_sha,\n                "evidence_path": (Path("artifacts") / batch / payload_name).as_posix(),\n                "evidence_sha256": payload_sha, "evidence_selector": f"{selector_prefix}/{index}",\n                "promotion_manifest_path": (Path("artifacts") / batch / "manifest.json").as_posix(),\n                "promotion_manifest_sha256": manifest_sha,\n                "independent_verifier_path": verifier_name,\n                "independent_verifier_sha256": verifier_sha,\n                "independent_verifier_report_sha256": report_sha,\n                "immutable_baseline_replay_verifier_path": FAST_AUDIT_REPLAY_VERIFIER.as_posix(),\n                "immutable_baseline_replay_verifier_sha256": FAST_AUDIT_REPLAY_VERIFIER_SHA256,\n                "runtime_reachability_claimed": False, "loaded_value_semantics_claimed": False,\n                "editing_writeback_relocation_safe_claimed": False,\n                "free_or_allocatable_space_claimed": False,\n                "mod