= {"path": ROM_PATH.as_posix(), "size": len(rom), "sha256": ROM_SHA256}\n        or payload.get("summary") != expected_summary\n        or payload.get("record_range_denominator_sha256")\n        != TRAINING_TEXT_SCRIPT_RECORD_DENOMINATOR_SHA256\n        or payload.get("command_range_denominator_sha256")\n        != TRAINING_TEXT_SCRIPT_COMMAND_DENOMINATOR_SHA256\n        or payload.get("command_sequence_sha256")\n        != TRAINING_TEXT_SCRIPT_COMMAND_SEQUENCE_SHA256\n        or payload.get("command_opcode_counts")\n        != {"0": 44, "1": 44, "3": 44, "4": 44, "5": 44, "12": 44}\n        or payload.get("scope") != TRAINING_TEXT_SCRIPT_SCOPE\n        or payload.get("files")\n        != {\n            bundle_path.name: {\n                "size": 2_505,\n                "sha256": TRAINING_TEXT_SCRIPT_BUNDLE_SHA256,\n            }\n        }\n        or not isinstance(implementation, dict)\n        or implementation.get("verifier")\n        != {\n            "path": TRAINING_TEXT_SCRIPT_VERIFIER.as_posix(),\n            "sha256": TRAINING_TEXT_SCRIPT_VERIFIER_SHA256,\n        }\n    ):\n        raise ValueError("training-text-script payload denominator changed")\n\n    report = verify_rom_training_text_script_inventory(root, artifact)\n    expected_report = {\n        "schema": "rom-training-text-script-inventory-verification-v1",\n        "verified": True,\n        "errors": [],\n        **expected_summary,\n        "summary": expected_summary,\n        "bundle_sha256": TRAINING_TEXT_SCRIPT_BUNDLE_SHA256,\n        "record_range_denominator_sha256": (\n            TRAINING_TEXT_SCRIPT_RECORD_DENOMINATOR_SHA256\n        ),\n        "command_range_denominator_sha256": (\n            TRAINING_TEXT_SCRIPT_COMMAND_DENOMINATOR_SHA256\n        ),\n    }\n    if report != expected_report:\n        raise ValueError(\n            f"training-text-script independent verifier failed: {report}"\n        )\n\n    table = payload.get("pointer_table")\n    if (\n        not isinstance(table, dict)\n        or table.get("semantic_type")\n        != "training_text_command_script_pointer_table"\n        or table.get("range") != [0x59A104, 0x59A1B8]\n        or table.get("entry_count") != 45\n        or table.get("entry_size") != 4\n        or table.get("null_slot_indices") != [0]\n        or table.get("non_null_slot_indices") != list(range(1, 45))\n        or table.get("sha256") != TRAINING_TEXT_SCRIPT_TABLE_SHA256\n        or _sha256(rom[0x59A104:0x59A1B8])\n        != TRAINING_TEXT_SCRIPT_TABLE_SHA256\n    ):\n        raise ValueError("training-text-script pointer-table denominator changed")\n    records = payload.get("records")\n    classified = payload.get("classified_ranges")\n    if not isinstance(records, list) or len(records) != 44:\n        raise ValueError("training-text-script record denominator changed")\n    if not isinstance(classified, list) or len(classified) != 44:\n        raise ValueError("training-text-script classified denominator changed")\n    records_by_id = {\n        record.get("record_id"): record\n        for record in records\n        if isinstance(record, dict) and isinstance(record.get("record_id"), str)\n    }\n    if len(records_by_id) != 44:\n        raise ValueError("training-text-script record IDs changed")\n\n    claims: list[dict[str, Any]] = []\n    record_ranges: list[list[int]] = []\n    command_ranges: list[list[int]] = []\n    command_sequence: list[list[int]] = []\n    packed_cursor = 0\n    previous_end = 0x7554\n    expected_opcodes = [1, 5, 4, 12, 3, 0]\n    for index, item in enumerate(classified):\n        slot = index + 1\n        record_id = f"training-text-script-{slot:02d}"\n        record = records_by_id.get(record_id)\n        if not isinstance(item, dict) or not isinstance(record, dict):\n            raise ValueError(f"training-text-script record changed: {slot}")\n        value = item.get("range")\n        packed = item.get("packed_range")\n        if (\n            item.get("range_id") != record_id\n            or item.get("kind") != "training_text_command_script"\n            or item.get("slot_index") != slot\n            or record.get("record_id") != record_id\n            or record.get("slot_index") != slot\n            or record.get("opcode_sequence") != expected_opcodes\n            or value != record.get("range")\n            or packed != record.get("packed_range")\n            or not isinstance(value, list)\n            or len(value) != 2\n            or not all(isinstance(boundary, int) for boundary in value)\n            or not isinstance(packed, list)\n            or len(packed) != 2\n            or not all(isinstance(boundary, int) for boundary in packed)\n        ):\n            raise ValueError(f"training-text-script schema changed: {slot}")\n        start, end = value\n        packed_start, packed_end = packed\n        raw = rom[start:end]\n        if (\n            start != previous_end\n            or not 0 <= start < end <= len(rom)\n            or packed_start != packed_cursor\n            or packed_end - packed_start != end - start\n            or item.get("size") != end - start\n            or record.get("size") != end - start\n            or item.get("sha256") != _sha256(raw)\n            or record.get("sha256") != item.get("sha256")\n            or bundle[packed_start:packed_end] != raw\n        ):\n            raise ValueError(f"training-text-script bytes changed: {slot}")\n        commands = record.get("commands")\n        if not isinstance(commands, list) or len(commands) != 6:\n            raise ValueError(f"training-text-script commands changed: {slot}")\n        command_cursor = start\n        for opcode, command in zip(expected_opcodes, commands):\n            if (\n                not isinstance(command, dict)\n                or command.get("opcode") != opcode\n                or not isinstance(command.get("range"), list)\n                or len(command["range"]) != 2\n                or command["range"][0] != command_cursor\n                or not command_cursor < command["range"][1] <= end\n            ):\n                raise ValueError(\n                    f"training-text-script command grammar changed: {slot}"\n                )\n            command_cursor = command["range"][1]\n            command_ranges.append(command["range"])\n            command_sequence.append([slot, opcode])\n        if command_cursor != end:\n            raise ValueError(f"training-text-script command tail changed: {slot}")\n        record_ranges.append(value)\n        previous_end = end\n        packed_cursor = packed_end\n        claims.append(\n            {\n                "id": f"training-text-script-record-{slot:02d}-{start:06x}",\n                "range": value,\n                "role": "primary",\n                "primary_class": "training_text_command_script",\n                "claim_kind": "training_text_command_script_bytes",\n                "bytes_sha256": item["sha256"],\n                "evidence_path": TRAINING_TEXT_SCRIPT_PAYLOAD.as_posix(),\n                "evidence_sha256": TRAINING_TEXT_SCRIPT_PAYLOAD_SHA256,\n                "evidence_selector": f"/classified_ranges/{index}",\n                "promotion_manifest_path": (\n                    TRAINING_TEXT_SCRIPT_ARTIFACT / "manifest.json"\n                ).as_posix(),\n                "promotion_manifest_sha256": (\n                    TRAINING_TEXT_SCRIPT_MANIFEST_SHA256\n                ),\n                "independent_verifier_path": (\n                    TRAINING_TEXT_SCRIPT_VERIFIER.as_posix()\n                ),\n                "independent_verifier_sha256": (\n                    TRAINING_TEXT_SCRIPT_VERIFIER_SHA256\n                ),\n                "record_id": record_id,\n                "slot_index": slot,\n                "limitations": [\n                    "The fixed-slot interpreter consumes this command script; natural execution of every training ID, Unicode decoding, and editing safety remain unclaimed."