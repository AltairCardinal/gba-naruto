LZ77/palette gap baseline role changed")\n        start, end = _validated_range(claim, len(rom))\n        by_id[identifier] = claim\n        by_range.setdefault((start, end), []).append(claim)\n        normalized.append((claim, start, end))\n\n    ranges: list[list[int]] = []\n    packed_parts: list[bytes] = []\n    for index, row in enumerate(rows):\n        if not isinstance(row, dict):\n            raise ValueError("tile-BG LZ77/palette gap row changed")\n        gap = row.get("range")\n        left_range = row.get("left")\n        right_range = row.get("right")\n        if (\n            not isinstance(gap, list)\n            or len(gap) != 2\n            or not all(isinstance(value, int) for value in gap)\n            or not isinstance(left_range, list)\n            or len(left_range) != 2\n            or not all(isinstance(value, int) for value in left_range)\n            or not isinstance(right_range, list)\n            or len(right_range) != 2\n            or not all(isinstance(value, int) for value in right_range)\n        ):\n            raise ValueError(f"tile-BG LZ77/palette gap row {index} ranges changed")\n        start, end = gap\n        left_start, left_end = left_range\n        right_start, right_end = right_range\n        raw = rom[start:end]\n        if (\n            row.get("gfx_stream_range") != left_range\n            or row.get("palette_range") != right_range\n            or not (0 <= left_start < left_end == start < end == right_start < right_end)\n            or end != ((start + 3) & ~3)\n            or end - start not in {1, 2, 3}\n            or right_end - right_start not in {32, 128}\n            or any(raw)\n            or row.get("size") != end - start\n            or row.get("alignment_unit_bytes") != 4\n            or row.get("raw_hex") != raw.hex()\n            or row.get("bytes_sha256") != _sha256(raw)\n            or row.get("left_id") != f"lz77-{left_start:06x}"\n            or row.get("left_primary_class") != "lz77_resource"\n            or row.get("right_id") != f"tile-bg-palette-{right_start:06x}"\n            or row.get("right_primary_class") != "palette_bgr555"\n            or row.get("right_claim_kind") != "tile_bg_palette_source_range"\n        ):\n            raise ValueError(f"tile-BG LZ77/palette gap row {index} changed")\n        overlaps = [\n            claim["id"]\n            for claim, claim_start, claim_end in normalized\n            if claim_start < end and start < claim_end\n        ]\n        if overlaps:\n            raise ValueError(\n                "tile-BG LZ77/palette gap is not fully current unknown; "\n                f"overlap at row {index}: {overlaps}"\n            )\n        ranges.append(gap)\n        packed_parts.append(raw)\n\n    if _sha256(\n        json.dumps(ranges, separators=(",", ":")).encode("ascii")\n    ) != TILE_BG_LZ77_PALETTE_GAP_RANGE_VECTOR_SHA256:\n        raise ValueError("tile-BG LZ77/palette gap range vector changed")\n    packed = b"".join(packed_parts)\n    if (\n        len(packed) != TILE_BG_LZ77_PALETTE_GAP_BYTES\n        or _sha256(packed) != TILE_BG_LZ77_PALETTE_GAP_PACKED_BYTES_SHA256\n    ):\n        raise ValueError("tile-BG LZ77/palette gap packed bytes changed")\n\n    references = _aligned_rom_pointer_references(rom)\n    non_claim_flags = {\n        f"{name}_claimed": False\n        for name in TILE_BG_LZ77_PALETTE_GAP_NON_CLAIMS\n    }\n    claims: list[dict[str, Any]] = []\n    packed_cursor = 0\n    for index, row in enumerate(rows):\n        start, end = row["range"]\n        left_start, left_end = row["left"]\n        right_start, right_end = row["right"]\n        left_candidates = by_range.get((left_start, left_end), [])\n        left_overlaps = [\n            claim["id"]\n            for claim, claim_start, claim_end in normalized\n            if claim_start < left_end and left_start < claim_end\n        ]\n        parsed = _parse_lz77(rom, left_start, materialize=False)\n        if (\n            len(left_candidates) != 1\n            or left_overlaps != [left_candidates[0].get("id")]\n            or parsed is None\n            or parsed[0] != left_end\n        ):\n            raise ValueError(f"tile-BG LZ77/palette gap left owner changed: {index}")\n        left = left_candidates[0]\n        if (\n            left.get("id") != row["left_id"]\n            or left.get("role") != "primary"\n            or left.get("primary_class") != "lz77_resource"\n            or left.get("claim_kind") != "aligned_pointer_reachable_lz77"\n            or left.get("aligned_pointer_reference_count")\n            != len(references.get(left_start, ()))\n            or left.get("aligned_pointer_reference_count", 0) <= 0\n            or left.get("bytes_sha256") != _sha256(rom[left_start:left_end])\n            or left.get("evidence_path")\n            != TILE_BG_LZ77_PALETTE_GAP_POINTER_PAYLOAD.as_posix()\n            or left.get("evidence_sha256")\n            != TILE_BG_LZ77_PALETTE_GAP_POINTER_PAYLOAD_SHA256\n        ):\n            raise ValueError(f"tile-BG LZ77/palette gap left owner changed: {index}")\n\n        right_candidates = by_range.get((right_start, right_end), [])\n        right_overlaps = [\n            claim["id"]\n            for claim, claim_start, claim_end in normalized\n            if claim_start < right_end and right_start < claim_end\n        ]\n        if (\n            len(right_candidates) != 1\n            or right_overlaps != [right_candidates[0].get("id")]\n        ):\n            raise ValueError(f"tile-BG LZ77/palette gap right owner changed: {index}")\n        right = right_candidates[0]\n        bindings = right.get("bindings")\n        bits_per_pixel = right.get("bits_per_pixel")\n        if (\n            right.get("id") != row["right_id"]\n            or right.get("role") != "primary"\n            or right.get("primary_class") != "palette_bgr555"\n            or right.get("claim_kind") != "tile_bg_palette_source_range"\n            or not isinstance(bindings, list)\n            or not bindings\n            or any(\n                not isinstance(binding, dict)\n                or not isinstance(binding.get("descriptor_id"), int)\n                or binding.get("layer") not in {"A", "B", "C", "D"}\n                for binding in bindings\n            )\n            or bits_per_pixel not in {4, 8}\n            or right.get("color_count") != (16 if bits_per_pixel == 4 else 64)\n            or right.get("source_ranges") != [[right_start, right_end]]\n            or right.get("bytes_sha256") != _sha256(rom[right_start:right_end])\n            or right.get("evidence_path")\n            != TILE_BG_LZ77_PALETTE_GAP_TILE_MANIFEST.as_posix()\n            or right.get("evidence_sha256")\n            != TILE_BG_LZ77_PALETTE_GAP_TILE_MANIFEST_SHA256\n        ):\n            raise ValueError(f"tile-BG LZ77/palette gap right owner changed: {index}")\n\n        size = end - start\n        claim = {\n            "id": row["id"],\n            "range": [start, end],\n            "gba_range": [GBA_ROM_BASE + start, GBA_ROM_BASE + end],\n            "role": "primary",\n            "primary_class": TILE_BG_LZ77_PALETTE_GAP_PRIMARY_CLASS,\n            "claim_kind": TILE_BG_LZ77_PALETTE_GAP_CLAIM_KIND,\n            "promotion_batch": TILE_BG_LZ77_PALETTE_GAP_BATCH,\n            "promoted_from_primary_class": "unknown",\n            "baseline_unknown_only": True,\n            "bytes_sha256": row["bytes_sha256"],\n            "packed_range": [packed_cursor, packed_cursor + size],\n            "packed_bytes_sha256": TILE_BG_LZ77_PALETTE_GAP_PACKED_BYTES_SHA256,\n            "range_vector_sha256": TILE_BG_LZ77_PALETTE_GAP_RANGE_VECTOR_SHA256,\n            "boundary_vector_sha256": (\n                TILE_BG_LZ77_PALETTE_GAP_BOUNDARY_VECTOR_SHA256\n            ),\n            "claim_denominator_sha256": (\n                TILE_BG_LZ77_PALETTE_GAP_CLAIM_DENOMINATOR_SHA256\n            ),\n            "alignment_unit_bytes": 4,\n            "alignment_target": end,\n            "alignment_formula_expression": "(start + 3) & ~3",\n            "alignment_gap_bytes": size,\n            "alignment_gap_is_exact": True,\n            "previous_owner_id": left["id"],\n            "previous_owner_range": [left_start, left_end],\n            "previous_owner_primary_class": left["primary_class"],\n            "previous_owner_claim_kind": left["claim_kind"],\n            "next_owner_id": right["id"],\n            "next_owner_range": [right_start, right_end],\n            "next_owner_primary_class": right["primary_class"],\n            "next_owner_claim_kind": right["claim_kind"],\n            "evidence_path": TILE_BG_LZ77_PALETTE_GAP_VERIFIER.as_posix(),\n            "evidence_sha256": TILE_BG_LZ77_PALETTE_GAP_VERIFIER_SHA256,\n            "evidence_selector": f"/rows/{index}",\n            "independent_verifier_path": (\n                TILE_BG_LZ77_PALETTE_GAP_VERIFIER.as_posix()\n            ),\n            "independent_verifier_sha256": (\n                TILE_BG_LZ77_PALETTE_GAP_VERIFIER_SHA256\n            ),\n            "independent_verifier_report_sha256": (\n                TILE_BG_LZ77_PALETTE_GAP_REPORT_SHA256\n            ),\n            "upstream_test_path": TILE_BG_LZ77_PALETTE_GAP_TEST.as_posix(),\n            "upstream_test_sha256": TILE_BG_LZ77_PALETTE_GAP_TEST_SHA256,\n            "pointer_inventory_manifest_path": (\n                TILE_BG_LZ77_PALETTE_GAP_POINTER_MANIFEST.as_posix()\n            ),\n            "pointer_inventory_manifest_sha256": (\n                TILE_BG_LZ77_PALETTE_GAP_POINTER_MANIFEST_SHA256\n            ),\n            "pointer_inventory_payload_path": (\n                TILE_BG_LZ77_PALETTE_GAP_POINTER_PAYLOAD.as_posix()\n            ),\n            "pointer_inventory_payload_sha256": (\n                TILE_BG_LZ77_PALETTE_GAP_POINTER_PAYLOAD_SHA256\n            ),\n            "tile_inventory_manifest_path": (\n                TILE_BG_LZ77_PALETTE_GAP_TILE_MANIFEST.as_posix()\n            ),\n            "tile_inventory_manifest_sha256": (\n                TILE_BG_LZ77_PALETTE_GAP_TILE_MANIFEST_SHA256\n            ),\n            "tile_inventory_verifier_path": (\n                TILE_BG_LZ77_PALETTE_GAP_TILE_VERIFIER.as_posix()\n            ),\n            "tile_inventory_verifier_sha256": (\n                TILE_BG_LZ77_PALETTE_GAP_TILE_VERIFIER_SHA256\n            ),\n            "non_claims": list(TILE_BG_LZ77_PALETTE_GAP_NON_CLAIMS),\n            **non_claim_flags,\n            "limitations": [TILE_BG_LZ77_PALETTE_GAP_COVERAGE_LIMITATION],\n        }\n        claims.append(claim)\n        packed_cursor += size\n\n    denominator = _sha256(\n        json.dumps(\n            [\n                {\n                    key: claim[key]\n                    for key in (\n                        "id",\n                        "range",\n                        "primary_class",\n                        "claim_kind",\n                        "bytes_sha256",\n                        "previous_owner_id",\n                        "next_owner_id",\n                        "evidence_selector",\n                    )\n                }\n                for claim in claims\n            ],\n            ensure_ascii=True,\n            separators=(",", ":"),\n            sort_keys=True,\n        ).encode("ascii")\n    )\n    if (\n        len(claims) != TILE_BG_LZ77_PALETTE_GAP_COUNT\n        or packed_cursor != TILE_BG_LZ77_PALETTE_GAP_BYTES\n        or denominator != TILE_BG_LZ77_PALETTE_GAP_CLAIM_DENOMINATOR_SHA256\n    ):\n        raise ValueError(\n            "tile-BG LZ77/palette gap coverage denominator changed: "\n            f"claims={len(claims)}, bytes={packed_cursor}, sha256={denominator}"\n        )\n    return claims\n\n\ndef _boot_thumb_code_literal_alignment_gap_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote the twelve frozen boot Thumb code-to-literal align4 gaps."""\n\n    raw_root = Path(root)\n    if raw_root.is_symlink():\n        raise ValueError("boot code/literal gap root uses a symlink")\n    root = raw_root.resolve(strict=True)\n    baseline = list(existing_claims)\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError("boot code/literal gap ROM identity changed")\n\n    static_contract = (\n        (\n            BOOT_THUMB_CODE_LITERAL_GAP_BATCH,\n            "rom-boot-thumb-code-literal-alignment-gaps-v1",\n        ),\n        (\n            BOOT_THUMB_CODE_LITERAL_GAP_PRIMARY_CLASS,\n            "boot_thumb_code_literal_alignment_bytes",\n        ),\n        (\n            BOOT_THUMB_CODE_LITERAL_GAP_CLAIM_KIND,\n            "boot_thumb_code_literal_alignment_gap_bytes",\n        ),\n        (BOOT_THUMB_CODE_LITERAL_GAP_COUNT, 12),\n        (BOOT_THUMB_CODE_LITERAL_GAP_BYTES, 24),\n        (\n            BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_PAYLOAD,\n            Path(\n                "artifacts/rom-boot-thumb-handoff-cfg-v1/"\n                "rom-boot-thumb-handoff-cfg.json"\n            ),\n        ),\n        (\n            BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_PAYLOAD_SHA256,\n            "a35b581e44b276399874a2fc393f22f3c548c6b99e053f504587bdd92fbad295",\n        ),\n        (\n            BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_MANIFEST_SHA256,\n            "d5af12930ed8e7539396f81deda19ae938eee3f029b95c959f6fa5d57c676d74",\n        ),\n        (\n            BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_VERIFIER_SHA256,\n            "2592e4f48f1a197e30cb4d360201228fc2bbeef5fad12879b1bbf77b29815b39",\n        ),\n    )\n    if any(actual != expected for actual, expected in static_contract):\n        raise ValueError("boot code/literal gap contract constants changed")\n\n    source_files = (\n        (\n            BOOT_THUMB_CODE_LITERAL_GAP_VERIFIER,\n            BOOT_THUMB_CODE_LITERAL_GAP_VERIFIER_SHA256,\n            "boot code/literal gap verifier",\n        ),\n        (\n            BOOT_THUMB_CODE_LITERAL_GAP_TEST,\n            BOOT_THUMB_CODE_LITERAL_GAP_TEST_SHA256,\n            "boot code/literal gap test",\n        ),\n        (\n            BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_MANIFEST,\n            BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_MANIFEST_SHA256,\n            "boot code/literal gap source manifest",\n        ),\n        (\n            BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_PAYLOAD,\n            BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_PAYLOAD_SHA256,\n            "boot code/literal gap source payload",\n        ),\n        (\n            BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_VERIFIER,\n            BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_VERIFIER_SHA256,\n            "boot code/literal gap source verifier",\n        ),\n        (\n            BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_EXPORTER,\n            BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_EXPORTER_SHA256,\n            "boot code/literal gap source exporter",\n        ),\n        (\n            BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_TEST,\n            BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_TEST_SHA256,\n            "boot code/literal gap source test",\n        ),\n    )\n    for relative, expected_sha256, label in source_files:\n        _checked_repository_file(root, relative, expected_sha256, label=label)\n\n    try:\n        report = verify_rom_boot_thumb_code_literal_alignment_gaps(root)\n    except Exception as error:\n        raise ValueError(\n            f"boot code/literal gap independent verification failed: {error}"\n        ) from error\n    if (\n        not isinstance(report, dict)\n        or report.get("verified") is not True\n        or report.get("errors") != []\n    ):\n        raise ValueError(\n            "boot code/literal gap independent verification failed: "\n            f"{report}"\n        )\n    report_sha256 = _sha256(\n        json.dumps(\n            report,\n            ensure_ascii=True,\n            separators=(",", ":"),\n            sort_keys=True,\n        ).encode("ascii")\n    )\n    summary = report.get("summary")\n    source = report.get("source")\n    rows = report.get("gaps")\n    expected_non_claims = {\n        name: False for name in BOOT_THUMB_CODE_LITERAL_GAP_NON_CLAIMS\n    }\n    if (\n        report_sha256 != BOOT_THUMB_CODE_LITERAL_GAP_REPORT_SHA256\n        or report.get("schema")\n        != "rom-boot-thumb-code-literal-alignment-gaps-verification-v1"\n        or report.get("promotion_batch") != BOOT_THUMB_CODE_LITERAL_GAP_BATCH\n        or report.get("primary_class")\n        != BOOT_THUMB_CODE_LITERAL_GAP_PRIMARY_CLASS\n        or report.get("claim_kind") != BOOT_THUMB_CODE_LITERAL_GAP_CLAIM_KIND\n        or report.get("contract_sha256")\n        != "2298b1f03236d77eb14e0970612c54cbfa2ba10f92ba595fc1cb6426a61f338b"\n        or not isinstance(summary, dict)\n        or summary.get("code_range_count") != 27\n        or summary.get("code_bytes") != 1_226\n        or summary.get("consumed_literal_range_count") != 22\n        or summary.get("consumed_literal_bytes") != 296\n        or summary.get("literal_binding_count") != 77\n        or summary.get("gap_count") != BOOT_THUMB_CODE_LITERAL_GAP_COUNT\n        or summary.get("gap_bytes") != BOOT_THUMB_CODE_LITERAL_GAP_BYTES\n        or summary.get("size_counts") != {"2": 12}\n        or summary.get("flow_counts")\n        != {"indirect_branch": 1, "return": 5, "unconditional_branch": 6}\n        or summary.get("all_bytes_zero") is not True\n        or summary.get("range_vector_sha256")\n        != BOOT_THUMB_CODE_LITERAL_GAP_RANGE_VECTOR_SHA256\n        or summary.get("boundary_vector_sha256")\n        != BOOT_THUMB_CODE_LITERAL_GAP_BOUNDARY_VECTOR_SHA256\n        or summary.get("packed_bytes_sha256")\n        != BOOT_THUMB_CODE_LITERAL_GAP_PACKED_BYTES_SHA256\n        or report.get("non_claims") != expected_non_claims\n        or report.get("source_artifact_historical_envelope_gaps_classified")\n        is not False\n        or report.get("source_wide_envelope_is_claim") is not False\n        or report.get("new_packet_additive") is not True\n        or not isinstance(report.get("limitations"), list)\n        or not isinstance(source, dict)\n        or source.get("manifest")\n        != {\n            "path": BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_MANIFEST.as_posix(),\n            "sha256": BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_MANIFEST_SHA256,\n        }\n        or source.get("payload")\n        != {\n            "path": BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_PAYLOAD.as_posix(),\n            "sha256": BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_PAYLOAD_SHA256,\n        }\n        or not isinstance(rows, list)\n        or len(rows) != BOOT_THUMB_CODE_LITERAL_GAP_COUNT\n    ):\n        raise ValueError(\n            "boot code/literal gap independent verification report changed"\n        )\n\n    row_ids = {row.get("id") for row in rows if isinstance(row, dict)}\n    if len(row_ids) != BOOT_THUMB_CODE_LITERAL_GAP_COUNT or None in row_ids:\n        raise ValueError("boot code/literal gap row IDs changed")\n    if any(\n        not isinstance(claim, dict)\n        or claim.get("promotion_batch") == BOOT_THUMB_CODE_LITERAL_GAP_BATCH\n        or claim.get("claim_kind") == BOOT_THUMB_CODE_LITERAL_GAP_CLAIM_KIND\n        or claim.get("primary_class") == BOOT_THUMB_CODE_LITERAL_GAP_PRIMARY_CLASS\n        or claim.get("id") in row_ids\n        for claim in baseline\n    ):\n        raise ValueError(\n            "pre-boot-code/literal gap claim is already present or baseline changed"\n        )\n\n    by_id: dict[str, dict[str, Any]] = {}\n    by_range: dict[tuple[int, int], list[dict[str, Any]]] = {}\n    normalized: list[tuple[dict[str, Any], int, int]] = []\n    for claim in baseline:\n        identifier = claim.get("id")\n        if not isinstance(identifier, str) or not identifier or identifier in by_id:\n            raise ValueError("boot code/literal gap baseline IDs changed")\n        if claim.get("role") not in {"primary", "secondary"}:\n            raise ValueError("boot code/literal gap baseline role changed")\n        start, end = _validated_range(claim, len(rom))\n        by_id[identifier] = claim\n        by_range.setdefault((start, end), []).append(claim)\n        normalized.append((claim, start, end))\n\n    ranges: list[list[int]] = []\n    packed_parts: list[bytes] = []\n    for index, row in enumerate(rows):\n        if not isinstance(row, dict):\n            raise ValueError("boot code/literal gap row changed")\n        gap = row.get("range")\n        left = row.get("left")\n        right = row.get("right")\n        terminal = row.get("terminal")\n        if (\n            not isinstance(gap, list)\n            or len(gap) != 2\n            or not all(isinstance(value, int) for value in gap)\n            or not isinstance(left, dict)\n            or not isinstance(right, dict)\n            or not isinstance(terminal, dict)\n        ):\n            raise ValueError(f"boot code/literal gap row {index} changed")\n        left_range = left.get("range")\n        right_range = right.get("range")\n        if (\n            not isinstance(left_range, list)\n            or len(left_range) != 2\n            or not all(isinstance(value, int) for value in left_range)\n            or not isinstance(right_range, list)\n            or len(right_range) != 2\n            or not all(isinstance(value, int) for value in right_range)\n        ):\n            raise ValueError(f"boot code/literal gap row {index} ranges changed")\n        start, end = gap\n        left_start, left_end = left_range\n        right_start, right_end = right_range\n        raw = rom[start:end]\n        left_index = left.get("source_index")\n        right_index = right.get("source_index")\n        expected_left_source_id = (\n            f"thumb-code-{left_index:02d}-{left_start:06x}"\n            if isinstance(left_index, int)\n            else None\n        )\n        expected_right_source_id = (\n            f"thumb-literal-{right_index:02d}-{right_start:06x}"\n            if isinstance(right_index, int)\n            else None\n        )\n        if (\n            not (0 <= left_start < left_end == start < end == right_start < right_end)\n            or end != ((left_end + 3) & ~3)\n            or end - start != 2\n            or raw != b"\\x00\\x00"\n            or row.get("size") != 2\n            or row.get("raw_hex") != raw.hex()\n            or row.get("sha256") != _sha256(raw)\n            or left.get("kind") != "reachable_thumb_code"\n            or right.get("kind") != "consumed_literal_pool"\n            or left.get("source_artifact_claim_id") != expected_left_source_id\n            or left.get("source_artifact_semantic_class")\n            != "armv4t_cfg_handoff_thumb_code"\n            or right.get("source_artifact_claim_id") != expected_right_source_id\n            or right.get("source_artifact_semantic_class")\n            != "thumb_pc_relative_literal"\n            or terminal.get("offset") != left_end - 2\n            or terminal.get("raw_hex") != rom[left_end - 2 : left_end].hex()\n            or terminal.get("flow_kind")\n            not in {"unconditional_branch", "return", "indirect_branch"}\n        ):\n            raise ValueError(f"boot code/literal gap row {index} changed")\n        overlaps = [\n            claim["id"]\n            for claim, claim_start, claim_end in normalized\n            if claim.get("role") == "primary"\n            and claim_start < end\n            and start < claim_end\n        ]\n        if overlaps:\n            raise ValueError(\n                "boot code/literal gap is not fully current unknown; "\n                f"overlap at row {index}: {overlaps}"\n            )\n        ranges.append(gap)\n        packed_parts.append(raw)\n\n    if _sha256(\n        json.dumps(ranges, separators=(",", ":")).encode("ascii")\n    ) != BOOT_THUMB_CODE_LITERAL_GAP_RANGE_VECTOR_SHA256:\n        raise ValueError("boot code/literal gap range vector changed")\n    packed = b"".join(packed_parts)\n    if (\n        len(packed) != BOOT_THUMB_CODE_LITERAL_GAP_BYTES\n        or _sha256(packed) != BOOT_THUMB_CODE_LITERAL_GAP_PACKED_BYTES_SHA256\n    ):\n        raise ValueError("boot code/literal gap packed bytes changed")\n\n    non_claim_flags = {\n        f"{name}_claimed": False\n        for name in BOOT_THUMB_CODE_LITERAL_GAP_NON_CLAIMS\n    }\n    claims: list[dict[str, Any]] = []\n    packed_cursor = 0\n    for index, row in enumerate(rows):\n        start, end = row["range"]\n        left = row["left"]\n        right = row["right"]\n        left_start, left_end = left["range"]\n        right_start, right_end = right["range"]\n        left_candidates = [\n            claim\n            for claim in by_range.get((left_start, left_end), [])\n            if claim.get("role") == "primary"\n        ]\n        right_candidates = [\n            claim\n            for claim in by_range.get((right_start, right_end), [])\n            if claim.get("role") == "primary"\n        ]\n        left_index = left["source_index"]\n        right_index = right["source_index"]\n        expected_left_id = (\n            f"boot-thumb-handoff-code-{left_index:02d}-{left_start:06x}"\n        )\n        expected_right_id = (\n            f"boot-thumb-handoff-literal-{right_index:02d}-{right_start:06x}"\n        )\n        if len(left_candidates) != 1:\n            raise ValueError(f"boot code/literal gap left owner changed: {index}")\n        if len(right_candidates) != 1:\n            raise ValueError(f"boot code/literal gap right owner changed: {index}")\n        left_owner = left_candidates[0]\n        right_owner = right_candidates[0]\n        common_owner_contract = {\n            "promotion_batch": "rom-boot-thumb-handoff-cfg-v1",\n            "promotion_manifest_path": (\n                BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_MANIFEST.as_posix()\n            ),\n            "promotion_manifest_sha256": (\n                BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_MANIFEST_SHA256\n            ),\n            "evidence_path": BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_PAYLOAD.as_posix(),\n            "evidence_sha256": BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_PAYLOAD_SHA256,\n            "independent_verifier_path": (\n                BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_VERIFIER.as_posix()\n            ),\n            "independent_verifier_sha256": (\n                BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_VERIFIER_SHA256\n            ),\n        }\n        if (\n            left_owner.get("id") != expected_left_id\n            or left_owner.get("role") != "primary"\n            or left_owner.get("primary_class")\n            != "armv4t_boot_thumb_handoff_reachable_code"\n            or left_owner.get("claim_kind")\n            != "boot_thumb_handoff_reachable_instruction_bytes"\n            or left_owner.get("artifact_range_id")\n            != f"code-{left_index:02d}-{left_start:06x}"\n            or left_owner.get("artifact_range_kind") != "code"\n            or left_owner.get("mode") != "thumb"\n            or left_owner.get("bytes_sha256")\n            != _sha256(rom[left_start:left_end])\n            or any(\n                left_owner.get(key) != value\n                for key, value in common_owner_contract.items()\n            )\n        ):\n            raise ValueError(f"boot code/literal gap left owner changed: {index}")\n        if (\n            right_owner.get("id") != expected_right_id\n            or right_owner.get("role") != "primary"\n            or right_owner.get("primary_class")\n            != "armv4t_boot_thumb_handoff_consumed_literal_pool"\n            or right_owner.get("claim_kind")\n            != "boot_thumb_handoff_consumed_literal_bytes"\n            or right_owner.get("artifact_range_id")\n            != f"literal-{right_index:02d}-{right_start:06x}"\n            or right_owner.get("artifact_range_kind") != "literal"\n            or right_owner.get("mode") is not None\n            or right_owner.get("bytes_sha256")\n            != _sha256(rom[right_start:right_end])\n            or any(\n                right_owner.get(key) != value\n                for key, value in common_owner_contract.items()\n            )\n        ):\n            raise ValueError(f"boot code/literal gap right owner changed: {index}")\n\n        size = end - start\n        claims.append(\n            {\n                "id": row["id"],\n                "range": [start, end],\n                "gba_range": [GBA_ROM_BASE + start, GBA_ROM_BASE + end],\n                "role": "primary",\n                "primary_class": BOOT_THUMB_CODE_LITERAL_GAP_PRIMARY_CLASS,\n                "claim_kind": BOOT_THUMB_CODE_LITERAL_GAP_CLAIM_KIND,\n                "promotion_batch": BOOT_THUMB_CODE_LITERAL_GAP_BATCH,\n                "promoted_from_primary_class": "unknown",\n                "baseline_unknown_only": True,\n                "bytes_sha256": row["sha256"],\n                "packed_range": [packed_cursor, packed_cursor + size],\n                "packed_bytes_sha256": (\n                    BOOT_THUMB_CODE_LITERAL_GAP_PACKED_BYTES_SHA256\n                ),\n                "range_vector_sha256": (\n                    BOOT_THUMB_CODE_LITERAL_GAP_RANGE_VECTOR_SHA256\n                ),\n                "boundary_vector_sha256": (\n                    BOOT_THUMB_CODE_LITERAL_GAP_BOUNDARY_VECTOR_SHA256\n                ),\n                "claim_denominator_sha256": (\n                    BOOT_THUMB_CODE_LITERAL_GAP_CLAIM_DENOMINATOR_SHA256\n                ),\n                "alignment_unit_bytes": 4,\n                "alignment_target": end,\n                "alignment_formula_expression": "(left_end + 3) & ~3",\n                "alignment_gap_bytes": size,\n                "alignment_gap_is_exact": True,\n                "terminal": row["terminal"],\n                "previous_owner_id": left_owner["id"],\n                "previous_owner_range": [left_start, left_end],\n                "previous_owner_primary_class": left_owner["primary_class"],\n                "previous_owner_claim_kind": left_owner["claim_kind"],\n                "next_owner_id": right_owner["id"],\n                "next_owner_range": [right_start, right_end],\n                "next_owner_primary_class": right_owner["primary_class"],\n                "next_owner_claim_kind": right_owner["claim_kind"],\n                "source_artifact_left_claim_id": left["source_artifact_claim_id"],\n                "source_artifact_right_claim_id": right[\n                    "source_artifact_claim_id"\n                ],\n                "evidence_path": BOOT_THUMB_CODE_LITERAL_GAP_VERIFIER.as_posix(),\n                "evidence_sha256": BOOT_THUMB_CODE_LITERAL_GAP_VERIFIER_SHA256,\n                "evidence_selector": f"/gaps/{index}",\n                "independent_verifier_path": (\n                    BOOT_THUMB_CODE_LITERAL_GAP_VERIFIER.as_posix()\n                ),\n                "independent_verifier_sha256": (\n                    BOOT_THUMB_CODE_LITERAL_GAP_VERIFIER_SHA256\n                ),\n                "independent_verifier_report_sha256": (\n                    BOOT_THUMB_CODE_LITERAL_GAP_REPORT_SHA256\n                ),\n                "upstream_test_path": BOOT_THUMB_CODE_LITERAL_GAP_TEST.as_posix(),\n                "upstream_test_sha256": BOOT_THUMB_CODE_LITERAL_GAP_TEST_SHA256,\n                "source_manifest_path": (\n                    BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_MANIFEST.as_posix()\n                ),\n                "source_manifest_sha256": (\n                    BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_MANIFEST_SHA256\n                ),\n                "source_payload_path": (\n                    BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_PAYLOAD.as_posix()\n                ),\n                "source_payload_sha256": (\n                    BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_PAYLOAD_SHA256\n                ),\n                "source_verifier_path": (\n                    BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_VERIFIER.as_posix()\n                ),\n                "source_verifier_sha256": (\n                    BOOT_THUMB_CODE_LITERAL_GAP_SOURCE_VERIFIER_SHA256\n                ),\n                "source_artifact_historical_envelope_gaps_classified": False,\n                "source_wide_envelope_is_claim": False,\n                "new_packet_additive": True,\n                "non_claims": list(BOOT_THUMB_CODE_LITERAL_GAP_NON_CLAIMS),\n                **non_claim_flags,\n                "limitations": [BOOT_THUMB_CODE_LITERAL_GAP_COVERAGE_LIMITATION],\n            }\n        )\n        packed_cursor += size\n\n    denominator = _sha256(\n        json.dumps(\n            [\n                {\n                    key: claim[key]\n                    for key in (\n                        "id",\n                        "range",\n                        "primary_class",\n                        "claim_kind",\n                        "bytes_sha256",\n                        "previous_owner_id",\n                        "next_owner_id",\n                        "evidence_selector",\n                    )\n                }\n                for claim in claims\n            ],\n            ensure_ascii=True,\n            separators=(",", ":"),\n            sort_keys=True,\n        ).encode("ascii")\n    )\n    if (\n        len(claims) != BOOT_THUMB_CODE_LITERAL_GAP_COUNT\n        or packed_cursor != BOOT_THUMB_CODE_LITERAL_GAP_BYTES\n        or denominator != BOOT_THUMB_CODE_LITERAL_GAP_CLAIM_DENOMINATOR_SHA256\n    ):\n        raise ValueError(\n            "boot code/literal gap coverage denominator changed: "\n            f"claims={len(claims)}, bytes={packed_cursor}, sha256={denominator}"\n        )\n    return claims\n\n\ndef _scene_visual_source_range_claims(\n    root: Path,\n    rom: bytes,\n    baseline_claims: list[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote the frozen current-unknown scene-visual source ranges."""\n\n    root = Path(root).resolve(strict=True)\n    if _sha256(rom) != ROM_SHA256:\n        raise ValueError("scene visual source ROM SHA-256 changed")\n    if any(\n        claim.get("promotion_batch") == SCENE_VISUAL_SOURCE_BATCH\n        for claim in baseline_claims\n    ):\n        raise ValueError("scene visual source batch is already present")\n\n    artifact = (root / SCENE_VISUAL_SOURCE_ARTIFACT).absolute()\n    manifest_path = artifact / "manifest.json"\n    payload_path = artifact / SCENE_VISUAL_SOURCE_PAYLOAD_NAME\n    bundle_path = artifact / SCENE_VISUAL_SOURCE_BUNDLE_NAME\n    verifier_path = (root / SCENE_VISUAL_SOURCE_VERIFIER).absolute()\n\n    def checked_path(path: Path, label: str, *, directory: bool = False) -> Path:\n        try:\n            resolved = path.resolve(strict=True)\n            resolved.relative_to(root)\n        except (OSError, ValueError) as error:\n            raise ValueError(f"scene visual source {label} path is unsafe") from error\n        if path.is_symlink() or resolved != path:\n            raise ValueError(f"scene visual source {label} path is unsafe")\n        if directory:\n            if not path.is_dir():\n                raise ValueError(f"scene visual source {label} is not a directory")\n        elif not path.is_file():\n            raise ValueError(f"scene visual source {label} is not a file")\n        return resolved\n\n    checked_path(artifact, "artifact", directory=True)\n    expected_names = {\n        "manifest.json",\n        SCENE_VISUAL_SOURCE_PAYLOAD_NAME,\n        SCENE_VISUAL_SOURCE_BUNDLE_NAME,\n    }\n    members = list(artifact.iterdir())\n    if (\n        {member.name for member in members} != expected_names\n        or any(member.is_symlink() or not member.is_file() for member in members)\n    ):\n        raise ValueError("scene visual source artifact file denominator changed")\n    for path, label in (\n        (manifest_path, "manifest"),\n        (payload_path, "payload"),\n        (bundle_path, "bundle"),\n        (verifier_path, "verifier"),\n    ):\n        checked_path(path, label)\n    if _sha256_file(manifest_path) != SCENE_VISUAL_SOURCE_MANIFEST_SHA256:\n        raise ValueError("scene visual source manifest hash changed")\n    if (\n        payload_path.stat().st_size != SCENE_VISUAL_SOURCE_PAYLOAD_SIZE\n        or _sha256_file(payload_path) != SCENE_VISUAL_SOURCE_PAYLOAD_SHA256\n    ):\n        raise ValueError("scene visual source payload identity changed")\n    if (\n        bundle_path.stat().st_size != 3_257\n        or _sha256_file(bundle_path) != SCENE_VISUAL_SOURCE_BUNDLE_SHA256\n    ):\n        raise ValueError("scene visual source bundle identity changed")\n    if _sha256_file(verifier_path) != SCENE_VISUAL_SOURCE_VERIFIER_SHA256:\n        raise ValueError("scene visual source verifier identity changed")\n\n    try:\n        manifest = json.loads(manifest_path.read_bytes())\n        payload = json.loads(payload_path.read_bytes())\n    except (OSError, json.JSONDecodeError) as error:\n        raise ValueError("scene visual source JSON is invalid") from error\n\n    expected_rom = {\n        "path": ROM_PATH.as_posix(),\n        "size": len(rom),\n        "sha256": ROM_SHA256,\n    }\n    expected_coverage_baseline = {\n        "path": "sequel/rom-byte-coverage.json",\n        "schema": SCHEMA,\n        "sha256": "b95e1239420e416fe03244d8e3584adc5dd93470dfa8bfe8e501addb78c3f2cd",\n        "rom": expected_rom,\n        "summary": {\n            "classified_bytes": 6_102_121,\n            "unknown_bytes": 189_335,\n            "claim_count": 13_872,\n            "segment_count": 16_119,\n        },\n    }\n    expected_source_identity = {\n        "artifact_path": "artifacts/scene-visual-packs-v1",\n        "artifact_schema": "scene-visual-packs-v1",\n        "manifest_path": "artifacts/scene-visual-packs-v1/manifest.json",\n        "manifest_sha256": (\n            "4bb40dff9ac2e5641b5e13f46b1dc90bdaa28b9b5615deab7e2a914ae002d5f4"\n        ),\n      