, not an explicit terminator record; padding, reserved/free space, reachability, editing, relocation, allocation, adjacent bytes, additional fields, and consumer completeness remain unclaimed.",\n            ],\n        }\n    ]\n\n\ndef _motion_spawn_sequence_alignment_gap_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote only the exact two-byte motion/sequence alignment gap.\n\n    The claim stays fail-closed over the exact candidate bytes, both adjacent\n    owner identities, their frozen evidence, and both independent verifiers.\n    """\n\n    root = Path(root).resolve(strict=True)\n    baseline_claims = list(existing_claims)\n\n    if any(\n        claim.get("promotion_batch") == MOTION_SPAWN_SEQUENCE_GAP_BATCH\n        or claim.get("claim_kind") == MOTION_SPAWN_SEQUENCE_GAP_CLAIM_KIND\n        for claim in baseline_claims\n    ):\n        raise ValueError(\n            "motion spawn sequence alignment gap batch is already present"\n        )\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError(\n            "motion spawn sequence alignment gap ROM identity changed"\n        )\n\n    expected_constant_values = (\n        (\n            MOTION_SPAWN_SEQUENCE_GAP_BATCH,\n            "rom-motion-spawn-sequence-descriptor-alignment-gap-coverage-v1",\n            "batch",\n        ),\n        (\n            MOTION_SPAWN_SEQUENCE_GAP_PRIMARY_CLASS,\n            "motion_spawn_to_sequence_descriptor_4byte_alignment_gap",\n            "primary class",\n        ),\n        (\n            MOTION_SPAWN_SEQUENCE_GAP_CLAIM_KIND,\n            "motion_spawn_sequence_descriptor_alignment_gap_bytes",\n            "claim kind",\n        ),\n        (MOTION_SPAWN_SEQUENCE_GAP_RANGE, (0x53EF2E, 0x53EF30), "candidate range"),\n        (\n            MOTION_SPAWN_SEQUENCE_GAP_GBA_RANGE,\n            (0x0853EF2E, 0x0853EF30),\n            "candidate GBA range",\n     