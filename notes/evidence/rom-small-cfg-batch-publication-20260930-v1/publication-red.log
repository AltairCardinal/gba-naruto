complete three-list configuration is classified; fixed-slot suffixes and unreferenced slots remain unknown."\n                    ],\n                }\n            )\n        elif kind == "selector_configuration_lists":\n            if (\n                record_id != "config-lists"\n                or value != config.get("range")\n                or item.get("sha256") != config.get("sha256")\n            ):\n                raise ValueError("selector-text configuration-list item changed")\n            claims.append(\n                {\n                    "id": "selector-configuration-lists-5a6344",\n                    **common,\n                    "primary_class": "selector_configuration_lists",\n                    "claim_kind": "selector_configuration_list_bytes",\n                    "list_count": 3,\n                    "record_count": 38,\n                    "terminator_count": 3,\n                    "limitations": [\n                        "The selector output domain 0..2 closes these three 0xFF-terminated configuration lists; natural execution of every row remains unclaimed."\n                    ],\n                }\n            )\n        else:\n            pointer_table = config["pointer_table"]\n            if (\n                record_id != "config-pointers"\n                or value != pointer_table.get("range")\n                or item.get("sha256") != pointer_table.get("sha256")\n            ):\n                raise ValueError("selector-text configuration-pointer item changed")\n            claims.append(\n                {\n                    "id": "selector-configuration-pointers-5a63e8",\n                    **common,\n                    "primary_class": "selector_configuration_pointer_table",\n                    "claim_kind": "selector_configuration_pointer_bytes",\n                    "entry_count": 3,\n                    "entry_size": 4,\n                    "limitations": [\n                        "The fixed three-entry pointer table is closed for the proven selector domain; editing safety remains unclaimed."\n                    ],\n                }\n            )\n\n    record_ranges = [\n        record["consumed_range"] for record in direct["records"]\n    ]\n    configured_ranges = [\n        record["consumed_range"] for record in configured["referenced_records"]\n    ]\n    for record in direct["records"] + configured["referenced_records"]:\n        suffix = record.get("unclassified_suffix_range")\n        if (\n            not isinstance(suffix, list)\n            or len(suffix) != 2\n            or suffix[0] != record["consumed_range"][1]\n            or suffix[1] != record["physical_range"][1]\n            or record.get("unclassified_suffix_size") != suffix[1] - suffix[0]\n            or any(rom[suffix[0] : suffix[1]])\n            or any(\n                start < suffix[1] and suffix[0] < end\n                for start, end in classified_ranges\n            )\n        ):\n            raise ValueError("selector-text unclassified suffix boundary changed")\n    if (\n        kind_counts\n        != {\n            "direct_renderer_text_prefix": 46,\n            "configured_copy_text_prefix": 38,\n            "selector_configuration_lists": 1,\n            "selector_configuration_pointer_table": 1,\n        }\n        or packed_cursor != len(bundle)\n        or len(bundle) != 816\n        or _sha256(\n            json.dumps(record_ranges, separators=(",", ":")).encode("ascii")\n        )\n        != SELECTOR_TEXT_DIRECT_RANGE_DENOMINATOR_SHA256\n        or _sha256(\n            json.dumps(configured_ranges, separators=(",", ":")).encode("ascii")\n        )\n        != SELECTOR_TEXT_CONFIGURED_RANGE_DENOMINATOR_SHA256\n        or _sha256(\n            json.dumps(classified_ranges, separators=(",", ":")).encode("ascii")\n        )\n        != SELECTOR_TEXT_CLASSIFIED_DENOMINATOR_SHA256\n    ):\n        raise ValueError("selector-text final denominator changed")\n    return claims\n\n\ndef _battle_message_text_claims(\n    root: Path, rom: bytes\n) -> list[dict[str, Any]]:\n    """Classify the fixed 79-slot message records and verified zero padding."""\n\n    if _sha256(rom) != ROM_SHA256:\n        raise ValueError("battle-message-text ROM SHA-256 changed")\n    artifact = (root / BATTLE_MESSAGE_TEXT_ARTIFACT).absolute()\n    manifest_path = artifact / "manifest.json"\n    payload_path = (root / BATTLE_MESSAGE_TEXT_PAYLOAD).absolute()\n    bundle_path = (root / BATTLE_MESSAGE_TEXT_BUNDLE).absolute()\n    exporter_path = (root / BATTLE_MESSAGE_TEXT_EXPORTER).absolute()\n    verifier_path = (root / BATTLE_MESSAGE_TEXT_VERIFIER).absolute()\n    test_path = (root / BATTLE_MESSAGE_TEXT_TEST).absolute()\n    for path, label in (\n        (artifact, "artifact"),\n        (manifest_path, "manifest"),\n        (payload_path, "payload"),\n        (bundle_path, "bundle"),\n        (exporter_path, "exporter"),\n        (verifier_path, "verifier"),\n        (test_path, "test"),\n    ):\n        try:\n            resolved = path.resolve(strict=True)\n            resolved.relative_to(root)\n        except (OSError, ValueError) as error:\n            raise ValueError(f"battle-message-text {label} is invalid") from error\n        if resolved != path or path.is_symlink():\n            raise ValueError(f"battle-message-text {label} uses a symlink")\n    if not artifact.is_dir() or any(path.is_symlink() for path in artifact.rglob("*")):\n        raise ValueError("battle-message-text artifact tree is unsafe")\n    if {\n        path.relative_to(artifact).as_posix()\n        for path in artifact.rglob("*")\n        if path.is_file()\n    } != {"manifest.json", payload_path.name, bundle_path.name}:\n        raise ValueError("battle-message-text artifact file denominator changed")\n    for path, digest, label in (\n        (manifest_path, BATTLE_MESSAGE_TEXT_MANIFEST_SHA256, "manifest"),\n        (payload_path, BATTLE_MESSAGE_TEXT_PAYLOAD_SHA256, "payload"),\n        (bundle_path, BATTLE_MESSAGE_TEXT_BUNDLE_SHA256, "bundle"),\n        (exporter_path, BATTLE_MESSAGE_TEXT_EXPORTER_SHA256, "exporter"),\n        (verifier_path, BATTLE_MESSAGE_TEXT_VERIFIER_SHA256, "verifier"),\n        (test_path, BATTLE_MESSAGE_TEXT_TEST_SHA256, "test"),\n    ):\n        if _sha256_file(path) != digest:\n            raise ValueError(f"battle-message-text {label} changed")\n\n    manifest = json.loads(manifest_path.read_bytes())\n    payload = json.loads(payload_path.read_bytes())\n    bundle = bundle_path.read_bytes()\n    implementation = {\n        "exporter": {\n            "path": BATTLE_MESSAGE_TEXT_EXPORTER.as_posix(),\n            "sha256": BATTLE_MESSAGE_TEXT_EXPORTER_SHA256,\n        },\n        "verifier": {\n            "path": BATTLE_MESSAGE_TEXT_VERIFIER.as_posix(),\n            "sha256": BATTLE_MESSAGE_TEXT_VERIFIER_SHA256,\n        },\n        "test": {\n            "path": BATTLE_MESSAGE_TEXT_TEST.as_posix(),\n            "sha256": BATTLE_MESSAGE_TEXT_TEST_SHA256,\n        },\n    }\n    expected_verification = {\n        "schema": "rom-battle-message-text-inventory-verification-v1",\n        "command": [\n            "python3",\n            BATTLE_MESSAGE_TEXT_VERIFIER.as_posix(),\n            "--root",\n            ".",\n            "--artifact-dir",\n            BATTLE_MESSAGE_TEXT_ARTIFACT.as_posix(),\n        ],\n        "verifier_sha256": BATTLE_MESSAGE_TEXT_VERIFIER_SHA256,\n    }\n    if (\n        manifest.get("schema")\n        != "rom-battle-message-text-inventory-v1-artifact-manifest-v1"\n        or manifest.get("artifact_schema")\n        != "rom-battle-message-text-inventory-v1"\n        or manifest.get("files")\n        != {\n            payload_path.name: BATTLE_MESSAGE_TEXT_PAYLOAD_SHA256,\n            bundle_path.name: BATTLE_MESSAGE_TEXT_BUNDLE_SHA256,\n        }\n        or manifest.get("producer") != implementation\n        or manifest.get("scope") != BATTLE_MESSAGE_TEXT_SCOPE\n        or manifest.get("verification") != expected_verification\n    ):\n        raise ValueError("battle-message-text manifest contract changed")\n    if (\n        payload.get("schema") != "rom-battle-message-text-inventory-v1"\n        or payload.get("rom")\n        != {"path": ROM_PATH.as_posix(), "size": len(rom), "sha256": ROM_SHA256}\n        or payload.get("summary") != BATTLE_MESSAGE_TEXT_EXPECTED_SUMMARY\n        or payload.get("scope") != BATTLE_MESSAGE_TEXT_SCOPE\n        or payload.get("implementation") != implementation\n        or payload.get("record_range_denominator_sha256")\n        != BATTLE_MESSAGE_TEXT_RECORD_DENOMINATOR_SHA256\n        or payload.get("zero_padding_range_denominator_sha256")\n        != BATTLE_MESSAGE_TEXT_PADDING_DENOMINATOR_SHA256\n        or payload.get("classified_range_denominator_sha256")\n        != BATTLE_MESSAGE_TEXT_CLASSIFIED_DENOMINATOR_SHA256\n        or payload.get("files")\n        != {\n            bundle_path.name: {\n                "size": 2_740,\n                "sha256": BATTLE_MESSAGE_TEXT_BUNDLE_SHA256,\n            }\n        }\n    ):\n        raise ValueError("battle-message-text payload denominator changed")\n\n    report = verify_rom_battle_message_text_inventory(root, artifact)\n    expected_report = {\n        "schema": "rom-battle-message-text-inventory-verification-v1",\n        "verified": True,\n        "errors": [],\n        **BATTLE_MESSAGE_TEXT_EXPECTED_SUMMARY,\n        "summary": BATTLE_MESSAGE_TEXT_EXPECTED_SUMMARY,\n        "artifact_schema": "rom-battle-message-text-inventory-v1",\n        "bundle_sha256": BATTLE_MESSAGE_TEXT_BUNDLE_SHA256,\n        "record_range_denominator_sha256": (\n            BATTLE_MESSAGE_TEXT_RECORD_DENOMINATOR_SHA256\n        ),\n        "zero_padding_range_denominator_sha256": (\n            BATTLE_MESSAGE_TEXT_PADDING_DENOMINATOR_SHA256\n        ),\n        "classified_range_denominator_sha256": (\n            BATTLE_MESSAGE_TEXT_CLASSIFIED_DENOMINATOR_SHA256\n        ),\n    }\n    if report != e