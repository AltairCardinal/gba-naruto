_ROW_INDICES\n    ]\n    empty_row_values: list[tuple[int, int, int, int]] = []\n    for index in range(31):\n        row_start = table_start + index * 8\n        row = rom[row_start : row_start + 8]\n        row_value = (\n            int.from_bytes(row[0:2], "little"),\n            row[2],\n            row[3],\n            int.from_bytes(row[4:8], "little"),\n        )\n        if index < 26 and row_value[1] <= 0:\n            raise ValueError("SJIS empty lookup rows preceding range is empty")\n        if index >= 26:\n            empty_row_values.append(row_value)\n            if (\n                row_value != (0, 0, 0, 0)\n                or _sha256(row) != SJIS_EMPTY_LOOKUP_ROWS_EMPTY_ROW_SHA256\n            ):\n                raise ValueError("SJIS empty lookup rows empty row identity changed")\n    if empty_row_values != [(0, 0, 0, 0)] * 5:\n        raise ValueError("SJIS empty lookup rows row denominator changed")\n\n    candidate_raw = rom[start:end]\n    range_denominator_sha256 = _sha256(\n        json.dumps([[start, end]], separators=(",", ":")).encode("ascii")\n    )\n    packed_bytes_sha256 = _sha256(candidate_raw)\n    if (\n        len(candidate_raw) != 40\n        or any(candidate_raw)\n        or _sha256(candidate_raw) != SJIS_EMPTY_LOOKUP_ROWS_BYTES_SHA256\n        or range_denominator_sha256\n        != SJIS_EMPTY_LOOKUP_ROWS_RANGE_DENOMINATOR_SHA256\n        or packed_bytes_sha256 != SJIS_EMPTY_LOOKUP_ROWS_BYTES_SHA256\n    ):\n        raise ValueError("SJIS empty lookup rows candidate bytes changed")\n\n    return [\n        {\n            "id": "dialogue-font-sjis-empty-lookup-rows-53d714",\n            "range": [start, end],\n            "role": "primary",\n            "primary_class": SJIS_EMPTY_LOOKUP_ROWS_PRIMARY_CLASS,\n            "claim_kind": SJIS_EMPTY_LOOKUP_ROWS_CLAIM_KIND,\n            "promotion_batch": SJIS_EMPTY_LOOKUP_ROWS_BATCH,\n            "promoted_from_primary_class": "unknown",\n            "baseline_unknown_only": True