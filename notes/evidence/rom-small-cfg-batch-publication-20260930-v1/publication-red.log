t("coverage_claims") != expected_coverage_claims\n        or manifest.get("gap_exclusion") != expected_gap\n        or payload.get("gap_exclusion") != expected_gap\n        or payload.get("unclassified_unknown_ranges")\n        != [list(M4A_INITIALIZER_GAP_RANGE)]\n        or manifest.get("scope") != M4A_INITIALIZER_SCOPE\n        or payload.get("scope") != M4A_INITIALIZER_SCOPE\n        or manifest.get("limitations") != limitations\n        or payload.get("limitations") != limitations\n        or payload.get("schema") != M4A_INITIALIZER_BATCH\n        or manifest.get("acceptance", {}).get("candidate_identity")\n        != expected_candidate_identity\n    ):\n        raise ValueError("M4A initializer promotion contract changed")\n\n    producer = payload.get("producer_denominator")\n    expected_root_producers = {\n        "0x09AA3C": [0x061E28],\n        "0x09ACF8": [0x09AA56],\n        "0x09B17C": [0x09AA76],\n    }\n    if (\n        not isinstance(producer, dict)\n        or producer.get("scan")\n        != {"mode": "raw-rom", "alignment_bytes": 2, "range": [0, len(rom)]}\n        or producer.get("thumb_bl") != [0x061E28, 0x09AA56, 0x09AA76]\n        or producer.get("all_non_thumb_bl_forms_empty") is not True\n        or producer.get("target_limited_raw_producer_denominator_complete")\n        is not True\n        or producer.get("computed_or_indirect_producer_denominator_complete")\n        is not False\n        or producer.get("producer_source_instruction_membership_proven")\n        is not False\n        or producer.get("producer_bytes_promoted") is not False\n        or {\n            root_id: forms.get("thumb_bl")\n            for root_id, forms in producer.get("root_forms", {}).items()\n        }\n        != expected_root_producers\n        or any(\n            values\n            for forms in producer.get("root_forms", {}).values()\n            for name, values in forms.items()\n            if name != "thumb_bl"\n        )\n    ):\n        raise ValueError("M4A initializer producer denominator changed")\n\n    primary = [claim for claim in baseline if claim.get("role") == "primary"]\n    for row in expected_rows:\n        start, end = _validated_range(row, len(rom))\n        if row["sha256"] != _sha256(rom[start:end]):\n            raise ValueError("M4A initializer promotion ROM bytes changed")\n        if any(\n            other_start < end and start < other_end\n            for other in primary\n            for other_start, other_end in [_validated_range(other, len(rom))]\n        ):\n            raise ValueError(\n                f"M4A initializer unknown projection overlap: {row[\'id\']}"\n            )\n    for start, end in ((0x061E28, 0x061E2C), M4A_INITIALIZER_GAP_RANGE):\n        if any(\n            other_start < end and start < other_end\n            for other in primary\n            for other_start, other_end in [_validated_range(other, len(rom))]\n        ):\n            raise ValueError("M4A initializer excluded bytes are no longer unknown")\n    if (\n        _sha256(rom[slice(*M4A_INITIALIZER_GAP_RANGE)])\n        != M4A_INITIALIZER_GAP_SHA256\n    ):\n        raise ValueError("M4A initializer return-to-pool gap changed")\n\n    packed = b"".join(\n        rom[start:end] for start, end in (row["range"] for row in expected_rows)\n    )\n    compact_union = (\n        json.dumps(\n            union_ranges,\n            ensure_ascii=False,\n            sort_keys=True,\n            separators=(",", ":"),\n        )\n        + "\\n"\n    ).encode("utf-8")\n    if (\n        binary_path.read_bytes() != packed\n        or len(packed) != M4A_INITIALIZER_BINARY_SIZE\n        or _sha256(packed) != M4A_INITIALIZER_BINARY_SHA256\n        or _sha256(compact_union) != M4A_INITIALIZER_RANGE_VECTOR_SHA256\n    ):\n        raise ValueError("M4A initializer packed denominator changed")\n    if (\n        sum(row["size"] for row in expected_rows if row["mode"] == "thumb")\n        != 390\n        or sum(row["size"] for row in expected_rows if row["mode"] is None)\n        != 128\n        or len(expected_rows) != 6\n    ):\n        raise ValueError("M4A initializer coverage denominator changed")\n\n    claims: list[dict[str, Any]] = []\n    for index, row in enumerate(expected_coverage_claims):\n        start, end = row["range"]\n        claims.append(\n            {\n                "id": row["id"],\n                "range": [start, end],\n                "gba_range": [0x08000000 + start, 0x08000000 + end],\n                "role": "primary",\n                "primary_class": row["semantic_class"],\n                "claim_kind": row["claim_kind"],\n                "mode": row["mode"],\n                "promotion_batch": M4A_INITIALIZER_BATCH,\n                "promoted_from_primary_class": "unknown",\n                "baseline_unknown_only": True,\n                "bytes_sha256": row["sha256"],\n                "artifact_range_id": row["id"],\n                "artifact_range_kind": row["kind"],\n                "promotion_union_range_count": 4,\n                "promotion_union_bytes": 518,\n                "promotion_union_range_vector_sha256": (\n                    M4A_INITIALIZER_RANGE_VECTOR_SHA256\n                ),\n                "evidence_path": (\n                    M4A_INITIALIZER_ARTIFACT / M4A_INITIALIZER_PAYLOAD_NAME\n                ).as_posix(),\n                "evidence_sha256": M4A_INITIALIZER_PAYLOAD_SHA256,\n                "evidence_selector": f"/coverage_claims/{index}",\n                "promotion_manifest_path": (\n                    M4A_INITIALIZER_ARTIFACT / "manifest.json"\n                ).as_posix(),\n                "promotion_manifest_sha256": M4A_INITIALIZER_MANIFEST_SHA256,\n                "candidate_snapshot_manifest_path": (\n                    M4A_INITIALIZER_ARTIFACT / "candidate" / "manifest.json"\n                ).as_posix(),\n                "candidate_snapshot_manifest_sha256": (\n                    M4A_INITIALIZER_CANDIDATE_MANIFEST_SHA256\n                ),\n                "independent_verifier_path": (\n                    M4A_INITIALIZER_VERIFIER.as_posix()\n                ),\n                "independent_verifier_sha256": (\n                    M4A_INITIALIZER_VERIFIER_SHA256\n                ),\n                "non_claims": dict(M4A_INITIALIZER_SCOPE),\n                "limitations": limitations,\n            }\n        )\n    return claims\n\n\ndef _mp2k_note_allocator_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote only the four accepted MP2K allocator evidence ranges."""\n\n    root = Path(root).resolve(strict=True)\n    baseline = list(existing_claims)\n    identifiers = {spec[0] for spec in MP2K_NOTE_ALLOCATOR_RANGE_SPECS}\n    claim_kinds = {spec[6] for spec in MP2K_NOTE_ALLOCATOR_RANGE_SPECS}\n    if any(\n        claim.get("promotion_batch") == MP2K_NOTE_ALLOCATOR_BATCH\n        or claim.get("claim_kind") in claim_kinds\n        or claim.get("id") in identifiers\n        for claim in baseline\n    ):\n        raise ValueError(\n            "MP2K note-allocator claims require a pre-promotion baseline; "\n            "batch is already present"\n        )\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError("MP2K note-allocator ROM identity changed")\n\n    try:\n        report = verify_rom_mp2k_note_allocator(\n            root, MP2K_NOTE_ALLOCATOR_ARTIFACT\n        )\n    except Exception as error:\n        raise ValueError(\n            f"MP2K note-allocator independent verification failed: {error}"\n        ) from error\n    if (\n        not isinstance(report, dict)\n        or report.get("schema")\n        != "rom-mp2k-note-allocator-verification-v1"\n        or report.get("verified") is not True\n        or report.get("contract_ok") is not True\n        or report.get("artifact_status") != "accepted"\n        or report.get("summary") != MP2K_NOTE_ALLOC