payload.get("summary") != DIALOGUE_TEXT_EXPECTED_SUMMARY:\n        raise ValueError("dialogue text summary denominator changed")\n    table = payload.get("table")\n    if not isinstance(table, dict) or table.get("file_range") != [\n        0x461CE4,\n        0x4634B8,\n    ]:\n        raise ValueError("dialogue pointer table range changed")\n    table_start, table_end = table["file_range"]\n    table_sha256 = _sha256(rom[table_start:table_end])\n    if (\n        table.get("row_count") != 305\n        or table.get("row_size") != 20\n        or table.get("sha256") != table_sha256\n    ):\n        raise ValueError("dialogue pointer table binding changed")\n\n    claims = [\n        {\n            "id": "dialogue-main-pointer-table",\n            "range": [table_start, table_end],\n            "role": "primary",\n            "primary_class": "dialogue_pointer_table",\n            "claim_kind": "dialogue_main_pointer_table",\n            "record_count": 305,\n            "record_size": 20,\n            "direct_pointer_slot_count": 1_220,\n            "bytes_sha256": table_sha256,\n            "evidence_path": (DIALOGUE_TEXT_ARTIFACT / "manifest.json").as_posix(),\n            "evidence_sha256": evidence_sha256,\n        }\n    ]\n    rows = payload.get("rows")\n    if not isinstance(rows, list) or len(rows) != 305:\n        raise ValueError("dialogue text row denominator changed")\n    target_count = 0\n    previous_end = -1\n    for row_id, row in enumerate(rows):\n        if not isinstance(row, dict) or row.get("row_id") != row_id:\n            raise ValueError("dialogue text row IDs changed")\n        targets = row.get("targets")\n        if not isinstance(targets, list) or len(targets) != 4:\n            raise ValueError("dialogue text row target count changed")\n        for slot_index, target in enumerate(targets):\n            if not isinstance(target, dict) or target.get("target_id") != target_count:\n                raise ValueError("dialogue text target IDs cha