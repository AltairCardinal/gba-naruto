se\n        claim["signedness_at_destination_claimed"] = False\n        claim["adjacent_zero_gap_claimed"] = False\n    return claims\n\n\ndef _v17_v18_helper_cfg_claims(root, rom, existing_claims):\n    """Project the producer-bound V17/V18 helper zero-frontier CFG."""\n\n    from tools.verify_rom_v17_v18_helper_cfg import verify_artifact\n\n    classes = {\n        "reachable_thumb_code": (\n            "armv4t_v17_v18_helper_reachable_thumb_code",\n            "v17_v18_helper_reachable_instruction_bytes",\n            "thumb",\n        ),\n        "consumed_literal_words": (\n            "armv4t_v17_v18_helper_consumed_literal_word",\n            "v17_v18_helper_consumed_literal_word_bytes",\n            None,\n        ),\n    }\n\n    def semantic(row, index):\n        try:\n            return classes[row.get("claim_kind")][index]\n        except KeyError as error:\n            raise ValueError("V17/V18 helper semantic kind changed") from error\n\n    spec = {\n        "label": "V17/V18 helper CFG",\n        "artifact": V17_V18_HELPER_CFG_ARTIFACT,\n        "payload": V17_V18_HELPER_CFG_PAYLOAD,\n        "manifest_size": V17_V18_HELPER_CFG_MANIFEST_SIZE,\n        "manifest_sha": V17_V18_HELPER_CFG_MANIFEST_SHA256,\n        "payload_size": V17_V18_HELPER_CFG_PAYLOAD_SIZE,\n        "payload_sha": V17_V18_HELPER_CFG_PAYLOAD_SHA256,\n        "verifier": V17_V18_HELPER_CFG_VERIFIER,\n        "verifier_sha": V17_V18_HELPER_CFG_VERIFIER_SHA256,\n        "promotion_bytes": 1_254,\n        "claim_count": 14,\n        "batch": "rom-v17-v18-helper-cfg-v1",\n        "hash_field": "bytes_sha256",\n        "class_for": lambda row: semantic(row, 0),\n        "kind_for": lambda row: semantic(row, 1),\n        "mode_for": lambda row: semantic(row, 2),\n    }\n    claims = _project_dependency_packet_claims(\n        root,\n        rom,\n        existing_claims,\n        spec=spec,\n        verify_root=lambda verifier_root, artifact: verify_artifact(\n            verifier_root, artifact\n        ),\n    )\n    for claim in claims:\n        claim["current_unknown_verified_by_auditor"] = True\n        claim["coverage_projection_gate"] = "current_unknown_before_projection"\n        claim["accepted_root_producer_count_verified"] = 33\n        claim["rejected_unbound_root_producer_count_verified"] = 1\n        claim["rejected_data_false_positive_count_verified"] = 1\n        claim["opaque_exit_ownership_verified"] = True\n        claim["structured_return_contract_verified"] = True\n        claim["natural_runtime_claimed"] = False\n    return claims\n\n\ndef _fixed_pair_table_claims(root, rom, existing_claims):\n    """Project the two frozen consumer-bound pair tables as Tier-1 claims."""\n\n    from tools.verify_rom_fixed_pair_tables import verify_artifact\n\n    classes = {\n        "fixed_signed_u16_sequence": "fixed_consumer_signed_u16_sequence",\n        "masked_u16_pair_table": "fixed_consumer_masked_u16_pair_table",\n    }\n\n    def primary_class(row):\n        try:\n            return classes[row.get("claim_kind")]\n        except KeyError as error:\n            raise ValueError("fixed pair-table semantic kind changed") from error\n\n    def claim_kind(row):\n        value = row.get("claim_kind")\n        if value not in classes:\n            raise ValueError("fixed pair-table semantic kind changed")\n        return value\n\n    spec = {\n        "label": "fixed pair tables",\n        "artifact": FIXED_PAIR_TABLES_ARTIFACT,\n        "payload": FIXED_PAIR_TABLES_PAYLOAD,\n        "manifest_size": FIXED_PAIR_TABLES_MANIFEST_SIZE,\n        "manifest_sha": FIXED_PAIR_TABLES_MANIFEST_SHA256,\n        "payload_size": FIXED_PAIR_TABLES_PAYLOAD_SIZE,\n        "payload_sha": FIXED_PAIR_TABLES_PAYLOAD_SHA256,\n        "verifier": FIXED_PAIR_TABLES_VERIFIER,\n        "verifier_sha": FIXED_PAIR_TABLES_VERIFIER_SHA256,\n        "promotion_bytes": 42,\n        "claim_count": 2,\n        "batch": "rom-fixed-pair-tables-v1",\n        "hash_field": "bytes