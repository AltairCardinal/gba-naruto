e independent verification failed: {error}"\n        ) from error\n    if report != MENU_PORTRAIT_PALETTE_EXPECTED_REPORT:\n        raise ValueError(\n            "menu portrait palette independent verification failed: " f"{report}"\n        )\n\n    baseline_segments = atomize_claims(len(rom), baseline_claims)\n    bundle = bundle_path.read_bytes()\n    claims: list[dict[str, Any]] = []\n    packed_cursor = 0\n    previous_end = -1\n    all_resource_ids: set[int] = set()\n    all_content_hashes: set[str] = set()\n    total_logical_aliases = 0\n    alias_groups: list[tuple[list[int], int, list[int]]] = []\n    for index, record in enumerate(records):\n        if not isinstance(record, dict):\n            raise ValueError("menu portrait palette record is not an object")\n        start, end = _validated_range(record, len(rom))\n        raw = rom[start:end]\n        packed = [packed_cursor, packed_cursor + len(raw)]\n        resource_ids = record.get("resource_ids")\n        logical_aliases = record.get("logical_aliases")\n        gba_range = [f"0x{GBA_ROM_BASE + start:08X}", f"0x{GBA_ROM_BASE + end:08X}"]\n        if (\n            record.get("physical_id") != index\n            or start < previous_end\n            or end - start != 128\n            or record.get("size") != 128\n            or record.get("gba_range") != gba_range\n            or record.get("packed_range") != packed\n            or record.get("raw_sha256") != _sha256(raw)\n            or record.get("palette_sha256") != _sha256(raw)\n            or not isinstance(resource_ids, list)\n            or not resource_ids\n            or resource_ids != sorted(set(resource_ids))\n            or record.get("resource_aliases") != resource_ids\n            or record.get("alias_count") != len(resource_ids)\n            or not isinstance(logical_aliases, list)\n            or record.get("logical_alias_count") != len(logical_aliases)\n            or bundle[packed[0] : packed[1]] != raw\n        ):\n            raise