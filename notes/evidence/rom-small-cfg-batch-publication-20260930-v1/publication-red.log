 "evidence_sha256": FIXED_CONSUMER_TEXT_PAYLOAD_SHA256,\n            "evidence_selectors": list(SJIS_EMPTY_LOOKUP_ROWS_EVIDENCE_SELECTORS),\n            "promotion_manifest_path": (\n                FIXED_CONSUMER_TEXT_ARTIFACT / "manifest.json"\n            ).as_posix(),\n            "promotion_manifest_sha256": FIXED_CONSUMER_TEXT_MANIFEST_SHA256,\n            "independent_verifier_path": FIXED_CONSUMER_TEXT_VERIFIER.as_posix(),\n            "independent_verifier_sha256": FIXED_CONSUMER_TEXT_VERIFIER_SHA256,\n            "sjis_lookup_range": list(SJIS_EMPTY_LOOKUP_ROWS_LOOKUP_RANGE),\n            "sjis_lookup_sha256": SJIS_EMPTY_LOOKUP_ROWS_LOOKUP_SHA256,\n            "renderer_parser_range": list(\n                SJIS_EMPTY_LOOKUP_ROWS_RENDERER_PARSER_RANGE\n            ),\n            "renderer_parser_sha256": SJIS_EMPTY_LOOKUP_ROWS_RENDERER_PARSER_SHA256,\n            "padding_claimed": False,\n            "reserved_space_claimed": False,\n            "reserved_author_intent_claimed": False,\n            "free_space_claimed": False,\n            "editable_claimed": False,\n            "relocatable_claimed": False,\n            "global_unreachable_claimed": False,\n            "natural_runtime_reachability_claimed": False,\n            "all_consumers_claimed": False,\n            "unicode_mapping_complete_claimed": False,\n            "safe_allocatable_space_claimed": False,\n            "editing_or_relocation_safety_claimed": False,\n            "limitations": [\n                "Only the five exact current-unknown empty rows at the tail of the frozen 31-row SJIS lookup table are classified.",\n                "This is not a padding, reserved-space, free-space, editable, relocatable, globally unreachable, natural-runtime, all-consumers, or complete Unicode mapping claim.",\n            ],\n        }\n    ]\n\n\ndef _training_text_script_claims(\n    root: Path, rom: bytes\n) -> list[dict[str, Any]]:\n    """Classify the 44 fixed-slot training scripts consumed by the interpreter."""\n\n    if _sha256(rom) != ROM_SHA256:\n        raise ValueError("training-text-script ROM SHA-256 changed")\n    artifact = (root / TRAINING_TEXT_SCRIPT_ARTIFACT).absolute()\n    manifest_path = artifact / "manifest.json"\n    payload_path = (root / TRAINING_TEXT_SCRIPT_PAYLOAD).absolute()\n    bundle_path = (root / TRAINING_TEXT_SCRIPT_BUNDLE).absolute()\n    verifier_path = (root / TRAINING_TEXT_SCRIPT_VERIFIER).absolute()\n    for path, label in (\n        (artifact, "artifact"),\n        (manifest_path, "manifest"),\n        (payload_path, "payload"),\n        (bundle_path, "bundle"),\n        (verifier_path, "verifier"),\n    ):\n        try:\n            resolved = path.resolve(strict=True)\n            resolved.relative_to(root)\n        except (OSError, ValueError) as error:\n            raise ValueError(f"training-text-script {label} is invalid") from error\n        if resolved != path or path.is_symlink():\n            raise ValueError(f"training-text-script {label} uses a symlink")\n    if not artifact.is_dir() or any(path.is_symlink() for path in artifact.rglob("*")):\n        raise ValueError("training-text-script artifact tree is unsafe")\n    if {\n        path.relative_to(artifact).as_posix()\n        for path in artifact.rglob("*")\n        if path.is_file()\n    } != {"manifest.json", payload_path.name, bundle_path.name}:\n        raise ValueError("training-text-script artifact file denominator changed")\n    for path, digest, label in (\n        (manifest_path, TRAINING_TEXT_SCRIPT_MANIFEST_SHA256, "manifest"),\n        (payload_path, TRAINING_TEXT_SCRIPT_PAYLOAD_SHA256, "payload"),\n        (bundle_path, TRAINING_TEXT_SCRIPT_BUNDLE_SHA256, "bundle"),\n        (verifier_path, TRAINING_TEXT_SCRIPT_VERIFIER_SHA256, "verifier"),\n    ):\n        if _sha256_file(path) != digest:\n            raise ValueError(f"training-text-script {label} changed")\n\n    manifest = json.loads(manifest_path.read_bytes())\n    payload = json.load