global code map are not claimed.",\n                    ],\n                }\n            )\n    if (\n        len(claims) != 20\n        or sum(claim["range"][1] - claim["range"][0] for claim in claims)\n        != 246\n    ):\n        raise ValueError("v8 promotion denominator changed")\n    return claims\n\n\ndef _cfg_proven_roots_v9_claims(\n    root: Path, rom: bytes, existing_claims: Iterable[dict[str, Any]]\n) -> list[dict[str, Any]]:\n    """Promote complete current-unknown blocks from the fixed controller BL roots."""\n    root = Path(root).resolve(strict=True)\n    baseline = list(existing_claims)\n    kind = "cfg_proven_roots_v9_reachable_instruction_bytes"\n    if any(claim.get("claim_kind") == kind for claim in baseline):\n        raise ValueError("v9 requires a pre-v9 baseline")\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError("v9 ROM identity changed")\n    artifact = (root / CFG_PROVEN_ROOTS_V9_ARTIFACT).absolute()\n    if artifact.resolve(strict=True) != artifact or not artifact.is_dir():\n        raise ValueError("v9 artifact invalid")\n    members = list(artifact.iterdir())\n    if (\n        {item.name for item in members}\n        != {"manifest.json", CFG_PROVEN_ROOTS_V9_PAYLOAD_NAME}\n        or any(item.is_symlink() or not item.is_file() for item in members)\n    ):\n        raise ValueError("v9 artifact file set changed")\n    verifier = (root / CFG_PROVEN_ROOTS_V9_VERIFIER).absolute()\n    if (\n        verifier.resolve(strict=True) != verifier\n        or _sha256_file(verifier) != CFG_PROVEN_ROOTS_V9_VERIFIER_SHA256\n    ):\n        raise ValueError("v9 verifier identity changed")\n    manifest_raw = (artifact / "manifest.json").read_bytes()\n    payload_raw = (artifact / CFG_PROVEN_ROOTS_V9_PAYLOAD_NAME).read_bytes()\n    if (\n        len(manifest_raw) != CFG_PROVEN_ROOTS_V9_MANIFEST_SIZE\n        or _sha256(manifest_raw) != CFG_PROVEN_ROOTS_V9_MANIFEST_SHA256\n        or len(payload_raw) != CFG_PROV