r manifest.get("schema") != "git-artifact-promotion-v1"\n        or manifest.get("artifact_schema") != SCENE_VISUAL_SOURCE_BATCH\n        or manifest.get("artifact_status") != "accepted"\n        or manifest.get("files") != expected_manifest_files\n        or manifest.get("rom") != expected_rom\n        or manifest.get("source_identity") != expected_source_identity\n        or manifest.get("coverage_baseline") != expected_coverage_baseline\n        or manifest.get("scope") != SCENE_VISUAL_SOURCE_SCOPE\n        or manifest.get("limitations") != SCENE_VISUAL_SOURCE_LIMITATIONS\n        or manifest.get("producer")\n        != {"command": expected_producer_command, **expected_implementation}\n        or manifest.get("verifier")\n        != {\n            "schema": "rom-scene-visual-source-ranges-verification-v1",\n            "command": expected_verifier_command,\n            "verifier_sha256": SCENE_VISUAL_SOURCE_VERIFIER_SHA256,\n            "exit_code": 0,\n            "report": SCENE_VISUAL_SOURCE_EXPECTED_REPORT,\n        }\n    ):\n        raise ValueError("scene visual source manifest contract changed")\n\n    expected_payload_files = {\n        SCENE_VISUAL_SOURCE_BUNDLE_NAME: {\n            "sha256": SCENE_VISUAL_SOURCE_BUNDLE_SHA256,\n            "size": 3_257,\n        }\n    }\n    if (\n        not isinstance(payload, dict)\n        or payload.get("schema") != SCENE_VISUAL_SOURCE_BATCH\n        or payload.get("rom") != expected_rom\n        or payload.get("coverage_baseline") != expected_coverage_baseline\n        or payload.get("source_identity") != expected_source_identity\n        or payload.get("implementation") != expected_implementation\n        or payload.get("scope") != SCENE_VISUAL_SOURCE_SCOPE\n        or payload.get("limitations") != SCENE_VISUAL_SOURCE_LIMITATIONS\n        or payload.get("files") != expected_payload_files\n        or payload.get("summary") != SCENE_VISUAL_SOURCE_EXPECTED_REPORT["summary"]\n    ):\n        raise ValueError("scene visual source payload contract changed")\n\n    denominator_specs = {\n        "source_denominator": (\n            57,\n            88_756,\n            SCENE_VISUAL_SOURCE_FULL_RANGE_DENOMINATOR_SHA256,\n        ),\n        "candidate_denominator": (\n            29,\n            3_288,\n            SCENE_VISUAL_SOURCE_CANDIDATE_RANGE_DENOMINATOR_SHA256,\n        ),\n        "overlap_denominator": (\n            1,\n            31,\n            SCENE_VISUAL_SOURCE_OVERLAP_RANGE_DENOMINATOR_SHA256,\n        ),\n        "promotion_denominator": (\n            29,\n            3_257,\n            SCENE_VISUAL_SOURCE_PROMOTION_RANGE_DENOMINATOR_SHA256,\n        ),\n    }\n    for name, (expected_count, expected_bytes, expected_hash) in denominator_specs.items():\n        denominator = payload.get(name)\n        records = denominator.get("records") if isinstance(denominator, dict) else None\n        if not isinstance(records, list):\n            raise ValueError(f"scene visual source {name} records changed")\n        ranges: list[list[int]] = []\n        byte_count = 0\n        for index, record in enumerate(records):\n            if not isinstance(record, dict):\n                raise ValueError(f"scene visual source {name} record changed: {index}")\n            start, end = _validated_range(record, len(rom))\n            if record.get("size") != end - start:\n                raise ValueError(f"scene visual source {name} size changed: {index}")\n            ranges.append([start, end])\n            byte_count += end - start\n        denominator_hash = _sha256(\n            json.dumps(ranges, separators=(",", ":")).encode("ascii")\n        )\n        if (\n            denominator.get("range_count") != expected_count\n            or denominator.get("byte_count") != expected_bytes\n            or denominator.get("range_vector") != ranges\n            or denominator.get("range_vector_sha256") != expected_hash\n            or len(records) != expected_count\n            or byte_count != expected_bytes\n            or denominator_hash != expected_hash\n        ):\n            raise ValueError(f"scene visual source {name} denominator changed")\n\n    try:\n        report = verify_rom_scene_visual_source_ranges(root, artifact)\n    except Exception as error:\n        raise ValueError(\n            f"scene visual source independent verification failed: {error}"\n        ) from error\n    if report != SCENE_VISUAL_SOURCE_EXPECTED_REPORT:\n        raise ValueError(\n            "scene visual source independent verification failed: " f"{report}"\n        )\n\n    candidate_records = payload["candidate_denominator"]["records"]\n    promotion_records = payload["promotion_denominator"]["records"]\n    overlap_records = payload["overlap_denominator"]["records"]\n    if (\n        len(overlap_records) != 1\n        or overlap_records[0]\n        != {\n            "source_id": "pack-05-definition",\n            "range": [0x407BF0, 0x407C0F],\n            "size": 31,\n            "primary_class": "lz77_syntax_unbound",\n            "primary_claim_ids": ["unbound-lz77-35-407bec"],\n        }\n    ):\n        raise ValueError("scene visual source overlap ownership changed")\n    candidate_by_source = {\n        record.get("source_id"): record for record in candidate_records\n    }\n    if len(candidate_by_source) != 29:\n        raise ValueError("scene visual source candidate IDs changed")\n    pack5_candidate = candidate_by_source.get("pack-05-definition")\n    if (\n        pack5_candidate is None\n        or pack5_candidate.get("range") != [0x407BF0, 0x407C50]\n        or pack5_candidate.get("baseline_state") != "mixed"\n        or pack5_candidate.get("promotion_state") != "mixed"\n        or pack5_candidate.get("known_slices") != [[0x407BF0, 0x407C0F]]\n        or pack5_candidate.get("unknown_slices") != [[0x407C0F, 0x407C50]]\n    ):\n        raise ValueError("scene visual source pack-05 candidate partition changed")\n\n    baseline_segments = atomize_claims(len(rom), baseline_claims)\n    overlap_start, overlap_end = overlap_records[0]["range"]\n    overlap_segments = [\n        segment\n        for segment in baseline_segments\n        if segment["range"][0] < overlap_end\n        and overlap_start < segment["range"][1]\n    ]\n    overlap_covered = sum(\n        min(overlap_end, segment["range"][1])\n        - max(overlap_start, segment["range"][0])\n        for segment in overlap_segments\n    )\n    if (\n        overlap_covered != 31\n        or any(\n            segment.get("primary_class") != "lz77_syntax_unbound"\n            or "unbound-lz77-35-407bec"\n            not in segment.get("primary_claim_ids", [])\n            for segment in overlap_segments\n        )\n    ):\n        raise ValueError("scene visual source preserved overlap owner changed")\n\n    bundle = bundle_path.read_bytes()\n    claims: list[dict[str, Any]] = []\n    packed_cursor = 0\n    previous_end = -1\n    for index, record in enumerate(promotion_records):\n        start, end = _validated_range(record, len(rom))\n        raw = rom[start:end]\n        source_id = record.get("source_id")\n        source_kind = record.get("kind")\n        candidate = candidate_by_source.get(source_id)\n        primary_class = SCENE_VISUAL_SOURCE_CLASS_BY_KIND.get(source_kind)\n        packed_range = [packed_cursor, packed_cursor + len(raw)]\n        gba_range = [f"0x{GBA_ROM_BASE + start:08X}", f"0x{GBA_ROM_BASE + end:08X}"]\n        if (\n            source_id is None\n            or candidate is None\n            or primary_class is None\n            or start < previous_end\n            or record.get("size") != end - start\n            or record.get("raw_sha256") != _sha256(raw)\n            or record.get("gba_range") != gba_range\n            or record.get("baseline_state") != "current_unknown"\n            or record.get("promotion_state") != "current_unknown"\n            or "known_slices" in record\n            or "unknown_slices" in record\n            or record.get("kind") != candidate.get("kind")\n            or bundle[packed_range[0] : packed_range[1]] != raw\n        ):\n            raise ValueError(f"scene visual source promotion changed: {index}")\n        if source_id == "pack-05-definition":\n            if [start, end] != [0x407C0F, 0x407C50]:\n                raise ValueError("scene visual source pack-05 promotion changed")\n        elif [start, end] != candidate.get("range"):\n            raise ValueError(f"scene visual source promotion split changed: {index}")\n\n        intersections = [\n            segment\n            for segment in baseline_segments\n            if segment["range"][0] < end and start < segment["range"][1]\n        ]\n        covered = sum(\n            min(end, segment["range"][1]) - max(start, segment["range"][0])\n            for segment in intersections\n        )\n        known_bytes = sum(\n            min(end, segment["range"][1]) - max(start, segment["range"][0])\n            for segment in intersections\n            if segment.get("primary_class") != "unknown"\n        )\n        if covered != end - start or known_bytes:\n            raise ValueError(\n                "scene visual source range is not fully current unknown: "\n                f"promotion-{index:02d} ({known_bytes} known bytes)"\n            )\n\n        claims.append(\n            {\n                "id": f"scene-visual-source-{index:02d}-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": primary_class,\n                "claim_kind": "scene_visual_source_range",\n                "promotion_batch": SCENE_VISUAL_SOURCE_BATCH,\n                "promoted_from_primary_class": "unknown",\n                "baseline_unknown_only": True,\n                "source_id": source_id,\n                "source_kind": source_kind,\n                "bytes_sha256": record["raw_sha256"],\n                "packed_range": packed_range,\n                "evidence_path": (\n                    SCENE_VISUAL_SOURCE_ARTIFACT / SCENE_VISUAL_SOURCE_PAYLOAD_NAME\n                ).as_posix(),\n                "evidence_sha256": SCENE_VISUAL_SOURCE_PAYLOAD_SHA256,\n                "evidence_selector": f"/promotion_denominator/records/{index}",\n                "promotion_manifest_path": (\n                    SCENE_VISUAL_SOURCE_ARTIFACT / "manifest.json"\n                ).as_posix(),\n                "promotion_manifest_sha256": SCENE_VISUAL_SOURCE_MANIFEST_SHA256,\n                "independent_verifier_path": SCENE_VISUAL_SOURCE_VERIFIER.as_posix(),\n                "independent_verifier_sha256": SCENE_VISUAL_SOURCE_VERIFIER_SHA256,\n                "natural_runtime_reachability_claimed": False,\n                "final_pixel_equivalence_claimed": False,\n                "editing_or_relocation_safety_claimed": False,\n                "allocatable_space_claimed": False,\n                "limitations": [\n                    "Only this complete current-unknown portion of the frozen source extent is classified.",\n                    "Natural reachability, final-pixel equivalence, editing or relocation safety, and allocatable space are not claimed.",\n                ],\n            }\n        )\n        packed_cursor += end - start\n        previous_end = end\n\n    denominator = _sha256(\n        json.dumps(\n            [claim["range"] for claim in claims], separators=(",", ":")\n        ).encode("ascii")\n    )\n    class_bytes = {\n        primary_class: sum(\n            claim["range"][1] - claim["range"][0]\n            for claim in claims\n            if claim["primary_class"] == primary_class\n        )\n        for primary_class in SCENE_VISUAL_SOURCE_CLASS_BYTES\n    }\n    class_counts = {\n        primary_class: sum(\n            claim["primary_class"] == primary_class for claim in claims\n        )\n        for primary_class in SCENE_VISUAL_SOURCE_CLASS_COUNTS\n    }\n    if (\n        len(claims) != 29\n        or packed_cursor != 3_257\n        or packed_cursor != len(bundle)\n        or denominator != SCENE_VISUAL_SOURCE_PROMOTION_RANGE_DENOMINATOR_SHA256\n        or class_bytes != SCENE_VISUAL_SOURCE_CLASS_BYTES\n        or class_counts != SCENE_VISUAL_SOURCE_CLASS_COUNTS\n    ):\n        raise ValueError(\n            "scene visual source coverage denominator changed: "\n            f"claims={len(claims)}, bytes={packed_cursor}, sha256={denominator}"\n        )\n    return claims\n\n\ndef _cutscene_obj_source_range_claims(\n    root: Path,\n    rom: bytes,\n    baseline_claims: list[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote the 28 verifier-bound Cutscene OBJ source ranges."""\n\n    root = Path(root).resolve(strict=True)\n    if _sha256(rom) != ROM_SHA256:\n        raise ValueError("cutscene OBJ source ROM SHA-256 changed")\n    if any(\n        claim.get("promotion_batch") == CUTSCENE_OBJ_SOURCE_BATCH\n        for claim in baseline_claims\n    ):\n        raise ValueError("cutscene OBJ source batch is already present")\n\n    artifact = (root / CUTSCENE_OBJ_SOURCE_ARTIFACT).absolute()\n    manifest_path = artifact / "manifest.json"\n    payload_path = artifact / CUTSCENE_OBJ_SOURCE_PAYLOAD_NAME\n    bundle_path = artifact / CUTSCENE_OBJ_SOURCE_BUNDLE_NAME\n    verifier_path = (root / CUTSCENE_OBJ_SOURCE_VERIFIER).absolute()\n\n    def checked_path(path: Path, label: str, *, directory: bool = False) -> Path:\n        try:\n            resolved = path.resolve(strict=True)\n            resolved.relative_to(root)\n        except (OSError, ValueError) as error:\n            raise ValueError(f"cutscene OBJ source {label} path is unsafe") from error\n        if path.is_symlink() or resolved != path:\n            raise ValueError(f"cutscene OBJ source {label} path is unsafe")\n        if directory:\n            if not path.is_dir():\n                raise ValueError(f"cutscene OBJ source {label} is not a directory")\n        elif not path.is_file():\n            raise ValueError(f"cutscene OBJ source {label} is not a file")\n        return resolved\n\n    checked_path(artifact, "artifact", directory=True)\n    expected_names = {\n        "manifest.json",\n        CUTSCENE_OBJ_SOURCE_PAYLOAD_NAME,\n        CUTSCENE_OBJ_SOURCE_BUNDLE_NAME,\n    }\n    members = list(artifact.iterdir())\n    if (\n        {member.name for member in members} != expected_names\n        or any(member.is_symlink() or not member.is_file() for member in members)\n    ):\n        raise ValueError("cutscene OBJ source artifact file denominator changed")\n    for path, label in (\n        (manifest_path, "manifest"),\n        (payload_path, "payload"),\n        (bundle_path, "bundle"),\n        (verifier_path, "verifier"),\n    ):\n        checked_path(path, label)\n    if _sha256_file(manifest_path) != CUTSCENE_OBJ_SOURCE_MANIFEST_SHA256:\n        raise ValueError("cutscene OBJ source manifest hash changed")\n    if (\n        payload_path.stat().st_size != CUTSCENE_OBJ_SOURCE_PAYLOAD_SIZE\n        or _sha256_file(payload_path) != CUTSCENE_OBJ_SOURCE_PAYLOAD_SHA256\n    ):\n        raise ValueError("cutscene OBJ source payload identity changed")\n    if (\n        bundle_path.stat().st_size != 400\n        or _sha256_file(bundle_path) != CUTSCENE_OBJ_SOURCE_BUNDLE_SHA256\n    ):\n        raise ValueError("cutscene OBJ source bundle identity changed")\n    if _sha256_file(verifier_path) != CUTSCENE_OBJ_SOURCE_VERIFIER_SHA256:\n        raise ValueError("cutscene OBJ source verifier identity changed")\n\n    try:\n        manifest = json.loads(manifest_path.read_bytes())\n        payload = json.loads(payload_path.read_bytes())\n    except (OSError, json.JSONDecodeError) as error:\n        raise ValueError("cutscene OBJ source JSON is invalid") from error\n\n    expected_rom = {\n        "path": ROM_PATH.as_posix(),\n        "size": len(rom),\n        "sha256": ROM_SHA256,\n    }\n    expected_implementation = {\n        "exporter": {\n            "path": CUTSCENE_OBJ_SOURCE_EXPORTER.as_posix(),\n            "sha256": CUTSCENE_OBJ_SOURCE_EXPORTER_SHA256,\n        },\n        "test": {\n            "path": CUTSCENE_OBJ_SOURCE_TEST.as_posix(),\n            "sha256": CUTSCENE_OBJ_SOURCE_TEST_SHA256,\n        },\n        "verifier": {\n            "path": CUTSCENE_OBJ_SOURCE_VERIFIER.as_posix(),\n            "sha256": CUTSCENE_OBJ_SOURCE_VERIFIER_SHA256,\n        },\n    }\n    expected_producer_command = [\n        "python3",\n        CUTSCENE_OBJ_SOURCE_EXPORTER.as_posix(),\n        "--root",\n        ".",\n        "--output-dir",\n        "build/experiments/active/cutscene-obj-source-ranges/r5/final",\n    ]\n    expected_verifier_command = [\n        "python3",\n        CUTSCENE_OBJ_SOURCE_VERIFIER.as_posix(),\n        "--root",\n        ".",\n        "--artifact-dir",\n        "build/experiments/active/cutscene-obj-source-ranges/r5/final",\n    ]\n    expected_manifest_files = {\n        CUTSCENE_OBJ_SOURCE_PAYLOAD_NAME: CUTSCENE_OBJ_SOURCE_PAYLOAD_SHA256,\n        CUTSCENE_OBJ_SOURCE_BUNDLE_NAME: CUTSCENE_OBJ_SOURCE_BUNDLE_SHA256,\n    }\n    if (\n        not isinstance(manifest, dict)\n        or set(manifest)\n        != {\n            "schema",\n            "artifact_schema",\n            "artifact_status",\n            "files",\n            "producer",\n            "verifier",\n            "rom",\n            "source_identity",\n            "scope",\n            "limitations",\n        }\n        or manifest.get("schema") != "git-artifact-promotion-v1"\n        or manifest.get("artifact_schema") != CUTSCENE_OBJ_SOURCE_BATCH\n        or manifest.get("artifact_status") != "accepted"\n        or manifest.get("files") != expected_manifest_files\n        or manifest.get("rom") != expected_rom\n        or manifest.get("scope") != CUTSCENE_OBJ_SOURCE_SCOPE\n        or manifest.get("limitations") != CUTSCENE_OBJ_SOURCE_LIMITATIONS\n        or manifest.get("producer")\n        != {"command": expected_producer_command, **expected_implementation}\n        or manifest.get("verifier")\n        != {\n            "schema": "rom-cutscene-obj-source-ranges-verification-v1",\n            "command": expected_verifier_command,\n            "exit_code": 0,\n            "report": CUTSCENE_OBJ_SOURCE_EXPECTED_REPORT,\n            "verifier_sha256": CUTSCENE_OBJ_SOURCE_VERIFIER_SHA256,\n        }\n    ):\n        raise ValueError("cutscene OBJ source manifest contract changed")\n\n    expected_summary = {\n        "bundle_sha256": CUTSCENE_OBJ_SOURCE_BUNDLE_SHA256,\n        "byte_count": 400,\n        "kind_counts": {\n            "animation_pointer_table": {"byte_count": 40, "range_count": 4},\n            "animation_timeline": {"byte_count": 80, "range_count": 10},\n            "definition_pointer_table": {"byte_count": 40, "range_count": 4},\n            "definition_record": {"byte_count": 240, "range_count": 10},\n        },\n        "range_count": 28,\n        "range_vector_sha256": (\n            "5ffcd048916c21a3cd46a7baf5421c2db7812a4c5cf0d73edd83efb9eb03ab43"\n        ),\n        "resource_envelope_bytes": 400,\n        "resource_envelope_count": 4,\n        "resource_envelopes": [\n            [0x12DEFC, 0x12DF4C],\n            [0x12E444, 0x12E494],\n            [0x12E960, 0x12E9B0],\n            [0x12ED70, 0x12EE10],\n        ],\n    }\n    records = payload.get("records") if isinstance(payload, dict) else None\n    resources = payload.get("resources") if isinstance(payload, dict) else None\n    if (\n        payload.get("schema") != CUTSCENE_OBJ_SOURCE_BATCH\n        or payload.get("rom") != expected_rom\n        or payload.get("resource_count") != 4\n        or payload.get("frame_counts") != [2, 2, 2, 4]\n        or payload.get("implementation") != expected_implementation\n        or payload.get("scope") != CUTSCENE_OBJ_SOURCE_SCOPE\n        or payload.get("limitations") != CUTSCENE_OBJ_SOURCE_LIMITATIONS\n        or payload.get("files")\n        != {\n            CUTSCENE_OBJ_SOURCE_BUNDLE_NAME: {\n                "sha256": CUTSCENE_OBJ_SOURCE_BUNDLE_SHA256,\n                "size": 400,\n            }\n        }\n        or payload.get("summary") != expected_summary\n        or not isinstance(records, list)\n        or len(records) != 28\n        or not isinstance(resources, list)\n        or len(resources) != 4\n        or manifest.get("source_identity") != payload.get("source_identity")\n    ):\n        raise ValueError("cutscene OBJ source payload contract changed")\n\n    try:\n        report = verify_rom_cutscene_obj_source_ranges(root, artifact)\n    except Exception as error:\n        raise ValueError(\n            f"cutscene OBJ source independent verification failed: {error}"\n        ) from error\n    if report != CUTSCENE_OBJ_SOURCE_EXPECTED_REPORT:\n        raise ValueError(\n            "cutscene OBJ source independent verification failed: " f"{report}"\n        )\n\n    resource_by_id = {\n        resource.get("resource_id"): resource\n        for resource in resources\n        if isinstance(resource, dict)\n    }\n    if set(resource_by_id) != set(range(4)):\n        raise ValueError("cutscene OBJ source resource denominator changed")\n\n    baseline_segments = atomize_claims(len(rom), baseline_claims)\n    bundle = bundle_path.read_bytes()\n    claims: list[dict[str, Any]] = []\n    packed_cursor = 0\n    previous_end = -1\n    component_keys = {\n        "tile_offset",\n        "flag_02",\n        "flag_03",\n        "horizontal_position_input",\n        "vertical_position_input",\n        "width",\n        "height",\n        "transform_factor_0c",\n        "transform_factor_0e",\n        "unknown_10_byte",\n        "oam_attribute_byte",\n        "unknown_12",\n    }\n    for index, record in enumerate(records):\n        if not isinstance(record, dict):\n            raise ValueError(f"cutscene OBJ source record changed: {index}")\n        start, end = _validated_range(record, len(rom))\n        raw = rom[start:end]\n        source_kind = record.get("kind")\n        primary_class = CUTSCENE_OBJ_SOURCE_CLASS_BY_KIND.get(source_kind)\n        resource_id = record.get("resource_id")\n        resource = resource_by_id.get(resource_id)\n        packed_range = [packed_cursor, packed_cursor + len(raw)]\n        if (\n            primary_class is None\n            or resource is None\n            or start < previous_end\n            or record.get("size") != end - start\n            or record.get("raw_hex") != raw.hex()\n            or record.get("raw_sha256") != _sha256(raw)\n            or record.get("gba_range")\n            != [f"0x{GBA_ROM_BASE + start:08X}", f"0x{GBA_ROM_BASE + end:08X}"]\n            or bundle[packed_range[0] : packed_range[1]] != raw\n        ):\n            raise ValueError(f"cutscene OBJ source record bytes changed: {index}")\n\n        frame_count = resource.get("frame_count")\n        if source_kind == "definition_record":\n            if (\n                end - start != 24\n                or record.get("terminator_hex") != "ffff0000"\n                or raw[-4:] != bytes.fromhex("ffff0000")\n                or not isinstance(record.get("frame_id"), int)\n                or not 0 <= record["frame_id"] < frame_count\n                or not isinstance(record.get("component"), dict)\n                or set(record["component"]) != component_keys\n            ):\n                raise ValueError(\n                    f"cutscene OBJ definition record changed: {index}"\n                )\n        elif source_kind == "animation_timeline":\n            if (\n                end - start != 8\n                or record.get("terminator_hex") != "ffff0000"\n                or raw[-4:] != bytes.fromhex("ffff0000")\n                or not isinstance(record.get("frame_id"), int)\n                or not 0 <= record["frame_id"] < frame_count\n                or not isinstance(record.get("duration"), int)\n            ):\n                raise ValueError(\n                    f"cutscene OBJ animation timeline changed: {index}"\n                )\n        else:\n            pointer_vector = record.get("pointer_vector")\n            expected_role = (\n                "definition"\n                if source_kind == "definition_pointer_table"\n                else "animation"\n            )\n            try:\n                pointer_raw = b"".join(\n                    int(pointer, 16).to_bytes(4, "little")\n                    for pointer in pointer_vector\n                )\n            except (TypeError, ValueError, OverflowError) as error:\n                raise ValueError(\n                    f"cutscene OBJ pointer vector changed: {index}"\n                ) from error\n            if (\n                record.get("entry_size") != 4\n                or len(pointer_vector) != frame_count\n                or end - start != 4 * frame_count\n                or pointer_raw != raw\n                or record.get("selector", {}).get("pointer_table_role")\n                != expected_role\n            ):\n                raise ValueError(\n                    f"cutscene OBJ pointer table changed: {index}"\n                )\n\n        intersections = [\n            segment\n            for segment in baseline_segments\n            if segment["range"][0] < end and start < segment["range"][1]\n        ]\n        covered = sum(\n            min(end, segment["range"][1]) - max(start, segment["range"][0])\n            for segment in intersections\n        )\n        known_bytes = sum(\n            min(end, segment["range"][1]) - max(start, segment["range"][0])\n            for segment in intersections\n            if segment.get("primary_class") != "unknown"\n        )\n        if covered != end - start or known_bytes:\n            raise ValueError(\n                "cutscene OBJ source range is not fully current unknown: "\n                f"record-{index:02d} ({known_bytes} known bytes)"\n            )\n\n        claim = {\n            "id": f"cutscene-obj-source-{index:02d}-{start:06x}",\n            "range": [start, end],\n            "role": "primary",\n            "primary_class": primary_class,\n            "claim_kind": "cutscene_obj_source_range",\n            "promotion_batch": CUTSCENE_OBJ_SOURCE_BATCH,\n            "promoted_from_primary_class": "unknown",\n            "baseline_unknown_only": True,\n            "artifact_record_index": index,\n            "resource_id": resource_id,\n            "source_kind": source_kind,\n            "bytes_sha256": record["raw_sha256"],\n            "packed_range": packed_range,\n            "evidence_path": (\n                CUTSCENE_OBJ_SOURCE_ARTIFACT / CUTSCENE_OBJ_SOURCE_PAYLOAD_NAME\n            ).as_posix(),\n            "evidence_sha256": CUTSCENE_OBJ_SOURCE_PAYLOAD_SHA256,\n            "evidence_selector": f"/records/{index}",\n            "promotion_manifest_path": (\n                CUTSCENE_OBJ_SOURCE_ARTIFACT / "manifest.json"\n            ).as_posix(),\n            "promotion_manifest_sha256": CUTSCENE_OBJ_SOURCE_MANIFEST_SHA256,\n            "independent_verifier_path": CUTSCENE_OBJ_SOURCE_VERIFIER.as_posix(),\n            "independent_verifier_sha256": CUTSCENE_OBJ_SOURCE_VERIFIER_SHA256,\n            "natural_runtime_reachability_claimed": False,\n            "final_pixel_equivalence_claimed": False,\n            "definition_unknown_field_semantics_claimed": False,\n            "graphics_or_palette_expansion_claimed": False,\n            "editing_or_relocation_safety_claimed": False,\n            "allocatable_space_claimed": False,\n            "limitations": [\n                "Only this complete verifier-bound Cutscene OBJ source record or pointer table is classified.",\n                "Natural reachability, final-pixel equivalence, unknown definition-field semantics, graphics or palette expansion, editing or relocation safety, and allocatable space are not claimed.",\n            ],\n        }\n        if isinstance(record.get("frame_id"), int):\n            claim["frame_id"] = record["frame_id"]\n        claims.append(claim)\n        packed_cursor += end - start\n        previous_end = end\n\n    denominator = _sha256(\n        json.dumps(\n            [\n                {\n                    key: claim[key]\n                    for key in (\n                        "id",\n                        "range",\n                        "primary_class",\n                        "bytes_sha256",\n                        "evidence_selector",\n                    )\n                }\n                for claim in claims\n            ],\n            ensure_ascii=True,\n            separators=(",", ":"),\n            sort_keys=True,\n        ).encode("ascii")\n    )\n    class_bytes = {\n        primary_class: sum(\n            claim["range"][1] - claim["range"][0]\n            for claim in claims\n            if claim["primary_class"] == primary_class\n        )\n        for primary_class in CUTSCENE_OBJ_SOURCE_CLASS_BYTES\n    }\n    class_counts = {\n        primary_class: sum(\n            claim["primary_class"] == primary_class for claim in claims\n        )\n        for primary_class in CUTSCENE_OBJ_SOURCE_CLASS_COUNTS\n    }\n    if (\n        len(claims) != 28\n        or packed_cursor != 400\n        or packed_cursor != len(bundle)\n        or denominator != CUTSCENE_OBJ_SOURCE_RANGE_DENOMINATOR_SHA256\n        or class_bytes != CUTSCENE_OBJ_SOURCE_CLASS_BYTES\n        or class_counts != CUTSCENE_OBJ_SOURCE_CLASS_COUNTS\n    ):\n        raise ValueError(\n            "cutscene OBJ source coverage denominator changed: "\n            f"claims={len(claims)}, bytes={packed_cursor}, sha256={denominator}"\n        )\n    return claims\n\n\ndef _positions_aux_dispatch_claims(\n    root: Path,\n    rom: bytes,\n    baseline_claims: list[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote the 144 independently verified positions auxiliary tables."""\n\n    root = Path(root).resolve(strict=True)\n    baseline_claims = list(baseline_claims)\n    if _sha256(rom) != ROM_SHA256:\n        raise ValueError("positions auxiliary dispatch ROM SHA-256 changed")\n    if any(\n        claim.get("promotion_batch") == POSITIONS_AUX_DISPATCH_BATCH\n        for claim in baseline_claims\n    ):\n        raise ValueError("positions auxiliary dispatch batch is already present")\n\n    artifact = (root / POSITIONS_AUX_DISPATCH_ARTIFACT).absolute()\n    manifest_path = artifact / "manifest.json"\n    payload_path = artifact / POSITIONS_AUX_DISPATCH_PAYLOAD_NAME\n    exporter_path = (root / POSITIONS_AUX_DISPATCH_EXPORTER).absolute()\n    verifier_path = (root / POSITIONS_AUX_DISPATCH_VERIFIER).absolute()\n    test_path = (root / POSITIONS_AUX_DISPATCH_TEST).absolute()\n\n    def checked_path(path: Path, label: str, *, directory: bool = False) -> Path:\n        try:\n            resolved = path.resolve(strict=True)\n            resolved.relative_to(root)\n        except (OSError, ValueError) as error:\n            raise ValueError(\n                f"positions auxiliary dispatch {label} path is unsafe"\n            ) from error\n        if path.is_symlink() or resolved != path:\n            raise ValueError(f"positions auxiliary dispatch {label} path is unsafe")\n        if directory:\n            if not path.is_dir():\n                raise ValueError(\n                    f"positions auxiliary dispatch {label} is not a directory"\n                )\n        elif not path.is_file():\n            raise ValueError(f"positions auxiliary dispatch {label} is not a file")\n        return resolved\n\n    checked_path(artifact, "artifact", directory=True)\n    expected_files = {"manifest.json", POSITIONS_AUX_DISPATCH_PAYLOAD_NAME}\n    members = list(artifact.iterdir())\n    if (\n        {member.name for member in members} != expected_files\n        or any(member.is_symlink() or not member.is_file() for member in members)\n    ):\n        raise ValueError("positions auxiliary dispatch artifact file set changed")\n    for path, label in (\n        (manifest_path, "manifest"),\n        (payload_path, "payload"),\n        (exporter_path, "exporter"),\n        (verifier_path, "verifier"),\n        (test_path, "test"),\n    ):\n        checked_path(path, label)\n\n    if _sha256_file(manifest_path) != POSITIONS_AUX_DISPATCH_MANIFEST_SHA256:\n        raise ValueError("positions auxiliary dispatch manifest hash changed")\n    if (\n        payload_path.stat().st_size != POSITIONS_AUX_DISPATCH_PAYLOAD_SIZE\n        or _sha256_file(payload_path) != POSITIONS_AUX_DISPATCH_PAYLOAD_SHA256\n    ):\n        raise ValueError("positions auxiliary dispatch payload identity changed")\n    for path, expected, label in (\n        (\n            exporter_path,\n            POSITIONS_AUX_DISPATCH_EXPORTER_SHA256,\n            "exporter",\n        ),\n        (\n            verifier_path,\n            POSITIONS_AUX_DISPATCH_VERIFIER_SHA256,\n            "verifier",\n        ),\n        (test_path, POSITIONS_AUX_DISPATCH_TEST_SHA256, "test"),\n    ):\n        if _sha256_file(path) != expected:\n            raise ValueError(\n                f"positions auxiliary dispatch {label} identity changed"\n            )\n\n    try:\n        manifest = json.loads(manifest_path.read_bytes())\n        payload = json.loads(payload_path.read_bytes())\n    except (OSError, json.JSONDecodeError) as error:\n        raise ValueError("positions auxiliary dispatch JSON is invalid") from error\n\n    expected_rom = {\n        "path": ROM_PATH.as_posix(),\n        "size": len(rom),\n        "sha256": ROM_SHA256,\n    }\n    expected_implementation = {\n        "exporter": {\n            "path": POSITIONS_AUX_DISPATCH_EXPORTER.as_posix(),\n            "sha256": POSITIONS_AUX_DISPATCH_EXPORTER_SHA256,\n        },\n        "test": {\n            "path": POSITIONS_AUX_DISPATCH_TEST.as_posix(),\n            "sha256": POSITIONS_AUX_DISPATCH_TEST_SHA256,\n        },\n        "verifier": {\n            "path": POSITIONS_AUX_DISPATCH_VERIFIER.as_posix(),\n            "sha256": POSITIONS_AUX_DISPATCH_VERIFIER_SHA256,\n        },\n    }\n    expected_denominator = {\n        "range_list_sha256": POSITIONS_AUX_DISPATCH_RANGE_DENOMINATOR_SHA256,\n        "packed_range_bytes_sha256": POSITIONS_AUX_DISPATCH_PACKED_BYTES_SHA256,\n        "per_range_sha256_vector_sha256": POSITIONS_AUX_DISPATCH_VECTOR_SHA256,\n    }\n    expected_non_claims = {\n        field: False for field in POSITIONS_AUX_DISPATCH_NON_CLAIM_FIELDS\n    }\n    if (\n        not isinstance(manifest, dict)\n        or set(manifest)\n        != {\n            "schema",\n            "artifact_schema",\n            "files",\n            "file_set",\n            "payload",\n            "rom",\n            "producer",\n            "summary",\n            "denominator",\n            "verification",\n        }\n        or manifest.get("schema")\n        != "rom-positions-aux-dispatch-v1-artifact-manifest-v1"\n        or manifest.get("artifact_schema") != POSITIONS_AUX_DISPATCH_BATCH\n        or manifest.get("files")\n        != {\n            POSITIONS_AUX_DISPATCH_PAYLOAD_NAME: (\n                POSITIONS_AUX_DISPATCH_PAYLOAD_SHA256\n            )\n        }\n        or manifest.get("file_set") != sorted(expected_files)\n        or manifest.get("payload")\n        != {\n            "filename": POSITIONS_AUX_DISPATCH_PAYLOAD_NAME,\n            "sha256": POSITIONS_AUX_DISPATCH_PAYLOAD_SHA256,\n        }\n        or manifest.get("rom") != expected_rom\n        or manifest.get("producer") != expected_implementation\n        or manifest.get("summary") != POSITIONS_AUX_DISPATCH_EXPECTED_SUMMARY\n        or manifest.get("denominator") != expected_denominator\n        or manifest.get("verification")\n        != {\n            "schema": "rom-positions-aux-dispatch-verification-v1",\n            "command": [\n                "python3",\n                POSITIONS_AUX_DISPATCH_VERIFIER.as_posix(),\n                "--root",\n                ".",\n                "--artifact-dir",\n                POSITIONS_AUX_DISPATCH_ARTIFACT.as_posix(),\n            ],\n            "verifier_sha256": POSITIONS_AUX_DISPATCH_VERIFIER_SHA256,\n        }\n    ):\n        raise ValueError("positions auxiliary dispatch manifest contract changed")\n\n    tables = payload.get("tables") if isinstance(payload, dict) else None\n    ranges = payload.get("range_denominator") if isinstance(payload, dict) else None\n    vector = (\n        payload.get("per_range_sha256_vector")\n        if isinstance(payload, dict)\n        else None\n    )\n    scope = payload.get("scope") if isinstance(payload, dict) else None\n    if (\n        payload.get("schema") != POSITIONS_AUX_DISPATCH_BATCH\n        or payload.get("rom") != expected_rom\n        or payload.get("implementation") != expected_implementation\n        or payload.get("summary") != POSITIONS_AUX_DISPATCH_EXPECTED_SUMMARY\n        or payload.get("range_list_sha256")\n        != POSITIONS_AUX_DISPATCH_RANGE_DENOMINATOR_SHA256\n        or payload.get("packed_range_bytes_sha256")\n        != POSITIONS_AUX_DISPATCH_PACKED_BYTES_SHA256\n        or payload.get("per_range_sha256_vector_sha256")\n        != POSITIONS_AUX_DISPATCH_VECTOR_SHA256\n        or payload.get("upstream_positions_file_sha256")\n        != "1e9d2822e486c6e79c9ad4f1545915fa378505dd1b58e840f939fd1032fd55e9"\n        or payload.get("non_claims") != expected_non_claims\n        or not isinstance(scope, dict)\n        or set(scope)\n        != {"conclusion", "read_footprint", *POSITIONS_AUX_DISPATCH_NON_CLAIM_FIELDS}\n        or scope.get("read_footprint") != POSITIONS_AUX_DISPATCH_READ_FOOTPRINT\n        or any(scope.get(field) is not False for field in expected_non_claims)\n        or not isinstance(tables, list)\n        or len(tables)\n        != POSITIONS_AUX_DISPATCH_GROUP_COUNT\n        * POSITIONS_AUX_DISPATCH_VARIANT_COUNT\n        or not isinstance(ranges, list)\n        or len(ranges) != len(tables)\n        or not isinstance(vector, list)\n        or len(vector) != len(tables)\n    ):\n        raise ValueError("positions auxiliary dispatch payload contract changed")\n\n    try:\n        report = verify_rom_positions_aux_dispatch(root, artifact)\n    except Exception as error:\n        raise ValueError(\n            f"positions auxiliary dispatch independent verification failed: {error}"\n        ) from error\n    if (\n        not isinstance(report, dict)\n        or report.get("verified") is not True\n        or report.get("errors") != []\n        or report.get("schema")\n        != "rom-positions-aux-dispatch-verification-v1"\n        or report.get("artifact_schema") != POSITIONS_AUX_DISPATCH_BATCH\n        or report.get("summary") != POSITIONS_AUX_DISPATCH_EXPECTED_SUMMARY\n        or report.get("range_list_sha256")\n        != POSITIONS_AUX_DISPATCH_RANGE_DENOMINATOR_SHA256\n        or report.get("packed_range_bytes_sha256")\n        != POSITIONS_AUX_DISPATCH_PACKED_BYTES_SHA256\n        or report.get("per_range_sha256_vector_sha256")\n        != POSITIONS_AUX_DISPATCH_VECTOR_SHA256\n        or report.get("non_claims") != expected_non_claims\n        or report.get("scope") != scope\n        or report.get("consumer") != payload.get("consumer")\n    ):\n        raise ValueError(\n            f"positions auxiliary dispatch independent verification failed: {report}"\n        )\n\n    primary_ranges: list[tuple[int, int, str]] = []\n    for claim in baseline_claims:\n        if claim.get("role") != "primary":\n            continue\n        start, end = _validated_range(claim, len(rom))\n        primary_ranges.append((start, end, str(claim.get("id"))))\n\n    claims: list[dict[str, Any]] = []\n    packed = bytearray()\n    rebuilt_vector: list[str] = []\n    for ordinal, table in enumerate(tables):\n        group, variant = divmod(ordinal, POSITIONS_AUX_DISPATCH_VARIANT_COUNT)\n        start = (\n            POSITIONS_AUX_DISPATCH_BASE\n            + group * POSITIONS_AUX_DISPATCH_GROUP_STRIDE\n            + variant * POSITIONS_AUX_DISPATCH_VARIANT_STRIDE\n            + POSITIONS_AUX_DISPATCH_OFFSET\n        )\n        end = start + POSITIONS_AUX_DISPATCH_BYTES_PER_TABLE\n        raw = rom[start:end]\n        raw_sha256 = _sha256(raw)\n        cells = table.get("cells") if isinstance(table, dict) else None\n        if (\n            table.get("ordinal") != ordinal\n            or table.get("group") != group\n            or table.get("variant") != variant\n            or table.get("base")\n            != POSITIONS_AUX_DISPATCH_BASE\n            + group * POSITIONS_AUX_DISPATCH_GROUP_STRIDE\n            + variant * POSITIONS_AUX_DISPATCH_VARIANT_STRIDE\n            or table.get("range") != [start, end]\n            or table.get("gba_range")\n            != [f"0x{GBA_ROM_BASE + start:08X}", f"0x{GBA_ROM_BASE + end:08X}"]\n            or table.get("sha256") != raw_sha256\n            or ranges[ordinal] != [start, end]\n            or vector[ordinal] != raw_sha256\n            or not isinstance(cells, list)\n            or len(cells) != POSITIONS_AUX_DISPATCH_CELL_COUNT\n        ):\n            raise ValueError(\n                f"positions auxiliary dispatch table contract changed: {ordinal}"\n            )\n        for cell_index, cell in enumerate(cells):\n            cell_start = start + cell_index * POSITIONS_AUX_DISPATCH_CELL_STRIDE\n            cell_end = cell_start + POSITIONS_AUX_DISPATCH_CELL_STRIDE\n            cell_raw = rom[cell_start:cell_end]\n            if (\n                not isinstance(cell, dict)\n                or cell.get("index") != cell_index\n                or cell.get("range") != [cell_start, cell_end]\n                or cell.get("gba_range")\n                != [\n                    f"0x{GBA_ROM_BASE + cell_start:08X}",\n                    f"0x{GBA_ROM_BASE + cell_end:08X}",\n                ]\n                or cell.get("raw_hex") != cell_raw.hex()\n                or cell.get("byte0_dispatch_selector") != cell_raw[0]\n                or cell.get("byte1_raw_handler_operand") != cell_raw[1]\n                or cell.get("byte2_raw_handler_operand") != cell_raw[2]\n                or cell.get("byte3_raw_handler_operand") != cell_raw[3]\n            ):\n                raise ValueError(\n                    "positions auxiliary dispatch cell contract changed: "\n                    f"{ordinal}/{cell_index}"\n                )\n        overlaps = [\n            claim_id\n            for claim_start, claim_end, claim_id in primary_ranges\n            if claim_start < end and start < claim_end\n        ]\n        if overlaps:\n            raise ValueError(\n                "positions auxiliary dispatch range is not fully current unknown: "\n                f"ordinal={ordinal}, overlaps={overlaps[:8]}"\n            )\n        packed.extend(raw)\n        rebuilt_vector.append(raw_sha256)\n        claims.append(\n            {\n                "id": f"positions-aux-dispatch-table-{ordinal:03d}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": POSITIONS_AUX_DISPATCH_PRIMARY_CLASS,\n                "claim_kind": POSITIONS_AUX_DISPATCH_CLAIM_KIND,\n                "promotion_batch": POSITIONS_AUX_DISPATCH_BATCH,\n                "promoted_from_primary_class": "unknown",\n                "baseline_unknown_only": True,\n                "ordinal": ordinal,\n                "group": group,\n                "variant": variant,\n                "cell_count": POSITIONS_AUX_DISPATCH_CELL_COUNT,\n                "cell_stride": POSITIONS_AUX_DISPATCH_CELL_STRIDE,\n                "read_footprint": list(POSITIONS_AUX_DISPATCH_READ_FOOTPRINT),\n                "bytes_sha256": raw_sha256,\n                "evidence_path": (\n                    POSITIONS_AUX_DISPATCH_ARTIFACT\n                    / POSITIONS_AUX_DISPATCH_PAYLOAD_NAME\n                ).as_posix(),\n                "evidence_sha256": POSITIONS_AUX_DISPATCH_PAYLOAD_SHA256,\n                "evidence_selector": f"/tables/{ordinal}",\n                "promotion_manifest_path": (\n                    POSITIONS_AUX_DISPATCH_ARTIFACT / "manifest.json"\n                ).as_posix(),\n                "promotion_manifest_sha256": (\n                    POSITIONS_AUX_DISPATCH_MANIFEST_SHA256\n                ),\n                "independent_verifier_path": (\n                    POSITIONS_AUX_DISPATCH_VERIFIER.as_posix()\n                ),\n                "independent_verifier_sha256": (\n                    POSITIONS_AUX_DISPATCH_VERIFIER_SHA256\n                ),\n                **expected_non_claims,\n            }\n        )\n\n    range_hash = _sha256(\n        json.dumps(ranges, separators=(",", ":")).encode("ascii")\n    )\n    vector_hash = _sha256(\n        json.dumps(rebuilt_vector, separators=(",", ":")).encode("ascii")\n    )\n    if (\n        len(claims) != 144\n        or len(packed) != 9_216\n        or range_hash != POSITIONS_AUX_DISPATCH_RANGE_DENOMINATOR_SHA256\n        or _sha256(bytes(packed)) != POSITIONS_AUX_DISPATCH_PACKED_BYTES_SHA256\n        or vector_hash != POSITIONS_AUX_DISPATCH_VECTOR_SHA256\n    ):\n        raise ValueError(\n            "positions auxiliary dispatch coverage denominator changed: "\n            f"claims={len(claims)}, bytes={len(packed)}, sha256={range_hash}"\n        )\n    return claims\n\n\ndef _battle_sound_selector_claims(\n    root: Path,\n    rom: bytes,\n    baseline_claims: list[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote one verifier-bound 256-byte battle sound selector table."""\n\n    root = Path(root).resolve(strict=True)\n    baseline_claims = list(baseline_claims)\n    if _sha256(rom) != ROM_SHA256:\n        raise ValueError("battle sound selector ROM SHA-256 changed")\n    if any(\n        claim.get("promotion_batch") == BATTLE_SOUND_SELECTOR_BATCH\n        for claim in baseline_claims\n    ):\n        raise ValueError("battle sound selector batch is already present")\n\n    artifact = (root / BATTLE_SOUND_SELECTOR_ARTIFACT).absolute()\n    manifest_path = artifact / "manifest.json"\n    payload_path = artifact / BATTLE_SOUND_SELECTOR_PAYLOAD_NAME\n    binary_path = artifact / BATTLE_SOUND_SELECTOR_BINARY_NAME\n    exporter_path = (root / BATTLE_SOUND_SELECTOR_EXPORTER).absolute()\n    verifier_path = (root / BATTLE_SOUND_SELECTOR_VERIFIER).absolute()\n    test_path = (root / BATTLE_SOUND_SELECTOR_TEST).absolute()\n\n    def checked_path(path: Path, label: str, *, directory: bool = False) -> Path:\n        try:\n            resolved = path.resolve(strict=True)\n            resolved.relative_to(root)\n        except (OSError, ValueError) as error:\n            raise ValueError(f"battle sound selector {label} path is unsafe") from error\n        if path.is_symlink() or resolved != path:\n            raise ValueError(f"battle sound selector {label} path is unsafe")\n        if directory:\n            if not path.is_dir():\n                raise ValueError(f"battle sound selector {label} is not a directory")\n        elif not path.is_file():\n            raise ValueError(f"battle sound selector {label} is not a file")\n        return resolved\n\n    checked_path(artifact, "artifact", directory=True)\n    expected_files = {\n        "manifest.json",\n        BATTLE_SOUND_SELECTOR_PAYLOAD_NAME,\n        BATTLE_SOUND_SELECTOR_BINARY_NAME,\n    }\n    members = list(artifact.iterdir())\n    if (\n        {member.name for member in members} != expected_files\n        or any(member.is_symlink() or not member.is_file() for member in members)\n    ):\n        raise ValueError("battle sound selector artifact file set changed")\n    for path, label in (\n        (manifest_path, "manifest"),\n        (payload_path, "payload"),\n        (binary_path, "binary"),\n        (exporter_path, "exporter"),\n        (verifier_path, "verifier"),\n        (test_path, "test"),\n    ):\n        checked_path(path, label)\n\n    if _sha256_file(manifest_path) != BATTLE_SOUND_SELECTOR_MANIFEST_SHA256:\n        raise ValueError("battle sound selector manifest hash changed")\n    if (\n        payload_path.stat().st_size != BATTLE_SOUND_SELECTOR_PAYLOAD_SIZE\n        or _sha256_file(payload_path) != BATTLE_SOUND_SELECTOR_PAYLOAD_SHA256\n    ):\n        raise ValueError("battle sound selector payload identity changed")\n    if (\n        binary_path.stat().st_size != 256\n        or _sha256_file(binary_path) != BATTLE_SOUND_SELECTOR_BINARY_SHA256\n    ):\n        raise ValueError("battle sound selector binary identity changed")\n    for path, expected, label in (\n        (exporter_path, BATTLE_SOUND_SELECTOR_EXPORTER_SHA256, "exporter"),\n        (verifier_path, BATTLE_SOUND_SELECTOR_VERIFIER_SHA256, "verifier"),\n        (test_path, BATTLE_SOUND_SELECTOR_TEST_SHA256, "test"),\n    ):\n        if _sha256_file(path) != expected:\n            raise ValueError(f"battle sound selector {label} identity changed")\n\n    try:\n        manifest_raw = manifest_path.read_bytes()\n        payload_raw = payload_path.read_bytes()\n        manifest = json.loads(manifest_raw)\n        payload = json.loads(payload_raw)\n    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:\n        raise ValueError("battle sound selector JSON is invalid") from error\n\n    def canonical(value: Any) -> bytes:\n        return (\n            json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\\n"\n        ).encode("utf-8")\n\n    if manifest_raw != canonical(manifest) or payload_raw != canonical(payload):\n        raise ValueError("battle sound selector JSON is not canonical")\n\n    expected_rom = {\n        "path": ROM_PATH.as_posix(),\n        "size": len(rom),\n        "sha256": ROM_SHA256,\n    }\n    expected_implementation = {\n        "exporter": {\n            "path": BATTLE_SOUND_SELECTOR_EXPORTER.as_posix(),\n            "sha256": BATTLE_SOUND_SELECTOR_EXPORTER_SHA256,\n        },\n        "tests": {\n            "path": BATTLE_SOUND_SELECTOR_TEST.as_posix(),\n            "sha256": BATTLE_SOUND_SELECTOR_TEST_SHA256,\n        },\n        "verifier": {\n            "path": BATTLE_SOUND_SELECTOR_VERIFIER.as_posix(),\n            "sha256": BATTLE_SOUND_SELECTOR_VERIFIER_SHA256,\n        },\n    }\n    expected_non_claims = {\n        field: False for field in BATTLE_SOUND_SELECTOR_NON_CLAIM_FIELDS\n    }\n    expected_scope = {\n        "physical_selector_table_complete": True,\n        "direct_literal_consumer_denominator_complete": True,\n        "coverage_classification_performed": False,\n        "non_claims": expected_non_claims,\n    }\n    expected_range = list(BATTLE_SOUND_SELECTOR_RANGE)\n    selector = payload.get("selector") if isinstance(payload, dict) else None\n    entries = payload.get("entries") if isinstance(payload, dict) else None\n    if (\n        not isinstance(payload, dict)\n        or set(payload)\n        != {\n            "schema",\n            "rom",\n            "selector",\n            "entries",\n            "literal_xrefs",\n            "consumer_paths",\n            "literal_denominator",\n            "right_boundary",\n            "scope",\n            "non_claims",\n            "implementation",\n        }\n        or payload.get("schema") != BATTLE_SOUND_SELECTOR_BATCH\n        or payload.get("rom") != expected_rom\n        or payload.get("implementation") != expected_implementation\n        or payload.get("scope") != expected_scope\n        or payload.get("non_claims") != expected_non_claims\n        or not isinstance(selector, dict)\n        or selector.get("range") != expected_range\n        or selector.get("gba_range")\n        != [\n            GBA_ROM_BASE + BATTLE_SOUND_SELECTOR_RANGE[0],\n            GBA_ROM_BASE + BATTLE_SOUND_SELECTOR_RANGE[1],\n        ]\n        or selector.get("entry_count") != 256\n        or selector.get("entry_size") != 1\n        or selector.get("byte_sha256") != BATTLE_SOUND_SELECTOR_BINARY_SHA256\n        or selector.get("denominator_sha256")\n        != BATTLE_SOUND_SELECTOR_DENOMINATOR_SHA256\n        or not isinstance(entries, list)\n        or len(entries) != 256\n        or not isinstance(payload.get("literal_xrefs"), list)\n        or len(payload["literal_xrefs"]) != 5\n        or not isinstance(payload.get("consumer_paths"), list)\n        or len(payload["consumer_paths"]) != 5\n        or payload.get("literal_denominator", {}).get("count") != 5\n        or payload.get("right_boundary")\n        != {\n            "table_end_exclusive": BATTLE_SOUND_SELECTOR_RANGE[1],\n            "table_end_gba_address": (\n                GBA_ROM_BASE + BATTLE_SOUND_SELECTOR_RANGE[1]\n            ),\n            "no_overlap": True,\n            "no_gap_claimed": True,\n            "next_byte": {\n                "file_offset": BATTLE_SOUND_SELECTOR_RANGE[1],\n                "gba_address": GBA_ROM_BASE + BATTLE_SOUND_SELECTOR_RANGE[1],\n                "class": "battle_effect_runtime_state_sequence_table",\n                "claim": (\n                    "verified-reuse-battle-effect-runtime-state-sequences-53e596"\n                ),\n            },\n        }\n    ):\n        raise ValueError("battle sound selector payload contract changed")\n\n    start, end = BATTLE_SOUND_SELECTOR_RANGE\n    table = rom[start:end]\n    if (\n        binary_path.read_bytes() != table\n        or _sha256(table) != BATTLE_SOUND_SELECTOR_BINARY_SHA256\n    ):\n        raise ValueError("battle sound selector ROM slice changed")\n    for index, row in enumerate(entries):\n        if row != {\n            "index": index,\n            "file_offset": start + index,\n            "gba_address": GBA_ROM_BASE + start + index,\n            "value": table[index],\n        }:\n            raise ValueError(f"battle sound selector entry changed: {index}")\n\n    if (\n        not isinstance(manifest, dict)\n        or manifest.get("schema") != "git-artifact-promotion-v1"\n        or manifest.get("artifact_schema") != BATTLE_SOUND_SELECTOR_BATCH\n        or manifest.get("artifact_status") != "accepted"\n        or manifest.get("files")\n        != {\n            BATTLE_SOUND_SELECTOR_BINARY_NAME: BATTLE_SOUND_SELECTOR_BINARY_SHA256,\n            BATTLE_SOUND_SELECTOR_PAYLOAD_NAME: BATTLE_SOUND_SELECTOR_PAYLOAD_SHA256,\n        }\n        or manifest.get("implementation") != expected_implementation\n        or manifest.get("rom") != expected_rom\n        or manifest.get("scope") != expected_scope\n    ):\n        raise ValueError("battle sound selector promotion manifest changed")\n\n    try:\n        report = verify_rom_battle_sound_selector(root, artifact)\n    except Exception as error:\n        raise ValueError(\n            f"battle sound selector independent verification failed: {error}"\n        ) from error\n    if (\n        not isinstance(report, dict)\n        or report.get("verified") is not True\n        or report.get("errors") != []\n        or report.get("schema")\n        != "rom-battle-sound-selector-verification-v1"\n        or report.get("artifact_schema") != BATTLE_SOUND_SELECTOR_BATCH\n        or report.get("selector_range") != expected_range\n        or report.get("entry_count") != 256\n        or report.get("direct_literal_consumer_count") != 5\n        or report.get("implementation") != expected_implementation\n        or report.get("scope") != expected_scope\n        or report.get("non_claims") != expected_non_claims\n    ):\n        raise ValueError(\n            f"battle sound selector independent verification failed: {report}"\n        )\n\n    overlaps = []\n    for claim in baseline_claims:\n        if claim.get("role") != "primary":\n            continue\n        claim_start, claim_end = _validated_range(claim, len(rom))\n        if claim_start < end and start < claim_end:\n            overlaps.append(str(claim.get("id")))\n    if overlaps:\n        raise ValueError(\n            "battle sound selector range is not fully current unknown: "\n            f"overlaps={overlaps[:8]}"\n        )\n\n    return [\n        {\n            "id": "battle-sound-selector-table-53e496",\n            "range": [start, end],\n            "role": "primary",\n            "primary_class": BATTLE_SOUND_SELECTOR_PRIMARY_CLASS,\n            "claim_kind": BATTLE_SOUND_SELECTOR_CLAIM_KIND,\n            "promotion_batch": BATTLE_SOUND_SELECTOR_BATCH,\n            "promoted_from_primary_class": "unknown",\n            "baseline_unknown_only": True,\n            "entry_count": 256,\n            "entry_size": 1,\n            "direct_literal_consumer_count": 5,\n            "bytes_sha256": BATTLE_SOUND_SELECTOR_BINARY_SHA256,\n            "entry_denominator_sha256": (\n                BATTLE_SOUND_SELECTOR_DENOMINATOR_SHA256\n            ),\n            "evidence_path": (\n                BATTLE_SOUND_SELECTOR_ARTIFACT\n                / BATTLE_SOUND_SELECTOR_PAYLOAD_NAME\n            ).as_posix(),\n            "evidence_sha256": BATTLE_SOUND_SELECTOR_PAYLOAD_SHA256,\n            "evidence_selector": "/selector",\n            "binary_path": (\n                BATTLE_SOUND_SELECTOR_ARTIFACT\n                / BATTLE_SOUND_SELECTOR_BINARY_NAME\n            ).as_posix(),\n            "binary_sha256": BATTLE_SOUND_SELECTOR_BINARY_SHA256,\n            "promotion_manifest_path": (\n                BATTLE_SOUND_SELECTOR_ARTIFACT / "manifest.json"\n            ).as_posix(),\n            "promotion_manifest_sha256": BATTLE_SOUND_SELECTOR_MANIFEST_SHA256,\n            "independent_verifier_path": (\n                BATTLE_SOUND_SELECTOR_VERIFIER.as_posix()\n            ),\n            "independent_verifier_sha256": (\n                BATTLE_SOUND_SELECTOR_VERIFIER_SHA256\n            ),\n            "non_claims": expected_non_claims,\n            **expected_non_claims,\n            "limitations": [\n                "Only the complete 256-byte physical u8 selector table and five direct pointer-literal-bound consumer paths are proven.",\n                "Natural index/path reachability, indirect or computed consumers, value semantics, playback success, editing, write-back, relocation, and free or allocatable space are not claimed.",\n            ],\n        }\n    ]\n\n\ndef _battle_condition_record_claims(\n    root: Path,\n    rom: bytes,\n    baseline_claims: list[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote only the frozen current-unknown battle-condition fragments."""\n\n    root = Path(root).resolve(strict=True)\n    baseline_claims = list(baseline_claims)\n    if _sha256(rom) != ROM_SHA256:\n        raise ValueError("battle condition ROM SHA-256 changed")\n    if any(\n        claim.get("promotion_batch") == BATTLE_CONDITION_RECORDS_BATCH\n        for claim in baseline_claims\n    ):\n        raise ValueError("battle condition records batch is already present")\n\n    artifact = (root / BATTLE_CONDITION_RECORDS_ARTIFACT).absolute()\n    manifest_path = artifact / "manifest.json"\n    payload_path = artifact / BATTLE_CONDITION_RECORDS_PAYLOAD_NAME\n    binary_path = artifact / BATTLE_CONDITION_RECORDS_BINARY_NAME\n    exporter_path = (root / BATTLE_CONDITION_RECORDS_EXPORTER).absolute()\n    verifier_path = (root / BATTLE_CONDITION_RECORDS_VERIFIER).absolute()\n    test_path = (root / BATTLE_CONDITION_RECORDS_TEST).absolute()\n\n    def checked_path(path: Path, label: str, *, directory: bool = False) -> Path:\n        try:\n            resolved = path.resolve(strict=True)\n            resolved.relative_to(root)\n        except (OSError, ValueError) as error:\n            raise ValueError(f"battle condition {label} path is unsafe") from error\n        if path.is_symlink() or resolved != path:\n            raise ValueError(f"battle condition {label} path is unsafe")\n        if directory:\n            if not path.is_dir():\n                raise ValueError(f"battle condition {label} is not a directory")\n        elif not path.is_file():\n            raise ValueError(f"battle condition {label} is not a file")\n        return resolved\n\n    checked_path(artifact, "artifact", directory=True)\n    expected_files = {\n        "manifest.json",\n        BATTLE_CONDITION_RECORDS_PAYLOAD_NAME,\n        BATTLE_CONDITION_RECORDS_BINARY_NAME,\n    }\n    members = list(artifact.iterdir())\n    if (\n        {member.name for member in members} != expected_files\n        or any(member.is_symlink() or not member.is_file() for member in members)\n    ):\n        raise ValueError("battle condition artifact file set changed")\n    for path, label in (\n        (manifest_path, "manifest"),\n        (payload_path, "payload"),\n        (binary_path, "binary"),\n        (exporter_path, "exporter"),\n        (verifier_path, "verifier"),\n        (test_path, "test"),\n    ):\n        checked_path(path, label)\n\n    if _sha256_file(manifest_path) != BATTLE_CONDITION_RECORDS_MANIFEST_SHA256:\n        raise ValueError("battle condition manifest hash changed")\n    if (\n        payload_path.stat().st_size != BATTLE_CONDITION_RECORDS_PAYLOAD_SIZE\n        or _sha256_file(payload_path) != BATTLE_CONDITION_RECORDS_PAYLOAD_SHA256\n    ):\n        raise ValueError("battle condition payload identity changed")\n    if (\n        binary_path.stat().st_size != 9_588\n        or _sha256_file(binary_path) != BATTLE_CONDITION_RECORDS_BINARY_SHA256\n    ):\n        raise ValueError("battle condition binary identity changed")\n    for path, expected, label in (\n        (exporter_path, BATTLE_CONDITION_RECORDS_EXPORTER_SHA256, "exporter"),\n        (verifier_path, BATTLE_CONDITION_RECORDS_VERIFIER_SHA256, "verifier"),\n        (test_path, BATTLE_CONDITION_RECORDS_TEST_SHA256, "test"),\n    ):\n        if _sha256_file(path) != expected:\n            raise ValueError(f"battle condition {label} identity changed")\n\n    try:\n        manifest_raw = manifest_path.read_bytes()\n        payload_raw = payload_path.read_bytes()\n        manifest = json.loads(manifest_raw)\n        payload = json.loads(payload_raw)\n    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:\n        raise ValueError("battle condition JSON is invalid") from error\n\n    def canonical(value: Any) -> bytes:\n        return (\n            json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\\n"\n        ).encode("utf-8")\n\n    def compact_ranges(ranges: list[list[int]]) -> bytes:\n        return (\n            json.dumps(ranges, ensure_ascii=False, separators=(",", ":")) + "\\n"\n        ).encode("utf-8")\n\n    if manifest_raw != canonical(manifest) or payload_raw != canonical(payload):\n        raise ValueError("battle condition JSON is not canonical")\n\n    expected_rom = {\n        "path": ROM_PATH.as_posix(),\n        "size": len(rom),\n        "sha256": ROM_SHA256,\n    }\n    expected_implementation = {\n        "exporter": {\n            "path": BATTLE_CONDITION_RECORDS_EXPORTER.as_posix(),\n            "sha256": BATTLE_CONDITION_RECORDS_EXPORTER_SHA256,\n        },\n        "tests": {\n            "path": BATTLE_CONDITION_RECORDS_TEST.as_posix(),\n            "sha256": BATTLE_CONDITION_RECORDS_TEST_SHA256,\n        },\n        "verifier": {\n            "path": BATTLE_CONDITION_RECORDS_VERIFIER.as_posix(),\n            "sha256": BATTLE_CONDITION_RECORDS_VERIFIER_SHA256,\n        },\n    }\n    expected_non_claims = {\n        field: False for field in BATTLE_CONDITION_NON_CLAIM_FIELDS\n    }\n    expected_scope = {\n        "complete_physical_table": True,\n        "raw_interpreter_bound_layout": True,\n        "coverage_classification_performed": False,\n        "non_claims": expected_non_claims,\n    }\n    expected_table = {\n        "file_range": list(BATTLE_CONDITION_RECORDS_RANGE),\n        "gba_range": [\n            GBA_ROM_BASE + BATTLE_CONDITION_RECORDS_RANGE[0],\n            GBA_ROM_BASE + BATTLE_CONDITION_RECORDS_RANGE[1],\n        ],\n        "byte_size": 9_588,\n        "byte_sha256": BATTLE_CONDITION_RECORDS_BINARY_SHA256,\n        "battle_count": 47,\n        "battle_stride": 0xCC,\n        "variants_per_battle": 3,\n        "variant_stride": 0x44,\n        "variant_count": 141,\n        "predicate_slot_count": 1_128,\n        "denominator_hashes": {\n            "prefix_ranges_json_sha256": (\n                "1e2e792bf9c4fd75afe20481e55ca3ba7ea0374b88db95e7dad918b52f8bdd2d"\n            ),\n            "prefix_bytes_sha256": (\n                "45ca80c7d87e05305a9677c54c552161834f1829c298b0d2078924e0947d950c"\n            ),\n            "predicate_payload_ranges_json_sha256": (\n                "240541fbf33b129c71076b7dbbed0fa12c5e4e58cc4d0df91dd406b96e22c958"\n            ),\n            "predicate_payload_bytes_sha256": (\n                "f429071eb67753a70d01e5ea056a1853646598cda81866adaa82630c13f17f7e"\n            ),\n            "predicate_slot_ranges_json_sha256": (\n                "c9156961326d3ea4e7ba99f85c1860c3c6bfe587edbe79cda6fd5a5b541d7f6a"\n            ),\n            "predicate_slot_bytes_sha256": (\n                "f429071eb67753a70d01e5ea056a1853646598cda81866adaa82630c13f17f7e"\n            ),\n        },\n    }\n    variants = payload.get("variants") if isinstance(payload, dict) else None\n    if (\n        not isinstance(payload, dict)\n        or set(payload)\n        != {\n            "schema",\n            "rom",\n            "table",\n            "consumer",\n            "variants",\n            "statistics",\n            "scope",\n            "non_claims",\n            "implementation",\n        }\n        or payload.get("schema") != BATTLE_CONDITION_RECORDS_BATCH\n        or payload.get("rom") != expected_rom\n        or payload.get("table") != expected_table\n        or payload.get("implementation") != expected_implementation\n        or payload.get("scope") != expected_scope\n        or payload.get("non_claims") != expected_non_claims\n        or not isinstance(variants, list)\n        or len(variants) != 141\n    ):\n        raise ValueError("battle condition payload contract changed")\n\n    table_start, table_end = BATTLE_CONDITION_RECORDS_RANGE\n    table = rom[table_start:table_end]\n    if (\n        binary_path.read_bytes() != table\n        or _sha256(table) != BATTLE_CONDITION_RECORDS_BINARY_SHA256\n    ):\n        raise ValueError("battle condition ROM table changed")\n    gap_start, gap_end = BATTLE_CONDITION_RIGHT_GAP_RANGE\n    if _sha256(rom[gap_start:gap_end]) != BATTLE_CONDITION_RIGHT_GAP_SHA256:\n        raise ValueError("battle condition right gap identity changed")\n\n    prefix_sources: list[tuple[int, int, int, list[int]]] = []\n    predicate_sources: list[tuple[int, int, int, list[int]]] = []\n    for ordinal, row in enumerate(variants):\n        battle_id, variant_index = divmod(ordinal, 3)\n        start = table_start + ordinal * 0x44\n        end = start + 0x44\n        prefix_range = [start, start + 4]\n        predicate_range = [start + 4, end]\n        win = row.get("win") if isinstance(row, dict) else None\n        lose = row.get("lose") if isinstance(row, dict) else None\n        if (\n            not isinstance(row, dict)\n            or row.get("battle_id") != battle_id\n            or row.get("variant_index") != variant_index\n            or row.get("file_range") != [start, end]\n            or row.get("gba_range")\n            != [GBA_ROM_BASE + start, GBA_ROM_BASE + end]\n            or row.get("prefix_file_range") != prefix_range\n            or row.get("prefix_gba_range")\n            != [GBA_ROM_BASE + start, GBA_ROM_BASE + start + 4]\n            or row.get("prefix_bytes") != list(rom[start : start + 4])\n            or row.get("prefix_bytes_hex") != rom[start : start + 4].hex()\n            or not isinstance(win, dict)\n            or win.get("file_range") != [start + 4, start + 0x24]\n            or not isinstance(win.get("predicates"), list)\n            or len(win["predicates"]) != 4\n            or not isinstance(lose, dict)\n            or lose.get("file_range") != [start + 0x24, end]\n            or not isinstance(lose.get("predicates"), list)\n            or len(lose["predicates"]) != 4\n        ):\n            raise ValueError(f"battle condition variant contract changed: {ordinal}")\n        for group_index, group in enumerate((win, lose)):\n            group_start = start + 4 + group_index * 0x20\n            for slot_index, predicate in enumerate(group["predicates"]):\n                slot_start = group_start + slot_index * 8\n                slot_end = slot_start + 8\n                if (\n                    not isinstance(predicate, dict)\n                    or predicate.get("slot_index") != slot_index\n                    or predicate.get("file_range") != [slot_start, slot_end]\n                    or predicate.get("gba_range")\n                    != [GBA_ROM_BASE + slot_start, GBA_ROM_BASE + slot_end]\n                    or predicate.get("raw_hex") != rom[slot_start:slot_end].hex()\n                ):\n                    raise ValueError(\n                        f"battle condition predicate contract changed: {ordinal}/{group_index}/{slot_index}"\n                    )\n        prefix_sources.append((ordinal, battle_id, variant_index, prefix_range))\n        predicate_sources.append(\n            (ordinal, battle_id, variant_index, predicate_range)\n        )\n\n    if (\n        not isinstance(manifest, dict)\n        or manifest.get("schema") != "git-artifact-promotion-v1"\n        or manifest.get("artifact_schema") != BATTLE_CONDITION_RECORDS_BATCH\n        or manifest.get("artifact_status") != "accepted"\n        or manifest.get("files")\n        != {\n            BATTLE_CONDITION_RECORDS_BINARY_NAME: (\n                BATTLE_CONDITION_RECORDS_BINARY_SHA256\n            ),\n            BATTLE_CONDITION_RECORDS_PAYLOAD_NAME: (\n                BATTLE_CONDITION_RECORDS_PAYLOAD_SHA256\n            ),\n        }\n        or manifest.get("implementation") != expected_implementation\n        or manifest.get("rom") != expected_rom\n        or manifest.get("scope") != expected_scope\n    ):\n        raise ValueError("battle condition promotion manifest changed")\n\n    try:\n        report = verify_rom_battle_condition_records(root, artifact)\n    except Exception as error:\n        raise ValueError(\n            f"battle condition independent verification failed: {error}"\n        ) from error\n    expected_report = {\n        "schema": "rom-battle-condition-records-verification-v1",\n        "artifact_schema": BATTLE_CONDITION_RECORDS_BATCH,\n        "verified": True,\n        "errors": [],\n        "rom": expected_rom,\n        "table_file_range": list(BATTLE_CONDITION_RECORDS_RANGE),\n        "variant_count": 141,\n        "predicate_slot_count": 1_128,\n        "consumer_interpreter_verified": True,\n        "non_claims": expected_non_claims,\n        "scope": expected_scope,\n        "implementation": expected_implementation,\n    }\n    if report != expected_report:\n        raise ValueError(\n            f"battle condition independent verification failed: {report}"\n        )\n\n    occupied: list[list[int]] = []\n    for claim in baseline_claims:\n        if claim.get("role") != "primary":\n            continue\n        start, end = _validated_range(claim, len(rom))\n        start = max(start, table_start)\n        end = min(end, table_end)\n        if start < end:\n            occupied.append([start, end])\n    occupied.sort()\n    merged_occupied: list[list[int]] = []\n    for start, end in occupied:\n        if merged_occupied and start < merged_occupied[-1][1]:\n            raise ValueError("battle condition baseline primary claims overlap")\n        if merged_occupied and start == merged_occupied[-1][1]:\n            merged_occupied[-1][1] = end\n        else:\n            merged_occupied.append([start, end])\n    projected: list[list[int]] = []\n    cursor = table_start\n    for start, end in merged_occupied:\n        if cursor < start:\n            projected.append([cursor, start])\n        cursor = end\n    if cursor < table_end:\n        projected.append([cursor, table_end])\n    if projected != [list(value) for value in BATTLE_CONDITION_PROJECTED_UNKNOWN_RANGES]:\n        raise ValueError(f"battle condition unknown projection changed: {projected}")\n    if (\n        _sha256(compact_ranges(projected))\n        != BATTLE_CONDITION_PROJECTED_RANGE_SHA256\n        or _sha256(b"".join(rom[start:end] for start, end in projected))\n        != BATTLE_CONDITION_PROJECTED_BYTES_SHA256\n    ):\n        raise ValueError("battle condition unknown projection identity changed")\n\n    def fragments(\n        sources: list[tuple[int, int, int, list[int]]],\n    ) -> list[tuple[int, int, int, list[int], list[int]]]:\n        result = []\n        for ordinal, battle_id, variant_index, source_range in sources:\n            for unknown_start, unknown_end in projected:\n                start = max(source_range[0], unknown_start)\n                end = min(source_range[1], unknown_end)\n                if start < end:\n                    result.append(\n                        (\n                            ordinal,\n                            battle_id,\n                            variant_index,\n                            source_range,\n                            [start, end],\n                        )\n                    )\n        return result\n\n    prefix_fragments = fragments(prefix_sources)\n    predicate_fragments = fragments(predicate_sources)\n    prefix_ranges = [row[4] for row in prefix_fragments]\n    predicate_ranges = [row[4] for row in predicate_fragments]\n    combined_ranges = sorted(prefix_ranges + predicate_ranges)\n    if (\n        len(prefix_ranges) != 41\n        or sum(end - start for start, end in prefix_ranges) != 164\n        or _sha256(compact_ranges(prefix_ranges))\n        != BATTLE_CONDITION_PREFIX_FRAGMENT_RANGE_SHA256\n        or _sha256(b"".join(rom[start:end] for start, end in prefix_ranges))\n        != BATTLE_CONDITION_PREFIX_FRAGMENT_BYTES_SHA256\n    ):\n        raise ValueError("battle condition prefix fragment denominator changed")\n    if (\n        len(predicate_ranges) != 43\n        or sum(end - start for start, end in predicate_ranges) != 2_608\n        or _sha256(compact_ranges(predicate_ranges))\n        != BATTLE_CONDITION_PREDICATE_FRAGMENT_RANGE_SHA256\n        or _sha256(b"".join(rom[start:end] for start, end in predicate_ranges))\n        != BATTLE_CONDITION_PREDICATE_FRAGMENT_BYTES_SHA256\n    ):\n        raise ValueError("battle condition predicate fragment denominator changed")\n    if (\n        len(combined_ranges) != 84\n        or _sha256(compact_ranges(combined_ranges))\n        != BATTLE_CONDITION_COMBINED_FRAGMENT_RANGE_SHA256\n        or _sha256(b"".join(rom[start:end] for start, end in combined_ranges))\n        != BATTLE_CONDITION_PROJECTED_BYTES_SHA256\n    ):\n        raise ValueError("battle condition combined fragment denominator changed")\n\n    claims: list[dict[str, Any]] = []\n    for fragment_kind, primary_class, rows, range_sha, packed_sha in (\n        (\n            "raw_prefix",\n            BATTLE_CONDITION_PREFIX_PRIMARY_CLASS,\n            prefix_fragments,\n            BATTLE_CONDITION_PREFIX_FRAGMENT_RANGE_SHA256,\n            BATTLE_CONDITION_PREFIX_FRAGMENT_BYTES_SHA256,\n        ),\n        (\n            "predicate_payload",\n            BATTLE_CONDITION_PREDICATE_PRIMARY_CLASS,\n            predicate_fragments,\n            BATTLE_CONDITION_PREDICATE_FRAGMENT_RANGE_SHA256,\n            BATTLE_CONDITION_PREDICATE_FRAGMENT_BYTES_SHA256,\n        ),\n    ):\n        for ordinal, battle_id, variant_index, source_range, claim_range in rows:\n            start, end = claim_range\n            short_kind = "prefix" if fragment_kind == "raw_prefix" else "predicates"\n            claims.append(\n                {\n                    "id": (\n                        f"battle-condition-{short_kind}-b{battle_id:02d}-"\n                        f"v{variant_index}-{start:06x}"\n                    ),\n                    "range": claim_range,\n                    "source_range": source_range,\n                    "role": "primary",\n                    "primary_class": primary_class,\n                    "claim_kind": BATTLE_CONDITION_RECORDS_CLAIM_KIND,\n                    "promotion_batch": BATTLE_CONDITION_RECORDS_BATCH,\n                    "promoted_from_primary_class": "unknown",\n                    "baseline_unknown_only": True,\n                    "preserves_existing_primary_owners": True,\n                    "battle_id": battle_id,\n                    "variant_index": variant_index,\n                    "variant_ordinal": ordinal,\n                    "fragment_kind": fragment_kind,\n                    "bytes_sha256": _sha256(rom[start:end]),\n                    "fragment_range_denominator_sha256": range_sha,\n                    "fragment_bytes_denominator_sha256": packed_sha,\n                    "combined_fragment_range_denominator_sha256": (\n                        BATTLE_CONDITION_COMBINED_FRAGMENT_RANGE_SHA256\n                    ),\n                    "projected_unknown_range_denominator_sha256": (\n                        BATTLE_CONDITION_PROJECTED_RANGE_SHA256\n                    ),\n                    "projected_unknown_bytes_sha256": (\n                        BATTLE_CONDITION_PROJECTED_BYTES_SHA256\n                    ),\n                    "table_sha256": BATTLE_CONDITION_RECORDS_BINARY_SHA256,\n                    "evidence_path": (\n                        BATTLE_CONDITION_RECORDS_ARTIFACT\n                        / BATTLE_CONDITION_RECORDS_PAYLOAD_NAME\n                    ).as_posix(),\n                    "evidence_sha256": BATTLE_CONDITION_RECORDS_PAYLOAD_SHA256,\n                    "evidence_selector": f"/variants/{ordinal}",\n                    "binary_path": (\n                        BATTLE_CONDITION_RECORDS_ARTIFACT\n                        / BATTLE_CONDITION_RECORDS_BINARY_NAME\n                    ).as_posix(),\n                    "binary_sha256": BATTLE_CONDITION_RECORDS_BINARY_SHA256,\n                    "promotion_manifest_path": (\n                        BATTLE_CONDITION_RECORDS_ARTIFACT / "manifest.json"\n                    ).as_posix(),\n                    "promotion_manifest_sha256": (\n                        BATTLE_CONDITION_RECORDS_MANIFEST_SHA256\n                    ),\n                    "independent_verifier_path": (\n                        BATTLE_CONDITION_RECORDS_VERIFIER.as_posix()\n                    ),\n                    "independent_verifier_sha256": (\n                        BATTLE_CONDITION_RECORDS_VERIFIER_SHA256\n                    ),\n                    "non_claims": expected_non_claims,\n                    **expected_non_claims,\n                    "limitations": [\n                        "Only this exact current-unknown fragment of the frozen physical battle-condition table is classified; existing primary owners are preserved.",\n                        "Natural reachability, business field names, owner reclassification, the adjacent 144-byte zero range, editing, write-back, relocation, and free or allocatable space remain unclaimed.",\n                    ],\n                }\n            )\n    claims.sort(key=lambda claim: (claim["range"], claim["id"]))\n    return claims\n\n\ndef _cutscene_obj_palette_definition_alignment_gap_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote four verifier-bound palette/definition alignment gaps."""\n\n    root = Path(root).resolve(strict=True)\n    baseline_claims = list(existing_claims)\n    packet_rom_sha256 = (\n        "1198ece781aaf629db1f0c6628b4f9f1849ecc4a2eac6a55d32748c2a459d05b"\n    )\n    canonical_ranges = (\n        (0x12DEFA, 0x12DEFC),\n        (0x12E4