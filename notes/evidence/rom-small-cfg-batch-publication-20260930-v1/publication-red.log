e-text {label} uses a symlink")\n    if not artifact.is_dir() or any(path.is_symlink() for path in artifact.rglob("*")):\n        raise ValueError("profile-text artifact tree is unsafe")\n    if {\n        path.relative_to(artifact).as_posix()\n        for path in artifact.rglob("*")\n        if path.is_file()\n    } != {"manifest.json", payload_path.name, bundle_path.name}:\n        raise ValueError("profile-text artifact file denominator changed")\n    expected_hashes = (\n        (manifest_path, PROFILE_TEXT_MANIFEST_SHA256, "manifest"),\n        (payload_path, PROFILE_TEXT_PAYLOAD_SHA256, "payload"),\n        (bundle_path, PROFILE_TEXT_BUNDLE_SHA256, "bundle"),\n        (verifier_path, PROFILE_TEXT_VERIFIER_SHA256, "verifier"),\n    )\n    for path, digest, label in expected_hashes:\n        if _sha256_file(path) != digest:\n            raise ValueError(f"profile-text {label} changed")\n\n    manifest = json.loads(manifest_path.read_bytes())\n    payload = json.loads(payload_path.read_bytes())\n    bundle = bundle_path.read_bytes()\n    if (\n        manifest.get("schema")\n        != "rom-profile-text-inventory-v1-artifact-manifest-v1"\n        or manifest.get("artifact_schema") != "rom-profile-text-inventory-v1"\n        or manifest.get("files")\n        != {\n            payload_path.name: PROFILE_TEXT_PAYLOAD_SHA256,\n            bundle_path.name: PROFILE_TEXT_BUNDLE_SHA256,\n        }\n        or manifest.get("verification", {}).get("schema")\n        != "rom-profile-text-inventory-verification-v1"\n    ):\n        raise ValueError("profile-text manifest contract changed")\n    expected_summary = {\n        "pointer_table_count": 1,\n        "pointer_slot_count": 46,\n        "unique_target_count": 46,\n        "profile_text_record_count": 46,\n        "profile_text_bytes": 6_798,\n        "alignment_padding_range_count": 19,\n        "alignment_padding_bytes": 38,\n        "claimed_region_bytes": 6_836,\n        "parse_failure_count": 0,\n    }\n    if (\n        payload.get("schema") != "rom-profile-text-inventory-v1"\n        or payload.get("rom")\n        != {"path": ROM_PATH.as_posix(), "size": len(rom), "sha256": ROM_SHA256}\n        or payload.get("summary") != expected_summary\n        or payload.get("range_denominator_sha256")\n        != PROFILE_TEXT_RANGE_DENOMINATOR_SHA256\n        or payload.get("pointer_table")\n        != {\n            "range": [0x5A143C, 0x5A14F4],\n            "gba_range": ["0x085A143C", "0x085A14F4"],\n            "entry_count": 46,\n            "entry_size": 4,\n            "sha256": "e372c37fc5d41e2118ebee5feeb81967dd2f8413cc70d01ff7dc493197771410",\n            "pointer_vector_sha256": "e372c37fc5d41e2118ebee5feeb81967dd2f8413cc70d01ff7dc493197771410",\n        }\n        or payload.get("profile_region")\n        != {\n            "range": [0x59F988, 0x5A143C],\n            "gba_range": ["0x0859F988", "0x085A143C"],\n            "size": 6_836,\n            "sha256": PROFILE_TEXT_BUNDLE_SHA256,\n            "file": bundle_path.name,\n        }\n        or payload.get("implementation", {}).get("verifier")\n        != {\n            "path": PROFILE_TEXT_VERIFIER.as_posix(),\n            "sha256": PROFILE_TEXT_VERIFIER_SHA256,\n        }\n    ):\n        raise ValueError("profile-text payload denominator changed")\n    report = verify_rom_profile_text_inventory(root, artifact)\n    expected_report = {\n        "schema": "rom-profile-text-inventory-verification-v1",\n        "verified": True,\n        "errors": [],\n        **expected_summary,\n        "rom_sha256": ROM_SHA256,\n        "table_sha256": "e372c37fc5d41e2118ebee5feeb81967dd2f8413cc70d01ff7dc493197771410",\n        "region_sha256": PROFILE_TEXT_BUNDLE_SHA256,\n    }\n    if report != expected_report:\n        raise ValueError(f"profile-text independent verifier failed: {report}")\n    if bundle != rom[0x59F988:0x5A143C]:\n        raise ValueError("profile-text region bundle differs from ROM")\n\n    records = payload.get("records")\n    padding = payload.get("alignment_padding")\n    if not isinstance(records, list) or len(records) != 46:\n        raise ValueError("profile-text record denominator changed")\n    if not isinstance(padding, list) or len(padding) != 19:\n        raise ValueError("profile-text padding denominator changed")\n    claims: list[dict[str, Any]] = []\n    ranges: list[list[int]] = []\n    for index, record in enumerate(records):\n        if not isinstance(record, dict):\n            raise ValueError("profile-text record schema changed")\n        value = record.get("range")\n        region_range = record.get("region_range")\n        if (\n            record.get("record_id") != f"profile-text-{index:03d}"\n            or record.get("table_index") != index\n            or record.get("pointer_slot_offset") != 0x5A143C + index * 4\n            or not isinstance(value, list)\n            or len(value) != 2\n            or not all(isinstance(item, int) for item in value)\n            or not isinstance(region_range, list)\n            or len(region_range) != 2\n        ):\n            raise ValueError(f"profile-text record {index} schema changed")\n        start, end = value\n        region_start, region_end = region_range\n        if (\n            not 0x59F988 <= start < end <= 0x5A143C\n            or region_start != start - 0x59F988\n            or region_end != end - 0x59F988\n            or record.get("size") != end - start\n            or record.get("pointer_value") != f"0x{GBA_ROM_BASE + start:08X}"\n            or record.get("terminator") != 0\n            or rom[end - 1] != 0\n            or record.get("bytes_sha256") != _sha256(rom[start:end])\n            or bundle[region_start:region_end] != rom[start:end]\n        ):\n            raise ValueError(f"profile-text record bytes changed: {index}")\n        ranges.append(value)\n        claims.append(\n            {\n                "id": f"profile-text-record-{index:03d}-{start:06x}",\n                "range": value,\n                "role": "primary",\n                "primary_class": "profile_text_record",\n                "claim_kind": "profile_text_record_bytes",\n                "profile_id": index,\n                "bytes_sha256": record["bytes_sha256"],\n                "evidence_path": PROFILE_TEXT_PAYLOAD.as_posix(),\n                "evidence_sha256": PROFILE_TEXT_PAYLOAD_SHA256,\n                "evidence_selector": f"/records/{index}",\n                "promotion_manifest_path": (\n                    PROFILE_TEXT_ARTIFACT / "manifest.json"\n                ).as_posix(),\n                "promotion_manifest_sha256": PROFILE_TEXT_MANIFEST_SHA256,\n                "independent_verifier_path": PROFILE_TEXT_VERIFIER.as_posix(),\n                "independent_verifier_sha256": PROFILE_TEXT_VERIFIER_SHA256,\n                "limitations": [\n                    "The range is profile-reader-bounded game-encoded text, not a Unicode transcription."\n                ],\n            }\n        )\n    for index, item in enumerate(padding):\n        if not isinstance(item, dict):\n            raise ValueError("profile-text padding schema changed")\n        value = item.get("range")\n        region_range = item.get("region_range")\n        if (\n            item.get("padding_id")\n            != f"profile-alignment-{item.get(\'after_record_index\', -1):03d}"\n            or not isinstance(value, list)\n            or len(value) != 2\n            or not all(isinstance(boundary, int) for boundary in value)\n            or not isinstance(region_range, list)\n            or len(region_range) != 2\n        ):\n            raise ValueError(f"profile-text padding {index} schema changed")\n        start, end = value\n        region_start, region_end = region_range\n        if (\n            not 0x59F988 <= start < end <= 0x5A143C\n            or region_start != start - 0x59F988\n            or region_end != end - 0x59F988\n            or item.get("size") != end - start\n            or item.get("all_zero") is not True\n            or rom[start:end] != bytes(end - start)\n            or item.get("bytes_sha256") != _sha256(rom[start:end])\n            or bundle[region_start:region_end] != rom[start:end]\n        ):\n            raise ValueError(f"profile-text padding bytes changed: {index}")\n        ranges.append(value)\n        claims.append(\n            {\n                "id": f"profile-text-padding-{item[\'after_record_index\']:03d}-{start:06x}",\n                "range": value,\n                "role": "primary",\n                "primary_class": "profile_text_alignment_zero_padding",\n                "claim_kind": "profile_text_alignment_zero_padding",\n                "after_profile_id": item["after_record_index"],\n                "bytes_sha256": item["bytes_sha256"],\n                "evidence_path": PROFILE_TEXT_PAYLOAD.as_posix(),\n                "evidence_sha256": PROFILE_TEXT_PAYLOAD_SHA256,\n                "evidence_selector": f"/alignment_padding/{index}",\n                "promotion_manifest_path": (\n                    PROFILE_TEXT_ARTIFACT / "manifest.json"\n                ).as_posix(),\n                "promotion_manifest_sha256": PROFILE_TEXT_MANIFEST_SHA256,\n                "independent_verifier_path": PROFILE_TEXT_VERIFIER.as_posix(),\n                "independent_verifier_sha256": PROFILE_TEXT_VERIFIER_SHA256,\n                "limitations": [\n                    "Exact zero alignment padding between adjacent fixed profile records is not asserted to be free allocatable space."\n                ],\n            }\n        )\n    cursor = 0x59F988\n    for start, end in sorted(ranges):\n        if start != cursor:\n            raise ValueError("profile-text record and padding partition has a gap")\n        cursor = end\n    if cursor != 0x5A143C or len(claims) != 65:\n        raise ValueError("profile-text record and padding partition changed")\n    return claims\n\n\ndef _fixed_consumer_text_claims(\n    root: Path, rom: bytes\n) -> list[dict[str, Any]]:\n    """Classify eleven fixed pointer tables and parser-consumed targets."""\n\n    if _sha256(rom) != ROM_SHA256:\n        raise ValueError("fixed-consumer-text ROM SHA-256 changed")\n    artifact = (root / FIXED_CONSUMER_TEXT_ARTIFACT).absolute()\n    manifest_path = artifact / "manifest.json"\n    payload_path = (root / FIXED_CONSUMER_TEXT_PAYLOAD).absolute()\n    bundle_path = (root / FIXED_CONSUMER_TEXT_BUNDLE).absolute()\n    verifier_path = (root / FIXED_CONSUMER_TEXT_VERIFIER).absolute()\n    for path, label in (\n        (artifact, "artifact"),\n        (manifest_path, "manifest"),\n        (payload_path, "payload"),\n        (bundle_path, "bundle"),\n        (verifier_path, "verifier"),\n    ):\n        try:\n            resolved = path.resolve(strict=True)\n            resolved.relative_to(root)\n        except (OSError, ValueError) as error:\n            raise ValueError(f"fixed-consumer-text {label} is invalid") from error\n        if resolved != path or path.is_symlink():\n            raise ValueError(f"fixed-consumer-text {label} uses a symlink")\n    if not artifact.is_dir() or any(path.is_symlink() for path in artifact.rglob("*")):\n        raise ValueError("fixed-consumer-text artifact tree is unsafe")\n    if {\n        path.relative_to(artifact).as_posix()\n        for path in artifact.rglob("*")\n        if path.is_file()\n    } != {"manifest.json", payload_path.name, bundle_path.name}:\n        raise ValueError("fixed-consumer-text artifact file denominator changed")\n    for path, digest, label in (\n        (manifest_path, FIXED_CONSUMER_TEXT_MANIFEST_SHA256, "manifest"),\n        (payload_path, FIXED_CONSUMER_TEXT_PAYLOAD_SHA256, "payload"),\n        (bundle_path, FIXED_CONSUMER_TEXT_BUNDLE_SHA256, "bundle"),\n        (verifier_path, FIXED_CONSUMER_TEXT_VERIFIER_SHA256, "verifier"),\n    ):\n        if _sha256_file(path) != digest:\n            raise ValueError(f"fixed-consumer-text {label} changed")\n\n    manifest = json.loads(manifest_path.read_bytes())\n    payload = json.loads(payload_path.read_bytes())\n    bundle = bundle_path.read_bytes()\n    expected_summary = {\n        "pointer_table_count": 11,\n        "pointer_slot_count": 750,\n        "null_pointer_slot_count": 11,\n        "pointer_table_bytes": 3_000,\n        "unique_target_count": 735,\n        "renderer_record_count": 735,\n        "renderer_consumed_bytes": 11_177,\n        "classified_range_count": 746,\n        "classified_bytes": 14_177,\n        "range_overlap_bytes": 0,\n        "parse_failure_count": 0,\n        "packed_bytes": 14_177,\n    }\n    implementation = payload.get("implementation")\n    if (\n        manifest.get("schema")\n        != "rom-fixed-consumer-text-inventory-v1-artifact-manifest-v1"\n        or manifest.get("artifact_schema")\n        != "rom-fixed-consumer-text-inventory-v1"\n        or manifest.get("files")\n        != {\n            payload_path.name: FIXED_CONSUMER_TEXT_PAYLOAD_SHA256,\n            bundle_path.name: FIXED_CONSUMER_TEXT_BUNDLE_SHA256,\n        }\n        or manifest.get("producer") != implementation\n        or manifest.get("verification", {}).get("schema")\n        != "rom-fixed-consumer-text-inventory-verification-v1"\n        or manifest.get("verification", {}).get("verifier_sha256")\n        != FIXED_CONSUMER_TEXT_VERIFIER_SHA256\n    ):\n        raise ValueError("fixed-consumer-text manifest contract changed")\n    if (\n        payload.get("schema") != "rom-fixed-consumer-text-inventory-v1"\n        or payload.get("rom")\n        != {"path": ROM_PATH.as_posix(), "size": len(rom), "sha256": ROM_SHA256}\n        or payload.get("summary") != expected_summary\n        or payload.get("record_range_denominator_sha256")\n        != FIXED_CONSUMER_TEXT_RECORD_DENOMINATOR_SHA256\n        or payload.get("classified_range_denominator_sha256")\n        != FIXED_CONSUMER_TEXT_CLASSIFIED_DENOMINATOR_SHA256\n        or payload.get("files")\n        != {\n            bundle_path.name: {\n                "size": 14_177,\n                "sha256": FIXED_CONSUMER_TEXT_BUNDLE_SHA256,\n            }\n        }\n        or not isinstance(implementation, dict)\n        or implementation.get("verifier")\n        != {\n            "path": FIXED_CONSUMER_TEXT_VERIFIER.as_posix(),\n            "sha256": FIXED_CONSUMER_TEXT_VERIFIER_SHA256,\n        }\n    ):\n        raise ValueError("fixed-consumer-text payload denominator changed")\n    report = verify_rom_fixed_consumer_text_inventory(root, artifact)\n    expected_report = {\n        "schema": "rom-fixed-consumer-text-inventory-verification-v1",\n        "verified": True,\n        "errors": [],\n        **expected_summary,\n        "rom_sha256": ROM_SHA256,\n        "record_range_denominator_sha256": (\n            FIXED_CONSUMER_TEXT_RECORD_DENOMINATOR_SHA256\n        ),\n        "classified_range_denominator_sha256": (\n            FIXED_CONSUMER_TEXT_CLASSIFIED_DENOMINATOR_SHA256\n        ),\n        "bundle_sha256": FIXED_CONSUMER_TEXT_BUNDLE_SHA256,\n    }\n    if report != expected_report:\n        raise ValueError(\n            f"fixed-consumer-text independent verifier failed: {report}"\n        )\n\n    tables = payload.get("pointer_tables")\n    records = payload.get("records")\n    classified = payload.get("classified_ranges")\n    if not isinstance(tables, list) or len(tables) != 11:\n        raise ValueError("fixed-consumer-text table denominator changed")\n    if not isinstance(records, list) or len(records) != 735:\n        raise ValueError("fixed-consumer-text record denominator changed")\n    if not isinstance(classified, list) or len(classified) != 746:\n        raise ValueError("fixed-consumer-text classified denominator changed")\n    tables_by_id = {\n        table.get("table_id"): table\n        for table in tables\n        if isinstance(table, dict) and isinstance(table.get("table_id"), str)\n    }\n    records_by_id = {\n        record.get("record_id"): record\n        for record in records\n        if isinstance(record, dict) and isinstance(record.get("record_id"), str)\n    }\n    if len(tables_by_id) != 11 or len(records_by_id) != 735:\n        raise ValueError("fixed-consumer-text object IDs changed")\n\n    claims: list[dict[str, Any]] = []\n    semantic_ranges: list[list[int]] = []\n    packed_cursor = 0\n    previous_end = -1\n    table_count = 0\n    record_count = 0\n    for index, item in enumerate(classified):\n        if not isinstance(item, dict):\n            raise ValueError("fixed-consumer-text classified item changed")\n        value = item.get("range")\n        packed = item.get("packed_range")\n        if (\n            not isinstance(value, list)\n            or len(value) != 2\n            or not all(isinstance(boundary, int) for boundary in value)\n            or not isinstance(packed, list)\n            or len(packed) != 2\n            or not all(isinstance(boundary, int) for boundary in packed)\n        ):\n            raise ValueError(f"fixed-consumer-text range schema changed: {index}")\n        start, end = value\n        packed_start, packed_end = packed\n        raw = rom[start:end]\n        if (\n            not 0 <= start < end <= len(rom)\n            or start < previous_end\n            or packed_start != packed_cursor\n            or packed_end - packed_start != end - start\n            or item.get("size") != end - start\n            or item.get("sha256") != _sha256(raw)\n            or bundle[packed_start:packed_end] != raw\n        ):\n            raise ValueError(f"fixed-consumer-text bytes changed: {index}")\n        previous_end = end\n        packed_cursor = packed_end\n        semantic_ranges.append(value)\n        common = {\n            "range": value,\n            "role": "primary",\n            "bytes_sha256": item["sha256"],\n            "evidence_path": FIXED_CONSUMER_TEXT_PAYLOAD.as_posix(),\n            "evidence_sha256": FIXED_CONSUMER_TEXT_PAYLOAD_SHA256,\n            "evidence_selector": f"/classified_ranges/{index}",\n            "promotion_manifest_path": (\n                FIXED_CONSUMER_TEXT_ARTIFACT / "manifest.json"\n            ).as_posix(),\n            "promotion_manifest_sha256": (\n                FIXED_CONSUMER_TEXT_MANIFEST_SHA256\n            ),\n            "independent_verifier_path": (\n                FIXED_CONSUMER_TEXT_VERIFIER.as_posix()\n            ),\n            "independent_verifier_sha256": (\n                FIXED_CONSUMER_TEXT_VERIFIER_SHA256\n            ),\n        }\n        if item.get("kind") == "pointer_table":\n            table_count += 1\n            table_id = item.get("table_id")\n            table = tables_by_id.get(table_id)\n            if (\n                not isinstance(table, dict)\n                or item.get("range_id") != f"pointer-table-{table_id}"\n                or item.get("semantic_type") != table.get("semantic_type")\n                or value != table.get("range")\n                or item.get("sha256") != table.get("sha256")\n            ):\n                raise ValueError(f"fixed-consumer-text table item changed: {index}")\n            claims.append(\n                {\n                    "id": f"fixed-consumer-text-table-{table_id}-{start:06x}",\n                    **common,\n                    "primary_class": "fixed_consumer_text_pointer_table",\n                    "claim_kind": "fixed_consumer_text_pointer_table_bytes",\n                    "table_id": table_id,\n                    "semantic_type": item["semantic_type"],\n                    "limitations": [\n                        "The exact fixed pointer-table bytes are consumer-typed; runtime index bounds remain unproven."\n                    ],\n                }\n            )\n        elif item.get("kind") == "renderer_text_record":\n            record_count += 1\n            record_id = item.get("range_id")\n            record = records_by_id.get(record_id)\n            if (\n                not isinstance(record, dict)\n                or value != record.get("range")\n                or packed != record.get("packed_range")\n                or item.get("source_table_ids")\n                != [source.get("table_id") for source in record.get("sources", [])]\n                or item.get("sha256") != record.get("sha256")\n            ):\n                raise ValueError(f"fixed-consumer-text record item changed: {index}")\n            claims.append(\n                {\n                    "id": f"fixed-consumer-text-record-{record_id}-{start:06x}",\n                    **common,\n                    "primary_class": "fixed_consumer_renderer_text_record",\n                    "claim_kind": (\n                        "fixed_consumer_renderer_text_record_bytes"\n                    ),\n                    "record_id": record_id,\n                    "source_table_ids": item["source_table_ids"],\n                    "limitations": [\n                        "The range is renderer-parser-consumed game encoding, not a Unicode transcription or natural-runtime coverage claim."\n                    ],\n                }\n            )\n        else:\n            raise ValueError(f"fixed-consumer-text range kind changed: {index}")\n    if (\n        table_count != 11\n        or record_count != 735\n        or packed_cursor != len(bundle)\n        or len(bundle) != 14_177\n        or _sha256(\n            json.dumps(semantic_ranges, separators=(",", ":")).encode("ascii")\n        )\n        != FIXED_CONSUMER_TEXT_CLASSIFIED_DENOMINATOR_SHA256\n    ):\n        raise ValueError("fixed-consumer-text final denominator changed")\n    return claims\n\n\ndef _sjis_empty_lookup_row_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote only the five zero-valued rows at the frozen SJIS table tail."""\n\n    root = Path(root).resolve(strict=True)\n    baseline_claims = list(existing_claims)\n    if any(\n        claim.get("promotion_batch") == SJIS_EMPTY_LOOKUP_ROWS_BATCH\n        or claim.get("claim_kind") == SJIS_EMPTY_LOOKUP_ROWS_CLAIM_KIND\n        for claim in baseline_claims\n    ):\n        raise ValueError("SJIS empty lookup rows batch is already present")\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError("SJIS empty lookup rows ROM identity changed")\n\n    baseline_ranges: dict[str, tuple[int, int]] = {}\n    for claim in baseline_claims:\n        identifier = claim.get("id")\n        if not isinstance(identifier, str) or not identifier:\n            raise ValueError("SJIS empty lookup rows baseline claim ID changed")\n        if identifier in baseline_ranges:\n            raise ValueError("SJIS empty lookup rows baseline claim IDs are not unique")\n        role = claim.get("role")\n        if role not in {"primary", "secondary"}:\n            raise ValueError("SJIS empty lookup rows baseline claim role changed")\n        if role == "primary" and not isinstance(claim.get("primary_class"), str):\n            raise ValueError("SJIS empty lookup rows baseline primary class changed")\n        baseline_ranges[identifier] = _validated_range(claim, len(rom))\n\n    start, end = SJIS_EMPTY_LOOKUP_ROWS_RANGE\n    overlapping_primary_ids = [\n        claim["id"]\n        for claim in baseline_claims\n        if claim.get("role") == "primary"\n        and baseline_ranges[claim["id"]][0] < end\n        and start < baseline_ranges[claim["id"]][1]\n    ]\n    if overlapping_primary_ids:\n        raise ValueError(\n            "SJIS empty lookup rows range already has an existing primary claim: "\n            f"{overlapping_primary_ids}"\n        )\n    overlapping_secondary_ids = [\n        claim["id"]\n        for claim in baseline_claims\n        if claim.get("role") == "secondary"\n        and baseline_ranges[claim["id"]][0] < end\n        and start < baseline_ranges[claim["id"]][1]\n    ]\n    if overlapping_secondary_ids:\n        raise ValueError(\n            "SJIS empty lookup rows range is not an exact whole current unknown "\n            f"segment because secondary claims overlap: {overlapping_secondary_ids}"\n        )\n\n    expected_owner_claims = {\n        "dialogue-font-sjis-table": (\n            [0x53D644, 0x53D714],\n            "dialogue_font_sjis_table",\n        ),\n        "dialogue-font-byte-table": (\n            [0x53D73C, 0x53D74C],\n            "dialogue_font_byte_table",\n        ),\n    }\n    baseline_by_id = {claim["id"]: claim for claim in baseline_claims}\n    if any(\n        not isinstance(baseline_by_id.get(owner_id), dict)\n        or baseline_by_id[owner_id].get("range") != expected[0]\n        or baseline_by_id[owner_id].get("role") != "primary"\n        or baseline_by_id[owner_id].get("primary_class") != expected[1]\n        for owner_id, expected in expected_owner_claims.items()\n    ):\n        raise ValueError("SJIS empty lookup rows adjacent owner denominator changed")\n\n    previous_owner_range = [0x53D644, 0x53D714]\n    next_owner_range = [0x53D73C, 0x53D74C]\n    for owner_id, owner_range in (\n        ("dialogue-font-sjis-table", previous_owner_range),\n        ("dialogue-font-byte-table", next_owner_range),\n    ):\n        owner_start, owner_end = owner_range\n        overlapping_owner_ids = sorted(\n            identifier\n            for identifier, (claim_start, claim_end) in baseline_ranges.items()\n            if claim_start < owner_end and owner_start < claim_end\n        )\n        if overlapping_owner_ids != [owner_id]:\n            raise ValueError(\n                "SJIS empty lookup rows adjacent owner boundary changed: "\n                f"{owner_id} has {overlapping_owner_ids}"\n            )\n\n    fixed_artifact = (root / FIXED_CONSUMER_TEXT_ARTIFACT).absolute()\n    fixed_manifest_path = fixed_artifact / "manifest.json"\n    fixed_payload_path = (root / FIXED_CONSUMER_TEXT_PAYLOAD).absolute()\n    font_manifest_path = (\n        root / DIALOGUE_FONT_ARTIFACT / "manifest.json"\n    ).absolute()\n    for path, label in (\n        (fixed_manifest_path, "fixed-consumer-text manifest"),\n        (fixed_payload_path, "fixed-consumer-text payload"),\n        (font_manifest_path, "dialogue font manifest"),\n    ):\n        try:\n            raw = path.read_bytes()\n        except OSError as error:\n            raise ValueError(f"{label} is missing") from error\n        if b"rom-byte-coverage" in raw:\n            raise ValueError(f"{label} self-references coverage")\n\n    fixed_verifier_path = (root / FIXED_CONSUMER_TEXT_VERIFIER).absolute()\n    if (\n        _sha256(fixed_manifest_path.read_bytes())\n        != FIXED_CONSUMER_TEXT_MANIFEST_SHA256\n    ):\n        raise ValueError("fixed-consumer-text manifest changed")\n    if (\n        _sha256(fixed_payload_path.read_bytes())\n        != FIXED_CONSUMER_TEXT_PAYLOAD_SHA256\n    ):\n        raise ValueError("fixed-consumer-text payload changed")\n    if _sha256_file(fixed_verifier_path) != FIXED_CONSUMER_TEXT_VERIFIER_SHA256:\n        raise ValueError("fixed-consumer-text verifier changed")\n    if _sha256(font_manifest_path.read_bytes()) != DIALOGUE_FONT_MANIFEST_SHA256:\n        raise ValueError("dialogue font manifest SHA-256 changed")\n\n    _fixed_consumer_text_claims(root, rom)\n    fixed_payload_raw = fixed_payload_path.read_bytes()\n    try:\n        fixed_payload = json.loads(fixed_payload_raw)\n    except (TypeError, ValueError) as error:\n        raise ValueError("SJIS empty lookup rows fixed-consumer payload is invalid") from error\n\n    def select_payload(selector: str) -> object:\n        selected: object = fixed_payload\n        try:\n            for token in selector.lstrip("/").split("/"):\n                selected = (\n                    selected[int(token)]\n                    if isinstance(selected, list)\n                    else selected[token]  # type: ignore[index]\n                )\n        except (KeyError, IndexError, TypeError, ValueError) as error:\n            raise ValueError(\n                "SJIS empty lookup rows evidence selector is not parseable: "\n                f"{selector}"\n            ) from error\n        return selected\n\n    try:\n        lookup = select_payload(SJIS_EMPTY_LOOKUP_ROWS_EVIDENCE_SELECTORS[0])\n        range_table = select_payload(SJIS_EMPTY_LOOKUP_ROWS_EVIDENCE_SELECTORS[1])\n        renderer_parser = select_payload(\n            SJIS_EMPTY_LOOKUP_ROWS_EVIDENCE_SELECTORS[2]\n        )\n        renderer_grammar = select_payload(\n            SJIS_EMPTY_LOOKUP_ROWS_EVIDENCE_SELECTORS[3]\n        )\n    except ValueError:\n        raise\n    if (\n        not isinstance(lookup, dict)\n        or lookup.get("range") != list(SJIS_EMPTY_LOOKUP_ROWS_LOOKUP_RANGE)\n        or lookup.get("sha256") != SJIS_EMPTY_LOOKUP_ROWS_LOOKUP_SHA256\n        or not isinstance(range_table, dict)\n        or range_table.get("range")\n        != list(SJIS_EMPTY_LOOKUP_ROWS_FULL_TABLE_RANGE)\n        or range_table.get("entry_count") != 31\n        or range_table.get("entry_size") != 8\n        or range_table.get("sha256") != SJIS_EMPTY_LOOKUP_ROWS_FULL_TABLE_SHA256\n        or not isinstance(renderer_parser, dict)\n        or renderer_parser.get("range")\n        != list(SJIS_EMPTY_LOOKUP_ROWS_RENDERER_PARSER_RANGE)\n        or renderer_parser.get("sha256")\n        != SJIS_EMPTY_LOOKUP_ROWS_RENDERER_PARSER_SHA256\n        or not isinstance(renderer_grammar, dict)\n        or renderer_grammar.get("sjis_range_count") != 31\n        or renderer_grammar.get("sjis_entry_size") != 8\n        or renderer_grammar.get("sjis_lookup") != "0x08065E80"\n        or renderer_grammar.get("sjis_range_table") != "0x0853D644"\n    ):\n        raise ValueError("SJIS empty lookup rows evidence selector contract changed")\n\n    font_claims = _dialogue_font_claims(root, rom)\n    rebuilt_by_id = {claim.get("id"): claim for claim in font_claims}\n    owner_ids = ("dialogue-font