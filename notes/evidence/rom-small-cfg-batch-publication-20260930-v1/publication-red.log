erifier_path = _checked_repository_file(\n        root,\n        PREBATTLE_MENU_CONTROLLER_CFG_VERIFIER,\n        PREBATTLE_MENU_CONTROLLER_CFG_VERIFIER_SHA256,\n        label="pre-battle menu controller CFG verifier",\n    )\n    manifest_raw = manifest_path.read_bytes()\n    payload_raw = payload_path.read_bytes()\n    try:\n        manifest = json.loads(manifest_raw)\n        payload = json.loads(payload_raw)\n    except (UnicodeDecodeError, json.JSONDecodeError) as error:\n        raise ValueError("pre-battle menu controller CFG JSON is invalid") from error\n    if manifest_raw != _canonical_json_bytes(manifest) \\\n            or payload_raw != _canonical_json_bytes(payload):\n        raise ValueError("pre-battle menu controller CFG JSON is not canonical")\n    if manifest.get("schema") != "git-artifact-promotion-v1" \\\n            or manifest.get("artifact_schema") \\\n            != "rom-prebattle-menu-controller-cfg-v1" \\\n            or manifest.get("artifact_status") != "accepted" \\\n            or manifest.get("files") != {\n                PREBATTLE_MENU_CONTROLLER_CFG_PAYLOAD: {\n                    "sha256": PREBATTLE_MENU_CONTROLLER_CFG_PAYLOAD_SHA256,\n                    "size": PREBATTLE_MENU_CONTROLLER_CFG_PAYLOAD_SIZE,\n                }\n            }:\n        raise ValueError("pre-battle menu controller CFG manifest changed")\n    report = verify_artifact(root, artifact)\n    if report.get("verified") is not True \\\n            or report.get("promotion_bytes") != 1_920:\n        raise ValueError(\n            "pre-battle menu controller CFG independent verification failed: "\n            f"{report}"\n        )\n    promotion = payload.get("promotion")\n    if not isinstance(promotion, dict):\n        raise ValueError("pre-battle menu controller CFG promotion changed")\n    code_ranges = promotion.get("code_ranges")\n    literal_ranges = promotion.get("literal_ranges")\n    table_range = promotion.get("jump_table_range")\n    if not isinstance(code_ranges, list) or len(code_ranges) != 27 \\\n            or not isinstance(literal_ranges, list) or len(literal_ranges) != 24 \\\n            or not isinstance(table_range, list) or len(table_range) != 2 \\\n            or promotion.get("code_bytes") != 1_564 \\\n            or promotion.get("literal_bytes") != 332 \\\n            or promotion.get("jump_table_bytes") != 24 \\\n            or promotion.get("promotion_bytes") != 1_920:\n        raise ValueError("pre-battle menu controller CFG promotion changed")\n    records = [\n        ("code", index, value)\n        for index, value in enumerate(code_ranges)\n    ] + [\n        ("literal", index, value)\n        for index, value in enumerate(literal_ranges)\n    ] + [("jump-table", 0, table_range)]\n    _require_current_unknown_ranges(\n        len(rom),\n        existing_claims,\n        [value for _, _, value in records],\n        label="pre-battle menu controller CFG",\n    )\n    semantics = {\n        "code": (\n            "armv4t_prebattle_menu_controller_reachable_thumb_code",\n            "prebattle_menu_controller_reachable_instruction_bytes",\n            "thumb",\n        ),\n        "literal": (\n            "armv4t_prebattle_menu_controller_consumed_literal_word",\n            "prebattle_menu_controller_consumed_literal_word_bytes",\n            None,\n        ),\n        "jump-table": (\n            "prebattle_menu_controller_fixed_jump_table",\n            "prebattle_menu_controller_fixed_jump_table_bytes",\n            None,\n        ),\n    }\n    evidence_path = (\n        PREBATTLE_MENU_CONTROLLER_CFG_ARTIFACT\n        / PREBATTLE_MENU_CONTROLLER_CFG_PAYLOAD\n    ).as_posix()\n    report_sha = _sha256(_canonical_json_bytes(report))\n    claims = []\n    for family, index, value in records:\n        start, end = value\n        primary_class, claim_kind, mode = semantics[family]\n        selector = (\n            f"/promotion/{\'jump_table_range\' if family == \'jump-table\' else family + \'_ranges\'}"\n            + ("" if family == "jump-table" else f"/{index}")\n        )\n        claims.append({\n            "id": f"prebattle-menu-controller-{family}-{index:02d}-{start:06x}",\n            "range": [start, end],\n            "role": "primary",\n            "primary_class": primary_class,\n            "claim_kind": claim_kind,\n            "mode": mode,\n            "promotion_batch": "rom-prebattle-menu-controller-cfg-v1",\n            "promoted_from_primary_class": "unknown",\n            "baseline_unknown_only": True,\n            "current_unknown_verified_by_auditor": True,\n            "coverage_projection_gate": "current_unknown_before_projection",\n            "bytes_sha256": _sha256(rom[start:end]),\n            "evidence_path": evidence_path,\n            "evidence_sha256": PREBATTLE_MENU_CONTROLLER_CFG_PAYLOAD_SHA256,\n            "evidence_selector": selector,\n            "promotion_manifest_path": (\n                PREBATTLE_MENU_CONTROLLER_CFG_ARTIFACT / "manifest.json"\n            ).as_posix(),\n            "promotion_manifest_sha256": (\n                PREBATTLE_MENU_CONTROLLER_CFG_MANIFEST_SHA256\n            ),\n            "independent_verifier_path": verifier_path.relative_to(root).as_posix(),\n            "independent_verifier_sha256": (\n                PREBATTLE_MENU_CONTROLLER_CFG_VERIFIER_SHA256\n            ),\n            "independent_verifier_report_sha256": report_sha,\n            "root_producer_denominator_verified": True,\n            "selector_jump_table_verified": True,\n            "opaque_call_target_ownership_verified": True,\n            "runtime_reachability_claimed": False,\n            "global_code_map_claimed": False,\n            "indirect_frontier_resolution_complete": False,\n            "loaded_value_semantics_claimed": False,\n            "editing_writeback_relocation_safe_claimed": False,\n            "free_or_allocatable_space_claimed": False,\n        })\n    claims.sort(key=lambda claim: (claim["range"], claim["id"]))\n    if len(claims) != 52 \\\n            or sum(end - start for claim in claims\n                   for start, end in [claim["range"]]) != 1_920 \\\n            or any(left["range"][1] > right["range"][0]\n                   for left, right in zip(claims, claims[1:])):\n        raise ValueError("pre-battle menu controller CFG accounting changed")\n    return claims\n\n\ndef _scene_source_closure_claims(root, rom, existing_claims):\n    """Project the frozen parser/OBJ source closures without a full audit."""\n\n    from tools.verify_rom_scene_source_closures import verify_artifact\n\n    root = Path(root).resolve(strict=True)\n    artifact = _checked_artifact_directory(\n        root,\n        SCENE_SOURCE_CLOSURES_ARTIFACT,\n        {"manifest.json", SCENE_SOURCE_CLOSURES_PAYLOAD},\n        label="scene source closures artifact",\n    )\n    manifest_path = _checked_repository_file(\n        root,\n        SCENE_SOURCE_CLOSURES_ARTIFACT / "manifest.json",\n        SCENE_SOURCE_CLOSURES_MANIFEST_SHA256,\n        expected_size=SCENE_SOURCE_CLOSURES_MANIFEST_SIZE,\n        label="scene source closures manifest",\n    )\n    payload_path = _checked_repository_file(\n        root,\n        SCENE_SOURCE_CLOSURES_ARTIFACT / SCENE_SOURCE_CLOSURES_PAYLOAD,\n        SCENE_SOURCE_CLOSURES_PAYLOAD_SHA256,\n        expected_size=SCENE_SOURCE_CLOSURES_PAYLOAD_SIZE,\n        label="scene source closures payload",\n    )\n    verifier_path = _checked_repository_file(\n        root,\n        SCENE_SOURCE_CLOSURES_VERIFIER,\n        SCENE_SOURCE_CLOSURES_VERIFIER_SHA256,\n        label="scene source closures verifier",\n    )\n    manifest_raw = manifest_path.read_bytes()\n    payload_raw = payload_path.read_bytes()\n    try:\n        manifest = json.loads(manifest_raw)\n        payload = json.loads(payload_raw)\n    except (UnicodeDecodeError, json.JSONDecodeError) as error:\n        raise ValueError("scene source closures JSON is invalid") from error\n    if manifest_raw != _canonical_json_bytes(manifest) \\\n            or payload_raw != _canonical_json_bytes(payload):\n        raise ValueError("scene source closures JSON is not canonical")\n    if manifest.get("schema") != "git-artifact-promotion-v1" \\\n            or manifest.get("artifact_schema") != "rom-scene-source-closures-v1" \\\n            or manifest.get("artifact_status") != "accepted" \\\n            or manifest.get("canonical_destination") \\\n            != SCENE_SOURCE_CLOSURES_ARTIFACT.as_posix() \\\n            or manifest.get("files") != {\n                SCENE_SOURCE_CLOSURES_PAYLOAD: {\n                    "sha256": SCENE_SOURCE_CLOSURES_PAYLOAD_SHA256,\n                    "size": SCENE_SOURCE_CLOSURES_PAYLOAD_SIZE,\n                }\n            }:\n        raise ValueError("scene source closures manifest changed")\n    report = verify_artifact(root, artifact)\n    if report.get("verified") is not True \\\n            or report.get("promotion_bytes") != 1_015 \\\n            or report.get("promotion_claim_count") != 73:\n        raise ValueError(\n            "scene source closures independent verification failed: "\n            f"{report}"\n        )\n    promotion = payload.get("promotion")\n    records = promotion.get("claims") if isinstance(promotion, dict) else None\n    if not isinstance(records, list) or len(records) != 73 \\\n            or promotion.get("bytes") != 1_015 \\\n            or promotion.get("obj_claim_count") != 2 \\\n            or promotion.get("obj_bytes") != 360 \\\n            or promotion.get("source_claim_count") != 71 \\\n            or promotion.get("source_bytes") != 655:\n        raise ValueError("scene source closures promotion changed")\n    allowed = {\n        "scene_obj_source_closure": "scene_obj_source_closure_bytes",\n        "parser_bound_scene_source_record": (\n            "parser_bound_scene_source_record_bytes"\n        ),\n    }\n    candidate_ranges = []\n    for index, record in enumerate(records):\n        if not isinstance(record, dict):\n            raise ValueError("scene source closures claim changed")\n        start, end = record.get("range", [None, None])\n        primary_class = record.get("primary_class")\n        if record.get("kind") != primary_class \\\n                or primary_class not in allowed \\\n                or record.get("baseline_unknown_only") is not True \\\n                or record.get("bytes_sha256") != _sha256(rom[start:end]) \\\n                or not isinstance(record.get("id"), str) \\\n                or not isinstance(start, int) or not isinstance(end, int) \\\n                or not 0 <= start < end <= len(rom):\n            raise ValueError(\n                f"scene source closures claim {index} changed"\n            )\n        candidate_ranges.append([start, end])\n    _require_current_unknown_ranges(\n        len(rom), existing_claims, candidate_ranges,\n        label="scene source closures",\n    )\n    evidence_path = (\n        SCENE_SOURCE_CLOSURES_ARTIFACT / SCENE_SOURCE_CLOSURES_PAYLOAD\n    ).as_posix()\n    report_sha = _sha256(_canonical_json_bytes(report))\n    claims = []\n    for index, record in enumerate(records):\n        start, end = record["range"]\n        primary_class = record["primary_class"]\n        claims.append({\n            "id": f"scene-source-closure-{index:02d}-{start:06x}",\n            "range": [start, end],\n            "role": "primary",\n            "primary_class": primary_class,\n            "claim_kind": allowed[primary_class],\n            "promotion_batch": "rom-scene-source-closures-v1",\n            "promoted_from_primary_class": "unknown",\n            "baseline_unknown_only": True,\n            "current_unknown_verified_by_auditor": True,\n            "coverage_projection_gate": "current_unknown_before_projection",\n            "bytes_sha256": record["bytes_sha256"],\n            "evidence_path": evidence_path,\n            "evidence_sha256": SCENE_SOURCE_CLOSURES_PAYLO