  environment = os.environ.copy()\n    for name in ("PYTHONPATH", "PYTHONHOME", "LIBCAPSTONE_PATH"):\n        environment.pop(name, None)\n    completed = subprocess.run(\n        command,\n        cwd=root,\n        env=environment,\n        input=wrapper_source,\n        capture_output=True,\n        check=False,\n        timeout=300,\n    )\n    try:\n        stdout = completed.stdout.decode("utf-8")\n        stderr = completed.stderr.decode("utf-8")\n        report = json.loads(stdout)\n    except (UnicodeDecodeError, json.JSONDecodeError) as error:\n        raise ValueError("v15 isolated verifier output is not JSON") from error\n    if not isinstance(report, dict):\n        raise ValueError("v15 isolated verifier report is not an object")\n    if stderr:\n        raise ValueError("v15 isolated verifier emitted stderr")\n    if completed.returncode not in {0, 1}:\n        raise ValueError(\n            f"v15 isolated verifier exited unexpectedly: {completed.returncode}"\n        )\n    return report\n\n\ndef _cfg_proven_roots_v15_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote only the ten frozen v15 semantic code/literal ranges."""\n\n    root = Path(root).resolve(strict=True)\n    baseline = list(existing_claims)\n    if any(\n        claim.get("promotion_batch") == CFG_PROVEN_ROOTS_V15_BATCH\n        or claim.get("claim_kind")\n        in {CFG_PROVEN_ROOTS_V15_CODE_KIND, CFG_PROVEN_ROOTS_V15_LITERAL_KIND}\n        for claim in baseline\n    ):\n        raise ValueError("v15 claims require a pre-v15 baseline; batch is already present")\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError("v15 ROM identity changed")\n\n    artifact = _checked_artifact_directory(\n        root,\n        CFG_PROVEN_ROOTS_V15_ARTIFACT,\n        {"manifest.json", CFG_PROVEN_ROOTS_V15_PAYLOAD_NAME},\n        label="v15 artifact",\n    )\n    verifier = _checked_repository_file(\n        root,\n        CFG_PROVEN_ROOTS_V15_VERIFIER,\n        CFG_PROVEN_ROOTS_V15_VERIFIER_SHA256,\n        label="v15 verifier",\n    )\n    bundle_verifier = _checked_repository_file(\n        root,\n        CFG_PROVEN_ROOTS_V15_BUNDLE_VERIFIER,\n        CFG_PROVEN_ROOTS_V15_BUNDLE_VERIFIER_SHA256,\n        label="v15 bundle verifier",\n    )\n    bundle_verifier_source = bundle_verifier.read_bytes()\n    manifest_raw = (artifact / "manifest.json").read_bytes()\n    payload_raw = (artifact / CFG_PROVEN_ROOTS_V15_PAYLOAD_NAME).read_bytes()\n    if (\n        len(manifest_raw) != CFG_PROVEN_ROOTS_V15_MANIFEST_SIZE\n        or _sha256(manifest_raw) != CFG_PROVEN_ROOTS_V15_MANIFEST_SHA256\n        or len(payload_raw) != CFG_PROVEN_ROOTS_V15_PAYLOAD_SIZE\n        or _sha256(payload_raw) != CFG_PROVEN_ROOTS_V15_PAYLOAD_SHA256\n    ):\n        raise ValueError("v15 artifact identity changed")\n    try:\n        manifest = json.loads(manifest_raw)\n        payload = json.loads(payload_raw)\n    except json.JSONDecodeError as error:\n        raise ValueError("v15 artifact JSON is invalid") from error\n    if (\n        manifest_raw != _canonical_json_bytes(manifest)\n        or payload_raw != _canonical_json_bytes(payload)\n    ):\n        raise ValueError("v15 artifact JSON is not canonical")\n\n    report = _run_cfg_proven_roots_v15_bundle_verifier(\n        root,\n        bundle_verifier_source,\n        bundle_verifier,\n    )\n    if report != CFG_PROVEN_ROOTS_V15_BUNDLE_EXPECTED_REPORT:\n        raise ValueError(f"v15 independent verification failed: {report}")\n\n    expected_rom = {\n        "path": ROM_PATH.as_posix(),\n        "size": len(rom),\n        "sha256": ROM_SHA256,\n    }\n    expected_files = {\n        CFG_PROVEN_ROOTS_V15_PAYLOAD_NAME: {\n            "size": CFG_PROVEN_ROOTS_V15_PAYLOAD_SIZE,\n            "sha256": CFG_PROVEN_ROOTS_V15_PAYLOAD_SHA256,\n        }\n    }\n    mirrored_fields = (\n        "excluded_source_candidate",\n        "implementation",\n        "promotion",\n        "rejected_targets",\n        "rom",\n        "scope",\n        "source_membership",\n        "targets",\n        "upstream",\n    )\n    if (\n        set(manifest) != CFG_PROVEN_ROOTS_V15_MANIFEST_KEYS\n        or manifest.get("schema") != "git-artifact-promotion-v1"\n        or manifest.get("artifact_schema") != "rom-cfg-proven-roots-v15"\n        or manifest.get("artifact_status") != "accepted"\n        or manifest.get("rom") != expected_rom\n        or manifest.get("files") != expected_files\n        or any(manifest.get(field) != payload.get(field) for field in mirrored_fields)\n    ):\n        raise ValueError("v15 promotion manifest contract changed")\n    implementation = payload.get("implementation")\n    if (\n        payload.get("schema") != "rom-cfg-proven-roots-v15"\n        or payload.get("artifact_relative_path")\n        != CFG_PROVEN_ROOTS_V15_ARTIFACT.as_posix()\n        or payload.get("rom") != expected_rom\n        or not isinstance(implementation, dict)\n        or implementation.get("verifier_sha256")\n        != CFG_PROVEN_ROOTS_V15_VERIFIER_SHA256\n        or implementation.get("bundle_verifier_sha256")\n        != CFG_PROVEN_ROOTS_V15_BUNDLE_VERIFIER_SHA256\n    ):\n        raise ValueError("v15 payload contract changed")\n\n    verifier_receipt = manifest.get("verifier")\n    producer_receipt = manifest.get("producer")\n    if (\n        not isinstance(verifier_receipt, dict)\n        or verifier_receipt.get("schema")\n        != "rom-cfg-proven-roots-v15-verification-v1"\n        or verifier_receipt.get("verifier_sha256")\n        != CFG_PROVEN_ROOTS_V15_VERIFIER_SHA256\n        or verifier_receipt.get("exit_code") != 0\n        or verifier_receipt.get("report") != CFG_PROVEN_ROOTS_V15_EXPECTED_REPORT\n        or verifier_receipt.get("command")\n        != [\n            "python3",\n            "-I",\n            "-S",\n            CFG_PROVEN_ROOTS_V15_VERIFIER.as_posix(),\n            "--root",\n            ".",\n            "--artifact-dir",\n            CFG_PROVEN_ROOTS_V15_ARTIFACT.as_posix(),\n        ]\n        or not isinstance(producer_receipt, dict)\n        or producer_receipt.get("implementation") != implementation\n        or producer_receipt.get("command")\n        != [\n            "python3",\n            "-I",\n            "-S",\n            "tools/export_rom_cfg_proven_roots_v15.py",\n            "--root",\n            ".",\n            "--output-dir",\n            CFG_PROVEN_ROOTS_V15_ARTIFACT.as_posix(),\n        ]\n    ):\n        raise ValueError("v15 accepted verifier receipt contract changed")\n\n    targets = payload.get("targets")\n    rejected_targets = payload.get("rejected_targets")\n    promotion = payload.get("promotion")\n    expected_target_code_ranges = [\n        [[0x09A3E0, 0x09A422]],\n        [[0x0611F4, 0x06123A], [0x061250, 0x061276]],\n        [[0x0618FC, 0x061920], [0x061924, 0x061936]],\n        [[0x08B6F0, 0x08B79A]],\n    ]\n    expected_target_literal_ranges = [\n        [[0x09A424, 0x09A42C]],\n        [[0x06123C, 0x061250], [0x061278, 0x06128C]],\n        [[0x061920, 0x061924]],\n        [],\n    ]\n    expected_target_holes = [\n        [[0x09A422, 0x09A424]],\n        [\n            [0x06123A, 0x06123C],\n            [0x061276, 0x061278],\n            [0x06128C, 0x0612BC],\n        ],\n        [[0x061936, 0x061A80]],\n        [[0x08B79A, 0x08B79C]],\n    ]\n    if (\n        not isinstance(targets, list)\n        or len(targets) != 4\n        or [target.get("root") for target in targets]\n        != [0x09A3E0, 0x0611F4, 0x0618FC, 0x08B6F0]\n        or any(target.get("accepted") is not True for target in targets)\n        or [target.get("code_ranges") for target in targets]\n        != expected_target_code_ranges\n        or [\n            target.get("literal_projection", {}).get("literal_only_ranges")\n            for target in targets\n        ]\n        != expected_target_literal_ranges\n        or [target.get("holes") for target in targets] != expected_target_holes\n        or [len(target.get("producer_membership", [])) for target in targets]\n        != [1, 1, 1, 1]\n        or not isinstance(rejected_targets, list)\n        or len(rejected_targets) != 1\n        or rejected_targets[0].get("root") != 0x09C0F4\n        or rejected_targets[0].get("accepted") is not False\n        or rejected_targets[0].get("envelope")\n        != CFG_PROVEN_ROOTS_V15_REJECTED_RANGE\n        or set(rejected_targets[0].get("reasons", []))\n        != {"literal_code_overlap", "unbound_raw_thumb_bl_match"}\n        or not isinstance(promotion, dict)\n        or promotion.get("batch") != CFG_PROVEN_ROOTS_V15_BATCH\n        or promotion.get("accepted_roots")\n        != [0x09A3E0, 0x0611F4, 0x0618FC, 0x08B6F0]\n        or promotion.get("rejected_roots") != [0x09C0F4]\n        or promotion.get("semantic_ranges")\n        != CFG_PROVEN_ROOTS_V15_SEMANTIC_RANGES\n        or promotion.get("union_ranges") != CFG_PROVEN_ROOTS_V15_UNION_RANGES\n        or promotion.get("ranges") != CFG_PROVEN_ROOTS_V15_UNION_RANGES\n        or promotion.get("semantic_range_count") != 10\n        or promotion.get("promotion_union_range_count") != 7\n        or promotion.get("promotion_range_count") != 10\n        or promotion.get("promotion_bytes") != 450\n        or promotion.get("promotion_code_bytes") != 398\n        or promotion.get("promotion_literal_bytes") != 52\n        or promotion.get("preserved_unknown_hole_bytes") != 386\n        or promotion.get("semantic_range_vector_sha256")\n        != CFG_PROVEN_ROOTS_V15_EXPECTED_REPORT["semantic_range_vector_sha256"]\n        or promotion.get("union_range_vector_sha256")\n        != CFG_PROVEN_ROOTS_V15_EXPECTED_REPORT["union_range_vector_sha256"]\n        or promotion.get("packed_sha256")\n        != CFG_PROVEN_ROOTS_V15_EXPECTED_REPORT["promotion_packed_sha256"]\n    ):\n        raise ValueError("v15 promotion denominator changed")\n\n    baseline_segments = atomize_claims(len(rom), baseline)\n    unknown_ranges = [\n        tuple(segment["range"])\n        for segment in baseline_segments\n        if segment.get("primary_class") == "unknown"\n    ]\n    known_ranges = [\n        tuple(segment["range"])\n        for segment in baseline_segments\n        if segment.get("primary_class") != "unknown"\n    ]\n    allowed_ranges = {\n        tuple(interval) for interval in CFG_PROVEN_ROOTS_V15_SEMANTIC_RANGES\n    }\n\n    def require_unknown(start: int, end: int) -> None:\n        if (start, end) not in allowed_ranges:\n            raise ValueError("v15 claim is outside the semantic promotion denominator")\n        if any(\n            start < known_end and known_start < end\n            for known_start, known_end in known_ranges\n        ):\n            raise ValueError("v15 claim overlaps current known bytes")\n        if not any(left <= start and end <= right for left, right in unknown_ranges):\n            raise ValueError("v15 claim is not fully current unknown")\n\n    nonclaims = payload.get("scope", {}).get("nonclaims")\n    if (\n        not isinstance(nonclaims, list)\n        or len(nonclaims) != 8\n        or set(nonclaims) != set(CFG_PROVEN_ROOTS_V15_NONCLAIMS)\n    ):\n        raise ValueError("v15 nonclaim denominator changed")\n    limitations = [\n        "Only ten frozen semantic ranges from four accepted Thumb roots are classified: six reachable-code ranges and four consumed-literal ranges.",\n        "The rejected root at 0x09C0F4, all six accepted-envelope holes, and all adjacent bytes remain unknown.",\n        "The three indirect-PC frontiers and two external calls remain opaque; producer instructions are provenance only and are not re-claimed.",\n        "Natural execution, global denominators, BIOS or callee semantics, literal business meaning, editing, relocation and free-space safety are not claimed.",\n    ]\n    evidence_path = (\n        CFG_PROVEN_ROOTS_V15_ARTIFACT / CFG_PROVEN_ROOTS_V15_PAYLOAD_NAME\n    ).as_posix()\n    manifest_evidence_path = (\n        CFG_PROVEN_ROOTS_V15_ARTIFACT / "manifest.json"\n    ).as_posix()\n    claims: list[dict[str, Any]] = []\n    for target_index, target in enumerate(targets):\n        denominator = target.get("producer_denominator", {}).get("vector", [])\n        memberships = target.get("producer_membership", [])\n        for range_index, code_range in enumerate(target["code_ranges"]):\n            start, end = code_range\n            require_unknown(start, end)\n            claims.append(\n                {\n                    "id": (\n                        "cfg-proven-roots-v15-thumb-"\n                        f"{target_index:04d}-{range_index:02d}-{start:06x}"\n                    ),\n                    "range": [start, end],\n                    "role": "primary",\n                    "primary_class": CFG_PROVEN_ROOTS_V15_CODE_CLASS,\n                    "claim_kind": CFG_PROVEN_ROOTS_V15_CODE_KIND,\n                    "mode": "thumb",\n                    "fixed_root_count": 4,\n                    "target_root_file_offset": target["root"],\n                    "raw_target_producer_count": len(denominator),\n                    "accepted_target_producer_count": len(memberships),\n                    "source_block_count": target["decoded_basic_block_count"],\n                    "source_instruction_count": target["decoded_instruction_count"],\n                    "promoted_from_primary_class": "unknown",\n                    "runtime_reachability_claimed": False,\n                    "global_code_map_claimed": False,\n                    "bytes_sha256": _sha256(rom[start:end]),\n                    "evidence_path": evidence_path,\n                    "evidence_sha256": CFG_PROVEN_ROOTS_V15_PAYLOAD_SHA256,\n                    "evidence_selector": (\n                        f"/targets/{target_index}/code_ranges/{range_index}"\n                    ),\n                    "promotion_manifest_path": manifest_evidence_path,\n                    "promotion_manifest_sha256": (\n                        CFG_PROVEN_ROOTS_V15_MANIFEST_SHA256\n                    ),\n                    "independent_verifier_path": (\n                        CFG_PROVEN_ROOTS_V15_BUNDLE_VERIFIER.as_posix()\n                    ),\n                    "independent_verifier_sha256": (\n                        CFG_PROVEN_ROOTS_V15_BUNDLE_VERIFIER_SHA256\n                    ),\n                    "promotion_batch": CFG_PROVEN_ROOTS_V15_BATCH,\n                    "nonclaims": nonclaims,\n                    "limitations": limitations,\n                }\n            )\n        literal_projection = target.get("literal_projection", {})\n        bindings = literal_projection.get("bindings", [])\n        for range_index, literal_range in enumerate(\n            literal_projection["literal_only_ranges"]\n        ):\n            start, end = literal_range\n            require_unknown(start, end)\n            claims.append(\n                {\n                    "id": (\n                        "cfg-proven-roots-v15-literal-"\n                        f"{target_index:04d}-{range_index:02d}-{start:06x}"\n                    ),\n                    "range": [start, end],\n                    "role": "primary",\n                    "primary_class": CFG_PROVEN_ROOTS_V15_LITERAL_CLASS,\n                    "claim_kind": CFG_PROVEN_ROOTS_V15_LITERAL_KIND,\n                    "target_root_file_offset": target["root"],\n                    "literal_reference_count": sum(\n                        start <= binding[1] < end for binding in bindings\n                    ),\n                    "promoted_from_primary_class": "unknown",\n                    "runtime_reachability_claimed": False,\n                    "global_code_map_claimed": False,\n                    "bytes_sha256": _sha256(rom[start:end]),\n                    "evidence_path": evidence_path,\n                    "evidence_sha256": CFG_PROVEN_ROOTS_V15_PAYLOAD_SHA256,\n                    "evidence_selector": (\n                        f"/targets/{target_index}/literal_projection/"\n                        f"literal_only_ranges/{range_index}"\n                    ),\n                    "promotion_manifest_path": manifest_evidence_path,\n                    "promotion_manifest_sha256": (\n                        CFG_PROVEN_ROOTS_V15_MANIFEST_SHA256\n                    ),\n                    "independent_verifier_path": (\n                        CFG_PROVEN_ROOTS_V15_BUNDLE_VERIFIER.as_posix()\n                    ),\n                    "independent_verifier_sha256": (\n                        CFG_PROVEN_ROOTS_V15_BUNDLE_VERIFIER_SHA256\n                    ),\n                    "promotion_batch": CFG_PROVEN_ROOTS_V15_BATCH,\n                    "nonclaims": nonclaims,\n                    "limitations": limitations,\n                }\n            )\n    claims.sort(key=lambda claim: claim["range"])\n    forbidden_ranges = [\n        *CFG_PROVEN_ROOTS_V15_HOLES,\n        CFG_PROVEN_ROOTS_V15_REJECTED_RANGE,\n    ]\n    if (\n        len(claims) != 10\n        or [claim["range"] for claim in claims]\n        != CFG_PROVEN_ROOTS_V15_SEMANTIC_RANGES\n        or sum(claim["range"][1] - claim["range"][0] for claim in claims) != 450\n        or sum(\n            claim["range"][1] - claim["range"][0]\n            for claim in claims\n            if claim["claim_kind"] == CFG_PROVEN_ROOTS_V15_CODE_KIND\n        )\n        != 398\n        or sum(\n            claim["range"][1] - claim["range"][0]\n            for claim in claims\n            if claim["claim_kind"] == CFG_PROVEN_ROOTS_V15_LITERAL_KIND\n        )\n        != 52\n        or any(\n            start < forbidden_end and forbidden_start < end\n            for start, end in (claim["range"] for claim in claims)\n            for forbidden_start, forbidden_end in forbidden_ranges\n        )\n    ):\n        raise ValueError("v15 claim projection changed")\n    return claims\n\n\ndef _u8_indexed_u16_pair_lookup_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote only the frozen lookup\'s 144-byte current-unknown prefix."""\n\n    root = Path(root).resolve(strict=True)\n    baseline = list(existing_claims)\n    if any(\n        claim.get("promotion_batch") == U8_LOOKUP_BATCH\n        or claim.get("claim_kind") == U8_LOOKUP_CLAIM_KIND\n        for claim in baseline\n    ):\n        raise ValueError("u8 lookup claims require a pre-promotion baseline; batch is already present")\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError("u8 lookup ROM identity changed")\n\n    artifact = _checked_artifact_directory(\n        root,\n        U8_LOOKUP_ARTIFACT,\n        {"manifest.json", U8_LOOKUP_PAYLOAD_NAME, U8_LOOKUP_BINARY_NAME},\n        label="u8 lookup artifact",\n    )\n    manifest_path = _checked_repository_file(\n        root,\n        U8_LOOKUP_ARTIFACT / "manifest.json",\n        U8_LOOKUP_MANIFEST_SHA256,\n        expected_size=U8_LOOKUP_MANIFEST_SIZE,\n        label="u8 lookup manifest",\n    )\n    payload_path = _checked_repository_file(\n        root,\n        U8_LOOKUP_ARTIFACT / U8_LOOKUP_PAYLOAD_NAME,\n        U8_LOOKUP_PAYLOAD_SHA256,\n        expected_size=U8_LOOKUP_PAYLOAD_SIZE,\n        label="u8 lookup payload",\n    )\n    binary_path = _checked_repository_file(\n        root,\n        U8_LOOKUP_ARTIFACT / U8_LOOKUP_BINARY_NAME,\n        U8_LOOKUP_BINARY_SHA256,\n        expected_size=U8_LOOKUP_BINARY_SIZE,\n        label="u8 lookup binary",\n    )\n    for path, expected, label in (\n        (U8_LOOKUP_EXPORTER, U8_LOOKUP_EXPORTER_SHA256, "u8 lookup exporter"),\n        (U8_LOOKUP_VERIFIER, U8_LOOKUP_VERIFIER_SHA256, "u8 lookup verifier"),\n        (U8_LOOKUP_TEST, U8_LOOKUP_TEST_SHA256, "u8 lookup test"),\n    ):\n        _checked_repository_file(root, path, expected, label=label)\n\n    manifest_raw = manifest_path.read_bytes()\n    payload_raw = payload_path.read_bytes()\n    try:\n        manifest = json.loads(manifest_raw)\n        payload = json.loads(payload_raw)\n    except (UnicodeDecodeError, json.JSONDecodeError) as error:\n        raise ValueError("u8 lookup artifact JSON is invalid") from error\n    if (\n        manifest_raw != _canonical_json_bytes(manifest)\n        or payload_raw != _canonical_json_bytes(payload)\n    ):\n        raise ValueError("u8 lookup artifact JSON is not canonical")\n\n    expected_implementation = {\n        "exporter": {\n            "path": U8_LOOKUP_EXPORTER.as_posix(),\n            "sha256": U8_LOOKUP_EXPORTER_SHA256,\n        },\n        "tests": {\n            "path": U8_LOOKUP_TEST.as_posix(),\n            "sha256": U8_LOOKUP_TEST_SHA256,\n        },\n        "verifier": {\n            "path": U8_LOOKUP_VERIFIER.as_posix(),\n            "sha256": U8_LOOKUP_VERIFIER_SHA256,\n        },\n    }\n    if (\n        not isinstance(manifest, dict)\n        or manifest.get("schema") != "git-artifact-promotion-v1"\n        or manifest.get("artifact_schema") != U8_LOOKUP_BATCH\n        or manifest.get("artifact_status") != "accepted"\n        or manifest.get("files")\n        != {\n            U8_LOOKUP_BINARY_NAME: U8_LOOKUP_BINARY_SHA256,\n            U8_LOOKUP_PAYLOAD_NAME: U8_LOOKUP_PAYLOAD_SHA256,\n        }\n        or manifest.get("implementation") != expected_implementation\n        or manifest.get("scope") != payload.get("scope")\n        or manifest.get("non_claims") != payload.get("non_claims")\n        or manifest.get("coverage_baseline") != payload.get("coverage_baseline")\n        or not isinstance(payload, dict)\n        or payload.get("schema") != U8_LOOKUP_BATCH\n        or payload.get("implementation") != expected_implementation\n    ):\n        raise ValueError("u8 lookup promotion contract changed")\n\n    try:\n        report = verify_rom_u8_indexed_u16_pair_lookup(root, artifact)\n    except Exception as error:\n        raise ValueError(f"u8 lookup independent verification failed: {error}") from error\n    verifier_receipt = manifest.get("verifier")\n    if (\n        not isinstance(report, dict)\n        or not isinstance(verifier_receipt, dict)\n        or verifier_receipt.get("exit_code") != 0\n        or verifier_receipt.get("report") != report\n        or manifest.get("verification") != report\n        or report.get("verified") is not True\n        or report.get("errors") != []\n        or report.get("schema")\n        != "rom-u8-indexed-u16-pair-lookup-verification-v1"\n        or report.get("current_unknown_primary_bytes") != 144\n        or report.get("existing_owner_overlap_bytes") != 880\n    ):\n        raise ValueError(f"u8 lookup independent verification failed: {report}")\n\n    logical = payload.get("logical_view")\n    projection = payload.get("coverage_projection")\n    current = projection.get("current_unknown") if isinstance(projection, dict) else None\n    overlap = (\n        projection.get("existing_owner_overlap")\n        if isinstance(projection, dict)\n        else None\n    )\n    cells = logical.get("cells") if isinstance(logical, dict) else None\n    if (\n        not isinstance(logical, dict)\n        or logical.get("range") != [0x59F560, 0x59F960]\n        or logical.get("cell_count") != 256\n        or logical.get("cell_size") != 4\n        or logical.get("size") != 1_024\n        or logical.get("sha256") != U8_LOOKUP_BINARY_SHA256\n        or not isinstance(cells, list)\n        or len(cells) != 256\n        or not isinstance(current, dict)\n        or current.get("range") != list(U8_LOOKUP_PRIMARY_RANGE)\n        or current.get("cell_range") != [0, 36]\n        or current.get("cell_count") != 36\n        or current.get("size") != 144\n        or current.get("sha256") != U8_LOOKUP_PRIMARY_SHA256\n        or current.get("primary_class") != U8_LOOKUP_PRIMARY_CLASS\n        or current.get("claim_kind") != U8_LOOKUP_CLAIM_KIND\n        or not isinstance(overlap, dict)\n        or overlap.get("range") != list(U8_LOOKUP_OVERLAP_RANGE)\n        or overlap.get("cell_range") != [36, 256]\n        or overlap.get("cell_count") != 220\n        or overlap.get("size") != 880\n        or overlap.get("sha256") != U8_LOOKUP_OVERLAP_SHA256\n        or overlap.get("reclassifies_existing_owner") is not False\n    ):\n        raise ValueError("u8 lookup coverage projection changed")\n    if (\n        binary_path.read_bytes() != rom[0x59F560:0x59F960]\n        or _sha256(rom[slice(*U8_LOOKUP_PRIMARY_RANGE)])\n        != U8_LOOKUP_PRIMARY_SHA256\n        or _sha256(rom[slice(*U8_LOOKUP_OVERLAP_RANGE)])\n        != U8_LOOKUP_OVERLAP_SHA256\n    ):\n        raise ValueError("u8 lookup ROM projection identity changed")\n\n    primary = [claim for claim in baseline if claim.get("role") == "primary"]\n    target_start, target_end = U8_LOOKUP_PRIMARY_RANGE\n    for claim in primary:\n        start, end = _validated_range(claim, len(rom))\n        if start < target_end and target_start < end:\n            raise ValueError("u8 lookup unknown projection changed")\n    overlap_claims = sorted(\n        (\n            claim\n            for claim in primary\n            if _validated_range(claim, len(rom))[0] < U8_LOOKUP_OVERLAP_RANGE[1]\n            and U8_LOOKUP_OVERLAP_RANGE[0]\n            < _validated_range(claim, len(rom))[1]\n        ),\n        key=lambda claim: claim["range"],\n    )\n    if (\n        [claim.get("id") for claim in overlap_claims]\n        != overlap.get("owner_claim_ids")\n        or [claim.get("range") for claim in overlap_claims]\n        != overlap.get("owner_ranges")\n        or any(\n            claim.get("primary_class") != overlap.get("owner_primary_class")\n            or claim.get("claim_kind") != overlap.get("owner_claim_kind")\n            for claim in overlap_claims\n        )\n    ):\n        raise ValueError("u8 lookup existing-owner projection changed")\n\n    non_claims = payload.get("non_claims")\n    if (\n        not isinstance(non_claims, dict)\n        or not non_claims\n        or any(value is not False for value in non_claims.values())\n    ):\n        raise ValueError("u8 lookup non-claim contract changed")\n    return [\n        {\n            "id": "u8-indexed-u16-pair-lookup-unknown-59f560",\n            "range": list(U8_LOOKUP_PRIMARY_RANGE),\n            "gba_range": [0x0859F560, 0x0859F5F0],\n            "role": "primary",\n            "primary_class": U8_LOOKUP_PRIMARY_CLASS,\n            "claim_kind": U8_LOOKUP_CLAIM_KIND,\n            "promotion_batch": U8_LOOKUP_BATCH,\n            "promoted_from_primary_class": "unknown",\n            "baseline_unknown_only": True,\n            "preserves_existing_primary_owners": True,\n            "bytes_sha256": U8_LOOKUP_PRIMARY_SHA256,\n            "logical_cell_range": [0, 36],\n            "logical_cell_count": 36,\n            "logical_cell_size": 4,\n            "logical_view_range": [0x59F560, 0x59F960],\n            "logical_view_cell_count": 256,\n            "logical_view_bytes": 1_024,\n            "logical_view_sha256": U8_LOOKUP_BINARY_SHA256,\n            "existing_owner_overlap_range": list(U8_LOOKUP_OVERLAP_RANGE),\n            "existing_owner_overlap_bytes": 880,\n            "existing_owner_overlap_sha256": U8_LOOKUP_OVERLAP_SHA256,\n            "evidence_path": (U8_LOOKUP_ARTIFACT / U8_LOOKUP_PAYLOAD_NAME).as_posix(),\n            "evidence_sha256": U8_LOOKUP_PAYLOAD_SHA256,\n            "evidence_selector": "/coverage_projection/current_unknown",\n            "promotion_manifest_path": (U8_LOOKUP_ARTIFACT / "manifest.json").as_posix(),\n            "promotion_manifest_sha256": U8_LOOKUP_MANIFEST_SHA256,\n            "independent_verifier_path": U8_LOOKUP_VERIFIER.as_posix(),\n            "independent_verifier_sha256": U8_LOOKUP_VERIFIER_SHA256,\n            "non_claims": non_claims,\n            **non_claims,\n            "limitations": [\n                "Only cells 0..35 in the frozen 256-cell logical view are promoted from current unknown.",\n                "The 880-byte overlap at cells 36..255 remains owned by the existing selector direct-source claims and is provenance only.",\n                "Natural reachability, business field semantics, editing, relocation, and allocatable space remain unclaimed.",\n            ],\n        }\n    ]\n\n\ndef _boot_thumb_handoff_cfg_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote the 27 code and 22 literal ranges from the frozen boot CFG."""\n\n    root = Path(root).resolve(strict=True)\n    baseline = list(existing_claims)\n    if any(\n        claim.get("promotion_batch") == BOOT_THUMB_HANDOFF_BATCH\n        or claim.get("claim_kind")\n        in {BOOT_THUMB_HANDOFF_CODE_KIND, BOOT_THUMB_HANDOFF_LITERAL_KIND}\n        for claim in baseline\n    ):\n        raise ValueError("boot Thumb handoff claims require a pre-promotion baseline; batch is already present")\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError("boot Thumb handoff ROM identity changed")\n\n    artifact = _checked_artifact_directory(\n        root,\n        BOOT_THUMB_HANDOFF_ARTIFACT,\n        {\n            "manifest.json",\n            BOOT_THUMB_HANDOFF_PAYLOAD_NAME,\n            BOOT_THUMB_HANDOFF_BINARY_NAME,\n        },\n        label="boot Thumb handoff artifact",\n    )\n    manifest_path = _checked_repository_file(\n        root,\n        BOOT_THUMB_HANDOFF_ARTIFACT / "manifest.json",\n        BOOT_THUMB_HANDOFF_MANIFEST_SHA256,\n        expected_size=BOOT_THUMB_HANDOFF_MANIFEST_SIZE,\n        label="boot Thumb handoff manifest",\n    )\n    payload_path = _checked_repository_file(\n        root,\n        BOOT_THUMB_HANDOFF_ARTIFACT / BOOT_THUMB_HANDOFF_PAYLOAD_NAME,\n        BOOT_THUMB_HANDOFF_PAYLOAD_SHA256,\n        expected_size=BOOT_THUMB_HANDOFF_PAYLOAD_SIZE,\n        label="boot Thumb handoff payload",\n    )\n    binary_path = _checked_repository_file(\n        root,\n        BOOT_THUMB_HANDOFF_ARTIFACT / BOOT_THUMB_HANDOFF_BINARY_NAME,\n        BOOT_THUMB_HANDOFF_BINARY_SHA256,\n        expected_size=BOOT_THUMB_HANDOFF_BINARY_SIZE,\n        label="boot Thumb handoff binary",\n    )\n    for path, expected, label in (\n        (\n            BOOT_THUMB_HANDOFF_EXPORTER,\n            BOOT_THUMB_HANDOFF_EXPORTER_SHA256,\n            "boot Thumb handoff exporter",\n        ),\n        (\n            BOOT_THUMB_HANDOFF_VERIFIER,\n            BOOT_THUMB_HANDOFF_VERIFIER_SHA256,\n            "boot Thumb handoff verifier",\n        ),\n        (\n            BOOT_THUMB_HANDOFF_TEST,\n            BOOT_THUMB_HANDOFF_TEST_SHA256,\n            "boot Thumb handoff test",\n        ),\n    ):\n        _checked_repository_file(root, path, expected, label=label)\n\n    manifest_raw = manifest_path.read_bytes()\n    payload_raw = payload_path.read_bytes()\n    try:\n        manifest = json.loads(manifest_raw)\n        payload = json.loads(payload_raw)\n    except (UnicodeDecodeError, json.JSONDecodeError) as error:\n        raise ValueError("boot Thumb handoff artifact JSON is invalid") from error\n    if (\n        manifest_raw != _canonical_json_bytes(manifest)\n        or payload_raw != _canonical_json_bytes(payload)\n    ):\n        raise ValueError("boot Thumb handoff artifact JSON is not canonical")\n\n    expected_implementation = {\n        "exporter": {\n            "path": BOOT_THUMB_HANDOFF_EXPORTER.as_posix(),\n            "sha256": BOOT_THUMB_HANDOFF_EXPORTER_SHA256,\n        },\n        "test": {\n            "path": BOOT_THUMB_HANDOFF_TEST.as_posix(),\n            "sha256": BOOT_THUMB_HANDOFF_TEST_SHA256,\n        },\n        "verifier": {\n            "path": BOOT_THUMB_HANDOFF_VERIFIER.as_posix(),\n            "sha256": BOOT_THUMB_HANDOFF_VERIFIER_SHA256,\n        },\n    }\n    if (\n        not isinstance(manifest, dict)\n        or manifest.get("schema") != "git-artifact-promotion-v1"\n        or manifest.get("artifact_schema") != BOOT_THUMB_HANDOFF_BATCH\n        or manifest.get("artifact_status") != "accepted"\n        or manifest.get("files")\n        != {\n            BOOT_THUMB_HANDOFF_BINARY_NAME: {\n                "sha256": BOOT_THUMB_HANDOFF_BINARY_SHA256,\n                "size": BOOT_THUMB_HANDOFF_BINARY_SIZE,\n            },\n            BOOT_THUMB_HANDOFF_PAYLOAD_NAME: {\n                "sha256": BOOT_THUMB_HANDOFF_PAYLOAD_SHA256,\n                "size": BOOT_THUMB_HANDOFF_PAYLOAD_SIZE,\n            },\n        }\n        or manifest.get("implementation") != expected_implementation\n        or manifest.get("summary") != BOOT_THUMB_HANDOFF_EXPECTED_SUMMARY\n        or manifest.get("summary") != payload.get("summary")\n        or manifest.get("promotion") != payload.get("promotion")\n        or manifest.get("scope") != payload.get("scope")\n        or manifest.get("limitations") != payload.get("limitations")\n        or not isinstance(payload, dict)\n        or payload.get("schema") != BOOT_THUMB_HANDOFF_BATCH\n        or payload.get("implementation") != expected_implementation\n    ):\n        raise ValueError("boot Thumb handoff promotion contract changed")\n\n    try:\n        report = verify_rom_boot_thumb_handoff_cfg(root, artifact)\n    except Exception as error:\n        raise ValueError(\n            f"boot Thumb handoff independent verification failed: {error}"\n        ) from error\n    verification = manifest.get("verification")\n    expected_report = (\n        verification.get("report") if isinstance(verification, dict) else None\n    )\n    if (\n        not isinstance(report, dict)\n        or report != expected_report\n        or report.get("verified") is not True\n        or report.get("errors") != []\n        or report.get("summary") != BOOT_THUMB_HANDOFF_EXPECTED_SUMMARY\n        or manifest.get("verifier") != verification\n        or verification.get("exit_code") != 0\n        or verification.get("verifier_sha256")\n        != BOOT_THUMB_HANDOFF_VERIFIER_SHA256\n    ):\n        raise ValueError(\n            f"boot Thumb handoff independent verification failed: {report}"\n        )\n\n    rows = payload.get("promotion_ranges")\n    union_ranges = payload.get("union_ranges")\n    promotion = payload.get("promotion")\n    if not isinstance(rows, list) or not isinstance(union_ranges, list):\n        raise ValueError("boot Thumb handoff promotion ranges are missing")\n    primary = [claim for claim in baseline if claim.get("role") == "primary"]\n    code_count = literal_count = code_bytes = literal_bytes = 0\n    ranges: list[list[int]] = []\n    for index, row in enumerate(rows):\n        if not isinstance(row, dict) or set(row) != {\n            "id",\n            "kind",\n            "range",\n            "size",\n            "sha256",\n            "baseline_unknown_only",\n        }:\n            raise ValueError(f"boot Thumb handoff promotion row changed: {index}")\n        start, end = _validated_range(row, len(rom))\n        kind = row.get("kind")\n        if (\n            kind not in {"code", "literal"}\n            or row.get("size") != end - start\n            or row.get("sha256") != _sha256(rom[start:end])\n            or row.get("baseline_unknown_only") is not True\n        ):\n            raise ValueError(f"boot Thumb handoff promotion row identity changed: {index}")\n        if any(\n            other_start < end and start < other_end\n            for other in primary\n            for other_start, other_end in [_validated_range(other, len(rom))]\n        ):\n            raise ValueError(\n                f"boot Thumb handoff unknown projection changed: {row.get(\'id\')}"\n            )\n        ranges.append([start, end])\n        if kind == "code":\n            code_count += 1\n            code_bytes += end - start\n        else:\n            literal_count += 1\n            literal_bytes += end - start\n\n    merged: list[list[int]] = []\n    for start, end in sorted(ranges):\n        if merged and start < merged[-1][1]:\n            raise ValueError("boot Thumb handoff promotion ranges overlap")\n        if merged and start == merged[-1][1]:\n            merged[-1][1] = end\n        else:\n            merged.append([start, end])\n    compact_union_sha = _sha256(\n        json.dumps(\n            union_ranges, ensure_ascii=False, sort_keys=True, separators=(",", ":")\n        ).encode("utf-8")\n    )\n    packed = b"".join(rom[start:end] for start, end in union_ranges)\n    if (\n        len(rows) != 49\n        or code_count != 27\n        or code_bytes != 1_226\n        or literal_count != 22\n        or literal_bytes != 296\n        or merged != union_ranges\n        or len(union_ranges) != 25\n        or sum(end - start for start, end in union_ranges) != 1_522\n        or compact_union_sha != BOOT_THUMB_HANDOFF_UNION_RANGE_SHA256\n        or binary_path.read_bytes() != packed\n        or _sha256(packed) != BOOT_THUMB_HANDOFF_BINARY_SHA256\n        or not isinstance(promotion, dict)\n        or promotion.get("code_range_count") != 27\n        or promotion.get("code_bytes") != 1_226\n        or promotion.get("literal_range_count") != 22\n        or promotion.get("literal_bytes") != 296\n        or promotion.get("union_range_count") != 25\n        or promotion.get("union_bytes") != 1_522\n        or promotion.get("union_bytes_sha256")\n        != BOOT_THUMB_HANDOFF_BINARY_SHA256\n        or promotion.get("union_range_vector_sha256")\n        != BOOT_THUMB_HANDOFF_UNION_RANGE_SHA256\n        or promotion.get("wide_envelope_is_claim") is not False\n    ):\n        raise ValueError("boot Thumb handoff promotion denominator changed")\n\n    scope = payload.get("scope")\n    limitations = payload.get("limitations")\n    if not isinstance(scope, dict) or not isinstance(limitations, list):\n        raise ValueError("boot Thumb handoff scope changed")\n    non_claims = {key: value for key, value in scope.items() if value is False}\n    claims: list[dict[str, Any]] = []\n    for index, row in enumerate(rows):\n        start, end = row["range"]\n        kind = row["kind"]\n        claim_kind = (\n            BOOT_THUMB_HANDOFF_CODE_KIND\n            if kind == "code"\n            else BOOT_THUMB_HANDOFF_LITERAL_KIND\n        )\n        primary_class = (\n            BOOT_THUMB_HANDOFF_CODE_CLASS\n            if kind == "code"\n            else BOOT_THUMB_HANDOFF_LITERAL_CLASS\n        )\n        claims.append(\n            {\n                "id": f"boot-thumb-handoff-{row[\'id\']}",\n                "range": [start, end],\n                "gba_range": [0x08000000 + start, 0x08000000 + end],\n                "role": "primary",\n                "primary_class": primary_class,\n                "claim_kind": claim_kind,\n                "mode": "thumb" if kind == "code" else None,\n                "promotion_batch": BOOT_THUMB_HANDOFF_BATCH,\n                "promoted_from_primary_class": "unknown",\n                "baseline_unknown_only": True,\n                "bytes_sha256": row["sha256"],\n                "artifact_range_id": row["id"],\n                "artifact_range_kind": kind,\n                "promotion_union_range_count": 25,\n                "promotion_union_bytes": 1_522,\n                "promotion_union_range_vector_sha256": (\n                    BOOT_THUMB_HANDOFF_UNION_RANGE_SHA256\n                ),\n                "evidence_path": (\n                    BOOT_THUMB_HANDOFF_ARTIFACT / BOOT_THUMB_HANDOFF_PAYLOAD_NAME\n                ).as_posix(),\n                "evidence_sha256": BOOT_THUMB_HANDOFF_PAYLOAD_SHA256,\n                "evidence_selector": f"/promotion_ranges/{index}",\n                "promotion_manifest_path": (\n                    BOOT_THUMB_HANDOFF_ARTIFACT / "manifest.json"\n                ).as_posix(),\n                "promotion_manifest_sha256": BOOT_THUMB_HANDOFF_MANIFEST_SHA256,\n                "independent_verifier_path": BOOT_THUMB_HANDOFF_VERIFIER.as_posix(),\n                "independent_verifier_sha256": (\n                    BOOT_THUMB_HANDOFF_VERIFIER_SHA256\n                ),\n                "non_claims": non_claims,\n                "limitations": limitations,\n            }\n        )\n    return claims\n\n\ndef _task_scheduler_core_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote only the scheduler packet\'s four code and three literal ranges."""\n\n    root = Path(root).resolve(strict=True)\n    baseline = list(existing_claims)\n    if any(\n        claim.get("promotion_batch") == TASK_SCHEDULER_BATCH\n        or claim.get("claim_kind")\n        in {TASK_SCHEDULER_CODE_KIND, TASK_SCHEDULER_LITERAL_KIND}\n        for claim in baseline\n    ):\n        raise ValueError(\n            "task scheduler claims require a pre-promotion baseline; batch is already present"\n        )\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError("task scheduler ROM identity changed")\n\n    artifact = _checked_artifact_directory(\n        root,\n        TASK_SCHEDULER_ARTIFACT,\n        {\n            "manifest.json",\n            TASK_SCHEDULER_PAYLOAD_NAME,\n            TASK_SCHEDULER_BINARY_NAME,\n        },\n        label="task scheduler artifact",\n    )\n    manifest_path = _checked_repository_file(\n        root,\n        TASK_SCHEDULER_ARTIFACT / "manifest.json",\n        TASK_SCHEDULER_MANIFEST_SHA256,\n        expected_size=TASK_SCHEDULER_MANIFEST_SIZE,\n        label="task scheduler manifest",\n    )\n    payload_path = _checked_repository_file(\n        root,\n        TASK_SCHEDULER_ARTIFACT / TASK_SCHEDULER_PAYLOAD_NAME,\n        TASK_SCHEDULER_PAYLOAD_SHA256,\n        expected_size=TASK_SCHEDULER_PAYLOAD_SIZE,\n        label="task scheduler payload",\n    )\n    binary_path = _checked_repository_file(\n        root,\n        TASK_SCHEDULER_ARTIFACT / TASK_SCHEDULER_BINARY_NAME,\n        TASK_SCHEDULER_BINARY_SHA256,\n        expected_size=TASK_SCHEDULER_BINARY_SIZE,\n        label="task scheduler binary",\n    )\n    for path, expected, label in (\n        (\n            TASK_SCHEDULER_EXPORTER,\n            TASK_SCHEDULER_EXPORTER_SHA256,\n            "task scheduler exporter",\n        ),\n        (\n            TASK_SCHEDULER_VERIFIER,\n            TASK_SCHEDULER_VERIFIER_SHA256,\n            "task scheduler verifier",\n        ),\n        (\n            TASK_SCHEDULER_BUNDLE_VERIFIER,\n            TASK_SCHEDULER_BUNDLE_VERIFIER_SHA256,\n            "task scheduler bundle verifier",\n        ),\n        (\n            TASK_SCHEDULER_BUNDLE_TEST,\n            TASK_SCHEDULER_BUNDLE_TEST_SHA256,\n            "task scheduler bundle verifier test",\n        ),\n        (\n            TASK_SCHEDULER_TEST,\n            TASK_SCHEDULER_TEST_SHA256,\n            "task scheduler test",\n        ),\n    ):\n        _checked_repository_file(root, path, expected, label=label)\n\n    manifest_raw = manifest_path.read_bytes()\n    payload_raw = payload_path.read_bytes()\n    try:\n        manifest = json.loads(manifest_raw)\n        payload = json.loads(payload_raw)\n    except (UnicodeDecodeError, json.JSONDecodeError) as error:\n        raise ValueError("task scheduler artifact JSON is invalid") from error\n    if (\n        manifest_raw != _canonical_json_bytes(manifest)\n        or payload_raw != _canonical_json_bytes(payload)\n    ):\n        raise ValueError("task scheduler artifact JSON is not canonical")\n\n    expected_implementation = {\n        "exporter": {\n            "path": TASK_SCHEDULER_EXPORTER.as_posix(),\n            "sha256": TASK_SCHEDULER_EXPORTER_SHA256,\n        },\n        "test": {\n            "path": TASK_SCHEDULER_TEST.as_posix(),\n            "sha256": TASK_SCHEDULER_TEST_SHA256,\n        },\n        "verifier": {\n            "path": TASK_SCHEDULER_VERIFIER.as_posix(),\n            "sha256": TASK_SCHEDULER_VERIFIER_SHA256,\n        },\n    }\n    if (\n        not isinstance(manifest, dict)\n        or not isinstance(payload, dict)\n        or manifest.get("schema") != "git-artifact-promotion-v1"\n        or manifest.get("artifact_schema") != TASK_SCHEDULER_BATCH\n        or manifest.get("artifact_status") != "accepted"\n        or manifest.get("files")\n        != {\n            TASK_SCHEDULER_BINARY_NAME: {\n                "sha256": TASK_SCHEDULER_BINARY_SHA256,\n                "size": TASK_SCHEDULER_BINARY_SIZE,\n            },\n            TASK_SCHEDULER_PAYLOAD_NAME: {\n                "sha256": TASK_SCHEDULER_PAYLOAD_SHA256,\n                "size": TASK_SCHEDULER_PAYLOAD_SIZE,\n            },\n        }\n        or manifest.get("implementation") != expected_implementation\n        or manifest.get("summary") != TASK_SCHEDULER_EXPECTED_SUMMARY\n        or manifest.get("summary") != payload.get("summary")\n        or manifest.get("coverage_baseline") != payload.get("coverage_baseline")\n        or manifest.get("promotion") != payload.get("promotion")\n        or manifest.get("provenance_inputs") != payload.get("provenance_inputs")\n        or manifest.get("entry_proof") != payload.get("entry_proof")\n        or manifest.get("scope") != payload.get("scope")\n        or manifest.get("limitations") != payload.get("limitations")\n        or payload.get("schema") != TASK_SCHEDULER_BATCH\n        or payload.get("implementation") != expected_implementation\n    ):\n        raise ValueError("task scheduler promotion contract changed")\n\n    try:\n        report = verify_rom_task_scheduler_core_bundle(root, artifact)\n    except Exception as error:\n        raise ValueError(\n            f"task scheduler independent verification failed: {error}"\n        ) from error\n    verification = manifest.get("verification")\n    expected_report = (\n        verification.get("report") if isinstance(verification, dict) else None\n    )\n    if (\n        not isinstance(report, dict)\n        or report.get("schema")\n        != "rom-task-scheduler-core-bundle-verification-v1"\n        or report.get("verified") is not True\n        or report.get("errors") != []\n        or report.get("artifact_schema") != TASK_SCHEDULER_BATCH\n        or report.get("artifact_status") != "accepted"\n        or report.get("artifact_bundle_verified") is not True\n        or report.get("legacy_receipt_verified") is not True\n        or report.get("live_coverage_verified") is not False\n        or report.get("rom_sha256") != ROM_SHA256\n        or report.get("promotion_bytes") != 308\n        or report.get("promotion_claim_count") != 7\n        or report.get("promotion_range_count") != 7\n        or report.get("unclassified_historical_bytes") != 6\n        or report.get("legacy_verifier_sha256")\n        != TASK_SCHEDULER_VERIFIER_SHA256\n        or report.get("bundle_verifier_sha256")\n        != TASK_SCHEDULER_BUNDLE_VERIFIER_SHA256\n        or report.get("legacy_report") != expected_report\n        or report.get("summary") != TASK_SCHEDULER_EXPECTED_SUMMARY\n        or report.get("promotion") != payload.get("promotion")\n        or manifest.get("verifier") != verification\n        or verification.get("exit_code") != 0\n        or verification.get("verifier_sha256")\n        != TASK_SCHEDULER_VERIFIER_SHA256\n    ):\n        raise ValueError(\n            f"task scheduler independent verification failed: {report}"\n        )\n\n    rows = payload.get("promotion_ranges")\n    promotion = payload.get("promotion")\n    scope = payload.get("scope")\n    limitations = payload.get("limitations")\n    if (\n        not isinstance(rows, list)\n        or not isinstance(promotion, dict)\n        or not isinstance(scope, dict)\n        or not isinstance(limitations, list)\n    ):\n        raise ValueError("task scheduler promotion ranges are missing")\n\n    expected_union_ranges = [\n        [0x061C58, 0x061D62],\n        [0x061D64, 0x061D7A],\n        [0x061DEC, 0x061E00],\n    ]\n    expected_promotion = {\n        "code_bytes": 264,\n        "code_range_count": 4,\n        "current_known_overlap_bytes": 0,\n        "future_coverage_claim_projection": {\n            "code_claim_count": 4,\n            "literal_claim_count": 3,\n            "owned_claim_count": 0,\n            "unclassified_claim_count": 0,\n        },\n        "literal_bytes": 44,\n        "literal_range_count": 3,\n        "owned_provenance_bytes": 138,\n        "owned_provenance_ranges": [\n            [0x061D7C, 0x061DEA],\n            [0x061E00, 0x061E1C],\n        ],\n        "unclassified_unknown_bytes": 6,\n        "unclassified_unknown_ranges": [list(item) for item in TASK_SCHEDULER_GAP_RANGES],\n        "union_bytes": 308,\n        "union_bytes_sha256": TASK_SCHEDULER_BINARY_SHA256,\n        "union_range_count": 3,\n        "union_range_vector_sha256": TASK_SCHEDULER_UNION_RANGE_SHA256,\n        "union_ranges": expected_union_ranges,\n    }\n    if promotion != expected_promotion:\n        raise ValueError("task scheduler promotion denominator changed")\n\n    primary = [claim for claim in baseline if claim.get("role") == "primary"]\n    code_count = literal_count = code_bytes = literal_bytes = 0\n    ranges: list[list[int]] = []\n    for index, row in enumerate(rows):\n        if not isinstance(row, dict) or set(row) != {\n            "baseline_unknown_only",\n            "id",\n            "kind",\n            "range",\n            "semantic_class",\n            "sha256",\n            "size",\n        }:\n            raise ValueError(f"task scheduler promotion row changed: {index}")\n        start, end = _validated_range(row, len(rom))\n        kind = row.get("kind")\n        primary_class = row.get("semantic_class")\n        if (\n            kind not in {"code", "literal"}\n            or row.get("size") != end - start\n            or row.get("sha256") != _sha256(rom[start:end])\n            or row.get("baseline_unknown_only") is not True\n            or primary_class\n            != (\n                TASK_SCHEDULER_CODE_CLASS\n                if kind == "code"\n                else TASK_SCHEDULER_LITERAL_CLASS\n            )\n        ):\n            raise ValueError(\n                f"task scheduler promotion row identity changed: {index}"\n            )\n        if any(\n            other_start < end and start < other_end\n            for other in primary\n            for other_start, other_end in [_validated_range(other, len(rom))]\n        ):\n            raise ValueError(\n                f"task scheduler unknown projection changed: {row.get(\'id\')}"\n            )\n        ranges.append([start, end])\n        if kind == "code":\n            code_count += 1\n            code_bytes += end - start\n        else:\n            literal_count += 1\n            literal_bytes += end - start\n\n    merged: list[list[int]] = []\n    for start, end in sorted(ranges):\n        if merged and start < merged[-1][1]:\n            raise ValueError("task scheduler promotion ranges overlap")\n        if merged and start == merged[-1][1]:\n            merged[-1][1] = end\n        else:\n            merged.append([start, end])\n    compact_union_sha = _sha256(_canonical_json_bytes(expected_union_ranges))\n    packed = b"".join(\n        rom[row["range"][0] : row["range"][1]] for row in rows\n    )\n    if (\n        len(rows) != 7\n        or code_count != 4\n        or code_bytes != 264\n        or literal_count != 3\n        or literal_bytes != 44\n        or merged != expected_union_ranges\n        or compact_union_sha != TASK_SCHEDULER_UNION_RANGE_SHA256\n        or binary_path.read_bytes() != packed\n        or _sha256(packed) != TASK_SCHEDULER_BINARY_SHA256\n    ):\n        raise ValueError("task scheduler promotion denominator changed")\n\n    claim_map = {\n        claim.get("id"): claim\n        for claim in primary\n        if isinstance(claim, dict)\n    }\n    for claim_id, interval, expected_sha in TASK_SCHEDULER_OWNER_RANGES:\n        owner = claim_map.get(claim_id)\n        if (\n            not isinstance(owner, dict)\n            or owner.get("range") != list(interval)\n            or owner.get("primary_class")\n            != "armv4t_cfg_reachable_thumb_code"\n            or owner.get("bytes_sha256") != expected_sha\n            or _sha256(rom[slice(*interval)]) != expected_sha\n        ):\n            raise ValueError(f"task scheduler owned provenance changed: {claim_id}")\n    for gap_index, (start, end) in enumerate(TASK_SCHEDULER_GAP_RANGES):\n        if _sha256(rom[start:end]) != ARTIFACT_BOUND_ALIGNMENT_GAP_BYTES_SHA256:\n            raise ValueError("task scheduler unclassified gap bytes changed")\n        overlaps = [\n            other\n            for other in primary\n            for other_start, other_end in [_validated_range(other, len(rom))]\n            if other_start < end and start < other_end\n        ]\n        if not overlaps:\n            continue\n        expected_gap = {\n            "id": ARTIFACT_BOUND_ALIGNMENT_GAP_IDS[gap_index],\n            "range": [start, end],\n            "role": "primary",\n            "primary_class": ARTIFACT_BOUND_ALIGNMENT_GAP_PRIMARY_CLASS,\n            "claim_kind": ARTIFACT_BOUND_ALIGNMENT_GAP_CLAIM_KIND,\n            "promotion_batch": ARTIFACT_BOUND_ALIGNMENT_GAP_BATCH,\n            "baseline_unknown_only": True,\n            "bytes_sha256": ARTIFACT_BOUND_ALIGNMENT_GAP_BYTES_SHA256,\n            "claim_denominator_sha256": (\n                ARTIFACT_BOUND_ALIGNMENT_GAP_CLAIM_DENOMINATOR_SHA256\n            ),\n            "independent_verifier_path": (\n                ARTIFACT_BOUND_ALIGNMENT_GAP_VERIFIER.as_posix()\n            ),\n            "independent_verifier_sha256": (\n                ARTIFACT_BOUND_ALIGNMENT_GAP_VERIFIER_SHA256\n            ),\n        }\n        if len(overlaps) != 1 or any(\n            overlaps[0].get(key) != value for key, value in expected_gap.items()\n        ):\n            raise ValueError(\n                "task scheduler unclassified gap later-promotion contract changed"\n            )\n\n    non_claims = {key: value for key, value in scope.items() if value is False}\n    claims: list[dict[str, Any]] = []\n    for index, row in enumerate(rows):\n        start, end = row["range"]\n        kind = row["kind"]\n        claims.append(\n            {\n                "id": row["id"],\n                "range": [start, end],\n                "gba_range": [0x08000000 + start, 0x08000000 + end],\n                "role": "primary",\n                "primary_class": row["semantic_class"],\n                "claim_kind": (\n                    TASK_SCHEDULER_CODE_KIND\n                    if kind == "code"\n                    else TASK_SCHEDULER_LITERAL_KIND\n                ),\n                "mode": "thumb" if kind == "code" else None,\n                "promotion_batch": TASK_SCHEDULER_BATCH,\n                "promoted_from_primary_class": "unknown",\n                "baseline_unknown_only": True,\n                "bytes_sha256": row["sha256"],\n                "artifact_range_id": row["id"],\n                "artifact_range_kind": kind,\n                "promotion_union_range_count": 3,\n                "promotion_union_bytes": 308,\n                "promotion_union_range_vector_sha256": (\n                    TASK_SCHEDULER_UNION_RANGE_SHA256\n                ),\n                "evidence_path": (\n                    TASK_SCHEDULER_ARTIFACT / TASK_SCHEDULER_PAYLOAD_NAME\n                ).as_posix(),\n                "evidence_sha256": TASK_SCHEDULER_PAYLOAD_SHA256,\n                "evidence_selector": f"/promotion_ranges/{index}",\n                "promotion_manifest_path": (\n                    TASK_SCHEDULER_ARTIFACT / "manifest.json"\n                ).as_posix(),\n                "promotion_manifest_sha256": TASK_SCHEDULER_MANIFEST_SHA256,\n                "independent_verifier_path": TASK_SCHEDULER_VERIFIER.as_posix(),\n                "independent_verifier_sha256": (\n                    TASK_SCHEDULER_VERIFIER_SHA256\n                ),\n                "non_claims": non_claims,\n                "limitations": limitations,\n            }\n        )\n    return claims\n\n\ndef _mplaymain_scheduler_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote only the frozen MPlayMain code and consumed-literal ranges."""\n\n    root = Path(root).resolve(strict=True)\n    baseline = list(existing_claims)\n    if any(\n        claim.get("promotion_batch") == MPLAYMAIN_BATCH\n        or claim.get("claim_kind")\n        in {MPLAYMAIN_CODE_KIND, MPLAYMAIN_LITERAL_KIND}\n        for claim in baseline\n    ):\n        raise ValueError(\n            "MPlayMain scheduler claims require a pre-promotion baseline; batch is already present"\n        )\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError("MPlayMain scheduler ROM identity changed")\n\n    artifact = _checked_artifact_directory(\n        root,\n        MPLAYMAIN_ARTIFACT,\n        {"manifest.json", MPLAYMAIN_PAYLOAD_NAME, MPLAYMAIN_BINARY_NAME},\n        label="MPlayMain scheduler artifact",\n    )\n    manifest_path = _checked_repository_file(\n        root,\n        MPLAYMAIN_ARTIFACT / "manifest.json",\n        MPLAYMAIN_MANIFEST_SHA256,\n        expected_size=MPLAYMAIN_MANIFEST_SIZE,\n        label="MPlayMain scheduler manifest",\n    )\n    payload_path = _checked_repository_file(\n        root,\n        MPLAYMAIN_ARTIFACT / MPLAYMAIN_PAYLOAD_NAME,\n        MPLAYMAIN_PAYLOAD_SHA256,\n        expected_size=MPLAYMAIN_PAYLOAD_SIZE,\n        label="MPlayMain scheduler payload",\n    )\n    binary_path = _checked_repository_file(\n        root,\n        MPLAYMAIN_ARTIFACT / MPLAYMAIN_BINARY_NAME,\n        MPLAYMAIN_BINARY_SHA256,\n        expected_size=MPLAYMAIN_BINARY_SIZE,\n        label="MPlayMain scheduler binary",\n    )\n    for path, expected, label in (\n        (MPLAYMAIN_EXPORTER, MPLAYMAIN_EXPORTER_SHA256, "MPlayMain exporter"),\n        (MPLAYMAIN_VERIFIER, MPLAYMAIN_VERIFIER_SHA256, "MPlayMain verifier"),\n        (\n            MPLAYMAIN_BUNDLE_VERIFIER,\n            MPLAYMAIN_BUNDLE_VERIFIER_SHA256,\n            "MPlayMain immutable bundle verifier",\n        ),\n        (\n            MPLAYMAIN_EXPORTER_TEST,\n            MPLAYMAIN_EXPORTER_TEST_SHA256,\n            "MPlayMain exporter test",\n        ),\n        (\n            MPLAYMAIN_BUNDLE_TEST,\n            MPLAYMAIN_BUNDLE_TEST_SHA256,\n            "MPlayMain bundle verifier test",\n        ),\n    ):\n        _checked_repository_file(root, path, expected, label=label)\n\n    manifest_raw = manifest_path.read_bytes()\n    payload_raw = payload_path.read_bytes()\n    try:\n        manifest = json.loads(manifest_raw)\n        payload = json.loads(payload_raw)\n    except (UnicodeDecodeError, json.JSONDecodeError) as error:\n        raise ValueError("MPlayMain scheduler artifact JSON is invalid") from error\n    if (\n        manifest_raw != _canonical_json_bytes(manifest)\n        or payload_raw != _canonical_json_bytes(payload)\n    ):\n        raise ValueError("MPlayMain scheduler artifact JSON is not canonical")\n\n    expected_implementation = {\n        "exporter": {\n            "path": MPLAYMAIN_EXPORTER.as_posix(),\n            "sha256": MPLAYMAIN_EXPORTER_SHA256,\n        },\n        "test": {\n            "path": MPLAYMAIN_EXPORTER_TEST.as_posix(),\n            "sha256": MPLAYMAIN_EXPORTER_TEST_SHA256,\n        },\n        "verifier": {\n            "path": MPLAYMAIN_VERIFIER.as_posix(),\n            "sha256": MPLAYMAIN_VERIFIER_SHA256,\n        },\n    }\n    if (\n        not isinstance(manifest, dict)\n        or not isinstance(payload, dict)\n        or manifest.get("schema") != "git-artifact-promotion-v1"\n        or manifest.get("artifact_schema") != MPLAYMAIN_BATCH\n        or manifest.get("artifact_status") != "accepted"\n        or manifest.get("files")\n        != {\n            MPLAYMAIN_BINARY_NAME: {\n                "sha256": MPLAYMAIN_BINARY_SHA256,\n                "size": MPLAYMAIN_BINARY_SIZE,\n            },\n            MPLAYMAIN_PAYLOAD_NAME: {\n                "sha256": MPLAYMAIN_PAYLOAD_SHA256,\n                "size": MPLAYMAIN_PAYLOAD_SIZE,\n            },\n        }\n        or manifest.get("implementation") != expected_implementation\n        or payload.get("implementation") != expected_implementation\n        or manifest.get("summary") != MPLAYMAIN_EXPECTED_SUMMARY\n        or payload.get("summary") != MPLAYMAIN_EXPECTED_SUMMARY\n        or manifest.get("coverage_baseline") != payload.get("coverage_baseline")\n        or manifest.get("promotion") != payload.get("promotion")\n        or manifest.get("provenance_inputs") != payload.get("provenance_inputs")\n        or manifest.get("entry_proof") != payload.get("entry_proof")\n        or manifest.get("scope") != payload.get("scope")\n        or manifest.get("limitations") != payload.get("limitations")\n        or payload.get("schema") != MPLAYMAIN_BATCH\n    ):\n        raise ValueError("MPlayMain scheduler promotion contract changed")\n\n    try:\n        report = verify_rom_mplaymain_scheduler_bundle(root, artifact)\n    except Exception as error:\n        raise ValueError(\n            f"MPlayMain scheduler independent verification failed: {error}"\n        ) from error\n    if (\n        not isinstance(report, dict)\n        or report.get("schema")\n        != "rom-mplaymain-scheduler-bundle-verification-v1"\n        or report.get("verified") is not True\n        or report.get("errors") != []\n        or report.get("artifact_schema") != MPLAYMAIN_BATCH\n        or report.get("artifact_status") != "accepted"\n        or report.get("artifact_bundle_verified") is not True\n        or report.get("legacy_receipt_verified") is not True\n        or report.get("live_coverage_verified") is not False\n        or report.get("rom_sha256") != ROM_SHA256\n        or report.get("promotion_bytes") != 612\n        or report.get("promotion_claim_count") != 2\n        or report.get("promotion_range_count") != 2\n        or report.get("promotion_packed_sha256") != MPLAYMAIN_BINARY_SHA256\n        or report.get("unclassified_historical_bytes") != 2\n        or report.get("legacy_verifier_sha256") != MPLAYMAIN_VERIFIER_SHA256\n        or report.get("bundle_verifier_sha256")\n        != MPLAYMAIN_BUNDLE_VERIFIER_SHA256\n        or report.get("summary") != MPLAYMAIN_EXPECTED_SUMMARY\n        or report.get("promotion") != payload.get("promotion")\n        or report.get("legacy_report", {}).get("contract_ok") is not True\n    ):\n        raise ValueError(\n            f"MPlayMain scheduler independent verification failed: {report}"\n        )\n\n    expected_promotion = {\n        "code_bytes": 600,\n        "code_range_count": 1,\n        "current_known_overlap_bytes": 0,\n        "future_coverage_claim_projection": {\n            "code_claim_count": 1,\n            "literal_claim_count": 1,\n            "owned_claim_count": 0,\n            "unclassified_claim_count": 0,\n        },\n        "literal_bytes": 12,\n        "literal_range_count": 1,\n        "owned_provenance_bytes": 2,\n        "owned_provenance_ranges": [[0x09A684, 0x09A686]],\n        "projected_totals": {\n            "classified_bytes": 6_122_489,\n            "unknown_bytes": 168_967,\n            "claim_count": 14_484,\n            "segment_count": 16_593,\n        },\n        "unclassified_unknown_bytes": 2,\n        "unclassified_unknown_ranges": [[0x09A686, 0x09A688]],\n        "union_bytes": 612,\n        "union_bytes_sha256": MPLAYMAIN_BINARY_SHA256,\n        "union_range_count": 2,\n        "union_range_vector_sha256": MPLAYMAIN_UNION_RANGE_SHA256,\n        "union_ranges": [[0x09A42C, 0x09A684], [0x09A688, 0x09A694]],\n    }\n    promotion = payload.get("promotion")\n    rows = payload.get("promotion_ranges")\n    scope = payload.get("scope")\n    limitations = payload.get("limitations")\n    if (\n        promotion != expected_promotion\n        or not isinstance(rows, list)\n        or not isinstance(scope, dict)\n        or not isinstance(limitations, list)\n    ):\n        raise ValueError("MPlayMain scheduler promotion denominator changed")\n\n    expected_rows = [\n        {\n            "baseline_unknown_only": True,\n            "claim_kind": MPLAYMAIN_CODE_KIND,\n            "id": "mplaymain-code-00-09a42c",\n            "kind": "code",\n            "range": [0x09A42C, 0x09A684],\n            "semantic_class": MPLAYMAIN_CODE_CLASS,\n            "sha256": (\n                "0603b7d7cbd42674284783b638188595f07155ec8942d0ef96137bec36b1b86c"\n            ),\n            "size": 600,\n        },\n        {\n            "baseline_unknown_only": True,\n            "claim_kind": MPLAYMAIN_LITERAL_KIND,\n            "id": "mplaymain-literal-00-09a688",\n            "kind": "literal",\n            "range": [0x09A688, 0x09A694],\n            "semantic_class": MPLAYMAIN_LITERAL_CLASS,\n            "sha256": (\n                "d1b4099db32ee07e0e14f3d78937fcdda9ee750b9b3128d23d4d5e56df04c764"\n            ),\n            "size": 12,\n        },\n    ]\n    if rows != expected_rows:\n        raise ValueError("MPlayMain scheduler promotion rows changed")\n\n    primary = [claim for claim in baseline if claim.get("role") == "primary"]\n    for row in rows:\n        start, end = _validated_range(row, len(rom))\n        if row.get("sha256") != _sha256(rom[start:end]):\n            raise ValueError("MPlayMain scheduler promotion ROM bytes changed")\n        if any(\n            other_start < end and start < other_end\n            for other in primary\n            for other_start, other_end in [_validated_range(other, len(rom))]\n        ):\n            raise ValueError(\n                f"MPlayMain scheduler unknown projection overlap: {row.get(\'id\')}"\n            )\n    packed = b"".join(rom[start:end] for start, end in (row["range"] for row in rows))\n    if (\n        binary_path.read_bytes() != packed\n        or len(packed) != 612\n        or _sha256(packed) != MPLAYMAIN_BINARY_SHA256\n        or _sha256(_canonical_json_bytes(expected_promotion["union_ranges"]))\n        != MPLAYMAIN_UNION_RANGE_SHA256\n    ):\n        raise ValueError("MPlayMain scheduler packed denominator changed")\n\n    owner_id, owner_interval, owner_sha = MPLAYMAIN_OWNER\n    owner = next((claim for claim in primary if claim.get("id") == owner_id), None)\n    if (\n        not isinstance(owner, dict)\n        or owner.get("range") != list(owner_interval)\n        or owner.get("primary_class") != "armv4t_cfg_reachable_thumb_code"\n        or owner.get("bytes_sha256") != owner_sha\n        or _sha256(rom[slice(*owner_interval)]) != owner_sha\n    ):\n        raise ValueError("MPlayMain scheduler owned veneer identity changed")\n    gap_start, gap_end = MPLAYMAIN_GAP_RANGE\n    if _sha256(rom[gap_start:gap_end]) != MPLAYMAIN_GAP_SHA256:\n        raise ValueError("MPlayMain scheduler unknown gap identity changed")\n    if any(\n        other_start < gap_end and gap_start < other_end\n        for other in primary\n        for other_start, other_end in [_validated_range(other, len(rom))]\n    ):\n        raise ValueError("MPlayMain scheduler two-byte gap is no longer unknown")\n\n    non_claims = {key: value for key, value in scope.items() if value is False}\n    claims: list[dict[str, Any]] = []\n    for index, row in enumerate(rows):\n        start, end = row["range"]\n        claims.append(\n            {\n                "id": row["id"],\n                "range": [start, end],\n                "gba_range": [0x08000000 + start, 0x08000000 + end],\n                "role": "primary",\n                "primary_class": row["semantic_class"],\n                "claim_kind": row["claim_kind"],\n                "mode": "thumb" if row["kind"] == "code" else None,\n                "promotion_batch": MPLAYMAIN_BATCH,\n                "promoted_from_primary_class": "unknown",\n                "baseline_unknown_only": True,\n                "bytes_sha256": row["sha256"],\n                "artifact_range_id": row["id"],\n                "artifact_range_kind": row["kind"],\n                "promotion_union_range_count": 2,\n                "promotion_union_bytes": 612,\n                "promotion_union_range_vector_sha256": (\n                    MPLAYMAIN_UNION_RANGE_SHA256\n                ),\n                "evidence_path": (\n                    MPLAYMAIN_ARTIFACT / MPLAYMAIN_PAYLOAD_NAME\n                ).as_posix(),\n                "evidence_sha256": MPLAYMAIN_PAYLOAD_SHA256,\n                "evidence_selector": f"/promotion_ranges/{index}",\n                "promotion_manifest_path": (\n                    MPLAYMAIN_ARTIFACT / "manifest.json"\n                ).as_posix(),\n                "promotion_manifest_sha256": MPLAYMAIN_MANIFEST_SHA256,\n                "independent_verifier_path": (\n                    MPLAYMAIN_BUNDLE_VERIFIER.as_posix()\n                ),\n                "independent_verifier_sha256": (\n                    MPLAYMAIN_BUNDLE_VERIFIER_SHA256\n                ),\n                "accepted_legacy_verifier_path": MPLAYMAIN_VERIFIER.as_posix(),\n                "accepted_legacy_verifier_sha256": MPLAYMAIN_VERIFIER_SHA256,\n                "non_claims": non_claims,\n                "limitations": limitations,\n            }\n        )\n    return claims\n\n\ndef _soundmain_relocated_cfg_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote only the externally anchored SoundMain code/literal packet."""\n\n    root = Path(root).resolve(strict=True)\n    baseline = list(existing_claims)\n    claim_kinds = {\n        SOUNDMAIN_RELOCATED_CODE_KIND,\n        SOUNDMAIN_RELOCATED_LITERAL_KIND,\n    }\n    if any(\n        claim.get("promotion_batch") == SOUNDMAIN_RELOCATED_BATCH\n        or claim.get("claim_kind") in claim_kinds\n        for claim in baseline\n    ):\n        raise ValueError(\n            "SoundMain relocated claims require a pre-promotion baseline; batch is already present"\n        )\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError("SoundMain relocated ROM identity changed")\n\n    artifact = _checked_artifact_directory(\n        root,\n        SOUNDMAIN_RELOCATED_ARTIFACT,\n        {\n            "manifest.json",\n            SOUNDMAIN_RELOCATED_PAYLOAD_NAME,\n            SOUNDMAIN_RELOCATED_BINARY_NAME,\n        },\n        label="SoundMain relocated artifact",\n    )\n    manifest_path = _checked_repository_file(\n        root,\n        SOUNDMAIN_RELOCATED_ARTIFACT / "manifest.json",\n        SOUNDMAIN_RELOCATED_MANIFEST_SHA256,\n        expected_size=SOUNDMAIN_RELOCATED_MANIFEST_SIZE,\n        label="SoundMain relocated manifest",\n    )\n    payload_path = _checked_repository_file(\n        root,\n        SOUNDMAIN_RELOCATED_ARTIFACT / SOUNDMAIN_RELOCATED_PAYLOAD_NAME,\n        SOUNDMAIN_RELOCATED_PAYLOAD_SHA256,\n        expected_size=SOUNDMAIN_RELOCATED_PAYLOAD_SIZE,\n        label="SoundMain relocated payload",\n    )\n    binary_path = _checked_repository_file(\n        root,\n        SOUNDMAIN_RELOCATED_ARTIFACT / SOUNDMAIN_RELOCATED_BINARY_NAME,\n        SOUNDMAIN_RELOCATED_BINARY_SHA256,\n        expected_size=SOUNDMAIN_RELOCATED_BINARY_SIZE,\n        label="SoundMain relocated binary",\n    )\n    for path, expected, label in (\n        (\n            SOUNDMAIN_RELOCATED_EXPORTER,\n            SOUNDMAIN_RELOCATED_EXPORTER_SHA256,\n            "SoundMain relocated exporter",\n        ),\n        (\n            SOUNDMAIN_RELOCATED_VERIFIER,\n            SOUNDMAIN_RELOCATED_VERIFIER_SHA256,\n            "SoundMain relocated stage1 verifier",\n        ),\n        (\n            SOUNDMAIN_RELOCATED_BUNDLE_VERIFIER,\n            SOUNDMAIN_RELOCATED_BUNDLE_VERIFIER_SHA256,\n            "SoundMain relocated immutable bundle verifier",\n        ),\n        (\n            SOUNDMAIN_RELOCATED_EXPORTER_TEST,\n            SOUNDMAIN_RELOCATED_EXPORTER_TEST_SHA256,\n            "SoundMain relocated exporter test",\n        ),\n        (\n            SOUNDMAIN_RELOCATED_VERIFIER_TEST,\n            SOUNDMAIN_RELOCATED_VERIFIER_TEST_SHA256,\n            "SoundMain relocated verifier test",\n        ),\n        (\n            SOUNDMAIN_RELOCATED_BUNDLE_TEST,\n            SOUNDMAIN_RELOCATED_BUNDLE_TEST_SHA256,\n            "SoundMain relocated bundle test",\n        ),\n    ):\n        _checked_repository_file(root, path, expected, label=label)\n\n    manifest_raw = manifest_path.read_bytes()\n    payload_raw = payload_path.read_bytes()\n    try:\n        manifest = json.loads(manifest_raw)\n        payload = json.loads(payload_raw)\n    except (UnicodeDecodeError, json.JSONDecodeError) as error:\n        raise ValueError("SoundMain relocated artifact JSON is invalid") from error\n    if (\n        manifest_raw != _canonical_json_bytes(manifest)\n        or payload_raw != _canonical_json_bytes(payload)\n    ):\n        raise ValueError("SoundMain relocated artifact JSON is not canonical")\n\n    expected_implementation = {\n        "exporter": {\n            "path": SOUNDMAIN_RELOCATED_EXPORTER.as_posix(),\n            "sha256": SOUNDMAIN_RELOCATED_EXPORTER_SHA256,\n        },\n        "verifier": {\n            "path": SOUNDMAIN_RELOCATED_VERIFIER.as_posix(),\n            "sha256": SOUNDMAIN_RELOCATED_VERIFIER_SHA256,\n        },\n        "exporter_test": {\n            "path": SOUNDMAIN_RELOCATED_EXPORTER_TEST.as_posix(),\n            "sha256": SOUNDMAIN_RELOCATED_EXPORTER_TEST_SHA256,\n        },\n        "verifier_test": {\n            "path": SOUNDMAIN_RELOCATED_VERIFIER_TEST.as_posix(),\n            "sha256": SOUNDMAIN_RELOCATED_VERIFIER_TEST_SHA256,\n        },\n    }\n    expected_candidate_identity = {\n        "artifact_status": "candidate",\n        "manifest_sha256": SOUNDMAIN_RELOCATED_CANDIDATE_MANIFEST_SHA256,\n        "payload_sha256": SOUNDMAIN_RELOCATED_PAYLOAD_SHA256,\n        "bundle_sha256": SOUNDMAIN_RELOCATED_BINARY_SHA256,\n    }\n    if (\n        not isinstance(manifest, dict)\n        or not isinstance(payload, dict)\n        or manifest.get("schema") != "git-artifact-promotion-v1"\n        or manifest.get("artifact_schema") != SOUNDMAIN_RELOCATED_BATCH\n        or manifest.get("artifact_status") != "accepted"\n        or manifest.get("files")\n        != {\n            SOUNDMAIN_RELOCATED_BINARY_NAME: {\n                "sha256": SOUNDMAIN_RELOCATED_BINARY_SHA256,\n                "size": SOUNDMAIN_RELOCATED_BINARY_SIZE,\n            },\n            SOUNDMAIN_RELOCATED_PAYLOAD_NAME: {\n                "sha256": SOUNDMAIN_RELOCATED_PAYLOAD_SHA256,\n                "size": SOUNDMAIN_RELOCATED_PAYLOAD_SIZE,\n            },\n        }\n        or manifest.get("implementation") != expected_implementation\n        or payload.get("implementation") != expected_implementation\n        or manifest.get("summary") != SOUNDMAIN_RELOCATED_EXPECTED_SUMMARY\n        or payload.get("summary") != SOUNDMAIN_RELOCATED_EXPECTED_SUMMARY\n        or manifest.get("coverage_baseline") != payload.get("coverage_baseline")\n        or manifest.get("copy_operation") != payload.get("copy_operation")\n        or manifest.get("producer_denominator") != payload.get("producer_denominator")\n        or manifest.get("source") != payload.get("source")\n        or manifest.get("promotion") != payload.get("promotion")\n        or manifest.get("scope") != payload.get("scope")\n        or manifest.get("limitations") != payload.get("limitations")\n        or payload.get("schema") != SOUNDMAIN_RELOCATED_BATCH\n        or manifest.get("acceptance", {}).get("candidate_identity")\n        != expected_candidate_identity\n    ):\n        raise ValueError("SoundMain relocated promotion contract changed")\n\n    try:\n        report = verify_rom_soundmain_relocated_cfg_bundle(root, artifact)\n    except Exception as error:\n        raise ValueError(\n            f"SoundMain relocated independent verification failed: {error}"\n        ) from error\n    if (\n        not isinstance(report, dict)\n        or report.get("schema")\n        != "rom-soundmain-relocated-cfg-bundle-verification-v1"\n        or report.get("verified") is not True\n        or report.get("errors") != []\n        or report.get("artifact_schema") != SOUNDMAIN_RELOCATED_BATCH\n        or report.get("artifact_status") != "accepted"\n        or report.get("artifact_bundle_verified") is not True\n        or report.get("legacy_receipt_verified") is not True\n        or report.get("candidate_identity_verified") is not True\n        or report.get("live_coverage_verified") is not False\n        or report.get("rom_sha256") != ROM_SHA256\n        or report.get("promotion_bytes") != 924\n        or report.get("promotion_claim_count") != 6\n        or report.get("promotion_range_count") != 6\n        or report.get("promotion_union_range_count") != 5\n        or report.get("deferred_alignment_gap_bytes") != 6\n        or report.get("promotion_packed_sha256")\n        != SOUNDMAIN_RELOCATED_BINARY_SHA256\n        or report.get("accepted_manifest_sha256")\n        != SOUNDMAIN_RELOCATED_MANIFEST_SHA256\n        or report.get("candidate_manifest_sha256")\n        != SOUNDMAIN_RELOCATED_CANDIDATE_MANIFEST_SHA256\n        or report.get("legacy_verifier_sha256")\n        != SOUNDMAIN_RELOCATED_VERIFIER_SHA256\n        or report.get("bundle_verifier_sha256")\n        != SOUNDMAIN_RELOCATED_BUNDLE_VERIFIER_SHA256\n        or report.get("summary") != SOUNDMAIN_RELOCATED_EXPECTED_SUMMARY\n        or report.get("promotion") != payload.get("promotion")\n        or report.get("legacy_report", {}).get("contract_ok") is not True\n    ):\n        raise ValueError(\n            f"SoundMain relocated independent verification failed: {report}"\n        )\n\n    expected_promotion = {\n        "code_ranges": [\n            [0x099E10, 0x099E1A],\n            [0x099E1C, 0x099EC2],\n            [0x099EC8, 0x099FA6],\n            [0x099FA8, 0x09A1AE],\n        ],\n        "literal_ranges": [\n            [0x099EC4, 0x099EC8],\n            [0x09A1B0, 0x09A1B4],\n        ],\n        "semantic_union_ranges": [\n            [0x099E10, 0x099E1A],\n            [0x099E1C, 0x099EC2],\n            [0x099EC4, 0x099FA6],\n            [0x099FA8, 0x09A1AE],\n            [0x09A1B0, 0x09A1B4],\n        ],\n        "semantic_bytes": 924,\n        "semantic_claim_count": 6,\n        "semantic_packed_sha256": SOUNDMAIN_RELOCATED_BINARY_SHA256,\n        "semantic_union_range_vector_sha256": (\n            SOUNDMAIN_RELOCATED_UNION_RANGE_SHA256\n        ),\n        "deferred_alignment_gap_ranges": [\n            list(interval) for interval in SOUNDMAIN_RELOCATED_GAPS\n        ],\n        "deferred_alignment_gap_bytes": 6,\n        "alignment_gap_requires_accepted_immutable_artifact": True,\n        "projected_totals": {\n            "classified_bytes": 6_123_413,\n            "unknown_bytes": 168_043,\n            "claim_count": 14_490,\n            "segment_count": 16_600,\n        },\n        "post_gap_projected_totals": {\n            "classified_bytes": 6_123_419,\n            "unknown_bytes": 168_037,\n            "claim_count": 14_493,\n            "segment_count": 16_600,\n        },\n    }\n    promotion = payload.get("promotion")\n    rows = payload.get("promotion_ranges")\n    scope = payload.get("scope")\n    limitations = payload.get("limitations")\n    if (\n        promotion != expected_promotion\n        or not isinstance(rows, list)\n        or len(rows) != 6\n        or not isinstance(scope, dict)\n        or not isinstance(limitations, list)\n    ):\n        raise ValueError("SoundMain relocated promotion denominator changed")\n\n    expected_rows = [\n        ("soundmain-code-00-099e10", "code", [0x099E10, 0x099E1A], 10, "24afedc6cdbff9b7b4321f2e09ef10e899779307190eb09ceeaede96534e68ae", SOUNDMAIN_RELOCATED_CODE_CLASS, SOUNDMAIN_RELOCATED_CODE_KIND),\n        ("soundmain-code-01-099e1c", "code", [0x099E1C, 0x099EC2], 166, "28ceffde8c9efededde19ed0651c4dd7fd191443f26a1c24ceaadf2361a5f620", SOUNDMAIN_RELOCATED_CODE_CLASS, SOUNDMAIN_RELOCATED_CODE_KIND),\n        ("soundmain-literal-00-099ec4", "literal", [0x099EC4, 0x099EC8], 4, "2d04e57c5e80a3ae7f289b8ac025839a5b75d659b747ccd7e446f77e711a6663", SOUNDMAIN_RELOCATED_LITERAL_CLASS, SOUNDMAIN_RELOCATED_LITERAL_KIND),\n        ("soundmain-code-02-099ec8", "code", [0x099EC8, 0x099FA6], 222, "c804dcedcd92c3a0ec788ecb255aa1637ecdc838b9f1029c08ccb5cfb9fdea5e", SOUNDMAIN_RELOCATED_CODE_CLASS, SOUNDMAIN_RELOCATED_CODE_KIND),\n        ("soundmain-code-03-099fa8", "code", [0x099FA8, 0x09A1AE], 518, "34a9c442a64856a9eb8636a5d249a146260af74fe828dbbd338fe263eea90427", SOUNDMAIN_RELOCATED_CODE_CLASS, SOUNDMAIN_RELOCATED_CODE_KIND),\n        ("soundmain-literal-01-09a1b0", "literal", [0x09A1B0, 0x09A1B4], 4, "ee88b5a804fd87fa74b205951cfcc811ef5cdb452c4ad7f7cd1456fc90d71b90", SOUNDMAIN_RELOCATED_LITERAL_CLASS, SOUNDMAIN_RELOCATED_LITERAL_KIND),\n    ]\n    expected_row_objects = [\n        {\n            "id": identifier,\n            "kind": kind,\n            "range": interval,\n            "size": size,\n            "sha256": sha256,\n            "semantic_class": semantic_class,\n            "claim_kind": claim_kind,\n            "baseline_unknown_only": True,\n        }\n        for identifier, kind, interval, size, sha256, semantic_class, claim_kind\n        in expected_rows\n    ]\n    if rows != expected_row_objects:\n        raise ValueError("SoundMain relocated promotion rows changed")\n\n    primary = [claim for claim in baseline if claim.get("role") == "primary"]\n    for row in rows:\n        start, end = _validated_range(row, len(rom))\n        if row.get("sha256") != _sha256(rom[start:end]):\n            raise ValueError("SoundMain relocated promotion ROM bytes changed")\n        if any(\n            other_start < end and start < other_end\n            for other in primary\n            for other_start, other_end in [_validated_range(other, len(rom))]\n        ):\n            raise ValueError(\n                f"SoundMain relocated unknown projection overlap: {row.get(\'id\')}"\n            )\n    packed = b"".join(\n        rom[start:end] for start, end in (row["range"] for row in rows)\n    )\n    compact_union = (\n        json.dumps(\n            expected_promotion["semantic_union_ranges"],\n            ensure_ascii=False,\n            sort_keys=True,\n            separators=(",", ":"),\n        )\n        + "\\n"\n    ).encode("utf-8")\n    if (\n        binary_path.read_bytes() != packed\n        or len(packed) != SOUNDMAIN_RELOCATED_BINARY_SIZE\n        or _sha256(packed) != SOUNDMAIN_RELOCATED_BINARY_SHA256\n        or _sha256(compact_union) != SOUNDMAIN_RELOCATED_UNION_RANGE_SHA256\n    ):\n        raise ValueError("SoundMain relocated packed denominator changed")\n\n    owner_id, owner_interval, owner_sha = SOUNDMAIN_RELOCATED_OWNER\n    owner = next((claim for claim in primary if claim.get("id") == owner_id), None)\n    if (\n        not isinstance(owner, dict)\n        or owner.get("range") != list(owner_interval)\n        or owner.get("primary_class")\n        != "armv4t_boot_thumb_handoff_reachable_code"\n        or owner.get("bytes_sha256") != owner_sha\n        or _sha256(rom[slice(*owner_interval)]) != owner_sha\n    ):\n        raise ValueError("SoundMain relocated owned return veneer changed")\n    for gap_start, gap_end in SOUNDMAIN_RELOCATED_GAPS:\n        if _sha256(rom[gap_start:gap_end]) != SOUNDMAIN_RELOCATED_GAP_SHA256:\n            raise ValueError("SoundMain relocated deferred gap identity changed")\n        if any(\n            other_start < gap_end and gap_start < other_end\n            for other in primary\n            for other_start, other_end in [_validated_range(other, len(rom))]\n        ):\n            raise ValueError("SoundMain relocated deferred gap is no longer unknown")\n\n    non_claims = {key: value for key, value in scope.items() if value is False}\n    claims: list[dict[str, Any]] = []\n    for index, row in enumerate(rows):\n        start, end = row["range"]\n        claims.append({\n            "id": row["id"],\n            "range": [start, end],\n            "gba_range": [0x08000000 + start, 0x08000000 + end],\n            "role": "primary",\n            "primary_class": row["semantic_class"],\n            "claim_kind": row["claim_kind"],\n            "mode": (\n                "mixed_arm_thumb_relocated" if row["kind"] == "code" else None\n            ),\n            "promotion_batch": SOUNDMAIN_RELOCATED_BATCH,\n            "promoted_from_primary_class": "unknown",\n            "baseline_unknown_only": True,\n            "bytes_sha256": row["sha256"],\n            "artifact_range_id": row["id"],\n            "artifact_range_kind": row["kind"],\n            "promotion_union_range_count": 5,\n            "promotion_union_bytes": 924,\n            "promotion_union_range_vector_sha256": (\n                SOUNDMAIN_RELOCATED_UNION_RANGE_SHA256\n            ),\n            "evidence_path": (\n                SOUNDMAIN_RELOCATED_ARTIFACT / SOUNDMAIN_RELOCATED_PAYLOAD_NAME\n            ).as_posix(),\n            "evidence_sha256": SOUNDMAIN_RELOCATED_PAYLOAD_SHA256,\n            "evidence_selector": f"/promotion_ranges/{index}",\n            "promotion_manifest_path": (\n                SOUNDMAIN_RELOCATED_ARTIFACT / "manifest.json"\n            ).as_posix(),\n            "promotion_manifest_sha256": SOUNDMAIN_RELOCATED_MANIFEST_SHA256,\n            "candidate_manifest_sha256": (\n                SOUNDMAIN_RELOCATED_CANDIDATE_MANIFEST_SHA256\n            ),\n            "independent_verifier_path": (\n                SOUNDMAIN_RELOCATED_BUNDLE_VERIFIER.as_posix()\n            ),\n            "independent_verifier_sha256": (\n                SOUNDMAIN_RELOCATED_BUNDLE_VERIFIER_SHA256\n            ),\n            "accepted_stage1_verifier_path": (\n                SOUNDMAIN_RELOCATED_VERIFIER.as_posix()\n            ),\n            "accepted_stage1_verifier_sha256": (\n                SOUNDMAIN_RELOCATED_VERIFIER_SHA256\n            ),\n            "non_claims": non_claims,\n            "limitations": limitations,\n        })\n    return claims\n\n\ndef _soundmain_relocated_alignment_gap_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote three exact align4 gaps after the SoundMain semantic packet."""\n\n    root = Path(root).resolve(strict=True)\n    baseline = list(existing_claims)\n    for claim in baseline:\n        if not isinstance(claim, dict) or claim.get("role") not in {\n            "primary",\n            "secondary",\n        }:\n            raise ValueError("SoundMain alignment-gap baseline role is invalid")\n        _validated_range(claim, len(rom))\n    if any(\n        claim.get("promotion_batch") == SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_BATCH\n        or claim.get("claim_kind") == SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_CLAIM_KIND\n        or claim.get("id") in SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_IDS\n        for claim in baseline\n    ):\n        raise ValueError(\n            "SoundMain alignment-gap claims require a pre-promotion baseline; "\n            "batch is already present"\n        )\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError("SoundMain alignment-gap ROM identity changed")\n\n    expected_constants = (\n        SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_BATCH\n        == "rom-soundmain-relocated-alignment-gaps-v1",\n        SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_PRIMARY_CLASS\n        == "soundmain_relocated_artifact_bound_4byte_alignment_bytes",\n        SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_CLAIM_KIND\n        == "soundmain_relocated_alignment_gap_bytes",\n        SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_RANGES\n        == (\n            (0x099E1A, 0x099E1C),\n            (0x099EC2, 0x099EC4),\n            (0x099FA6, 0x099FA8),\n        ),\n        SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_IDS\n        == (\n            "soundmain-alignment-gap-00-099e1a",\n            "soundmain-alignment-gap-01-099ec2",\n            "soundmain-alignment-gap-02-099fa6",\n        ),\n        SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_BOUNDARY_IDS\n        == (\n            "soundmain-thumb-to-arm-099e1a",\n            "soundmain-branch-to-literal-099ec2",\n            "soundmain-thumb-to-arm-099fa6",\n        ),\n        SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_RIGHT_KINDS\n        == ("arm_block", "consumed_literal_range", "arm_block"),\n    )\n    if not all(expected_constants):\n        raise ValueError("SoundMain alignment-gap contract changed")\n\n    for path, expected_sha256, label in (\n        (\n            SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_VERIFIER,\n            SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_VERIFIER_SHA256,\n            "SoundMain alignment-gap verifier",\n        ),\n        (\n            SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_TEST,\n            SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_TEST_SHA256,\n            "SoundMain alignment-gap verifier test",\n        ),\n    ):\n        _checked_repository_file(root, path, expected_sha256, label=label)\n\n    identifiers = [claim.get("id") for claim in baseline]\n    if any(not isinstance(identifier, str) or not identifier for identifier in identifiers):\n        raise ValueError("SoundMain alignment-gap baseline has an invalid id")\n    if len(set(identifiers)) != len(identifiers):\n        raise ValueError("SoundMain alignment-gap baseline ids are not unique")\n\n    owner_by_id = {claim["id"]: claim for claim in baseline}\n    for owner_id, interval, primary_class, claim_kind, bytes_sha256 in (\n        SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_OWNER_SPECS\n    ):\n        owner = owner_by_id.get(owner_id)\n        expected = {\n            "range": list(interval),\n            "role": "primary",\n            "primary_class": primary_class,\n            "claim_kind": claim_kind,\n            "bytes_sha256": bytes_sha256,\n        }\n        if not isinstance(owner, dict) or any(\n            owner.get(key) != value for key, value in expected.items()\n        ):\n            raise ValueError(\n                f"SoundMain alignment-gap owner identity changed: {owner_id}"\n            )\n        if _sha256(rom[slice(*interval)]) != bytes_sha256:\n            raise ValueError(\n                f"SoundMain alignment-gap owner ROM identity changed: {owner_id}"\n            )\n\n    primary = [claim for claim in baseline if claim.get("role") == "primary"]\n    for gap_start, gap_end in SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_RANGES:\n        if any(\n            other_start < gap_end and gap_start < other_end\n            for other in primary\n            for other_start, other_end in [_validated_range(other, len(rom))]\n        ):\n            raise ValueError(\n                "SoundMain alignment-gap range is not current unknown; "\n                "baseline overlap found"\n            )\n\n    try:\n        report = verify_rom_soundmain_relocated_alignment_gaps(root)\n    except Exception as error:\n        raise ValueError(\n            f"SoundMain alignment-gap independent verification failed: {error}"\n        ) from error\n    if not isinstance(report, dict):\n        raise ValueError("SoundMain alignment-gap independent verification changed")\n    report_sha256 = _sha256(\n        json.dumps(\n            report,\n            ensure_ascii=True,\n            separators=(",", ":"),\n            sort_keys=True,\n        ).encode("ascii")\n    )\n    expected_non_claims = {\n        key: False for key in SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_NON_CLAIM_KEYS\n    }\n    expected_source_files = {\n        "manifest.json": {\n            "sha256": SOUNDMAIN_RELOCATED_MANIFEST_SHA256,\n            "size": SOUNDMAIN_RELOCATED_MANIFEST_SIZE,\n        },\n        SOUNDMAIN_RELOCATED_PAYLOAD_NAME: {\n            "sha256": SOUNDMAIN_RELOCATED_PAYLOAD_SHA256,\n            "size": SOUNDMAIN_RELOCATED_PAYLOAD_SIZE,\n        },\n        SOUNDMAIN_RELOCATED_BINARY_NAME: {\n            "sha256": SOUNDMAIN_RELOCATED_BINARY_SHA256,\n            "size": SOUNDMAIN_RELOCATED_BINARY_SIZE,\n        },\n        SOUNDMAIN_RELOCATED_BUNDLE_VERIFIER.name: {\n            "sha256": SOUNDMAIN_RELOCATED_BUNDLE_VERIFIER_SHA256,\n            "size": 10_678,\n        },\n    }\n    gaps = report.get("gaps")\n    if (\n        report.get("schema")\n        != "rom-soundmain-relocated-alignment-gaps-verification-v1"\n        or report.get("verified") is not True\n        or report.get("errors") != []\n        or report_sha256 != SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_REPORT_SHA256\n        or report.get("promotion_batch")\n        != SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_BATCH\n        or report.get("primary_class")\n        != SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_PRIMARY_CLASS\n        or report.get("claim_kind")\n        != SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_CLAIM_KIND\n        or report.get("gap_count") != 3\n        or report.get("byte_count") != 6\n        or report.get("zero_byte_count") != 6\n        or report.get("ranges")\n        != [list(pair) for pair in SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_RANGES]\n        or report.get("range_vector_sha256")\n        != SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_RANGE_VECTOR_SHA256\n        or report.get("boundary_vector_sha256")\n        != SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_BOUNDARY_VECTOR_SHA256\n        or report.get("claim_denominator_sha256")\n        != SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_CLAIM_DENOMINATOR_SHA256\n        or report.get("source_file_vector_sha256")\n        != SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_SOURCE_FILE_VECTOR_SHA256\n        or report.get("packed_bytes_sha256")\n        != SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_PACKED_BYTES_SHA256\n        or report.get("source_artifact_count") != 1\n        or report.get("source_bundle_verified") is not True\n        or report.get("source_files") != expected_source_files\n        or report.get("semantic_packet_modified") is not False\n        or report.get("all_alignment_equations_hold") is not True\n        or report.get("all_boundaries_exact") is not True\n        or report.get("non_claims") != expected_non_claims\n        or not isinstance(gaps, list)\n        or len(gaps) != 3\n    ):\n        raise ValueError("SoundMain alignment-gap independent verification changed")\n\n    packed = b"".join(\n        rom[start:end] for start, end in SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_RANGES\n    )\n    if (\n        packed != b"\\x00" * 6\n        or _sha256(packed)\n        != SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_PACKED_BYTES_SHA256\n    ):\n        raise ValueError("SoundMain alignment-gap byte denominator changed")\n\n    claims: list[dict[str, Any]] = []\n    for index, (\n        identifier,\n        boundary_id,\n        interval,\n        left_owner_id,\n        right_owner_id,\n        right_kind,\n        row,\n    ) in enumerate(\n        zip(\n            SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_IDS,\n            SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_BOUNDARY_IDS,\n            SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_RANGES,\n            SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_LEFT_OWNER_IDS,\n            SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_RIGHT_OWNER_IDS,\n            SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_RIGHT_KINDS,\n            gaps,\n            strict=True,\n        )\n    ):\n        start, end = interval\n        left_owner = owner_by_id[left_owner_id]\n        right_owner = owner_by_id[right_owner_id]\n        left_boundary = row.get("left_owner_range") if isinstance(row, dict) else None\n        right_boundary = row.get("right_range") if isinstance(row, dict) else None\n        if (\n            not isinstance(row, dict)\n            or row.get("id") != boundary_id\n            or row.get("gap_range") != [start, end]\n            or row.get("gap_size") != 2\n            or row.get("gap_raw_hex") != "0000"\n            or row.get("gap_sha256")\n            != SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_BYTES_SHA256\n            or row.get("right_kind") != right_kind\n            or row.get("gap_start_equals_left_owner_end") is not True\n            or row.get("gap_end_equals_align4_left_end") is not True\n            or row.get("right_start_equals_gap_end") is not True\n            or not isinstance(left_boundary, list)\n            or len(left_boundary) != 2\n            or not isinstance(right_boundary, list)\n            or len(right_boundary) != 2\n            or left_owner["range"][0] > left_boundary[0]\n            or left_boundary[1] != left_owner["range"][1]\n            or left_boundary[1] != start\n            or right_owner["range"][0] != right_boundary[0]\n            or right_boundary[0] != end\n            or right_boundary[1] > right_owner["range"][1]\n            or not isinstance(row.get("left_terminal"), dict)\n        ):\n            raise ValueError(\n                f"SoundMain alignment-gap boundary changed: {boundary_id}"\n            )\n        claims.append(\n            {\n                "id": identifier,\n                "range": [start, end],\n                "gba_range": [0x08000000 + start, 0x08000000 + end],\n                "role": "primary",\n                "primary_class": SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_PRIMARY_CLASS,\n                "claim_kind": SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_CLAIM_KIND,\n                "promotion_batch": SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_BATCH,\n                "promoted_from_primary_class": "unknown",\n                "baseline_unknown_only": True,\n                "resource_id": index,\n                "boundary_id": boundary_id,\n                "bytes_sha256": SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_BYTES_SHA256,\n                "packed_range": [index * 2, index * 2 + 2],\n                "packed_bytes_sha256": (\n                    SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_PACKED_BYTES_SHA256\n                ),\n                "range_vector_sha256": (\n                    SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_RANGE_VECTOR_SHA256\n                ),\n                "boundary_vector_sha256": (\n                    SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_BOUNDARY_VECTOR_SHA256\n                ),\n                "claim_denominator_sha256": (\n                    SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_CLAIM_DENOMINATOR_SHA256\n                ),\n                "source_file_vector_sha256": (\n                    SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_SOURCE_FILE_VECTOR_SHA256\n                ),\n                "all_zero": True,\n                "zero_byte_count": 2,\n                "alignment_bytes": 4,\n                "alignment_target": end,\n                "alignment_formula": (\n                    f"(0x{start:06X} + 3) & ~3 == 0x{end:06X}"\n                ),\n                "alignment_formula_expression": "(left_end + 3) & ~3",\n                "alignment_gap_bytes": 2,\n                "alignment_gap_is_exact": True,\n                "left_terminal": row["left_terminal"],\n                "previous_owner_id": left_owner_id,\n                "previous_owner_range": left_owner["range"],\n                "previous_owner_role": left_owner["role"],\n                "previous_owner_primary_class": left_owner["primary_class"],\n                "previous_owner_claim_kind": left_owner["claim_kind"],\n                "previous_owner_bytes_sha256": left_owner["bytes_sha256"],\n                "previous_boundary_range": left_boundary,\n                "next_owner_id": right_owner_id,\n                "next_owner_range": right_owner["range"],\n                "next_owner_role": right_owner["role"],\n                "next_owner_primary_class": right_owner["primary_class"],\n                "next_owner_claim_kind": right_owner["claim_kind"],\n                "next_owner_bytes_sha256": right_owner["bytes_sha256"],\n                "right_structure_kind": right_kind,\n                "right_structure_range": right_boundary,\n                "right_structure_sha256": row["right_sha256"],\n                "semantic_source_artifact_path": (\n                    SOUNDMAIN_RELOCATED_ARTIFACT.as_posix()\n                ),\n                "semantic_source_manifest_sha256": (\n                    SOUNDMAIN_RELOCATED_MANIFEST_SHA256\n                ),\n                "evidence_path": (\n                    SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_VERIFIER.as_posix()\n                ),\n                "evidence_sha256": (\n                    SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_VERIFIER_SHA256\n                ),\n                "evidence_selector": f"/gaps/{index}",\n                "independent_verifier_path": (\n                    SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_VERIFIER.as_posix()\n                ),\n                "independent_verifier_sha256": (\n                    SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_VERIFIER_SHA256\n                ),\n                "upstream_test_path": (\n                    SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_TEST.as_posix()\n                ),\n                "upstream_test_sha256": (\n                    SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_TEST_SHA256\n                ),\n                "independent_verifier_report_sha256": (\n                    SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_REPORT_SHA256\n                ),\n                "non_claims": expected_non_claims,\n                **expected_non_claims,\n                "limitations": [\n                    SOUNDMAIN_RELOCATED_ALIGNMENT_GAP_COVERAGE_LIMITATION\n                ],\n            }\n        )\n    return claims\n\n\ndef _m4a_initializer_chain_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote only the six accepted M4A initializer code/literal ranges."""\n\n    root = Path(root).resolve(strict=True)\n    baseline = list(existing_claims)\n    identifiers = {spec[0] for spec in M4A_INITIALIZER_RANGE_SPECS}\n    claim_kinds = {M4A_INITIALIZER_CODE_KIND, M4A_INITIALIZER_LITERAL_KIND}\n    if any(\n        claim.get("promotion_batch") == M4A_INITIALIZER_BATCH\n        or claim.get("claim_kind") in claim_kinds\n        or claim.get("id") in identifiers\n        for claim in baseline\n    ):\n        raise ValueError(\n            "M4A initializer claims require a pre-promotion baseline; "\n            "batch is already present"\n        )\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError("M4A initializer ROM identity changed")\n\n    try:\n        report = verify_rom_m4a_initializer_chain(\n            root, M4A_INITIALIZER_ARTIFACT\n        )\n    except Exception as error:\n        raise ValueError(\n            f"M4A initializer independent verification failed: {error}"\n        ) from error\n    if (\n        not isinstance(report, dict)\n        or report.get("schema")\n        != "rom-m4a-initializer-chain-verification-v1"\n        or report.get("verified") is not True\n        or report.get("contract_ok") is not True\n        or report.get("artifact_status") != "accepted"\n        or report.get("summary") != M4A_INITIALIZER_EXPECTED_SUMMARY\n        or report.get("bundle_sha256") != M4A_INITIALIZER_BINARY_SHA256\n        or report.get("payload_sha256") != M4A_INITIALIZER_PAYLOAD_SHA256\n        or report.get("manifest_sha256") != M4A_INITIALIZER_MANIFEST_SHA256\n        or report.get("coverage_baseline_sha256")\n        != "31cf4a9c14666345482cad325433814e7fe26d458327c3bc5d9a13e680616563"\n    ):\n        raise ValueError(\n            "M4A initializer independent verification identity changed: "\n            f"{report}"\n        )\n\n    manifest_path = _checked_repository_file(\n        root,\n        M4A_INITIALIZER_ARTIFACT / "manifest.json",\n        M4A_INITIALIZER_MANIFEST_SHA256,\n        expected_size=M4A_INITIALIZER_MANIFEST_SIZE,\n        label="M4A initializer accepted manifest",\n    )\n    payload_path = _checked_repository_file(\n        root,\n        M4A_INITIALIZER_ARTIFACT / M4A_INITIALIZER_PAYLOAD_NAME,\n        M4A_INITIALIZER_PAYLOAD_SHA256,\n        expected_size=M4A_INITIALIZER_PAYLOAD_SIZE,\n        label="M4A initializer accepted payload",\n    )\n    binary_path = _checked_repository_file(\n        root,\n        M4A_INITIALIZER_ARTIFACT / M4A_INITIALIZER_BINARY_NAME,\n        M4A_INITIALIZER_BINARY_SHA256,\n        expected_size=M4A_INITIALIZER_BINARY_SIZE,\n        label="M4A initializer accepted binary",\n    )\n    candidate_manifest_path = _checked_repository_file(\n        root,\n        M4A_INITIALIZER_ARTIFACT / "candidate" / "manifest.json",\n        M4A_INITIALIZER_CANDIDATE_MANIFEST_SHA256,\n        expected_size=M4A_INITIALIZER_CANDIDATE_MANIFEST_SIZE,\n        label="M4A initializer embedded candidate manifest",\n    )\n    _checked_repository_file(\n        root,\n        M4A_INITIALIZER_ARTIFACT\n        / "candidate"\n        / M4A_INITIALIZER_PAYLOAD_NAME,\n        M4A_INITIALIZER_PAYLOAD_SHA256,\n        expected_size=M4A_INITIALIZER_PAYLOAD_SIZE,\n        label="M4A initializer embedded candidate payload",\n    )\n    _checked_repository_file(\n        root,\n        M4A_INITIALIZER_ARTIFACT\n        / "candidate"\n        / M4A_INITIALIZER_BINARY_NAME,\n        M4A_INITIALIZER_BINARY_SHA256,\n        expected_size=M4A_INITIALIZER_BINARY_SIZE,\n        label="M4A initializer embedded candidate binary",\n    )\n    _checked_repository_file(\n        root,\n        M4A_INITIALIZER_PRE_COVERAGE_ARTIFACT / "manifest.json",\n        M4A_INITIALIZER_PRE_COVERAGE_MANIFEST_SHA256,\n        expected_size=M4A_INITIALIZER_PRE_COVERAGE_MANIFEST_SIZE,\n        label="M4A initializer immutable pre-coverage manifest",\n    )\n    _checked_repository_file(\n        root,\n        M4A_INITIALIZER_PRE_COVERAGE_ARTIFACT / "rom-byte-coverage.json.gz",\n        M4A_INITIALIZER_PRE_COVERAGE_ARCHIVE_SHA256,\n        expected_size=M4A_INITIALIZER_PRE_COVERAGE_ARCHIVE_SIZE,\n        label="M4A initializer immutable pre-coverage archive",\n    )\n    for path, expected_sha, label in (\n        (\n            M4A_INITIALIZER_EXPORTER,\n            M4A_INITIALIZER_EXPORTER_SHA256,\n            "M4A initializer exporter",\n        ),\n        (\n            M4A_INITIALIZER_VERIFIER,\n            M4A_INITIALIZER_VERIFIER_SHA256,\n            "M4A initializer verifier",\n        ),\n        (\n            M4A_INITIALIZER_EXPORTER_TEST,\n            M4A_INITIALIZER_EXPORTER_TEST_SHA256,\n            "M4A initializer exporter test",\n        ),\n        (\n            M4A_INITIALIZER_VERIFIER_TEST,\n            M4A_INITIALIZER_VERIFIER_TEST_SHA256,\n            "M4A initializer verifier test",\n        ),\n    ):\n        _checked_repository_file(root, path, expected_sha, label=label)\n\n    manifest_raw = manifest_path.read_bytes()\n    payload_raw = payload_path.read_bytes()\n    try:\n        manifest = json.loads(manifest_raw)\n        payload = json.loads(payload_raw)\n    except (UnicodeDecodeError, json.JSONDecodeError) as error:\n        raise ValueError("M4A initializer artifact JSON is invalid") from error\n    if (\n        manifest_raw != _canonical_json_bytes(manifest)\n        or payload_raw != _canonical_json_bytes(payload)\n    ):\n        raise ValueError("M4A initializer artifact JSON is not canonical")\n\n    expected_implementation = {\n        "exporter": {\n            "path": M4A_INITIALIZER_EXPORTER.as_posix(),\n            "sha256": M4A_INITIALIZER_EXPORTER_SHA256,\n        },\n        "exporter_test": {\n            "path": M4A_INITIALIZER_EXPORTER_TEST.as_posix(),\n            "sha256": M4A_INITIALIZER_EXPORTER_TEST_SHA256,\n        },\n        "verifier": {\n            "path": M4A_INITIALIZER_VERIFIER.as_posix(),\n            "sha256": M4A_INITIALIZER_VERIFIER_SHA256,\n        },\n        "verifier_test": {\n            "path": M4A_INITIALIZER_VERIFIER_TEST.as_posix(),\n            "sha256": M4A_INITIALIZER_VERIFIER_TEST_SHA256,\n        },\n    }\n    expected_rows = [\n        {\n            "id": identifier,\n            "kind": kind,\n            "range": list(interval),\n            "size": interval[1] - interval[0],\n            "sha256": sha256,\n            "mode": mode,\n            "semantic_class": semantic_class,\n            "claim_kind": claim_kind,\n        }\n        for (\n            identifier,\n            kind,\n            interval,\n            sha256,\n            mode,\n            semantic_class,\n            claim_kind,\n        ) in M4A_INITIALIZER_RANGE_SPECS\n    ]\n    limitations = list(M4A_INITIALIZER_LIMITATIONS)\n    expected_coverage_claims = [\n        {\n            **row,\n            "role": "primary",\n            "promotion_batch": M4A_INITIALIZER_BATCH,\n            "promoted_from_primary_class": "unknown",\n            "non_claims": dict(M4A_INITIALIZER_SCOPE),\n            "limitations": limitations,\n        }\n        for row in expected_rows\n    ]\n    union_ranges = [\n        [0x09AA3C, 0x09AAB4],\n        [0x09ACF8, 0x09AE10],\n        [0x09B17C, 0x09B1E6],\n        [0x09B1E8, 0x09B1F4],\n    ]\n    expected_promotion = {\n        "ranges": [row["range"] for row in expected_rows],\n        "union_ranges": union_ranges,\n        "union_range_count": 4,\n        "union_bytes": 518,\n        "range_count": 6,\n        "byte_count": 518,\n        "range_sha256": [row["sha256"] for row in expected_rows],\n        "range_vector_sha256": M4A_INITIALIZER_RANGE_VECTOR_SHA256,\n        "packed_bytes_sha256": M4A_INITIALIZER_BINARY_SHA256,\n        "code_bytes": 390,\n        "literal_bytes": 128,\n    }\n    expected_coverage_baseline = {\n        "path": "sequel/rom-byte-coverage.json",\n        "schema": "rom-byte-covera