rage-audit-v1",\n        "verified": not errors,\n        "state_inventory_complete": expected["state_inventory_complete"],\n        "semantic_classification_complete": expected[\n            "semantic_classification_complete"\n        ],\n        "summary": expected["summary"],\n        "errors": errors,\n    }\n\n\ndef _write_manifest_atomic(path: Path, manifest: dict[str, Any]) -> None:\n    path.parent.mkdir(parents=True, exist_ok=True)\n    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")\n    try:\n        temporary.write_text(\n            json.dumps(manifest, ensure_ascii=False, indent=2, sort_keys=True)\n            + "\\n",\n            encoding="utf-8",\n        )\n        os.replace(temporary, path)\n    finally:\n        temporary.unlink(missing_ok=True)\n\n\ndef _report_from_built_manifest(\n    manifest: dict[str, Any], *, errors: list[str]\n) -> dict[str, Any]:\n    return {\n        "schema": "rom-byte-coverage-audit-v1",\n        "verified": not errors,\n        "state_inventory_complete": manifest["state_inventory_complete"],\n        "semantic_classification_complete": manifest[\n            "semantic_classification_complete"\n        ],\n        "summary": manifest["summary"],\n        "errors": errors,\n    }\n\n\ndef main(argv: list[str] | None = None) -> int:\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument("--root", type=Path, default=Path.cwd())\n    parser.add_argument(\n        "--manifest",\n        type=Path,\n        default=Path("sequel/rom-byte-coverage.json"),\n    )\n    parser.add_argument("--write", action="store_true")\n    parser.add_argument(\n        "--require-semantic-complete",\n        action="store_true",\n        help="return 2 when the manifest is reproducible but any ROM byte remains unknown",\n    )\n    args = parser.parse_args(argv)\n    manifest_path = args.manifest\n    if not manifest_path.is_absolute():\n        manifest_path = args.root / manifest_path\n    if ar