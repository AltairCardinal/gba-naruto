{\n        "pre": {\n            "classified_bytes": 6_124_499,\n            "unknown_bytes": 166_957,\n            "claim_count": 14_503,\n            "segment_count": 16_614,\n        },\n        "post": {\n            "classified_bytes": 6_124_601,\n            "unknown_bytes": 166_855,\n            "claim_count": 14_507,\n            "segment_count": 16_617,\n        },\n        "classified_delta": 102,\n        "unknown_delta": -102,\n        "claim_delta": 4,\n        "segment_delta": 3,\n    }\n    expected_baseline_source = {\n        "kind": "immutable-gzip-artifact",\n        "artifact": MP2K_DISPATCHER_PRE_COVERAGE_ARTIFACT.as_posix(),\n        "manifest_sha256": MP2K_DISPATCHER_PRE_COVERAGE_MANIFEST_SHA256,\n        "archive_file": "rom-byte-coverage.json.gz",\n        "archive_size": MP2K_DISPATCHER_PRE_COVERAGE_ARCHIVE_SIZE,\n        "archive_sha256": MP2K_DISPATCHER_PRE_COVERAGE_ARCHIVE_SHA256,\n        "raw_size": MP2K_DISPATCHER_BASELINE_SIZE,\n        "raw_sha256": MP2K_DISPATCHER_BASELINE_SHA256,\n        "recovery_kind": "direct-frozen-prepromotion-snapshot",\n    }\n    expected_existing_ranges = [\n        {"claim_id": claim_id, "range": list(interval)}\n        for claim_id, interval in MP2K_DISPATCHER_EXISTING_OWNER_SPECS\n    ]\n    expected_baseline = {\n        "all_promotion_bytes_unknown": True,\n        "existing_primary_ranges": expected_existing_ranges,\n        "initializer_pointer_owner_claim_id": "psg-initializer-literals-09adc0",\n        "path": "sequel/rom-byte-coverage.json",\n        "primary_overlap_bytes": 0,\n        "promotion_bytes": 102,\n        "schema": "rom-byte-coverage-v1",\n        "sha256": MP2K_DISPATCHER_BASELINE_SHA256,\n        "size": MP2K_DISPATCHER_BASELINE_SIZE,\n        "summary": expected_projection["pre"],\n        "target_segments": [\n            {\n                "primary_claim_ids": [],\n                "primary_class": "unknown",\n                "range": [636_220, 638_180],\n            },\n            {\n                "primary_claim_ids": [],\n                "primary_class": "unknown",\n                "range": [638_244, 638_256],\n            },\n            {\n                "primary_claim_ids": [],\n                "primary_class": "unknown",\n                "range": [638_404, 638_444],\n            },\n            {\n                "primary_claim_ids": [],\n                "primary_class": "unknown",\n                "range": [638_458, 638_464],\n            },\n        ],\n        "unknown_promotion_bytes": 102,\n    }\n    expected_files = {\n        MP2K_DISPATCHER_BINARY_NAME: {\n            "size": MP2K_DISPATCHER_BINARY_SIZE,\n            "sha256": MP2K_DISPATCHER_BINARY_SHA256,\n        },\n        MP2K_DISPATCHER_PAYLOAD_NAME: {\n            "size": MP2K_DISPATCHER_PAYLOAD_SIZE,\n            "sha256": MP2K_DISPATCHER_PAYLOAD_SHA256,\n        },\n    }\n    expected_candidate_identity = {\n        "artifact_status": "candidate",\n        "manifest_sha256": MP2K_DISPATCHER_CANDIDATE_MANIFEST_SHA256,\n        "payload_sha256": MP2K_DISPATCHER_PAYLOAD_SHA256,\n        "bundle_sha256": MP2K_DISPATCHER_BINARY_SHA256,\n    }\n    expected_acceptance = {\n        "kind": "independent-self-contained-candidate-acceptance",\n        "candidate_artifact": (\n            MP2K_DISPATCHER_ARTIFACT / "candidate"\n        ).as_posix(),\n        "output_artifact": MP2K_DISPATCHER_ARTIFACT.as_posix(),\n        "candidate_identity": expected_candidate_identity,\n    }\n    if (\n        manifest.get("schema") != "git-artifact-promotion-v1"\n        or manifest.get("artifact_schema") != MP2K_DISPATCHER_BATCH\n        or manifest.get("artifact_status") != "accepted"\n        or payload.get("schema") != MP2K_DISPATCHER_BATCH\n        or manifest.get("files") != expected_files\n        or candidate_manifest.get("files") != expected_files\n        or manifest.get("implementation") != expected_implementation\n        or payload.get("implementation") != expected_implementation\n        or candidate_manifest.get("implementation") != expected_implementation\n        or manifest.get("summary") != MP2K_DISPATCHER_EXPECTED_SUMMARY\n        or payload.get("summary") != MP2K_DISPATCHER_EXPECTED_SUMMARY\n        or candidate_manifest.get("summary") != MP2K_DISPATCHER_EXPECTED_SUMMARY\n        or manifest.get("coverage_baseline") != expected_baseline\n        or payload.get("coverage_baseline") != expected_baseline\n        or candidate_manifest.get("coverage_baseline") != expected_baseline\n        or manifest.get("coverage_baseline_source")\n        != expected_baseline_source\n        or payload.get("coverage_baseline_source") != expected_baseline_source\n        or candidate_manifest.get("coverage_baseline_source")\n        != expected_baseline_source\n        or manifest.get("coverage_projection") != expected_projection\n        or payload.get("coverage_projection") != expected_projection\n        or candidate_manifest.get("coverage_projection") != expected_projection\n        or manifest.get("promotion") != expected_promotion\n        or payload.get("promotion") != expected_promotion\n        or candidate_manifest.get("promotion") != expected_promotion\n        or manifest.get("promotion_ranges") != expected_rows\n        or payload.get("promotion_ranges") != expected_rows\n        or candidate_manifest.get("promotion_ranges") != expected_rows\n        or payload.get("coverage_claims") != expected_coverage_claims\n        or manifest.get("excluded_ranges") != expected_excluded\n        or payload.get("excluded_ranges") != expected_excluded\n        or candidate_manifest.get("excluded_ranges") != expected_excluded\n        or payload.get("unclassified_unknown_ranges")\n        != [list(interval) for interval, _ in MP2K_DISPATCHER_EXCLUDED_SPECS]\n        or manifest.get("scope") != MP2K_DISPATCHER_SCOPE\n        or payload.get("scope") != MP2K_DISPATCHER_SCOPE\n        or manifest.get("limitations") != limitations\n        or payload.get("limitations") != limitations\n        or manifest.get("acceptance") != expected_acceptance\n        or candidate_manifest.get("artifact_status") != "candidate"\n    ):\n        raise ValueError("MP2K dispatcher promotion contract changed")\n\n    dispatcher = payload.get("dispatcher")\n    producer = payload.get("producer_denominator")\n    initializer = payload.get("initializer_binding")\n    if (\n        not isinstance(dispatcher, dict)\n        or dispatcher.get("accepted_index_domain") != [0, 17]\n        or dispatcher.get("accepted_value_count") != 18\n        or not isinstance(producer, dict)\n        or producer.get("target_limited_raw_producer_denominator_complete")\n        is not True\n        or producer.get("computed_or_indirect_producer_denominator_complete")\n        is not False\n        or producer.get("global_producer_denominator_complete") is not False\n        or producer.get("all_producer_source_membership_proven") is not True\n        or producer.get("all_producer_bytes_promoted") is not False\n        or producer.get("producer_form_vector_sha256")\n        != "ed31137a1e9b7c539050d0e252f36d5812907c52a192188d275ff43aaa05b107"\n        or len(producer.get("producer_roles", [])) != 19\n        or not isinstance(initializer, dict)\n        or initializer.get("entry_pointer_occurrences") != [634_328]\n        or initializer.get("entry_pointer_root_offset") != 638_132\n        or initializer.get("destination_address") != 50_361_664\n    ):\n        raise ValueError("MP2K dispatcher denominator contract changed")\n\n    primary = [claim for claim in baseline if claim.get("role") == "primary"]\n    for claim_id, expected_interval in MP2K_DISPATCHER_EXISTING_OWNER_SPECS:\n        matches = [claim for claim in primary if claim.get("id") == claim_id]\n        if (\n            len(matches) != 1\n            or _validated_range(matches[0], len(rom)) != expected_interval\n        ):\n            raise ValueError(\n                f"MP2K dispatcher existing owner provenance changed: {claim_id}"\n            )\n    initializer_owners = [\n        claim\n        for claim in primary\n        if claim.get("id") == "psg-initializer-literals-09adc0"\n    ]\n    if (\n        len(initializer_owners) != 1\n        or _validated_range(initializer_owners[0], len(rom))\n        != (634_304, 634_384)\n    ):\n        raise ValueError("MP2K dispatcher initializer owner provenance changed")\n\n    for row in expected_rows:\n        start, end = _validated_range(row, len(rom))\n        if row["sha256"] != _sha256(rom[start:end]):\n            raise ValueError("MP2K dispatcher promotion ROM bytes changed")\n        if any(\n            other_start < end and start < other_end\n            for other in primary\n            for other_start, other_end in [_validated_range(other, len(rom))]\n        ):\n            raise ValueError("MP2K dispatcher unknown projection overlap")\n    for interval, expected_sha in MP2K_DISPATCHER_EXCLUDED_SPECS:\n        start, end = interval\n        if any(\n            other_start < end and start < other_end\n            for other in primary\n            for other_start, other_end in [_validated_range(other, len(rom))]\n        ):\n            raise ValueError("MP2K dispatcher excluded bytes are no longer unknown")\n        if _sha256(rom[start:end]) != expected_sha:\n            raise ValueError("MP2K dispatcher excluded ROM bytes changed")\n\n    packed = b"".join(rom[start:end] for start, end in map(tuple, union_ranges))\n    compact_union = json.dumps(\n        union_ranges,\n        ensure_ascii=False,\n        sort_keys=True,\n        separators=(",", ":"),\n    ).encode("utf-8")\n    if (\n        binary_path.read_bytes() != packed\n        or len(packed) != MP2K_DISPATCHER_BINARY_SIZE\n        or _sha256(packed) != MP2K_DISPATCHER_BINARY_SHA256\n        or _sha256(compact_union) != MP2K_DISPATCHER_RANGE_VECTOR_SHA256\n        or sum(\n            row["bytes"]\n            for row in expected_rows\n            if row["kind"] == MP2K_DISPATCHER_CODE_KIND\n        )\n        != 86\n        or sum(\n            row["bytes"]\n            for row in expected_rows\n            if row["kind"] == MP2K_DISPATCHER_TABLE_KIND\n        )\n        != 12\n        or sum(\n            row["bytes"]\n            for row in expected_rows\n            if row["kind"] == MP2K_DISPATCHER_LITERAL_KIND\n        )\n        != 4\n    ):\n        raise ValueError("MP2K dispatcher coverage denominator changed")\n\n    claims: list[dict[str, Any]] = []\n    for index, (spec, row) in enumerate(\n        zip(MP2K_DISPATCHER_RANGE_SPECS, expected_rows, strict=True)\n    ):\n        claim_id, claim_kind, interval, _, mode = spec\n        start, end = interval\n        claims.append(\n            {\n                "id": claim_id,\n                "range": [start, end],\n                "gba_range": [0x08000000 + start, 0x08000000 + end],\n                "role": "primary",\n                "primary_class": row["semantic_class"],\n                "claim_kind": claim_kind,\n                "mode": mode,\n                "promotion_batch": MP2K_DISPATCHER_BATCH,\n                "promoted_from_primary_class": "unknown",\n                "baseline_unknown_only": True,\n                "bytes_sha256": row["sha256"],\n                "artifact_range_index": index,\n                "artifact_range_kind": row["kind"],\n                "promotion_union_range_count": 4,\n                "promotion_union_bytes": 102,\n                "promotion_union_range_vector_sha256": (\n                    MP2K_DISPATCHER_RANGE_VECTOR_SHA256\n                ),\n                "evidence_path": (\n                    MP2K_DISPATCHER_ARTIFACT / MP2K_DISPATCHER_PAYLOAD_NAME\n                ).as_posix(),\n                "evidence_sha256": MP2K_DISPATCHER_PAYLOAD_SHA256,\n                "evidence_selector": f"/coverage_claims/{index}",\n                "promotion_manifest_path": (\n                    M