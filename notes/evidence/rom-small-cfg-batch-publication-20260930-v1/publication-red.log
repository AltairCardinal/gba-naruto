fier canonical path",\n        ),\n        (\n            BATTLE_PRESENTATION_GAP_RIGHT_UPSTREAM_TEST,\n            Path("tests/test_export_tile_asset_bg_layers.py"),\n            "right upstream test canonical path",\n        ),\n        (\n            BATTLE_PRESENTATION_GAP_RIGHT_BANK_PATH,\n            Path("sequel/content/tile-assets/bank.json"),\n            "right bank canonical path",\n        ),\n        (\n            BATTLE_PRESENTATION_GAP_LEFT_MANIFEST_SHA256,\n            "ecc44fde0d886b75397d34181112f5b86dbb791b09e3b85797e9b4013f4e74a7",\n            "left manifest hash",\n        ),\n        (\n            BATTLE_PRESENTATION_GAP_LEFT_VERIFIER_SHA256,\n            "0c2b219f87bbdc19dc64aee97f2e131783978dc7c4dc70deb2c1764c9a9766fb",\n            "left verifier hash",\n        ),\n        (\n            BATTLE_PRESENTATION_GAP_LEFT_UPSTREAM_TEST_SHA256,\n            "0337a0db38640b28af048a22043914ee2cdfce85bc5242bca819cf29d993adfb",\n            "left upstream test hash",\n        ),\n        (\n            BATTLE_PRESENTATION_GAP_RIGHT_MANIFEST_SHA256,\n            "1df63cf6cf49079115e997c6f0f33c57578e517dbe22dc16c15f64c4d218a749",\n            "right manifest hash",\n        ),\n        (\n            BATTLE_PRESENTATION_GAP_RIGHT_VERIFIER_SHA256,\n            "4273c6d0cada4e7d018a805e5c96fca9654c19aabeff9a1a7b26e5aa8380d57c",\n            "right verifier hash",\n        ),\n        (\n            BATTLE_PRESENTATION_GAP_RIGHT_UPSTREAM_TEST_SHA256,\n            "f5bc75c6dee2eb487ef26ed91ee3e4663e5cb5c3237d5e3887659822d5330448",\n            "right upstream test hash",\n        ),\n        (\n            BATTLE_PRESENTATION_GAP_RIGHT_BANK_SHA256,\n            "9ef92f5c358f114a660eeea42ab5358f37435047d7bb91708c3a80274d5df218",\n            "right bank hash",\n        ),\n    )\n    for actual, expected, label in expected_constant_values:\n        if actual != expected:\n            raise ValueError(\n                f"battle presentation tile-assets alignment gap {label} contract changed"\n            )\n\n    start, end = BATTLE_PRESENTATION_TILE_ASSETS_GAP_RANGE\n    aligned_end = (start + 3) & ~3\n    if (\n        aligned_end != end\n        or end - start != 2\n        or list(BATTLE_PRESENTATION_TILE_ASSETS_GAP_GBA_RANGE)\n        != [GBA_ROM_BASE + start, GBA_ROM_BASE + end]\n    ):\n        raise ValueError(\n            "battle presentation tile-assets alignment gap alignment contract changed"\n        )\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError(\n            "battle presentation tile-assets alignment gap ROM identity changed"\n        )\n\n    baseline_by_id: dict[str, dict[str, Any]] = {}\n    overlapping_primary_ids: list[str] = []\n    overlapping_secondary_ids: list[str] = []\n    for claim in baseline_claims:\n        if not isinstance(claim, dict):\n            raise ValueError(\n                "battle presentation tile-assets alignment gap baseline claim changed"\n            )\n        identifier = claim.get("id")\n        if not isinstance(identifier, str) or not identifier:\n            raise ValueError(\n                "battle presentation tile-assets alignment gap baseline claim ID changed"\n            )\n        if identifier in baseline_by_id:\n            raise ValueError(\n                "battle presentation tile-assets alignment gap baseline claim IDs are not unique"\n            )\n        role = claim.get("role")\n        if role not in {"primary", "secondary"}:\n            raise ValueError(\n                "battle presentation tile-assets alignment gap baseline claim role changed"\n            )\n        if role == "primary" and not isinstance(claim.get("primary_class"), str):\n            raise ValueError(\n                "battle presentation tile-assets alignment gap baseline primary class changed"\n            )\n        claim_start, claim_end = _validated_range(claim, len(rom))\n        baseline_by_id[identifier] = claim\n        if claim_start < end and start < claim_end:\n            if role == "primary":\n                overlapping_primary_ids.append(identifier)\n            else:\n                overlapping_secondary_ids.append(identifier)\n    if overlapping_primary_ids:\n        raise ValueError(\n            "battle presentation tile-assets alignment gap range is not fully current unknown; "\n            f"existing primary claims: {overlapping_primary_ids}"\n        )\n    if overlapping_secondary_ids:\n        raise ValueError(\n            "battle presentation tile-assets alignment gap range has secondary claim overlap: "\n            f"{overlapping_secondary_ids}"\n        )\n\n    left_owner = baseline_by_id.get(BATTLE_PRESENTATION_GAP_LEFT_OWNER_ID)\n    right_owner = baseline_by_id.get(BATTLE_PRESENTATION_GAP_RIGHT_OWNER_ID)\n    if not isinstance(left_owner, dict) or not isinstance(right_owner, dict):\n        raise ValueError(\n            "battle presentation tile-assets alignment gap adjacent owner denominator changed"\n        )\n    expected_left_owner = {\n        "range": list(BATTLE_PRESENTATION_GAP_LEFT_OWNER_RANGE),\n        "role": "primary",\n        "primary_class": BATTLE_PRESENTATION_GAP_LEFT_OWNER_PRIMARY_CLASS,\n        "claim_kind": BATTLE_PRESENTATION_GAP_LEFT_OWNER_CLAIM_KIND,\n        "evidence_path": BATTLE_PRESENTATION_GAP_LEFT_MANIFEST_PATH.as_posix(),\n        "evidence_sha256": BATTLE_PRESENTATION_GAP_LEFT_MANIFEST_SHA256,\n        "record_count": BATTLE_PRESENTATION_BINDING_TABLE_RECORD_COUNT,\n        "record_size": BATTLE_PRESENTATION_BINDING_TABLE_RECORD_SIZE,\n        "bytes_sha256": BATTLE_PRESENTATION_BINDING_TABLE_SHA256,\n    }\n    expected_right_owner = {\n        "range": list(BATTLE_PRESENTATION_GAP_RIGHT_OWNER_RANGE),\n        "role": "primary",\n        "primary_class": BATTLE_PRESENTATION_GAP_RIGHT_OWNER_PRIMARY_CLASS,\n        "claim_kind": BATTLE_PRESENTATION_GAP_RIGHT_OWNER_CLAIM_KIND,\n        "evidence_path": BATTLE_PRESENTATION_GAP_RIGHT_BANK_PATH.as_posix(),\n        "evidence_sha256": BATTLE_PRESENTATION_GAP_RIGHT_BANK_SHA256,\n        "records": TILE_ASSETS_TABLE_RECORD_COUNT,\n        "bytes_sha256": TILE_ASSETS_TABLE_SHA256,\n    }\n    if any(left_owner.get(key) != value for key, value in expected_left_owner.items()):\n        raise ValueError(\n            "battle presentation tile-assets alignment gap left owner identity changed"\n        )\n    if any(right_owner.get(key) != value for key, value in expected_right_owner.items()):\n        raise ValueError(\n            "battle presentation tile-assets alignment gap right owner identity changed"\n        )\n    if (\n        left_owner["range"][1] != start\n        or right_owner["range"][0] != end\n        or right_owner["range"][1] - right_owner["range"][0]\n        != TILE_ASSETS_TABLE_RECORD_COUNT * TILE_ASSETS_TABLE_RECORD_SIZE\n    ):\n        raise ValueError(\n            "battle presentation tile-assets alignment gap owner boundary contract changed"\n        )\n\n    def checked_path(\n        path: Path,\n        canonical: Path,\n        label: str,\n        *,\n        directory: bool = False,\n    ) -> Path:\n        expected = root / canonical\n        candidate = path if path.is_absolute() else root / path\n        if candidate != expected:\n            raise ValueError(\n                f"battle presentation tile-assets alignment gap {label} path contract changed"\n            )\n        try:\n            resolved = candidate.resolve(strict=True)\n            resolved.relative_to(root)\n        except (OSError, ValueError) as error:\n            raise ValueError(\n                f"battle presentation tile-assets alignment gap {label} is invalid"\n            ) from error\n        if candidate.is_symlink() or resolved != candidate:\n            raise ValueError(\n                f"battle presentation tile-assets alignment gap {label} uses a symlink"\n            )\n        if directory:\n            if not candidate.is_dir():\n                raise ValueError(\n                    f"battle presentation tile-assets alignment gap {label} is not a directory"\n                )\n        elif not candidate.is_file():\n            raise ValueError(\n                f"battle presentation tile-assets alignment gap {label} is not a file"\n            )\n        return candidate\n\n    left_artifact = checked_path(\n        BATTLE_PRESENTATION_GAP_LEFT_ARTIFACT,\n        Path("artifacts/battle-presentation-glyphs-v1"),\n        "left artifact",\n        directory=True,\n    )\n    right_artifact = checked_path(\n        BATTLE_PRESENTATION_GAP_RIGHT_ARTIFACT,\n        Path("artifacts/tile-assets-bg-v2"),\n        "right artifact",\n        directory=True,\n    )\n    for artifact, label in (\n        (left_artifact, "left artifact"),\n        (right_artifact, "right artifact"),\n    ):\n        if any(path.is_symlink() for path in artifact.rglob("*")):\n            raise ValueError(\n                f"battle presentation tile-assets alignment gap {label} contains a symlink"\n            )\n    left_manifest = checked_path(\n        BATTLE_PRESENTATION_GAP_LEFT_MANIFEST_PATH,\n        Path("artifacts/battle-presentation-glyphs-v1/manifest.json"),\n        "left manifest",\n    )\n    right_manifest = checked_path(\n        BATTLE_PRESENTATION_GAP_RIGHT_MANIFEST_PATH,\n        Path("artifacts/tile-assets-bg-v2/manifest.json"),\n        "right manifest",\n    )\n    left_verifier = checked_path(\n        BATTLE_PRESENTATION_GAP_LEFT_VERIFIER,\n        Path("tools/verify_battle_presentation_rom_ranges.py"),\n        "left verifier",\n    )\n    right_verifier = checked_path(\n        BATTLE_PRESENTATION_GAP_RIGHT_VERIFIER,\n        Path("tools/verify_tile_asset_bg_export.py"),\n        "right verifier",\n    )\n    left_upstream_test = checked_path(\n        BATTLE_PRESENTATION_GAP_LEFT_UPSTREAM_TEST,\n        Path("tests/test_verify_battle_presentation_rom_ranges.py"),\n        "left upstream test",\n    )\n    right_upstream_test = checked_path(\n        BATTLE_PRESENTATION_GAP_RIGHT_UPSTREAM_TEST,\n        Path("tests/test_export_tile_asset_bg_layers.py"),\n        "right upstream test",\n    )\n    right_bank = checked_path(\n        BATTLE_PRESENTATION_GAP_RIGHT_BANK_PATH,\n        Path("sequel/content/tile-assets/bank.json"),\n        "right bank evidence",\n    )\n    if (\n        left_manifest != left_artifact / "manifest.json"\n        or right_manifest != right_artifact / "manifest.json"\n    ):\n        raise ValueError(\n            "battle presentation tile-assets alignment gap manifest path is outside artifact"\n        )\n    checked_identities = (\n        (\n            left_manifest,\n            BATTLE_PRESENTATION_GAP_LEFT_MANIFEST_SHA256,\n            "left manifest",\n        ),\n        (\n            right_manifest,\n            BATTLE_PRESENTATION_GAP_RIGHT_MANIFEST_SHA256,\n            "right manifest",\n        ),\n        (\n            left_verifier,\n            BATTLE_PRESENTATION_GAP_LEFT_VERIFIER_SHA256,\n            "left verifier",\n        ),\n        (\n            right_verifier,\n            BATTLE_PRESENTATION_GAP_RIGHT_VERIFIER_SHA256,\n            "right verifier",\n        ),\n        (\n            left_upstream_test,\n            BATTLE_PRESENTATION_GAP_LEFT_UPSTREAM_TEST_SHA256,\n            "left upstream test",\n        ),\n        (\n            right_upstream_test,\n            BATTLE_PRESENTATION_GAP_RIGHT_UPSTREAM_TEST_SHA256,\n            "right upstream test",\n        ),\n        (right_bank, BATTLE_PRESENTATION_GAP_RIGHT_BANK_SHA256, "right bank evidence"),\n    )\n    for path, expected_sha, label in checked_identities:\n        if _sha256_file(path) != expected_sha:\n            raise ValueError(\n                f"battle presentation tile-assets alignment gap {label} changed"\n            )\n\n    def read_document(path: Path, label: str) -> dict[str, Any]:\n        try:\n            value = json.loads(path.read_bytes())\n        except (OSError, TypeError, ValueError) as error:\n            raise ValueError(\n                f"battle presentation tile-assets alignment gap {label} is invalid"\n            ) from error\n        if not isinstance(value, dict):\n            raise ValueError(\n                f"battle presentation tile-assets alignment gap {label} is not an object"\n            )\n        return value\n\n    left_document = read_document(left_manifest, "left manifest")\n    right_document = read_document(right_manifest, "right manifest")\n    if (\n        left_document.get("schema") != "battle-presentation-glyphs-v1"\n        or left_document.get("rom")\n        != {"file": ROM_PATH.as_posix(), "sha256": ROM_SHA256}\n        or left_document.get("summary") != BATTLE_PRESENTATION_EXPECTED_SUMMARY\n    ):\n        raise ValueError(\n            "battle presentation tile-assets alignment gap left manifest identity changed"\n        )\n\n    tables = left_document.get("tables")\n    if not isinstance(tables, dict) or set(tables) != set(BATTLE_PRESENTATION_TABLES):\n        raise ValueError(\n            "battle presentation tile-assets alignment gap left table denominator changed"\n        )\n    for name, expected in BATTLE_PRESENTATION_TABLES.items():\n        table = tables.get(name)\n        table_start, table_end = expected["range"]\n        raw = rom[table_start:table_end]\n        if (\n            not isinstance(table, dict)\n            or table.get("file_offset") != table_start\n            or table.get("gba_address")\n            != f"0x{GBA_ROM_BASE + table_start:08X}"\n            or table.get("gba_end") != f"0x{GBA_ROM_BASE + table_end:08X}"\n            or table.get("entry_count") != expected["entry_count"]\n            or table.get("entry_size") != expected["entry_size"]\n            or table.get("sha256") != _sha256(raw)\n            or len(raw) != expected["entry_count"] * expected["entry_size"]\n        ):\n            raise ValueError(\n                f"battle presentation tile-assets alignment gap {name} table changed"\n            )\n    binding_table = tables["bindings"]\n    if (\n        binding_table.get("file_offset") != BATTLE_PRESENTATION_BINDING_TABLE_RANGE[0]\n        or binding_table.get("entry_count")\n        != BATTLE_PRESENTATION_BINDING_TABLE_RECORD_COUNT\n        or binding_table.get("entry_size")\n        != BATTLE_PRESENTATION_BINDING_TABLE_RECORD_SIZE\n        or binding_table.get("sha256") != BATTLE_PRESENTATION_BINDING_TABLE_SHA256\n        or _sha256(rom[BATTLE_PRESENTATION_BINDING_TABLE_RANGE[0] : BATTLE_PRESENTATION_BINDING_TABLE_RANGE[1]])\n        != BATTLE_PRESENTATION_BINDING_TABLE_SHA256\n    ):\n        raise ValueError(\n            "battle presentation tile-assets alignment gap binding table denominator changed"\n        )\n\n    messages = left_document.get("messages")\n    if not isinstance(messages, list) or len(messages) != BATTLE_PRESENTATION_BINDING_TABLE_RECORD_COUNT:\n        raise ValueError(\n            "battle presentation tile-assets alignment gap message denominator changed"\n        )\n    for message_id, message in enumerate(messages):\n        if not isinstance(message, dict) or message.get("message_id") != message_id:\n            raise ValueError(\n                "battle presentation tile-assets alignment gap message IDs changed"\n            )\n        binding = message.get("binding")\n        binding_start = BATTLE_PRESENTATION_BINDING_TABLE_RANGE[0] + message_id * BATTLE_PRESENTATION_BINDING_TABLE_RECORD_SIZE\n        binding_raw = rom[binding_start : binding_start + BATTLE_PRESENTATION_BINDING_TABLE_RECORD_SIZE]\n        glyph_count = binding_raw[0]\n        glyph_ids = list(binding_raw[1 : 1 + glyph_count])\n        if (\n            not isinstance(binding, dict)\n            or binding.get("file_offset") != binding_start\n            or binding.get("gba_address") != f"0x{GBA_ROM_BASE + binding_start:08X}"\n            or binding.get("raw_size") != BATTLE_PRESENTATION_BINDING_TABLE_RECORD_SIZE\n            or binding.get("raw_hex") != binding_raw.hex()\n            or binding.get("glyph_count") != glyph_count\n            or binding.get("glyph_ids") != glyph_ids\n        ):\n            raise ValueError(\n                f"battle presentation tile-assets alignment gap binding record changed: {message_id}"\n            )\n    final_record_raw = rom[\n        BATTLE_PRESENTATION_FINAL_RECORD_RANGE[0] : BATTLE_PRESENTATION_FINAL_RECORD_RANGE[1]\n    ]\n    final_message = messages[BATTLE_PRESENTATION_FINAL_RECORD_INDEX]\n    final_binding = final_message["binding"]\n    if (\n        BATTLE_PRESENTATION_FINAL_RECORD_RANGE\n        != (\n            BATTLE_PRESENTATION_BINDING_TABLE_RANGE[0]\n            + BATTLE_PRESENTATION_FINAL_RECORD_INDEX\n            * BATTLE_PRESENTATION_BINDING_TABLE_RECORD_SIZE,\n            BATTLE_PRESENTATION_BINDING_TABLE_RANGE[1],\n        )\n        or final_record_raw.hex() != BATTLE_PRESENTATION_FINAL_RECORD_RAW_HEX\n        or _sha256(final_record_raw) != BATTLE_PRESENTATION_FINAL_RECORD_SHA256\n        or final_binding.get("raw_hex") != BATTLE_PRESENTATION_FINAL_RECORD_RAW_HEX\n        or final_binding.get("glyph_count") != BATTLE_PRESENTATION_FINAL_RECORD_GLYPH_COUNT\n        or final_binding.get("glyph_ids") != list(BATTLE_PRESENTATION_FINAL_RECORD_GLYPH_IDS)\n    ):\n        raise ValueError(\n            "battle presentation tile-assets alignment gap final binding record changed"\n        )\n\n    if (\n        right_document.get("schema") != "tile-assets-bg-export-v2"\n        or right_document.get("rom")\n        != {\n            "path": ROM_PATH.as_posix(),\n            "size": len(rom),\n            "sha256": ROM_SHA256,\n        }\n        or right_document.get("source_bank")\n        != BATTLE_PRESENTATION_GAP_RIGHT_BANK_PATH.as_posix()\n        or right_document.get("descriptor_count") != TILE_ASSETS_TABLE_RECORD_COUNT\n        or right_document.get("complete_layer_count") != 236\n        or right_document.get("partial_layer_count") != 1\n        or right_document.get("unique_palette_count") != 107\n    ):\n        raise ValueError(\n            "battle presentation tile-assets alignment gap right manifest identity changed"\n        )\n    source_table = right_document.get("source_table")\n    right_start, right_end = TILE_ASSETS_TABLE_RANGE\n    right_raw = rom[right_start:right_end]\n    if (\n        not isinstance(source_table, dict)\n        or source_table.get("file_offset") != right_start\n        or source_table.get("gba_address")\n        != f"0x{GBA_ROM_BASE + right_start:08X}"\n        or source_table.get("entry_count") != TILE_ASSETS_TABLE_RECORD_COUNT\n        or source_table.get("entry_size") != TILE_ASSETS_TABLE_RECORD_SIZE\n        or source_table.get("sha256") != TILE_ASSETS_TABLE_SHA256\n        or source_table.get("verification") != "code_verified"\n        or len(right_raw) != TILE_ASSETS_TABLE_RECORD_COUNT * TILE_ASSETS_TABLE_RECORD_SIZE\n        or _sha256(right_raw) != TILE_ASSETS_TABLE_SHA256\n    ):\n        raise ValueError(\n            "battle presentation tile-assets alignment gap tile-assets table denominator changed"\n        )\n    descriptors = right_document.get("descriptors")\n    if not isinstance(descriptors, list) or len(descriptors) != TILE_ASSETS_TABLE_RECORD_COUNT:\n        raise ValueError(\n            "battle presentation tile-assets alignment gap descriptor denominator changed"\n        )\n    for descriptor_id, descriptor in enumerate(descriptors):\n        row_start = right_start + descriptor_id * TILE_ASSETS_TABLE_RECORD_SIZE\n        if (\n            not isinstance(descriptor, dict)\n            or descriptor.get("descriptor_id") != descriptor_id\n            or descriptor.get("consumer_id") != descriptor_id + 1\n            or descriptor.get("descriptor_file_offset") != row_start\n            or descriptor.get("descriptor_gba_address")\n            != f"