numerate(messages):\n        if not isinstance(message, dict) or message.get("message_id") != message_id:\n            raise ValueError("battle presentation message IDs changed")\n        start = message.get("file_offset")\n        size = message.get("raw_size")\n        pointer = message.get("pointer")\n        if not isinstance(start, int) or not isinstance(size, int):\n            raise ValueError("battle presentation message range changed")\n        end = start + size\n        if (\n            start < previous_end\n            or start < 0\n            or start >= end\n            or end > message_table_start\n            or pointer != f"0x{GBA_ROM_BASE + start:08X}"\n        ):\n            raise ValueError("battle presentation message layout changed")\n        raw = rom[start:end]\n        bytes_sha256 = _sha256(raw)\n        if (\n            raw[-1:] != b"\\0"\n            or message.get("raw_sha256") != bytes_sha256\n            or message.get("raw_hex") != raw.hex()\n        ):\n            raise ValueError("battle presentation message bytes changed")\n        claims.append(\n            {\n                "id": f"battle-presentation-message-{message_id:03d}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": "battle_presentation_encoded_text",\n                "claim_kind": "battle_presentation_message",\n                "message_id": message_id,\n                "bytes_sha256": bytes_sha256,\n                "evidence_path": (\n                    BATTLE_PRESENTATION_ARTIFACT / "manifest.json"\n                ).as_posix(),\n                "evidence_sha256": evidence_sha256,\n            }\n        )\n        previous_end = end\n        message_bytes += size\n    if message_bytes != 1_148:\n        raise ValueError("battle presentation message byte denominator changed")\n\n    palette = manifest.get("runtime_palette")\n    palette_start = 0x3E4AF0\n    palette_end = palette_start + 32\n    palette_raw = rom[palette_start:palette_end]\n    if (\n        not isinstance(palette, dict)\n        or palette.get("file_offset") != palette_start\n        or palette.get("gba_address") != "0x083E4AF0"\n        or palette.get("size") != 32\n        or palette.get("color_count") != 16\n        or palette.get("format") != "BGR555"\n        or palette.get("palette_bank") != 13\n        or palette.get("obj_palette_destination") != "0x050003A0"\n        or palette.get("sha256") != _sha256(palette_raw)\n    ):\n        raise ValueError("battle presentation runtime palette changed")\n    claims.append(\n        {\n            "id": "battle-presentation-runtime-palette",\n            "range": [palette_start, palette_end],\n            "role": "primary",\n            "primary_class": "palette_bgr555",\n            "claim_kind": "battle_presentation_palette",\n            "color_count": 16,\n            "palette_bank": 13,\n            "destination": "0x050003A0",\n            "bytes_sha256": _sha256(palette_raw),\n            "evidence_path": (\n                BATTLE_PRESENTATION_ARTIFACT / "manifest.json"\n            ).as_posix(),\n            "evidence_sha256": evidence_sha256,\n        }\n    )\n    return claims\n\n\ndef _similar_table_adjudication_claims(\n    root: Path, rom: bytes\n) -> list[dict[str, Any]]:\n    verifier_path = root / "tools/verify_similar_table_candidates.py"\n    if _sha256_file(verifier_path) != SIMILAR_TABLE_VERIFIER_SHA256:\n        raise ValueError("similar-table verifier SHA-256 changed")\n    scan_path = root / SIMILAR_TABLE_SCAN\n    adjudication_path = root / SIMILAR_TABLE_ADJUDICATIONS\n    scan_raw = scan_path.read_bytes()\n    adjudication_raw = adjudication_path.read_bytes()\n    if _sha256(scan_raw) != SIMILAR_TABLE_SCAN_SHA256:\n        raise ValueError("similar-table scan SHA-256 changed")\n    evidence_sha256 = _sha256(adjudication_raw)\n    if evidence_sha256 != SIMILAR_TABLE_ADJUDICATIONS_SHA256:\n        raise ValueError("similar-table adjudication SHA-256 changed")\n    scan = json.loads(scan_raw)\n    adjudications = json.loads(adjudication_raw)\n    verification = verify_repository_manifests(root, scan, adjudications)\n    if verification != {\n        "schema": "similar-table-candidates-verification-v1",\n        "verified": True,\n        "candidate_count": 114,\n        "adjudicated_candidate_count": 114,\n        "open_candidate_count": 0,\n        "decision_counts": {\n            "accepted": 60,\n            "alias_of": 26,\n            "rejected": 28,\n        },\n        "errors": [],\n    }:\n        raise ValueError(\n            "similar-table adjudications failed independent verification: "\n            + "; ".join(verification.get("errors", []))\n        )\n    decisions = adjudications.get("adjudications")\n    if not isinstance(decisions, list) or len(decisions) != 114:\n        raise ValueError("similar-table adjudication denominator changed")\n    by_id = {\n        item.get("candidate_id"): item\n        for item in decisions\n        if isinstance(item, dict)\n    }\n    if len(by_id) != 114 or set(by_id) != set(range(1, 115)):\n        raise ValueError("similar-table adjudication coverage changed")\n\n    claims: list[dict[str, Any]] = []\n\n    def add_range(\n        candidate_id: int,\n        value: object,\n        semantic_type: object,\n        expected_sha256: object,\n        relation: str,\n    ) -> None:\n        if (\n            not isinstance(value, list)\n            or len(value) != 2\n            or not all(isinstance(boundary, int) for boundary in value)\n            or not isinstance(semantic_type, str)\n            or not isinstance(expected_sha256, str)\n        ):\n            raise ValueError(\n                f"similar-table candidate {candidate_id} claim schema changed"\n            )\n        start, end = value\n        if start < 0 or start >= end or end > len(rom):\n            raise ValueError(\n                f"similar-table candidate {candidate_id} claim escapes ROM"\n            )\n        bytes_sha256 = _sha256(rom[start:end])\n        if bytes_sha256 != expected_sha256:\n            raise ValueError(\n                f"similar-table candidate {candidate_id} range hash changed"\n            )\n        claims.append(\n            {\n                "id": (\n                    f"similar-table-candidate-{candidate_id:03d}-"\n                    f"range-{len(claims):03d}"\n                ),\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": semantic_type,\n                "claim_kind": "similar_table_adjudicated_range",\n                "candidate_id": candidate_id,\n                "adjudication_relation": relation,\n                "bytes_sha256": bytes_sha256,\n                "evidence_path": SIMILAR_TABLE_ADJUDICATIONS.as_posix(),\n                "evidence_sha256": evidence_sha256,\n            }\n        )\n\n    for candidate_id in sorted(SIMILAR_TABLE_EXACT_ACCEPTED_IDS):\n        decision = by_id[candidate_id]\n        if (\n            decision.get("status") != "accepted"\n            or decision.get("relation") != "exact_consumer_bound_table"\n            or decision.get("candidate_range") != decision.get("canonical_range")\n        ):\n            raise ValueError(\n                f"similar-table candidate {candidate_id} acceptance changed"\n            )\n        add_range(\n            candidate_id,\n            decision.get("canonical_range"),\n            decision.get("semantic_type"),\n            decision.get("canonical_sha256"),\n            "exact_consumer_bound_table",\n        )\n\n    for candidate_id in sorted(SIMILAR_TABLE_CONSUMER_BOUND_ALIAS_IDS):\n        decision = by_id[candidate_id]\n        candidate_range = decision.get("candidate_range")\n        canonical_range = decision.get("canonical_range")\n        if (\n            decision.get("status") != "alias_of"\n            or decision.get("relation") != "strict_subrange"\n            or not isinstance(candidate_range, list)\n            or not isinstance(canonical_range, list)\n            or len(candidate_range) != 2\n            or len(canonical_range) != 2\n            or not (\n                canonical_range[0] <= candidate_range[0]\n                and candidate_range[1] <= canonical_range[1]\n                and canonical_range != candidate_range\n            )\n            or decision.get("evidence", {}).get("path") != ROM_PATH.as_posix()\n        ):\n            raise ValueError(\n                f"similar-table candidate {candidate_id} alias changed"\n            )\n        add_range(\n            candidate_id,\n            canonical_range,\n            (\n                decision.get("semantic_type")\n                if candidate_id == 92\n                else "consumer_bound_pointer_table"\n            ),\n            decision.get("canonical_sha256"),\n            "strict_subrange",\n        )\n\n    for candidate_id in sorted(SIMILAR_TABLE_INLINE_REJECTED_IDS):\n        decision = by_id[candidate_id]\n        partitions = decision.get("partitions")\n        if (\n            decision.get("status") != "rejected"\n            or decision.get("relation") != "crosses_canonical_table_boundary"\n            or not isinstance(partitions, list)\n            or len(partitions) != 2\n            or [item.get("semantic_type") for item in partitions]\n            != ["thumb_dispatch_literal_pool", "thumb_pc_relative_jump_table"]\n        ):\n            raise ValueError(\n                f"similar-table candidate {candidate_id} inline split changed"\n            )\n        for partition in partitions:\n            add_range(\n                candidate_id,\n                partition.get("range"),\n                partition.get("semantic_type"),\n                partition.get("sha256"),\n                "crosses_canonical_table_boundary",\n            )\n\n    literal_pool = by_id[23]\n    if (\n        literal_pool.get("status") != "rejected"\n        or literal_pool.get("relation") != "thumb_literal_pool_not_indexed_table"\n        or literal_pool.get("pc_relative_ldr_reference_count") != 17\n        or literal_pool.get("distinct_literal_word_count") != 16\n    ):\n        raise ValueError("similar-table candidate 23 rejection changed")\n    add_range(\n        23,\n        literal_pool.get("literal_pool_range"),\n        "thumb_literal_pool",\n        literal_pool.get("literal_pool_sha256"),\n        "thumb_literal_pool_not_indexed_table",\n    )\n\n    for candidate_id, semantic_type in (\n        (77, "unbound_thumb_code_pointer_pool"),\n        (84, "map_sprite_callback_pointer_pair"),\n    ):\n        decision = by_id[candidate_id]\n        partitions = decision.get("partitions")\n        if (\n            decision.get("status") != "rejected"\n            or decision.get("relation") != "crosses_canonical_table_boundary"\n            or not isinstance(partitions, list)\n            or len(partitions) != 2\n            or partitions[0].get("semantic_type") != semantic_type\n            or partitions[0].get("evidence", {}).get("path")\n            != ROM_PATH.as_posix()\n        ):\n            raise ValueError(\n                f"similar-table candidate {candidate_id} prefix changed"\n            )\n        add_range(\n            candidate_id,\n            partitions[0].get("range"),\n            semantic_type,\n            partitions[0].get("sha256"),\n            "crosses_canonical_table_boundary",\n        )\n    if len(claims) != 55 or sum(\n        claim["range"][1] - claim["range"][0] for claim in claims\n    ) != 6_304:\n        raise ValueError("similar-table coverage denominator changed")\n    return claims\n\n\ndef _tile_bg_palette_claims(root: Path, rom: bytes) -> list[dict[str, Any]]:\n    artifact_dir = (root / TILE_BG_ARTIFACT).absolute()\n    try:\n        resolved_artifact_dir = artifact_dir.resolve(strict=True)\n        resolved_artifact_dir.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError("tile BG artifact is missing") from error\n    if resolved_artifact_dir != artifact_dir or not artifact_dir.is_dir():\n        raise ValueError("tile BG artifact uses a symlink")\n    manifest_path = artifact_dir / "manifest.json"\n    manifest_raw = manifest_path.read_bytes()\n    evidence_sha256 = _sha256(manifest_raw)\n    if evidence_sha256 != TILE_BG_MANIFEST_SHA256:\n        raise ValueError("tile BG manifest SHA-256 changed")\n    manifest = json.loads(manifest_raw)\n    if (\n        manifest.get("schema") != "tile-assets-bg-export-v2"\n        or manifest.get("rom")\n        != {\n            "path": ROM_PATH.as_posix(),\n            "size": len(rom),\n            "sha256": ROM_SHA256,\n        }\n        or manifest.get("descriptor_count") != 79\n        or manifest.get("complete_layer_count") != 236\n        or manifest.get("unique_palette_count") != 107\n    ):\n        raise ValueError("tile BG manifest denominator changed")\n    table_start, table_end = TILE_BG_TABLE_RANGE\n    table = manifest.get("source_table")\n    if (\n        not isinstance(table, dict)\n        or table.get("file_offset") != table_start\n        or table.get("gba_address") != "0x085A320C"\n        or table.get("entry_count") != 79\n        or table.get("entry_size") != 68\n        or table.get("sha256") != TILE_BG_TABLE_SHA256\n        or _sha256(rom[table_start:table_end]) != TILE_BG_TABLE_SHA256\n    ):\n        raise ValueError("tile BG descriptor table changed")\n    descriptors = manifest.get("descriptors")\n    if not isinstance(descriptors, list) or len(descriptors) != 79:\n        raise ValueError("tile BG descriptor list changed")\n\n    ranges: dict[tuple[int, int], dict[str, Any]] = {}\n    palette_entry_count = 0\n    for descriptor_id, descriptor in enumerate(descriptors):\n        row_start = table_start + descriptor_id * 68\n        if (\n            not isinstance(descriptor, dict)\n            or descriptor.get("descriptor_id") != descriptor_id\n            or descriptor.get("descriptor_file_offset") != row_start\n            or descriptor.get("descriptor_gba_address")\n            != f"0x{GBA_ROM_BASE + row_start:08X}"\n        ):\n            raise ValueError(f"tile BG descriptor {descriptor_id} identity changed")\n        raw_words = descriptor.get("raw_words")\n        if not isinstance(raw_words, list) or len(raw_words) != 17:\n            raise ValueError(f"tile BG descriptor {descriptor_id} words changed")\n        try:\n            words = [int(value, 16) for value in raw_words]\n        except (TypeError, ValueError) as error:\n            raise ValueError(\n                f"tile BG descriptor {descriptor_id} word encoding changed"\n            ) from error\n        if b"".join(value.to_bytes(4, "little") for value in words) != rom[\n            row_start : row_start + 68\n        ]:\n            raise ValueError(f"tile BG descriptor {descriptor_id} differs from ROM")\n        layers = descriptor.get("layers")\n        if not isinstance(layers, list):\n            raise ValueError(f"tile BG descriptor {descriptor_id} layers changed")\n        seen_names: set[str] = set()\n        for layer in layers:\n            if not isinstance(layer, dict):\n                raise ValueError(f"tile BG descriptor {descriptor_id} layer changed")\n            name = layer.get("name")\n            if name not in TILE_BG_PALETTE_WORDS or name in seen_names:\n                raise ValueError(f"tile BG descriptor {descriptor_id} layer name changed")\n            seen_names.add(name)\n            palette = layer.get("palette")\n            if palette is None:\n                continue\n            if not isinstance(palette, dict):\n                raise ValueError(f"tile BG descriptor {descriptor_id} palette changed")\n            pointer = words[TILE_BG_PALETTE_WORDS[name]]\n            start = palette.get("file_offset")\n            size = palette.get("size")\n            bits_per_pixel = layer.get("bits_per_pixel")\n            expected_size = 32 if bits_per_pixel == 4 else 128 if bits_per_pixel == 8 else 0\n            if (\n                not isinstance(start, int)\n                or size != expected_size\n                or pointer != GBA_ROM_BASE + start\n                or layer.get("palette_pointer") != f"0x{pointer:08X}"\n                or palette.get("gba_address") != f"0x{pointer:08X}"\n                or start < 0\n                or start + size > len(rom)\n            ):\n                raise ValueError(\n                    f"tile BG descriptor {descriptor_id} layer {name} palette binding changed"\n                )\n            end = start + size\n            bytes_sha256 = _sha256(rom[start:end])\n            if palette.get("sha256") != bytes_sha256:\n                raise ValueError(\n                    f"tile BG descriptor {descriptor_id} layer {name} palette hash changed"\n                )\n            key = (start, end)\n            item = ranges.setdefault(\n                key,\n                {\n                    "bytes_sha256": bytes_sha256,\n                    "bits_per_pixel": bits_per_pixel,\n                    "bindings": [],\n                },\n            )\n            if (\n                item["bytes_sha256"] != bytes_sha256\n                or item["bits_per_pixel"] != bits_per_pixel\n            ):\n                raise ValueError("tile BG palette range has conflicting semantics")\n            item["bindings"].append(\n                {"descriptor_id": descriptor_id, "layer": name}\n            )\n            palette_entry_count += 1\n    if palette_entry_count != 236 or len(ranges) != 108:\n        raise ValueError("tile BG palette source denominator changed")\n    ordered = sorted(ranges)\n    if any(start < previous_end for (_, previous_end), (start, _) in zip(ordered, ordered[1:])):\n        raise ValueError("tile BG palette source ranges overlap")\n    merged: list[dict[str, Any]] = []\n    for start, end in ordered:\n        source = ranges[(start, end)]\n        if merged and merged[-1]["range"][1] == start:\n            if merged[-1]["bits_per_pixel"] != source["bits_per_pixel"]:\n                raise ValueError("adjacent tile BG palettes disagree on format")\n            merged[-1]["range"][1] = end\n            merged[-1]["bindings"].extend(source["bindings"])\n            merged[-1]["source_ranges"].append([start, end])\n        else:\n            merged.append(\n                {\n                    "range": [start, end],\n                    "bits_per_pixel": source["bits_per_pixel"],\n                    "bindings": list(source["bindings"]),\n                    "source_ranges": [[start, end]],\n                }\n            )\n    claims = []\n    for item in merged:\n        start, end = item["range"]\n        claims.append(\n            {\n                "id": f"tile-bg-palette-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": "palette_bgr555",\n                "claim_kind": "tile_bg_palette_source_range",\n                "color_count": (end - start) // 2,\n                "bits_per_pixel": item["bits_per_pixel"],\n                "bindings": item["bindings"],\n                "source_ranges": item["source_ranges"],\n                "bytes_sha256": _sha256(rom[start:end]),\n                "evidence_path": (TILE_BG_ARTIFACT / "manifest.json").as_posix(),\n                "evidence_sha256": evidence_sha256,\n            }\n        )\n    if len(claims) != 107 or sum(\n        claim["range"][1] - claim["range"][0] for claim in claims\n    ) != 9_984:\n        raise ValueError("tile BG palette byte denominator changed")\n    return claims\n\n\ndef _consumer_code_slice_claims(\n    root: Path, rom: bytes\n) -> list[dict[str, Any]]:\n    """Bind explicit consumer slices to ROM bytes without overclaiming code purity."""\n\n    records_by_artifact: dict[str, list[dict[str, Any]]] = {}\n    source_ranges: list[tuple[int, int]] = []\n\n    def select_record(\n        document: object, selector: tuple[object, ...], artifact_key: str\n    ) -> object:\n        selected = document\n        for selector_part in selector:\n            if isinstance(selector_part, str) and isinstance(selected, dict):\n                selected = selected.get(selector_part)\n            elif isinstance(selector_part, int) and isinstance(selected, list):\n                if not 0 <= selector_part < len(selected):\n                    raise ValueError(\n                        f"consumer-code selector changed: {artifact_key}"\n                    )\n                selected = selected[selector_part]\n            else:\n                raise ValueError(\n                    f"consumer-code selector changed: {artifact_key}"\n                )\n        return selected\n\n    for artifact_key, spec in CONSUMER_CODE_ARTIFACTS.items():\n        manifest_path = (root / spec["manifest"]).absolute()\n        verifier_path = (root / spec["verifier"]).absolute()\n        checked_paths = [\n            (manifest_path, "manifest"),\n            (verifier_path, "verifier"),\n        ]\n        payload_path = None\n        if "payload" in spec:\n            payload_path = (root / spec["payload"]).absolute()\n            checked_paths.append((payload_path, "payload"))\n        for path, label in checked_paths:\n            try:\n                resolved = path.resolve(strict=True)\n                resolved.relative_to(root)\n            except (OSError, ValueError) as error:\n                raise ValueError(\n                    f"consumer-code {label} is invalid: {artifact_key}"\n                ) from error\n            if resolved != path or not path.is_file():\n                raise ValueError(\n                    f"consumer-code {label} uses a symlink: {artifact_key}"\n                )\n        if _sha256_file(manifest_path) != spec["manifest_sha256"]:\n            raise ValueError(f"consumer-code manifest changed: {artifact_key}")\n        if _sha256_file(verifier_path) != spec["verifier_sha256"]:\n            raise ValueError(f"consumer-code verifier changed: {artifact_key}")\n        manifest = json.loads(manifest_path.read_bytes())\n        if manifest.get("schema") != spec["schema"]:\n            raise ValueError(f"consumer-code schema changed: {artifact_key}")\n        record_names: list[str | None]\n        record_selectors: list[tuple[object, ...]]\n        if payload_path is not None:\n            if _sha256_file(payload_path) != spec["payload_sha256"]:\n                raise ValueError(f"consumer-code payload changed: {artifact_key}")\n            files = manifest.get("files")\n            if (\n                manifest.get("artifact_status") != "accepted"\n                or not isinstance(files, dict)\n                or files.get(payload_path.name) != spec["payload_sha256"]\n            ):\n                raise ValueError(\n                    f"consumer-code promotion binding changed: {artifact_key}"\n                )\n            payload = json.loads(payload_path.read_bytes())\n            if payload.get("schema") != spec["payload_schema"]:\n                raise ValueError(f"consumer-code payload schema changed: {artifact_key}")\n            rom_identity = payload.get("rom")\n            records = []\n            record_names = []\n            record_selectors = []\n            for record_name, selector in spec["record_selectors"]:\n                records.append(select_record(payload, selector, artifact_key))\n                record_names.append(record_name)\n                record_selectors.append(selector)\n        else:\n            rom_identity = manifest.get("rom")\n            records = select_record(manifest, spec["selector"], artifact_key)\n            if isinstance(records, dict) and spec["record_count"] == 1:\n                records = [records]\n            if not isinstance(records, list):\n                raise ValueError(f"consumer-code denominator changed: {artifact_key}")\n            record_names = [None] * len(records)\n            record_selectors = [spec["selector"]] * len(records)\n        if (\n            not isinstance(rom_identity, dict)\n            or rom_identity.get("sha256") != ROM_SHA256\n        ):\n            raise ValueError(f"consumer-code ROM identity changed: {artifact_key}")\n        expected_record_count = spec.get(\n            "record_count", len(spec.get("record_selectors", ()))\n        )\n        if not isinstance(records, list) or len(records) != expected_record_count:\n            raise ValueError(f"consumer-code denominator changed: {artifact_key}")\n\n        parsed: list[dict[str, Any]] = []\n        for record_index, record in enumerate(records):\n            if not isinstance(record, dict):\n                raise ValueError(\n                    f"consumer-code record changed: {artifact_key}/{record_index}"\n                )\n            name = (\n                record.get("name")\n                or record_names[record_index]\n                or spec.get("record_name")\n            )\n            start = record.get("file_offset")\n            gba_start = (\n                record.get("gba_start")\n                or record.get("start_gba_address")\n                or record.get("start")\n            )\n            if not isinstance(start, int):\n                if not isinstance(gba_start, str):\n                    raise ValueError(\n                        f"consumer-code start changed: {artifact_key}/{record_index}"\n                    )\n                start = int(gba_start, 16) - GBA_ROM_BASE\n            if isinstance(gba_start, str) and int(gba_start, 16) != GBA_ROM_BASE + start:\n                raise ValueError(\n                    f"consumer-code start binding changed: {artifact_key}/{record_index}"\n                )\n            gba_address = record.get("gba_address")\n            if (\n                isinstance(gba_address, str)\n                and int(gba_address, 16) != GBA_ROM_BASE + start\n            ):\n                raise ValueError(\n                    f"consumer-code address changed: {artifact_key}/{record_index}"\n                )\n\n            size = record.get("size")\n            gba_end = (\n                record.get("gba_end")\n                or record.get("end_gba_address_exclusive")\n                or record.get("gba_end_exclusive")\n                or record.get("end_exclusive")\n            )\n            if isinstance(size, int):\n                end = start + size\n            elif isinstance(gba_end, str):\n                end = int(gba_end, 16) - GBA_ROM_BASE\n            else:\n                raise ValueError(\n                    f"consumer-code end changed: {artifact_key}/{record_index}"\n                )\n            if isinstance(gba_end, str) and int(gba_end, 16) != GBA_ROM_BASE + end:\n                raise ValueError(\n                    f"consumer-code end binding changed: {artifact_key}/{record_index}"\n                )\n            if (\n                not isinstance(name, str)\n                or not name\n                or start < 0\n                or start >= end\n                or end > len(rom)\n                or record.get("sha256") != _sha256(rom[start:end])\n            ):\n                raise ValueError(\n                    f"consumer-code bytes changed: {artifact_key}/{record_index}"\n                )\n            parsed_record = {\n                "name": name,\n                "range": [start, end],\n                "sha256": record["sha256"],\n                "evidence_selector": "/"\n                + "/".join(str(part) for part in record_selectors[record_index]),\n            }\n            parsed.append(parsed_record)\n            source_ranges.append((start, end))\n        records_by_artifact[artifact_key] = parsed\n\n    def union(ranges: Iterable[tuple[int, int]]) -> list[list[int]]:\n        merged: list[list[int]] = []\n        for start, end in sorted(ranges):\n            if merged and start <= merged[-1][1]:\n                merged[-1][1] = max(merged[-1][1], end)\n            else:\n                merged.append([start, end])\n        return merged\n\n    claim_ranges = [\n        (start, end) for start, end, _ in CONSUMER_CODE_CLAIM_RANGES\n    ]\n    if (\n        len(CONSUMER_CODE_CLAIM_RANGES) != 71\n        or sum(end - start for start, end in claim_ranges) != 22_434\n        or any(\n            start < previous_end\n            for (_, previous_end), (start, _) in zip(\n                claim_ranges, claim_ranges[1:]\n            )\n        )\n        or union(source_ranges)\n        != union([*claim_ranges, *CONSUMER_CODE_PRIMARY_EXCLUSIONS])\n    ):\n        raise ValueError("consumer-code claim union changed")\n\n    claims: list[dict[str, Any]] = []\n    for start, end, artifact_key in CONSUMER_CODE_CLAIM_RANGES:\n        spec = CONSUMER_CODE_ARTIFACTS[artifact_key]\n        source_records = [\n            record\n            for record in records_by_artifact[artifact_key]\n            if record["range"][0] < end and start < record["range"][1]\n        ]\n        if union(\n            (record["range"][0], record["range"][1])\n            for record in source_records\n        ) == []:\n            raise ValueError(f"consumer-code provenance missing: {artifact_key}")\n        local_union = union(\n            (record["range"][0], record["range"][1])\n            for record in source_records\n        )\n        if not any(\n            range_start <= start and end <= range_end\n            for range_start, range_end in local_union\n        ):\n            raise ValueError(f"consumer-code provenance gap: {artifact_key}")\n        claim = {\n            "id": f"consumer-code-{artifact_key}-{start:06x}",\n            "range": [start, end],\n            "role": "primary",\n            "primary_class": "consumer_code_slice",\n            "claim_kind": "consumer_code_slice",\n            "bytes_sha256": _sha256(rom[start:end]),\n            "source_records": source_records,\n            "evidence_path": spec.get("payload", spec["manifest"]).as_posix(),\n            "evidence_sha256": spec.get(\n                "payload_sha256", spec["manifest_sha256"]\n            ),\n            "evidence_selector": source_records[0]["evidence_selector"],\n            "independent_verifier_path": spec["verifier"].as_posix(),\n            "independent_verifier_sha256": spec["verifier_sha256"],\n            "limitations": [\n                "The bounded slice may include embedded literal-pool bytes; it is not asserted to be instruction-only."\n            ],\n        }\n        if "payload" in spec:\n            claim["promotion_manifest_path"] = spec["manifest"].as_posix()\n            claim["promotion_manifest_sha256"] = spec["manifest_sha256"]\n        claims.append(claim)\n    return claims\n\n\ndef _verified_artifact_reuse_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote only fixed, independently verified intersections still unknown."""\n\n    root = Path(root).resolve(strict=True)\n    if _sha256(rom) != ROM_SHA256:\n        raise ValueError("verified artifact reuse ROM SHA-256 changed")\n    baseline_claims = list(existing_claims)\n    if any(\n        claim.get("promotion_batch") == "verified-artifact-reuse-v1"\n        for claim in baseline_claims\n    ):\n        raise ValueError(\n            "verified artifact reuse claims require a pre-reuse baseline"\n        )\n\n    expected_artifact_ids = {\n        "cfg_seeds",\n        "battle_effect_sequences",\n        "battle_effect_resources",\n        "battle_effect_sprites",\n        "scene_visual_packs",\n        "world_map",\n        "residual_wram_ownership",\n        "residual_text_bg_ownership",\n        "staged_gpu",\n    }\n    artifacts_by_id = {\n        artifact["id"]: artifact for artifact in VERIFIED_REUSE_ARTIFACTS\n    }\n    if (\n        len(artifacts_by_id) != len(VERIFIED_REUSE_ARTIFACTS)\n        or set(artifacts_by_id) != expected_artifact_ids\n    ):\n        raise ValueError("verified artifact reuse evidence denominator changed")\n\n    verifier_functions = {\n        "cfg_seeds": verify_rom_cfg_seeds,\n        "battle_effect_sequences": verify_battle_effect_sequence_bindings,\n        "battle_effect_resources": verify_battle_effect_resource_pairs,\n        "battle_effect_sprites": verify_battle_effect_sprite_animations,\n        "scene_visual_packs": verify_scene_visual_packs,\n        "world_map": verify_world_map_backgrounds,\n        "residual_wram_ownership": (\n            verify_residual_wram_tilemap_resource_ownership\n        ),\n        "residual_text_bg_ownership": (\n            verify_residual_text_bg_tilemap_resource_ownership\n        ),\n        "staged_gpu": verify_rom_staged_gpu_copy_inventory,\n    }\n    verified_evidence: dict[str, dict[str, Any]] = {}\n    evidence_documents: dict[str, dict[str, Any]] = {}\n    for artifact_id in sorted(expected_artifact_ids):\n        artifact_spec = artifacts_by_id[artifact_id]\n        artifact_dir = (root / artifact_spec["artifact"]).absolute()\n        try:\n            resolved_artifact = artifact_dir.resolve(strict=True)\n            resolved_artifact.relative_to(root)\n        except (OSError, ValueError) as error:\n            raise ValueError(\n                f"verified artifact reuse directory is invalid: {artifact_id}"\n            ) from error\n        if (\n            resolved_artifact != artifact_dir\n            or not artifact_dir.is_dir()\n            or any(path.is_symlink() for path in artifact_dir.rglob("*"))\n        ):\n            raise ValueError(\n                f"verified artifact reuse directory is unsafe: {artifact_id}"\n            )\n\n        manifest_path = artifact_dir / "manifest.json"\n        verifier_path = (root / artifact_spec["verifier"]).absolute()\n        checked_files = [(manifest_path, "manifest")]\n        checked_files.extend(\n            (artifact_dir / name, f"payload {name}")\n            for name in artifact_spec["payloads"]\n        )\n        checked_files.append((verifier_path, "verifier"))\n        for path, label in checked_files:\n            try:\n                resolved = path.resolve(strict=True)\n                resolved.relative_to(root)\n            except (OSError, ValueError) as error:\n                raise ValueError(\n                    "verified artifact reuse "\n                    f"{label} is invalid: {artifact_id}"\n                ) from error\n            if resolved != path or path.is_symlink() or not path.is_file():\n                raise ValueError(\n                    "verified artifact reuse "\n                    f"{label} is unsafe: {artifact_id}"\n                )\n\n        manifest_raw = manifest_path.read_bytes()\n        if _sha256(manifest_raw) != artifact_spec["manifest_sha256"]:\n            raise ValueError(\n                f"verified artifact reuse manifest changed: {artifact_id}"\n            )\n        for name, digest in artifact_spec["payloads"].items():\n            if _sha256_file(artifact_dir / name) != digest:\n                raise ValueError(\n                    "verified artifact reuse payload changed: "\n                    f"{artifact_id}/{name}"\n                )\n        if _sha256_file(verifier_path) != artifact_spec["verifier_sha256"]:\n            raise ValueError(\n                f"verified artifact reuse verifier changed: {artifact_id}"\n            )\n        manifest = json.loads(manifest_raw)\n        rom_identity = manifest.get("rom")\n        if rom_identity is None and artifact_spec["payloads"]:\n            payload_name = next(iter(artifact_spec["payloads"]))\n            payload = json.loads((artifact_dir / payload_name).read_bytes())\n            rom_identity = payload.get("rom")\n        if (\n            not isinstance(rom_identity, dict)\n            or rom_identity.get("sha256") != ROM_SHA256\n            or (\n                "size" in rom_identity\n                and rom_identity.get("size") != len(rom)\n            )\n        ):\n            raise ValueError(\n                f"verified artifact reuse ROM binding changed: {artifact_id}"\n            )\n\n        report = verifier_functions[artifact_id](root, artifact_dir)\n        if report != artifact_spec["expected_report"]:\n            raise ValueError(\n                "verified artifact reuse independent verification failed: "\n                f"{artifact_id}: {report}"\n            )\n        evidence_name = next(iter(artifact_spec["payloads"]), "manifest.json")\n        evidence_sha256 = artifact_spec["payloads"].get(\n            evidence_name, artifact_spec["manifest_sha256"]\n        )\n        evidence_document = json.loads(\n            (artifact_dir / evidence_name).read_bytes()\n        )\n        if not isinstance(evidence_document, dict):\n            raise ValueError(\n                f"verified artifact reuse evidence is not an object: {artifact_id}"\n            )\n        evidence_documents[artifact_id] = evidence_document\n        verified_evidence[artifact_id] = {\n            "artifact_id": artifact_id,\n            "evidence_path": (\n                artifact_spec["artifact"] / evidence_name\n            ).as_posix(),\n            "evidence_sha256": evidence_sha256,\n            "promotion_manifest_path": (\n                artifact_spec["artifact"] / "manifest.json"\n            ).as_posix(),\n            "promotion_manifest_sha256": artifact_spec["manifest_sha256"],\n            "independent_verifier_path": artifact_spec["verifier"].as_posix(),\n            "independent_verifier_sha256": artifact_spec["verifier_sha256"],\n        }\n\n    spec_ids = [spec["id"] for spec in VERIFIED_REUSE_RANGE_SPECS]\n    if len(spec_ids) != len(set(spec_ids)):\n        raise ValueError("verified artifact reuse source ids are not unique")\n    baseline_segments = atomize_claims(len(rom), baseline_claims)\n    available = [\n        list(segment["range"])\n        for segment in baseline_segments\n        if segment["primary_class"] == "unknown"\n    ]\n\n    def select_evidence_record(\n        artifact_id: str, selector: str, source_id: str\n    ) -> dict[str, Any]:\n        if not isinstance(selector, str) or not selector.startswith("/"):\n            raise ValueError(\n                "verified artifact reuse evidence selector changed: "\n                f"{source_id}/{artifact_id}"\n            )\n        selected: object = evidence_documents[artifact_id]\n        try:\n            for part in selector.removeprefix("/").split("/"):\n                if isinstance(selected, dict):\n                    selected = selected[part]\n                elif isinstance(selected, list):\n                    selected = selected[int(part)]\n                else:\n                    raise KeyError(part)\n        except (KeyError, IndexError, TypeError, ValueError) as error:\n            raise ValueError(\n                "verified artifact reuse evidence selector is unresolved: "\n                f"{source_id}/{artifact_id}{selector}"\n            ) from error\n        if not isinstance(selected, dict):\n            raise ValueError(\n                "verified artifact reuse evidence selector is not a record: "\n                f"{source_id}/{artifact_id}{selector}"\n            )\n        return selected\n\n    def evidence_record_range(\n        record: dict[str, Any], source_id: str, artifact_id: str\n    ) -> tuple[int, int]:\n        if "table_range" in record:\n            value = record["table_range"]\n            if (\n                not isinstance(value, list)\n                or len(value) != 2\n                or not all(isinstance(item, int) for item in value)\n            ):\n                raise ValueError("invalid table_range")\n            start, end = value\n        elif "file_offset" in record:\n            start = record["file_offset"]\n            size = record.get("size")\n            gba_start = record.get("gba_start")\n            gba_end = record.get("gba_end")\n            if (\n                size is None\n                and isinstance(gba_start, str)\n                and isinstance(gba_end, str)\n            ):\n                if int(gba_start, 16) - GBA_ROM_BASE != start:\n                    raise ValueError("file_offset and gba_start disagree")\n                end = int(gba_end, 16) - GBA_ROM_BASE\n            else:\n                if size is None:\n                    size = record.get("entry_count", 0) * record.get(\n                        "entry_size", 0\n                    )\n                end = (\n                    start + size\n                    if isinstance(start, int) and isinstance(size, int)\n                    else -1\n                )\n        elif "gba_address" in record:\n            address = record["gba_address"]\n            size = record.get("size")\n            if size is None:\n                size = record.get("entry_count", 0) * record.get(\n                    "entry_size", 0\n                )\n            start = int(address, 16) - GBA_ROM_BASE if isinstance(address, str) else -1\n            end = start + size if isinstance(size, int) else -1\n        elif "gba_range" in record:\n            value = record["gba_range"]\n            if (\n                not isinstance(value, list)\n                or len(value) != 2\n                or not all(isinstance(item, str) for item in value)\n            ):\n                raise ValueError("invalid gba_range")\n            start, end = (\n                int(item, 16) - GBA_ROM_BASE for item in value\n            )\n        elif "source_pointer" in record:\n            pointer = record["source_pointer"]\n            size = record.get("size")\n            start = int(pointer, 16) - GBA_ROM_BASE if isinstance(pointer, str) else -1\n            end = start + size if isinstance(size, int) else -1\n        else:\n            raw_start = record.get("start")\n            raw_end = record.get("end_exclusive")\n            start = (\n                int(raw_start, 16) - GBA_ROM_BASE\n                if isinstance(raw_start, str)\n                else -1\n            )\n            end = (\n                int(raw_end, 16) - GBA_ROM_BASE\n                if isinstance(raw_end, str)\n                else -1\n            )\n        if start < 0 or start >= end or end > len(rom):\n            raise ValueError(\n                "verified artifact reuse evidence range is invalid: "\n                f"{source_id}/{artifact_id}"\n            )\n        size = record.get("size")\n        if isinstance(size, int) and size != end - start:\n            raise ValueError(\n                "verified artifact reuse evidence size changed: "\n                f"{source_id}/{artifact_id}"\n            )\n        return start, end\n\n    def consume_unknown(start: int, end: int) -> list[list[int]]:\n        nonlocal available\n        pieces: list[list[int]] = []\n        remaining: list[list[int]] = []\n        for available_start, available_end in available:\n            if available_end <= start or end <= available_start:\n                remaining.append([available_start, available_end])\n                continue\n            piece_start = max(start, available_start)\n            piece_end = min(end, available_end)\n            if available_start < piece_start:\n                remaining.append([available_start, piece_start])\n            pieces.append([piece_start, piece_end])\n            if piece_end < available_end:\n                remaining.append([piece_end, available_end])\n        available = remaining\n        return pieces\n\n    claims: list[dict[str, Any]] = []\n    for source_spec in VERIFIED_REUSE_RANGE_SPECS:\n        start, end = source_spec["range"]\n        artifact_ids = source_spec["artifact_ids"]\n        evidence_selectors = source_spec.get("evidence_selectors")\n        if (\n            not isinstance(start, int)\n            or not isinstance(end, int)\n            or start < 0\n            or start >= end\n            or end > len(rom)\n            or not artifact_ids\n            or any(artifact_id not in verified_evidence for artifact_id in artifact_ids)\n            or not isinstance(evidence_selectors, dict)\n            or set(evidence_selectors) != set(artifact_ids)\n        ):\n            raise ValueError(\n                "verified artifact reuse source contract changed: "\n                f"{source_spec[\'id\']}"\n            )\n        if _sha256(rom[start:end]) != source_spec["sha256"]:\n            raise ValueError(\n                "verified artifact reuse source bytes changed: "\n                f"{source_spec[\'id\']}"\n            )\n        supporting_evidence = []\n        for artifact_id in artifact_ids:\n            selector = evidence_selectors[artifact_id]\n            record = select_evidence_record(\n                artifact_id, selector, source_spec["id"]\n            )\n            record_range = evidence_record_range(\n                record, source_spec["id"], artifact_id\n            )\n            record_sha256 = record.get(\n                "table_sha256", record.get("sha256")\n            )\n            if (\n                record_range != (start, end)\n                or record_sha256 != source_spec["sha256"]\n            ):\n                raise ValueError(\n                    "verified artifact reuse evidence record changed: "\n                    f"{source_spec[\'id\']}/{artifact_id}"\n                )\n            supporting_evidence.append(\n                {\n                    **verified_evidence[artifact_id],\n                    "evidence_selector": selector,\n                }\n            )\n        for piece_start, piece_end in consume_unknown(start, end):\n            primary_evidence = supporting_evidence[0]\n            primary_class = source_spec["primary_class"]\n            limitations = [\n                "Only the baseline-unknown intersection is promoted; existing primary semantics are never replaced."\n            ]\n            if primary_class == "consumer_code_slice":\n                limitations.extend(\n                    [\n                        "The bounded slice may include embedded literal-pool bytes; it is not asserted to be instruction-only.",\n                        "Static consumer ownership does not prove natural runtime reachability.",\n                    ]\n                )\n                claim_kind = "consumer_code_slice"\n            elif primary_class == "canonical_thumb_dispatch_table":\n                limitations.append(\n                    "The table is verified data consumed by a Thumb dispatcher; it is not executable code and does not establish a global dispatch denominator."\n                )\n                claim_kind = "verified_artifact_reuse_table"\n            elif primary_class == "palette_bgr555":\n                limitations.append(\n                    "Only BGR555 palette bytes are classified; graphics, tilemap, runtime reachability, and final display equivalence are not claimed."\n                )\n                claim_kind = "verified_artifact_reuse_palette"\n            else:\n                limitations.append(\n                    "The fixed table layout is hash-bound; downstream runtime behavior and global denominator completeness are not claimed."\n                )\n                claim_kind = "verified_artifact_reuse_table"\n            claim = {\n                "id": (\n                    f"verified-reuse-{source_spec[\'id\']}-{piece_start:06x}"\n                ),\n                "range": [piece_start, piece_end],\n                "role": "primary",\n                "primary_class": primary_class,\n                "claim_kind": claim_kind,\n                "promotion_batch": "verified-artifact-reuse-v1",\n                "baseline_unknown_only": True,\n                "source_spec_id": source_spec["id"],\n                "full_source_range": [start, end],\n                "full_source_sha256": source_spec["sha256"],\n                "bytes_sha256": _sha256(rom[piece_start:piece_end]),\n                "evidence_path": primary_evidence["evidence_path"],\n                "evidence_sha256": primary_evidence["evidence_sha256"],\n                "evidence_selector": primary_evidence["evidence_selector"],\n                "promotion_manifest_path": primary_evidence[\n                    "promotion_manifest_path"\n                ],\n                "promotion_manifest_sha256": primary_evidence[\n                    "promotion_manifest_sha256"\n                ],\n                "independent_verifier_path": primary_evidence[\n                    "independent_verifier_path"\n                ],\n                "independent_verifier_sha256": primary_evidence[\n                    "independent_verifier_sha256"\n                ],\n                "supporting_evidence": supporting_evidence,\n                "raw_rom_resource_claimed": False,\n                "runtime_reachability_claimed": False,\n                "limitations": limitations,\n            }\n            if primary_class == "consumer_code_slice":\n                claim["instruction_only_claimed"] = False\n            if primary_class == "canonical_thumb_dispatch_table":\n                claim["executable_bytes_claimed"] = False\n                claim["global_dispatch_denominator_complete"] = False\n            claims.append(claim)\n\n    class_bytes = {\n        primary_class: sum(\n            claim["range"][1] - claim["range"][0]\n            for claim in claims\n            if claim["primary_class"] == primary_class\n        )\n        for primary_class in {claim["primary_class"] for claim in claims}\n    }\n    promoted_bytes = sum(\n        claim["range"][1] - claim["range"][0] for claim in claims\n    )\n    denominator = [\n        {\n            key: claim[key]\n            for key in (\n                "id",\n                "range",\n                "primary_class",\n                "bytes_sha256",\n                "evidence_path",\n                "evidence_selector",\n            )\n        }\n        for claim in sorted(claims, key=lambda item: (item["range"], item["id"]))\n    ]\n    denominator_sha256 = _sha256(\n        json.dumps(\n            denominator,\n            ensure_ascii=True,\n            separators=(",", ":"),\n            sort_keys=True,\n        ).encode("ascii")\n    )\n    if (\n        len(claims) != VERIFIED_REUSE_EXPECTED_CLAIM_COUNT\n        or promoted_bytes != VERIFIED_REUSE_EXPECTED_BYTES\n        or class_bytes != VERIFIED_REUSE_EXPECTED_CLASS_BYTES\n        or denominator_sha256 != VERIFIED_REUSE_CLAIM_DENOMINATOR_SHA256\n    ):\n        raise ValueError(\n            "verified artifact reuse unknown-intersection denominator changed: "\n            f"claims={len(claims)}, bytes={promoted_bytes}, classes={class_bytes}, "\n            f"sha256={denominator_sha256}"\n        )\n    return claims\n\n\ndef _bg_canvas_descriptor_claims(\n    root: Path, rom: bytes\n) -> list[dict[str, Any]]:\n    manifest_path = (root / BG_CANVAS_ARTIFACT / "manifest.json").absolute()\n    verifier_path = (root / BG_CANVAS_VERIFIER).absolute()\n    for path, label in ((manifest_path, "manifest"), (verifier_path, "verifier")):\n        try:\n            resolved = path.resolve(strict=True)\n            resolved.relative_to(root)\n        except (OSError, ValueError) as error:\n            raise ValueError(f"BG canvas {label} is invalid") from error\n        if resolved != path or not path.is_file():\n            raise ValueError(f"BG canvas {label} uses a symlink")\n    manifest_raw = manifest_path.read_bytes()\n    evidence_sha256 = _sha256(manifest_raw)\n    if evidence_sha256 != BG_CANVAS_MANIFEST_SHA256:\n        raise ValueError("BG canvas manifest SHA-256 changed")\n    if _sha256_file(verifier_path) != BG_CANVAS_VERIFIER_SHA256:\n        raise ValueError("BG canvas verifier SHA-256 changed")\n    manifest = json.loads(manifest_raw)\n    if (\n        manifest.get("schema") != "bg-resource-canvases-v1"\n        or manifest.get("rom", {}).get("sha256") != ROM_SHA256\n        or manifest.get("summary")\n        != {\n            "canvas_count": 12,\n            "4bpp_canvas_count": 7,\n            "8bpp_canvas_count": 5,\n            "unique_graphics_count": 11,\n            "unique_palette_count": 12,\n            "unique_tilemap_count": 8,\n        }\n    ):\n        raise ValueError("BG canvas manifest denominator changed")\n    table_start, table_end = BG_CANVAS_TABLE_RANGE\n    table = manifest.get("table")\n    if (\n        not isinstance(table, dict)\n        or table.get("file_offset") != table_start\n        or table.get("gba_address") != f"0x{GBA_ROM_BASE + table_start:08X}"\n        or table.get("gba_end") != f"0x{GBA_ROM_BASE + table_end:08X}"\n        or table.get("entry_count") != 14\n        or table.get("entry_size") != 16\n        or table.get("empty_entry_ids") != [0, 8]\n        or table.get("sha256") != BG_CANVAS_TABLE_SHA256\n        or _sha256(rom[table_start:table_end]) != BG_CANVAS_TABLE_SHA256\n    ):\n        raise ValueError("BG canvas descriptor table changed")\n    consumer = manifest.get("consumer")\n    if (\n        not isinstance(consumer, dict)\n        or consumer.get("gba_start") != "0x08088348"\n        or consumer.get("gba_end") != "0x0808842A"\n        or consumer.get("sha256")\n        != "1d581ddbdfb89f17de5b5e52fd1b34d9952fcaddf8e4f24f1f86982facf6db27"\n        or consumer.get("descriptor_formula")\n        != "0x0859903C + entry_id * 0x10"\n        or len(consumer.get("direct_callers", [])) != 4\n    ):\n        raise ValueError("BG canvas consumer binding changed")\n\n    entries = manifest.get("entries")\n    if not isinstance(entries, list) or len(entries) != 12:\n        raise ValueError("BG canvas entry denominator changed")\n    by_id = {\n        entry.get("entry_id"): entry\n        for entry in entries\n        if isinstance(entry, dict)\n    }\n    if set(by_id) != set(range(14)) - {0, 8}:\n        raise ValueError("BG canvas entry IDs changed")\n    for entry_id in range(14):\n        row_start = table_start + entry_id * 16\n        words = [\n            int.from_bytes(rom[offset : offset + 4], "little")\n            for offset in range(row_start, row_start + 16, 4)\n        ]\n        if entry_id in {0, 8}:\n            if words != [0, 0, 0, 0]:\n                raise ValueError(f"BG canvas empty entry {entry_id} changed")\n            continue\n        entry = by_id[entry_id]\n        if (\n            entry.get("descriptor_file_offset") != row_start\n            or entry.get("descriptor_gba_address")\n            != f"0x{GBA_ROM_BASE + row_start:08X}"\n            or entry.get("mode_flag") != words[3]\n            or words[3] not in {0, 1}\n        ):\n            raise ValueError(f"BG canvas descriptor {entry_id} changed")\n        for word_index, resource_name in enumerate(\n            ("graphics", "palette", "tilemap")\n        ):\n            resource = entry.get(resource_name)\n            if (\n                not isinstance(resource, dict)\n                or resource.get("gba_pointer") != f"0x{words[word_index]:08X}"\n                or not (GBA_ROM_BASE <= words[word_index] < GBA_ROM_BASE + len(rom))\n            ):\n                raise ValueError(\n                    f"BG canvas descriptor {entry_id} {resource_name} changed"\n                )\n    return [\n        {\n            "id": "bg-canvas-resource-descriptor-table",\n            "range": [table_start, table_end],\n            "role": "primary",\n            "primary_class": "bg_canvas_resource_descriptor_table",\n            "claim_kind": "bg_canvas_descriptor_table",\n            "entry_count": 14,\n            "entry_size": 16,\n            "empty_entry_ids": [0, 8],\n            "bytes_sha256": BG_CANVAS_TABLE_SHA256,\n            "evidence_path": (BG_CANVAS_ARTIFACT / "manifest.json").as_posix(),\n            "evidence_sha256": evidence_sha256,\n            "evidence_selector": "/table",\n            "independent_verifier_path": BG_CANVAS_VERIFIER.as_posix(),\n            "independent_verifier_sha256": BG_CANVAS_VERIFIER_SHA256,\n        }\n    ]\n\n\ndef _chapter_script_claims(\n    root: Path, rom: bytes\n) -> list[dict[str, Any]]:\n    """Classify only the independently rewalked chapter-interpreter byte union."""\n\n    artifact = (root / CHAPTER_SCRIPT_ARTIFACT).absolute()\n    manifest_path = artifact / "manifest.json"\n    payload_path = (root / CHAPTER_SCRIPT_PAYLOAD).absolute()\n    bundle_path = (root / CHAPTER_SCRIPT_BUNDLE).absolute()\n    verifier_path = (root / CHAPTER_SCRIPT_VERIFIER).absolute()\n    checked_paths = (\n        (artifact, "artifact"),\n        (manifest_path, "manifest"),\n        (payload_path, "payload"),\n        (bundle_path, "bundle"),\n        (verifier_path, "verifier"),\n    )\n    for path, label in checked_paths:\n        try:\n            resolved = path.resolve(strict=True)\n            resolved.relative_to(root)\n        except (OSError, ValueError) as error:\n            raise ValueError(f"chapter-script {label} is invalid") from error\n        if resolved != path or path.is_symlink():\n            raise ValueError(f"chapter-script {label} uses a symlink")\n    if not artifact.is_dir() or any(path.is_symlink() for path in artifact.rglob("*")):\n        raise ValueError("chapter-script artifact tree is unsafe")\n    actual_files = {\n        path.relative_to(artifact).as_posix()\n        for path in artifact.rglob("*")\n        if path.is_file()\n    }\n    if actual_files != {\n        "manifest.json",\n        payload_path.name,\n        bundle_path.name,\n    }:\n        raise ValueError("chapter-script artifact file set changed")\n    if _sha256_file(manifest_path) != CHAPTER_SCRIPT_MANIFEST_SHA256:\n        raise ValueError("chapter-script manifest changed")\n    if _sha256_file(payload_path) != CHAPTER_SCRIPT_PAYLOAD_SHA256:\n        raise ValueError("chapter-script payload changed")\n    if _sha256_file(bundle_path) != CHAPTER_SCRIPT_BUNDLE_SHA256:\n        raise ValueError("chapter-script bundle changed")\n    if _sha256_file(verifier_path) != CHAPTER_SCRIPT_VERIFIER_SHA256:\n        raise ValueError("chapter-script verifier changed")\n\n    manifest = json.loads(manifest_path.read_bytes())\n    payload = json.loads(payload_path.read_bytes())\n    bundle = bundle_path.read_bytes()\n    if (\n        manifest.get("schema") != "git-artifact-promotion-v1"\n        or manifest.get("artifact_schema") != "rom-chapter-script-inventory-v1"\n        or manifest.get("artifact_status") != "accepted"\n        or manifest.get("files")\n        != {\n            bundle_path.name: CHAPTER_SCRIPT_BUNDLE_SHA256,\n            payload_path.name: CHAPTER_SCRIPT_PAYLOAD_SHA256,\n        }\n    ):\n        raise ValueError("chapter-script promotion binding changed")\n    if (\n        payload.get("schema") != "rom-chapter-script-inventory-v1"\n        or payload.get("rom")\n        != {"path": ROM_PATH.as_posix(), "size": len(rom), "sha256": ROM_SHA256}\n        or payload.get("range_denominator_sha256")\n        != CHAPTER_SCRIPT_RANGE_DENOMINATOR_SHA256\n        or payload.get("files")\n        != {\n            bundle_path.name: {\n                "size": 334_060,\n                "sha256": CHAPTER_SCRIPT_BUNDLE_SHA256,\n            }\n        }\n        or payload.get("summary", {}).get("unique_instruction_nodes") != 18_994\n        or payload.get("summary", {}).get("parse_failure_count") != 0\n        or payload.get("summary", {}).get("merged_range_count") != 92\n        or payload.get("summary", {}).get("merged_range_bytes") != 334_060\n        or payload.get("summary", {}).get("node_overlap_bytes") != 0\n    ):\n        raise ValueError("chapter-script inventory denominator changed")\n    implementation = payload.get("implementation")\n    if (\n        not isinstance(implementation, dict)\n        or implementation.get("verifier_sha256") != CHAPTER_SCRIPT_VERIFIER_SHA256\n    ):\n        raise ValueError("chapter-script implementation binding changed")\n    verifier = manifest.get("verifier")\n    if (\n        not isinstance(verifier, dict)\n        or verifier.get("verifier_sha256") != CHAPTER_SCRIPT_VERIFIER_SHA256\n        or verifier.get("exit_code") != 0\n        or verifier.get("report", {}).get("verified") is not True\n        or verifier.get("report", {}).get("errors") != []\n        or verifier.get("report", {}).get("merged_range_count") != 92\n        or verifier.get("report", {}).get("merged_range_bytes") != 334_060\n    ):\n        raise ValueError("chapter-script verifier contract changed")\n    report = verify_rom_chapter_script_inventory(root, artifact)\n    if (\n        report.get("verified") is not True\n        or report.get("errors") != []\n        or report.get("unique_instruction_nodes") != 18_994\n        or report.get("merged_range_count") != 92\n        or report.get("merged_range_bytes") != 334_060\n    ):\n        raise ValueError(f"chapter-script independent verifier failed: {report}")\n\n    records = payload.get("ranges")\n    if not isinstance(records, list) or len(records) != 92:\n        raise ValueError("chapter-script range denominator changed")\n    claims: list[dict[str, Any]] = []\n    packed_cursor = 0\n    previous_end = -1\n    for range_id, record in enumerate(records):\n        if not isinstance(record, dict):\n            raise ValueError("chapter-script range record changed")\n        value = record.get("range")\n        packed = record.get("packed_range")\n        if (\n            record.get("range_id") != range_id\n            or not isinstance(value, list)\n            or len(value) != 2\n            or not all(isinstance(item, int) for item in value)\n            or not isinstance(packed, list)\n            or len(packed) != 2\n            or not all(isinstance(item, int) for item in packed)\n        ):\n            raise ValueError("chapter-script range record changed")\n        start, end = value\n        packed_start, packed_end = packed\n        if (\n            start <= previous_end\n            or start < 0\n            or start >= end\n            or end > len(rom)\n            or record.get("size") != end - start\n            or packed_start != packed_cursor\n            or packed_end - packed_start != end - start\n            or packed_end > len(bundle)\n            or record.get("gba_range")\n            != [f"0x{GBA_ROM_BASE + start:08X}", f"0x{GBA_ROM_BASE + end:08X}"]\n            or record.get("bytes_sha256") != _sha256(rom[start:end])\n            or bundle[packed_start:packed_end] != rom[start:end]\n        ):\n            raise ValueError(f"chapter-script bytes changed: {range_id}")\n        claims.append(\n            {\n                "id": f"chapter-script-reachable-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": "chapter_script_record",\n                "claim_kind": "chapter_script_reachable_record_bytes",\n                "range_id": range_id,\n                "bytes_sha256": record["bytes_sha256"],\n                "evidence_path": CHAPTER_SCRIPT_PAYLOAD.as_posix(),\n                "evidence_sha256": CHAPTER_SCRIPT_PAYLOAD_SHA256,\n                "evidence_selector": f"/ranges/{range_id}",\n                "promotion_manifest_path": (\n                    CHAPTER_SCRIPT_ARTIFACT / "manifest.json"\n                ).as_posix(),\n                "promotion_manifest_sha256": CHAPTER_SCRIPT_MANIFEST_SHA256,\n                "independent_verifier_path": CHAPTER_SCRIPT_VERIFIER.as_posix(),\n                "independent_verifier_sha256": CHAPTER_SCRIPT_VERIFIER_SHA256,\n                "limitations": [\n                    "The range may contain bytecode, inline encoded text, and pointer operands; it is classified as one interpreter-consumed script record union, not as decoded natural-language text.",\n                    "Static reachability from a fixed table slot does not prove natural gameplay execution of every root or complete runtime index coverage.",\n                ],\n            }\n        )\n        previous_end = end\n        packed_cursor = packed_end\n    if packed_cursor != len(bundle) or sum(\n        claim["range"][1] - claim["range"][0] for claim in claims\n    ) != 334_060:\n        raise ValueError("chapter-script packed denominator changed")\n    return claims\n\n\ndef _chapter_speaker_label_claims(\n    root: Path, rom: bytes\n) -> list[dict[str, Any]]:\n    """Classify only renderer-consumed bytes of labels referenced by fixed scripts."""\n\n    _chapter_script_claims(root, rom)\n    payload_path = root / CHAPTER_SCRIPT_PAYLOAD\n    payload = json.loads(payload_path.read_bytes())\n    labels = payload.get("referenced_resources", {}).get("speaker_labels")\n    if not isinstance(labels, dict):\n        raise ValueError("speaker-label resource contract changed")\n    expected_summary = {\n        "reference_node_counts": {"0x08": 5_701, "0x0E": 7},\n        "operand_reference_count": 5_715,\n        "referenced_label_ids": [\n            *range(1, 32),\n            35,\n            36,\n            37,\n            41,\n            *range(43, 55),\n            56,\n            61,\n        ],\n        "structural_record_count": 49,\n        "structural_record_bytes": 588,\n        "renderer_consumed_record_count": 49,\n        "renderer_consumed_bytes": 251,\n        "post_nul_padding_bytes": 337,\n        "renderer_length_distribution": {"3": 9, "5": 28, "7": 12},\n        "semantic_range_denominator_sha256": "118e9d300bded69407cfe4fe7a8625654af6532ba5a4da3058ca8542fa5e1779",\n        "semantic_bundle_sha256": "07c5281f03633aea88c4b70a4a0f755da92707aa2ab6e1a205a20252f8e78831",\n    }\n    if labels.get("summary") != expected_summary:\n        raise ValueError("speaker-label semantic denominator changed")\n    records = labels.get("records")\n    if not isinstance(records, list) or len(records) != 49:\n        raise ValueError("speaker-label record denominator changed")\n    claims = []\n    semantic_ranges = []\n    semantic_bundle = bytearray()\n    previous_start = -1\n    for index, record in enumerate(records):\n        if not isinstance(record, dict):\n            raise ValueError("speaker-label record changed")\n        value = record.get("renderer_range")\n        slot = record.get("slot_range")\n        if (\n            not isinstance(value, list)\n            or len(value) != 2\n            or not all(isinstance(item, int) for item in value)\n            or not isinstance(slot, list)\n            or len(slot) != 2\n            or not all(isinstance(item, int) for item in slot)\n        ):\n            raise ValueError("speaker-label record changed")\n        start, end = value\n        slot_start, slot_end = slot\n        if (\n            start <= previous_start\n            or start != slot_start\n            or slot_end - slot_start != 12\n            or not start < end <= slot_end <= len(rom)\n            or record.get("size") != end - start\n            or record.get("gba_renderer_range")\n            != [f"0x{GBA_ROM_BASE + start:08X}", f"0x{GBA_ROM_BASE + end:08X}"]\n            or record.get("bytes_sha256") != _sha256(rom[start:end])\n        ):\n            raise ValueError(f"speaker-label bytes changed: {index}")\n        semantic_ranges.append([start, end])\n        semantic_bundle.extend(rom[start:end])\n        claims.append(\n            {\n                "id": f"chapter-speaker-label-{record[\'label_id\']:02d}-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": "speaker_label_renderer_text",\n                "claim_kind": "chapter_speaker_label_renderer_bytes",\n                "label_id": record["label_id"],\n                "bytes_sha256": record["bytes_sha256"],\n                "evidence_path": CHAPTER_SCRIPT_PAYLOAD.as_posix(),\n                "evidence_sha256": CHAPTER_SCRIPT_PAYLOAD_SHA256,\n                "evidence_selector": f"/referenced_resources/speaker_labels/records/{index}",\n                "promotion_manifest_path": (\n                    CHAPTER_SCRIPT_ARTIFACT / "manifest.json"\n                ).as_posix(),\n                "promotion_manifest_sha256": CHAPTER_SCRIPT_MANIFEST_SHA256,\n                "independent_verifier_path": CHAPTER_SCRIPT_VERIFIER.as_posix(),\n                "independent_verifier_sha256": CHAPTER_SCRIPT_VERIFIER_SHA256,\n                "limitations": [\n                    "Only renderer-consumed bytes through the first valid NUL are classified; post-NUL bytes in the 12-byte slot remain unknown."\n                ],\n            }\n        )\n        previous_start = start\n    if (\n        _sha256(\n            json.dumps(semantic_ranges, separators=(",", ":")).encode("ascii")\n        )\n        != expected_summary["semantic_range_denominator_sha256"]\n        or _sha256(bytes(semantic_bundle))\n        != expected_summary["semantic_bundle_sha256"]\n        or len(semantic_bundle) != 251\n    ):\n        raise ValueError("speaker-label bytes changed")\n    return claims\n\n\ndef _sprite_definition_tile_offset_claims(\n    root: Path, rom: bytes\n) -> list[dict[str, Any]]:\n    """Bind the exact 43-entry tile-base table to its independent runtime verifier."""\n\n    artifact = (root / SPRITE_DEFINITION_ARTIFACT).absolute()\n    manifest_path = artifact / "manifest.json"\n    verifier_path = (root / SPRITE_DEFINITION_VERIFIER).absolute()\n    for path, label in (\n        (artifact, "artifact"),\n        (manifest_path, "manifest"),\n        (verifier_path, "verifier"),\n    ):\n        try:\n            resolved = path.resolve(strict=True)\n            resolved.relative_to(root)\n        except (OSError, ValueError) as error:\n            raise ValueError(f"sprite-definition {label} is invalid") from error\n        if resolved != path or path.is_symlink():\n            raise ValueError(f"sprite-definition {label} uses a symlink")\n    if not artifact.is_dir() or any(path.is_symlink() for path in artifact.rglob("*")):\n        raise ValueError("sprite-definition artifact tree is unsafe")\n    if _sha256_file(manifest_path) != SPRITE_DEFINITION_MANIFEST_SHA256:\n        raise ValueError("sprite-definition manifest changed")\n    if _sha256_file(verifier_path) != SPRITE_DEFINITION_VERIFIER_SHA256:\n        raise ValueError("sprite-definition verifier changed")\n\n    manifest = json.loads(manifest_path.read_bytes())\n    start, end = SPRITE_TILE_OFFSET_RANGE\n    expected_table = {\n        "file_offset": start,\n        "gba_address": f"0x{GBA_ROM_BASE + start:08X}",\n        "entry_count": 43,\n        "entry_size": 2,\n        "sha256": SPRITE_TILE_OFFSET_SHA256,\n    }\n    if (\n        manifest.get("schema") != "sprite-definition-assets-v2"\n        or manifest.get("rom")\n        != {"path": ROM_PATH.as_posix(), "size": len(rom), "sha256": ROM_SHA256}\n        or manifest.get("tile_offset_table") != expected_table\n    ):\n        raise ValueError("sprite-definition tile-offset contract changed")\n    if _sha256(rom[start:end]) != SPRITE_TILE_OFFSET_SHA256:\n        raise ValueError("sprite tile-offset table changed")\n\n    report = verify_sprite_definition_runtime_chain(root, artifact)\n    if (\n        report.get("schema") != "sprite-definition-assets-verification-v2"\n        or report.get("errors") != []\n        or report.get("verified_entries") != 43\n        or report.get("verified_components") != 45\n        or report.get("verified_assets") != 43\n    ):\n        raise ValueError(f"sprite-definition independent verifier failed: {report}")\n    return [\n        {\n            "id": "sprite-definition-tile-base-offsets-53f298",\n            "range": [start, end],\n            "role": "primary",\n            "primary_class": "sprite_tile_base_offset_table",\n            "claim_kind": "sprite_definition_tile_offset_table",\n            "entry_count": 43,\n            "entry_size": 2,\n            "bytes_sha256": SPRITE_TILE_OFFSET_SHA256,\n            "evidence_path": manifest_path.relative_to(root).as_posix(),\n            "evidence_sha256": SPRITE_DEFINITION_MANIFEST_SHA256,\n            "evidence_selector": "/tile_offset_table",\n            "independent_verifier_path": SPRITE_DEFINITION_VERIFIER.as_posix(),\n            "independent_verifier_sha256": SPRITE_DEFINITION_VERIFIER_SHA256,\n            "limitations": [\n                "This is a 43-entry sprite tile-base offset table, not a character-ID or unit-stat table."\n            ],\n        }\n    ]\n\n\ndef _sprite_definition_resolved_window_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote current-unknown bytes in the 43 verified 0x28 sprite windows."""\n    artifact = (root / SPRITE_DEFINITION_ARTIFACT).absolute()\n    manifest_path = artifact / "manifest.json"\n    verifier_path = (root / SPRITE_DEFINITION_VERIFIER).absolute()\n    if (\n        artifact.resolve(strict=True) != artifact\n        or manifest_path.resolve(strict=True) != manifest_path\n        or verifier_path.resolve(strict=True) != verifier_path\n        or _sha256_file(manifest_path) != SPRITE_DEFINITION_MANIFEST_SHA256\n        or _sha256_file(verifier_path) != SPRITE_DEFINITION_VERIFIER_SHA256\n    ):\n        raise ValueError("sprite-definition resolved-window identity changed")\n    manifest = json.loads(manifest_path.read_bytes())\n    report = verify_sprite_definition_runtime_chain(root, artifact)\n    if (\n        report.get("schema") != "sprite-definition-assets-verification-v2"\n        or report.get("errors") != []\n        or report.get("verified_entries") != 43\n        or report.get("verified_components") != 45\n        or report.get("verified_assets") != 43\n    ):\n        raise ValueError(\n            f"sprite-definition resolved-window verification failed: {report}"\n        )\n    entries = manifest.get("entries")\n    if not isinstance(entries, list) or len(entries) != 43:\n        raise ValueError("sprite-definition resolved-window entry denominator changed")\n    windows: list[tuple[int, int]] = []\n    concatenated = bytearray()\n    for index, entry in enumerate(entries):\n        try:\n            pointer = int(entry["component_list_pointer"], 16)\n        except (KeyError, TypeError, ValueError) as error:\n            raise ValueError("sprite-definition component pointer changed") from error\n        start = pointer - GBA_ROM_BASE\n        end = start + 0x28\n        raw = rom[start:end]\n        if (\n            entry.get("id") != index\n            or not 0 <= start < end <= len(rom)\n            or entry.get("resolved_window_0x28_sha256") != _sha256(raw)\n        ):\n            raise ValueError(f"sprite-definition resolved window changed: {index}")\n        windows.append((start, end))\n        concatenated.extend(raw)\n    if _sha256(bytes(concatenated)) != manifest.get("resolved_window_0x28_sha256"):\n        raise ValueError("sprite-definition resolved-window denominator changed")\n    merged: list[list[int]] = []\n    for start, end in sorted(windows):\n        if merged and start <= merged[-1][1]:\n            merged[-1][1] = max(merged[-1][1], end)\n        else:\n            merged.append([start, end])\n    unknown = [\n        tuple(segment["range"])\n        for segment in atomize_claims(len(rom), list(existing_claims))\n        if segment["primary_class"] == "unknown"\n    ]\n    pieces = [\n        (max(start, a), min(end, b))\n        for start, end in merged\n        for a, b in unknown\n        if a < end and start < b\n    ]\n    pieces = [(a, b) for a, b in pieces if a < b]\n    if len(pieces) != 3 or sum(b - a for a, b in pieces) != 1_720:\n        raise ValueError("sprite-definition resolved-window promotion changed")\n    return [\n        {\n            "id": f"sprite-definition-resolved-window-{index:02d}-{start:06x}",\n            "range": [start, end], "role": "primary",\n            "primary_class": "sprite_definition_resolved_component_window",\n            "claim_kind": "sprite_definition_resolved_window_bytes",\n            "promoted_from_primary_class": "unknown",\n            "bytes_sha256": _sha256(rom[start:end]),\n            "evidence_path": manifest_path.relative_to(root).as_posix(),\n            "evidence_sha256": SPRITE_DEFINITION_MANIFEST_SHA256,\n            "evidence_selector": "/resolved_window_0x28_sha256",\n            "independent_verifier_path": SPRITE_DEFINITION_VERIFIER.as_posix(),\n            "independent_verifier_sha256": SPRITE_DEFINITION_VERIFIER_SHA256,\n            "limitations": [\n                "Only current-unknown bytes in the union of 43 verified 0x28 component-list windows are promoted.",\n                "Animation payloads, gaps outside the windows, and natural runtime coverage are not claimed.",\n            ],\n        }\n        for index, (start, end) in enumerate(pieces)\n    ]\n\n\ndef _battle_effect_sprite_animation_source_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote the fixed battle-effect sprite source ranges.\n\n    The sprite artifact already has an independently verified manifest.  This\n    helper only binds the four source structures that are explicit in that\n    manifest: component lists, definition pointer tables, animation\n    timelines, and animation pointer tables.  Every complete source range\n    must still be ``unknown`` in the supplied baseline; a partial overlap is a\n    contract failure rather than an invitation to slice or reclaim a claim.\n    """\n\n    root = Path(root).resolve(strict=True)\n    if _sha256(rom) != ROM_SHA256:\n        raise ValueError("battle-effect sprite source ROM SHA-256 changed")\n    baseline_claims = list(existing_claims)\n    if any(\n        claim.get("promotion_batch") == BATTLE_EFFECT_SPRITE_SOURCE_BATCH\n        for claim in baseline_claims\n    ):\n        raise ValueError(\n            "battle-effect sprite source claims require a pre-source baseline"\n        )\n\n    try:\n        artifact_spec = next(\n            spec\n            for spec in VERIFIED_REUSE_ARTIFACTS\n            if spec.get("id") == "battle_effect_sprites"\n        )\n    except StopIteration as error:\n        raise ValueError(\n            "battle-effect sprite source reuse artifact is missing"\n        ) from error\n    if (\n        artifact_spec.get("artifact")\n        != Path("artifacts/battle-effect-sprite-animations-v1")\n        or artifact_spec.get("manifest_sha256")\n        != BATTLE_EFFECT_SPRITE_SOURCE_MANIFEST_SHA256\n        or artifact_spec.get("payloads") != {}\n        or artifact_spec.get("verifier")\n        != BATTLE_EFFECT_SPRITE_SOURCE_VERIFIER\n        or artifact_spec.get("verifier_sha256")\n        != BATTLE_EFFECT_SPRITE_SOURCE_VERIFIER_SHA256\n        or artifact_spec.get("expected_report")\n        != BATTLE_EFFECT_SPRITE_SOURCE_EXPECTED_REPORT\n    ):\n        raise ValueError("battle-effect sprite source reuse identity changed")\n\n    artifact_dir = (root / artifact_spec["artifact"]).absolute()\n    manifest_path = artifact_dir / "manifest.json"\n    verifier_path = (root / BATTLE_EFFECT_SPRITE_SOURCE_VERIFIER).absolute()\n\n    def checked_path(path: Path, label: str, *, directory: bool = False) -> None:\n        try:\n            resolved = path.resolve(strict=True)\n            resolved.relative_to(root)\n        except (OSError, ValueError) as error:\n            raise ValueError(\n                f"battle-effect sprite source {label} path is unsafe"\n            ) from error\n        if resolved != path or path.is_symlink():\n            raise ValueError(\n                f"battle-effect sprite source {label} path is unsafe"\n            )\n        if directory:\n            if not path.is_dir():\n                raise ValueError(\n                    f"battle-effect sprite source {label} is not a directory"\n                )\n        elif not path.is_file():\n            raise ValueError(\n                f"battle-effect sprite source {label} is not a file"\n            )\n\n    checked_path(artifact_dir, "artifact", directory=True)\n    for nested in artifact_dir.rglob("*"):\n        if nested.is_symlink():\n            raise ValueError(\n                "battle-effect sprite source artifact contains a symlink"\n            )\n    checked_path(manifest_path, "manifest")\n    checked_path(verifier_path, "verifier")\n    if _sha256_file(manifest_path) != BATTLE_EFFECT_SPRITE_SOURCE_MANIFEST_SHA256:\n        raise ValueError("battle-effect sprite source manifest hash changed")\n    if _sha256_file(verifier_path) != BATTLE_EFFECT_SPRITE_SOURCE_VERIFIER_SHA256:\n        raise ValueError("battle-effect sprite source verifier hash changed")\n\n    try:\n        manifest = json.loads(manifest_path.read_bytes())\n    except (OSError, json.JSONDecodeError) as error:\n        raise ValueError(\n            "battle-effect sprite source manifest is not valid JSON"\n        ) from error\n    if not isinstance(manifest, dict):\n        raise ValueError("battle-effect sprite source manifest is not an object")\n    if manifest.get("schema") != "battle-effect-sprite-animations-v1":\n        raise ValueError("battle-effect sprite source schema changed")\n    if manifest.get("rom") != {\n        "path": "rom/base.gba",\n        "size": len(rom),\n        "sha256": ROM_SHA256,\n    }:\n        raise ValueError("battle-effect sprite source ROM identity changed")\n\n    try:\n        report = verify_battle_effect_sprite_animations(root, artifact_dir)\n    except Exception as error:\n        raise ValueError(\n            f"battle-effect sprite source independent verification failed: {error}"\n        ) from error\n    if report != BATTLE_EFFECT_SPRITE_SOURCE_EXPECTED_REPORT:\n        raise ValueError(\n            "battle-effect sprite source independent verification failed: "\n            f"{report}"\n        )\n\n    if (\n        manifest.get("group_count") != 18\n        or manifest.get("frame_definition_count") != 178\n        or manifest.get("component_count") != 437\n        or manifest.get("animation_count") != 23\n        or manifest.get("keyframe_count") != 193\n    ):\n        raise ValueError("battle-effect sprite source count denominator changed")\n    groups = manifest.get("groups")\n    if not isinstance(groups, list) or len(groups) != 18:\n        raise ValueError("battle-effect sprite source group denominator changed")\n\n    component_sources: list[dict[str, Any]] = []\n    definition_table_sources: list[dict[str, Any]] = []\n    timeline_sources: list[dict[str, Any]] = []\n    animation_table_sources: list[dict[str, Any]] = []\n    total_frames = total_components = total_animations = total_keyframes = 0\n\n    def parse_pointer(value: object, label: str) -> int:\n        if not isinstance(value, str):\n            raise ValueError(f"{label} pointer changed")\n        try:\n            pointer = int(value, 16)\n        except (TypeError, ValueError) as error:\n            raise ValueError(f"{label} pointer changed") from error\n        if value != f"0x{pointer:08X}":\n            raise ValueError(f"{label} pointer spelling changed")\n        offset = pointer - GBA_ROM_BASE\n        if not 0 <= offset < len(rom):\n            raise ValueError(f"{label} pointer is outside ROM")\n        return pointer\n\n    def checked_range(start: int, size: int, label: str) -> tuple[int, int]:\n        if (\n            not isinstance(start, int)\n            or not isinstance(size, int)\n            or isinstance(size, bool)\n            or size <= 0\n        ):\n            raise ValueError(f"{label} range changed")\n        end = start + size\n        if not 0 <= start < end <= len(rom):\n            raise ValueError(f"{label} range is outside ROM")\n        return start, end\n\n    def checked_count(value: object, label: str, maximum: int) -> int:\n        if (\n            not isinstance(value, int)\n            or isinstance(value, bool)\n            or value < 0\n            or value > maximum\n        ):\n            raise ValueError(f"{label} count changed")\n        return value\n\n    def checked_sha(value: object, raw: bytes, label: str) -> str:\n        if not isinstance(value, str) or value != _sha256(raw):\n            raise ValueError(f"{label} raw hash changed")\n        return value\n\n    for group_index, group in enumerate(groups):\n        if not isinstance(group, dict) or group.get("group_id") != group_index + 1:\n            raise ValueError(f"battle-effect sprite source group changed: {group_index}")\n        frame_count = checked_count(group.get("frame_count"), "frame", 128)\n        animation_count = checked_count(\n            group.get("animation_count"), "animation", 32\n        )\n        frames = group.get("frames")\n        animations = group.get("animations")\n        if (\n            not isinstance(frames, list)\n            or len(frames) != frame_count\n            or not isinstance(animations, list)\n            or len(animations) != animation_count\n            or group.get("definition_region_contiguous") is not True\n            or group.get("timeline_region_contiguous") is not True\n        ):\n            raise ValueError(\n                f"battle-effect sprite source group structure changed: {group_index}"\n            )\n        definition_pointer = parse_pointer(\n            group.get("definition_pointer_table"),\n            f"group {group_index} definition table",\n        )\n        animation_pointer = parse_pointer(\n            group.get("animation_pointer_table"),\n            f"group {group_index} animation table",\n        )\n        timeline_start = parse_pointer(\n            group.get("timeline_region_start"),\n            f"group {group_index} timeline region",\n        )\n        definition_table_start = definition_pointer - GBA_ROM_BASE\n        definition_table_end = definition_table_start + frame_count * 4\n        if definition_table_end > len(rom):\n            raise ValueError("battle-effect sprite definition table is outside ROM")\n        if timeline_start != definition_pointer + frame_count * 4:\n            raise ValueError("battle-effect sprite timeline start drifted")\n        animation_table_start = animation_pointer - GBA_ROM_BASE\n        animation_table_end = animation_table_start + animation_count * 4\n        if animation_table_end > len(rom):\n            raise ValueError("battle-effect sprite animation table is outside ROM")\n\n        frame_pointers: list[int] = []\n        frame_ranges: list[tuple[int, int]] = []\n        group_component_count = 0\n        for frame_id, frame in enumerate(frames):\n            if not isinstance(frame, dict) or frame.get("frame_id") != frame_id:\n                raise ValueError(\n                    f"battle-effect sprite frame selector changed: {group_index}/{frame_id}"\n                )\n            pointer = parse_pointer(\n                frame.get("component_list_pointer"),\n                f"group {group_index} frame {frame_id} component list",\n            )\n            component_count = checked_count(\n                frame.get("component_count"), "component", 32\n            )\n            raw_size = frame.get("raw_size")\n            expected_size = component_count * 20 + 4\n            if raw_size != expected_size:\n                raise ValueError(\n                    f"battle-effect sprite component raw size changed: {group_index}/{frame_id}"\n                )\n            start, end = checked_range(\n                pointer - GBA_ROM_BASE,\n                raw_size,\n                f"group {group_index} frame {frame_id} component list",\n            )\n            raw = rom[start:end]\n            if raw[-4:] != bytes.fromhex("ffff0000"):\n                raise ValueError(\n                    f"battle-effect sprite component terminator changed: {group_index}/{frame_id}"\n                )\n            checked_sha(\n                frame.get("raw_sha256"),\n                raw,\n                f"group {group_index} frame {frame_id} component list",\n            )\n            if frame.get("terminator_raw_hex") != "ffff0000":\n                raise ValueError("battle-effect sprite component terminator metadata changed")\n            components = frame.get("components")\n            if not isinstance(components, list) or len(components) != component_count:\n                raise ValueError("battle-effect sprite component count changed")\n            frame_pointers.append(pointer)\n            frame_ranges.append((start, end))\n            group_component_count += component_count\n            component_sources.append(\n                {\n                    "id": f"battle-effect-sprite-component-g{group_index:02d}-f{frame_id:02d}",\n                    "primary_class": "battle_effect_sprite_component_records",\n                    "range": [start, end],\n                    "selector": f"/groups/{group_index}/frames/{frame_id}",\n                    "source_pointer": frame.get("component_list_pointer"),\n                    "source_raw_size": raw_size,\n                    "source_raw_sha256": frame.get("raw_sha256"),\n                    "terminator_raw_hex": "ffff0000",\n                    "source_group_index": group_index,\n                    "source_frame_id": frame_id,\n                    "table_entry_count": component_count,\n                }\n            )\n        if group.get("component_count") != group_component_count:\n            raise ValueError("battle-effect sprite component total changed")\n        if frame_ranges:\n            if frame_ranges[-1][1] != definition_pointer - GBA_ROM_BASE:\n                raise ValueError("battle-effect sprite definition region is not contiguous")\n            for previous, current in zip(frame_ranges, frame_ranges[1:]):\n                if current[0] != previous[1]:\n                    raise ValueError("battle-effect sprite definition region is not contiguous")\n        definition_table_raw = rom[definition_table_start:definition_table_end]\n        expected_definition_table = b"".join(\n            pointer.to_bytes(4, "little") for pointer in frame_pointers\n        )\n        if definition_table_raw != expected_definition_table:\n            raise ValueError("battle-effect sprite definition pointer table drifted")\n        definition_table_sha256 = _sha256(definition_table_raw)\n        definition_table_sources.append(\n            {\n                "id": f"battle-effect-sprite-definition-table-g{group_index:02d}",\n                "primary_class": "battle_effect_sprite_definition_pointer_table",\n                "range": [definition_table_start, definition_table_end],\n                "selector": (\n                    f"/groups/{group_index}/definition_pointer_table"\n                ),\n                "source_pointer": group.get("definition_pointer_table"),\n                "source_raw_size": frame_count * 4,\n                "source_raw_sha256": definition_table_sha256,\n                "table_entry_count": frame_count,\n                "table_entry_size": 4,\n                "source_group_index": group_index,\n                "pointer_values": frame_pointers,\n            }\n        )\n\n        animation_pointers: list[int] = []\n        animation_ranges: list[tuple[int, int]] = []\n        group_keyframe_count = 0\n        for animation_id, animation in enumerate(animations):\n            if (\n                not isinstance(animation, dict)\n                or animation.get("animation_id") != animation_id\n            ):\n                raise ValueError(\n                    f"battle-effect sprite animation selector changed: {group_index}/{animation_id}"\n                )\n            pointer = parse_pointer(\n                animation.get("timeline_pointer"),\n                f"group {group_index} animation {animation_id} timeline",\n            )\n            keyframe_count = checked_count(\n                animation.get("keyframe_count"), "keyframe", 256\n            )\n            raw_size = animation.get("raw_size")\n            expected_size = keyframe_count * 4 + 4\n            if raw_size != expected_size:\n                raise ValueError(\n                    f"battle-effect sprite timeline raw size changed: {group_index}/{animation_id}"\n                )\n            start, end = checked_range(\n                pointer - GBA_ROM_BASE,\n                raw_size,\n                f"group {group_index} animation {animation_id} timeline",\n            )\n            raw = rom[start:end]\n            if raw[-4:] != bytes.fromhex("ffff0000"):\n                raise ValueError(\n                    f"battle-effect sprite timeline terminator changed: {group_index}/{animation_id}"\n                )\n            checked_sha(\n                animation.get("raw_sha256"),\n                raw,\n                f"group {group_index} animation {animation_id} timeline",\n            )\n            if animation.get("terminator") != {\n                "frame_id": 0xFFFF,\n                "hold_frames": 0,\n            }:\n                raise ValueError("battle-effect sprite timeline terminator metadata changed")\n            keyframes = animation.get("keyframes")\n            if not isinstance(keyframes, list) or len(keyframes) != keyframe_count:\n                raise ValueError("battle-effect sprite keyframe count changed")\n            for keyframe_id, keyframe in enumerate(keyframes):\n                if not isinstance(keyframe, dict):\n                    raise ValueError("battle-effect sprite keyframe changed")\n                frame_id = keyframe.get("frame_id")\n                hold_frames = keyframe.get("hold_frames")\n                if (\n                    not isinstance(frame_id, int)\n                    or isinstance(frame_id, bool)\n                    or not 0 <= frame_id < frame_count\n                    or not isinstance(hold_frames, int)\n                    or isinstance(hold_frames, bool)\n                    or hold_frames <= 0\n                    or int.from_bytes(raw[keyframe_id * 4 : keyframe_id * 4 + 2], "little")\n                    != frame_id\n                    or int.from_bytes(\n                        raw[keyframe_id * 4 + 2 : keyframe_id * 4 + 4], "little"\n                    )\n                    != hold_frames\n                ):\n                    raise ValueError("battle-effect sprite keyframe bytes changed")\n            animation_pointers.append(pointer)\n            animation_ranges.append((start, end))\n            group_keyframe_count += keyframe_count\n            timeline_sources.append(\n                {\n                    "id": f"battle-effect-sprite-timeline-g{group_index:02d}-a{animation_id:02d}",\n                    "primary_class": "battle_effect_sprite_animation_timeline",\n                    "range": [start, end],\n                    "selector": f"/groups/{group_index}/animations/{animation_id}",\n                    "source_pointer": animation.get("timeline_pointer"),\n                    "source_raw_size": raw_size,\n                    "source_raw_sha256": animation.get("raw_sha256"),\n                    "terminator_raw_hex": "ffff0000",\n                    "source_group_index": group_index,\n                    "source_animation_id": animation_id,\n                    "table_entry_count": keyframe_count,\n                }\n            )\n        if group.get("keyframe_count") != group_keyframe_count:\n            raise ValueError("battle-effect sprite keyframe total changed")\n        if animation_ranges:\n            if animation_ranges[0][0] != timeline_start - GBA_ROM_BASE:\n                raise ValueError("battle-effect sprite timeline region is not contiguous")\n            if animation_ranges[-1][1] != animation_pointer - GBA_ROM_BASE:\n                raise ValueError("battle-effect sprite timeline region is not contiguous")\n            for previous, current in zip(animation_ranges, animation_ranges[1:]):\n                if current[0] != previous[1]:\n                    raise ValueError("battle-effect sprite timeline region is not contiguous")\n        animation_table_raw = rom[animation_table_start:animation_table_end]\n        expected_animation_table = b"".join(\n            pointer.to_bytes(4, "little") for pointer in animation_pointers\n        )\n        if animation_table_raw != expected_animation_table:\n            raise ValueError("battle-effect sprite animation pointer table drifted")\n        animation_table_sha256 = _sha256(animation_table_raw)\n        animation_table_sources.append(\n            {\n                "id": f"battle-effect-sprite-animation-table-g{group_index:02d}",\n                "primary_class": "battle_effect_sprite_animation_pointer_table",\n                "range": [animation_table_start, animation_table_end],\n                "selector": (\n                    f"/groups/{group_index}/animation_pointer_table"\n                ),\n                "source_pointer": group.get("animation_pointer_table"),\n                "source_raw_size": animation_count * 4,\n                "source_raw_sha256": animation_table_sha256,\n                "table_entry_count": animation_count,\n                "table_entry_size": 4,\n                "source_group_index": group_index,\n                "pointer_values": animation_pointers,\n            }\n        )\n        total_frames += frame_count\n        total_components += group_component_count\n        total_animations += animation_count\n        total_keyframes += group_keyframe_count\n\n    if (\n        total_frames != 178\n        or total_components != 437\n        or total_animations != 23\n        or total_keyframes != 193\n        or len(component_sources) != 178\n        or len(definition_table_sources) != 18\n        or len(timeline_sources) != 23\n        or len(animation_table_sources) != 18\n    ):\n        raise ValueError("battle-effect sprite source count denominator changed")\n\n    sources = (\n        component_sources\n        + definition_table_sources\n        + timeline_sources\n        + animation_table_sources\n    )\n    ordered_sources = sorted(sources, key=lambda item: (item["range"], item["id"]))\n    for previous, current in zip(ordered_sources, ordered_sources[1:]):\n        if previous["range"][1] > current["range"][0]:\n            raise ValueError("battle-effect sprite source ranges overlap")\n\n    baseline_segments = atomize_claims(len(rom), baseline_claims)\n    for source in sources:\n        start, end = source["range"]\n        known_bytes = sum(\n            max(0, min(end, segment["range"][1]) - max(start, segment["range"][0]))\n            for segment in baseline_segments\n            if segment["primary_class"] != "unknown"\n            and segment["range"][0] < end\n            and start < segment["range"][1]\n        )\n        if known_bytes:\n            raise ValueError(\n                "battle-effect sprite source range is not fully current unknown: "\n                f"{source[\'id\']} ({known_bytes} known bytes)"\n            )\n\n    evidence_path = (\n        artifact_spec["artifact"] / "manifest.json"\n    ).as_posix()\n    claims: list[dict[str, Any]] = []\n    for source in ordered_sources:\n        start, end = source["range"]\n        claim = {\n            "id": source["id"],\n            "range": [start, end],\n            "source_range": [start, end],\n            "role": "primary",\n            "primary_class": source["primary_class"],\n            "claim_kind": BATTLE_EFFECT_SPRITE_SOURCE_CLAIM_KIND,\n            "promotion_batch": BATTLE_EFFECT_SPRITE_SOURCE_BATCH,\n            "promoted_from_primary_class": "unknown",\n            "baseline_unknown_only": True,\n            "source_group_index": source["source_group_index"],\n            "bytes_sha256": _sha256(rom[start:end]),\n            "evidence_path": evidence_path,\n            "evidence_sha256": BATTLE_EFFECT_SPRITE_SOURCE_MANIFEST_SHA256,\n            "evidence_selector": source["selector"],\n            "promotion_manifest_path": evidence_path,\n            "promotion_manifest_sha256": BATTLE_EFFECT_SPRITE_SOURCE_MANIFEST_SHA256,\n            "independent_verifier_path": BATTLE_EFFECT_SPRITE_SOURCE_VERIFIER.as_posix(),\n            "independent_verifier_sha256": BATTLE_EFFECT_SPRITE_SOURCE_VERIFIER_SHA256,\n            "raw_rom_resource_claimed": False,\n            "runtime_reachability_claimed": False,\n            "limitations": [\n                "Only the complete current-unknown intersection of this fixed source range is promoted.",\n                "This static source binding does not claim natural runtime reachability or editable-space safety.",\n            ],\n        }\n        for key in (\n            "source_pointer",\n            "source_raw_size",\n            "source_raw_sha256",\n            "terminator_raw_hex",\n            "source_frame_id",\n            "source_animation_id",\n            "table_entry_count",\n            "table_entry_size",\n            "pointer_values",\n        ):\n            if key in source:\n                claim[key] = source[key]\n        claims.append(claim)\n\n    class_bytes = {\n        primary_class: sum(\n            claim["range"][1] - claim["range"][0]\n            for claim in claims\n            if claim["primary_class"] == primary_class\n        )\n        for primary_class in BATTLE_EFFECT_SPRITE_SOURCE_CLASS_BYTES\n    }\n    class_counts = {\n        primary_class: sum(\n            claim["primary_class"] == primary_class for claim in claims\n        )\n        for primary_class in BATTLE_EFFECT_SPRITE_SOURCE_CLASS_COUNTS\n    }\n    denominator = [\n        {\n            key: claim[key]\n            for key in (\n                "id",\n                "range",\n                "primary_class",\n                "bytes_sha256",\n                "evidence_selector",\n            )\n        }\n        for claim in claims\n    ]\n    denominator_sha256 = _sha256(\n        json.dumps(\n            denominator,\n            ensure_ascii=True,\n            separators=(",", ":"),\n            sort_keys=True,\n        ).encode("ascii")\n    )\n    if (\n        len(claims) != BATTLE_EFFECT_SPRITE_SOURCE_EXPECTED_CLAIM_COUNT\n        or sum(end - start for start, end in (claim["range"] for claim in claims))\n        != BATTLE_EFFECT_SPRITE_SOURCE_EXPECTED_BYTES\n        or class_counts != BATTLE_EFFECT_SPRITE_SOURCE_CLASS_COUNTS\n        or class_bytes != BATTLE_EFFECT_SPRITE_SOURCE_CLASS_BYTES\n        or denominator_sha256 != BATTLE_EFFECT_SPRITE_SOURCE_CLAIM_DENOMINATOR_SHA256\n    ):\n        raise ValueError(\n            "battle-effect sprite source denominator changed: "\n            f"claims={len(claims)}, bytes={sum(c[\'range\'][1] - c[\'range\'][0] for c in claims)}, "\n            f"classes={class_counts}, class_bytes={class_bytes}, "\n            f"sha256={denominator_sha256}"\n        )\n    return claims\n\n\n# Short alias for callers that refer to the artifact as battle-effect sprite\n# sources rather than spelling out the animation schema name.\n_battle_effect_sprite_source_claims = _battle_effect_sprite_animation_source_claims\n\n\ndef _referenced_text_slot_padding_claims(\n    root: Path,\n    rom: bytes,\n    baseline_claims: list[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote only the 133 complete, independently verified zero suffixes."""\n\n    if _sha256(rom) != ROM_SHA256:\n        raise ValueError("referenced text slot padding ROM SHA-256 changed")\n    if any(\n        claim.get("promotion_batch") == REFERENCED_TEXT_SLOT_PADDING_BATCH\n        for claim in baseline_claims\n    ):\n        raise ValueError("referenced text slot padding batch is already present")\n\n    artifact = (root / REFERENCED_TEXT_SLOT_PADDING_ARTIFACT).absolute()\n    manifest_path = artifact / "manifest.json"\n    payload_path = artifact / REFERENCED_TEXT_SLOT_PADDING_PAYLOAD_NAME\n    bundle_path = artifact / REFERENCED_TEXT_SLOT_PADDING_BUNDLE_NAME\n    verifier_path = (root / REFERENCED_TEXT_SLOT_PADDING_VERIFIER).absolute()\n\n    def checked_path(path: Path, label: str, *, directory: bool = False) -> Path:\n        try:\n            resolved = path.resolve(strict=True)\n            resolved.relative_to(root)\n        except (OSError, ValueError) as error:\n            raise ValueError(\n                f"referenced text slot padding {label} path is unsafe"\n            ) from error\n        if path.is_symlink() or resolved != path:\n            raise ValueError(\n                f"referenced text slot padding {label} path is unsafe"\n            )\n        if directory:\n            if not path.is_dir():\n                raise ValueError(\n                    f"referenced text slot padding {label} is not a directory"\n                )\n        elif not path.is_file():\n            raise ValueError(\n                f"referenced text slot padding {label} is not a file"\n            )\n        return resolved\n\n    checked_path(artifact, "artifact", directory=True)\n    members = list(artifact.iterdir())\n    expected_names = {\n        "manifest.json",\n        REFERENCED_TEXT_SLOT_PADDING_PAYLOAD_NAME,\n        REFERENCED_TEXT_SLOT_PADDING_BUNDLE_NAME,\n    }\n    if (\n        {member.name for member in members} != expected_names\n        or any(member.is_symlink() or not member.is_file() for member in members)\n    ):\n        raise ValueError("referenced text slot padding artifact file denominator changed")\n    checked_path(manifest_path, "manifest")\n    checked_path(payload_path, "payload")\n    checked_path(bundle_path, "bundle")\n    checked_path(verifier_path, "verifier")\n    if _sha256_file(manifest_path) != REFERENCED_TEXT_SLOT_PADDING_MANIFEST_SHA256:\n        raise ValueError("referenced text slot padding manifest hash changed")\n    if (\n        payload_path.stat().st_size != REFERENCED_TEXT_SLOT_PADDING_PAYLOAD_SIZE\n        or _sha256_file(payload_path) != REFERENCED_TEXT_SLOT_PADDING_PAYLOAD_SHA256\n    ):\n        raise ValueError("referenced text slot padding payload identity changed")\n    if _sha256_file(bundle_path) != REFERENCED_TEXT_SLOT_PADDING_BUNDLE_SHA256:\n        raise ValueError("referenced text slot padding bundle identity changed")\n    if _sha256_file(verifier_path) != REFERENCED_TEXT_SLOT_PADDING_VERIFIER_SHA256:\n        raise ValueError("referenced text slot padding verifier identity changed")\n\n    try:\n        manifest = json.loads(manifest_path.read_bytes())\n        payload = json.loads(payload_path.read_bytes())\n    except (OSError, json.JSONDecodeError) as error:\n        raise ValueError("referenced text slot padding JSON is invalid") from error\n    if not isinstance(manifest, dict) or not isinstance(payload, dict):\n        raise ValueError("referenced text slot padding JSON is not an object")\n    if (\n        manifest.get("schema") != "git-artifact-promotion-v1"\n        or manifest.get("artifact_schema") != "rom-referenced-text-slot-padding-v1"\n        or manifest.get("artifact_status") != "accepted"\n        or manifest.get("files")\n        != {\n            REFERENCED_TEXT_SLOT_PADDING_BUNDLE_NAME: (\n                REFERENCED_TEXT_SLOT_PADDING_BUNDLE_SHA256\n            ),\n            REFERENCED_TEXT_SLOT_PADDING_PAYLOAD_NAME: (\n                REFERENCED_TEXT_SLOT_PADDING_PAYLOAD_SHA256\n            ),\n        }\n        or manifest.get("verifier", {}).get("report")\n        != REFERENCED_TEXT_SLOT_PADDING_EXPECTED_REPORT\n        or manifest.get("verifier", {}).get("verifier_sha256")\n        != REFERENCED_TEXT_SLOT_PADDING_VERIFIER_SHA256\n    ):\n        raise ValueError("referenced text slot padding manifest contract changed")\n    if (\n        payload.get("schema") != "rom-referenced-text-slot-padding-v1"\n        or payload.get("rom")\n        != {"path": ROM_PATH.as_posix(), "size": len(rom), "sha256": ROM_SHA256}\n        or payload.get("group_summaries")\n        != REFERENCED_TEXT_SLOT_PADDING_EXPECTED_REPORT["group_summaries"]\n        or payload.get("summary")\n        != {\n            "bundle_sha256": REFERENCED_TEXT_SLOT_PADDING_BUNDLE_SHA256,\n            "packed_bytes": 1_255,\n            "padding_bytes": 1_255,\n            "padding_range_count": 133,\n            "range_denominator_sha256": (\n                REFERENCED_TEXT_SLOT_PADDING_RANGE_DENOMINATOR_SHA256\n            ),\n            "range_overlap_bytes": 0,\n            "zero_byte_count": 1_255,\n        }\n        or payload.get("scope", {}).get("zero_padding_safe_allocatable") is not False\n        or payload.get("scope", {}).get("unreferenced_slots_classified") is not False\n        or payload.get("scope", {}).get("nul_or_prefix_bytes_classified_here")\n        is not False\n    ):\n        raise ValueError("referenced text slot padding payload contract changed")\n\n    try:\n        report = verify_rom_referenced_text_slot_padding(root, artifact)\n    except Exception as error:\n        raise ValueError(\n            f"referenced text slot padding independent verification failed: {error}"\n        ) from error\n    if report != REFERENCED_TEXT_SLOT_PADDING_EXPECTED_REPORT:\n        raise ValueError(\n            "referenced text slot padding independent verification failed: "\n            f"{report}"\n        )\n\n    records = payload.get("classified_ranges")\n    if not isinstance(records, list) or len(records) != 133:\n        raise ValueError("referenced text slot padding range denominator changed")\n    bundle = bundle_path.read_bytes()\n    if len(bundle) != 1_255 or any(bundle):\n        raise ValueError("referenced text slot padding bundle bytes changed")\n    baseline_segments = atomize_claims(len(rom), baseline_claims)\n    claims: list[dict[str, Any]] = []\n    previous_end = -1\n    packed_cursor = 0\n    seen_ids: set[str] = set()\n    for index, record in enumerate(records):\n        if not isinstance(record, dict):\n            raise ValueError("referenced text slot padding record is not an object")\n        start, end = _validated_range(record, len(rom))\n        if start < previous_end:\n            raise ValueError("referenced text slot padding ranges overlap or reorder")\n        previous_end = end\n        source_kind = record.get("source_kind")\n        primary_class = REFERENCED_TEXT_SLOT_PADDING_CLASS_BY_SOURCE.get(source_kind)\n        claim_kind = REFERENCED_TEXT_SLOT_PADDING_CLAIM_KIND_BY_SOURCE.get(source_kind)\n        range_id = record.get("range_id")\n        source_record_id = record.get("source_record_id")\n        source_selector = record.get("source_selector")\n        consumed = record.get("source_consumed_range")\n        physical = record.get("source_physical_range")\n        packed = record.get("packed_range")\n        raw = rom[start:end]\n        if (\n            not isinstance(range_id, str)\n            or range_id in seen_ids\n            or not isinstance(source_record_id, str)\n            or not isinstance(source_selector, str)\n            or not source_selector.startswith("/")\n            or primary_class is None\n            or claim_kind is None\n            or record.get("size") != end - start\n            or record.get("bytes_sha256") != _sha256(raw)\n            or record.get("all_zero") is not True\n            or record.get("safe_allocatable_space_claimed") is not False\n            or any(raw)\n            or not isinstance(consumed, list)\n            or not isinstance(physical, list)\n            or len(consumed) != 2\n            or len(physical) != 2\n            or consumed[1] != start\n            or physical[1] != end\n            or consumed[0] != physical[0]\n            or not 0 <= consumed[0] < consumed[1] <= physical[1] <= len(rom)\n            or rom[start - 1] != 0\n            or packed != [packed_cursor, packed_cursor + end - start]\n            or bundle[packed_cursor : packed_cursor + end - start] != raw\n        ):\n            raise ValueError(\n                f"referenced text slot padding record changed: {index}"\n            )\n        seen_ids.add(range_id)\n        packed_cursor += end - start\n\n        known_bytes = sum(\n            max(0, min(end, segment["range"][1]) - max(start, segment["range"][0]))\n            for segment in baseline_segments\n            if segment["primary_class"] != "unknown"\n            and segment["range"][0] < end\n            and start < segment["range"][1]\n        )\n        if known_bytes:\n            raise ValueError(\n                "referenced text slot padding range is not fully current unknown: "\n                f"{range_id} ({known_bytes} known bytes)"\n            )\n\n        source_domain = "chapter" if source_kind == "chapter_speaker" else "selector"\n        source_evidence = payload.get("sources", {}).get(source_domain, {}).get(\n            "payload"\n        )\n        if not isinstance(source_evidence, dict):\n            raise ValueError("referenced text slot padding source evidence changed")\n        claim = {\n            "id": f"referenced-text-slot-padding-{index:03d}-{start:06x}",\n            "range": [start, end],\n            "role": "primary",\n            "primary_class": primary_class,\n            "claim_kind": claim_kind,\n            "promotion_batch": REFERENCED_TEXT_SLOT_PADDING_BATCH,\n            "promoted_from_primary_class": "unknown",\n            "baseline_unknown_only": True,\n            "source_kind": source_kind,\n            "source_record_id": source_record_id,\n            "source_selector": source_selector,\n            "source_consumed_range": consumed,\n            "source_physical_range": physical,\n            "bytes_sha256": record["bytes_sha256"],\n            "zero_byte_count": end - start,\n            "evidence_path": (\n                REFERENCED_TEXT_SLOT_PADDING_ARTIFACT\n                / REFERENCED_TEXT_SLOT_PADDING_PAYLOAD_NAME\n            ).as_posix(),\n            "evidence_sha256": REFERENCED_TEXT_SLOT_PADDING_PAYLOAD_SHA256,\n            "evidence_selector": f"/classified_ranges/{index}",\n            "source_artifact_path": source_evidence.get("path"),\n            "source_artifact_sha256": source_evidence.get("sha256"),\n            "promotion_manifest_path": (\n                REFERENCED_TEXT_SLOT_PADDING_ARTIFACT / "manifest.json"\n            ).as_posix(),\n            "promotion_manifest_sha256": (\n                REFERENCED_TEXT_SLOT_PADDING_MANIFEST_SHA256\n            ),\n            "independent_verifier_path": (\n                REFERENCED_TEXT_SLOT_PADDING_VERIFIER.as_posix()\n            ),\n            "independent_verifier_sha256": (\n                REFERENCED_TEXT_SLOT_PADDING_VERIFIER_SHA256\n            ),\n            "safe_allocatable_space_claimed": False,\n            "runtime_reachability_claimed": False,\n            "text_semantics_claimed": False,\n            "limitations": [\n                "Only the complete current-unknown post-NUL suffix of this referenced fixed slot is promoted.",\n                "Zero bytes are structural padding, not proven editable or safely allocatable space.",\n            ],\n        }\n        if source_kind == "chapter_speaker":\n            if not isinstance(record.get("label_id"), int):\n                raise ValueError("referenced speaker label identity changed")\n            claim["label_id"] = record["label_id"]\n        else:\n            if not isinstance(record.get("slot_id"), int):\n                raise ValueError("referenced selector slot identity changed")\n            claim["slot_id"] = record["slot_id"]\n        claims.append(claim)\n\n    class_counts = {\n        primary_class: sum(\n            claim["primary_class"] == primary_class for claim in claims\n        )\n        for primary_class in REFERENCED_TEXT_SLOT_PADDING_CLASS_COUNTS\n    }\n    class_bytes = {\n        primary_class: sum(\n            claim["range"][1] - claim["range"][0]\n            for claim in claims\n            if claim["primary_class"] == primary_class\n        )\n        for primary_class in REFERENCED_TEXT_SLOT_PADDING_CLASS_BYTES\n    }\n    range_denominator = _sha256(\n        json.dumps(\n            [claim["range"] for claim in claims],\n            separators=(",", ":"),\n        ).encode("ascii")\n    )\n    if (\n        packed_cursor != 1_255\n        or len(claims) != 133\n        or class_counts != REFERENCED_TEXT_SLOT_PADDING_CLASS_COUNTS\n        or class_bytes != REFERENCED_TEXT_SLOT_PADDING_CLASS_BYTES\n        or range_denominator\n        != REFERENCED_TEXT_SLOT_PADDING_RANGE_DENOMINATOR_SHA256\n    ):\n        raise ValueError(\n            "referenced text slot padding coverage denominator changed: "\n            f"claims={len(claims)}, bytes={packed_cursor}, "\n            f"counts={class_counts}, class_bytes={class_bytes}, "\n            f"sha256={range_denominator}"\n        )\n    return claims\n\n\ndef _parser_bound_zero_padding_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote only complete current-unknown parser-bound zero ranges."""\n\n    root = Path(root).resolve(strict=True)\n    baseline_claims = list(existing_claims)\n    if any(\n        claim.get("promotion_batch") == PARSER_BOUND_ZERO_PADDING_BATCH\n        or claim.get("claim_kind") == PARSER_BOUND_ZERO_PADDING_CLAIM_KIND\n        for claim in baseline_claims\n    ):\n        raise ValueError("parser-bound zero padding batch is already present")\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError("parser-bound zero padding ROM identity changed")\n\n    artifact = (root / PARSER_BOUND_ZERO_PADDING_ARTIFACT).absolute()\n    try:\n        resolved_artifact = artifact.resolve(strict=True)\n        resolved_artifact.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError(\n            "parser-bound zero padding artifact is missing or outside the repository"\n        ) from error\n    if resolved_artifact != artifact or not artifact.is_dir():\n        raise ValueError(\n            "parser-bound zero padding artifact uses a symlink or is not a directory"\n        )\n    members = list(artifact.iterdir())\n    expected_members = {\n        "manifest.json",\n        PARSER_BOUND_ZERO_PADDING_PAYLOAD_NAME,\n        PARSER_BOUND_ZERO_PADDING_BUNDLE_NAME,\n    }\n    if (\n        {member.name for member in members} != expected_members\n        or any(member.is_symlink() or not member.is_file() for member in members)\n    ):\n        raise ValueError("parser-bound zero padding artifact file set changed")\n\n    verifier = (root / PARSER_BOUND_ZERO_PADDING_VERIFIER).absolute()\n    try:\n        resolved_verifier = verifier.resolve(strict=True)\n        resolved_verifier.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError("parser-bound zero padding verifier is missing") from error\n    if (\n        resolved_verifier != verifier\n        or not verifier.is_file()\n        or verifier.stat().st_size != PARSER_BOUND_ZERO_PADDING_VERIFIER_SIZE\n        or _sha256_file(verifier) != PARSER_BOUND_ZERO_PADDING_VERIFIER_SHA256\n    ):\n        raise ValueError("parser-bound zero padding verifier identity changed")\n\n    mani