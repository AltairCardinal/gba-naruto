_bytes(value: object) -> bytes:\n    return (\n        json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\\n"\n    ).encode("utf-8")\n\n\ndef _cfg_code_aggregate(claims: Iterable[dict[str, Any]]) -> dict[str, Any]:\n    """Build fail-closed bounded-CFG totals from one frozen kind registry."""\n\n    rows = [claim for claim in claims if claim.get("role") == "primary"]\n    stable_thumb_kinds = frozenset(CFG_CODE_KIND_REGISTRY["thumb_only"])\n    staged_thumb_kinds = frozenset(\n        CFG_STAGED_CODE_KIND_REGISTRY["thumb_only"]\n    )\n    arm_kinds = frozenset(CFG_CODE_KIND_REGISTRY["arm_only"])\n    mixed_splits = CFG_CODE_KIND_REGISTRY["mixed"]\n    mixed_kinds = frozenset(mixed_splits)\n    producer_kinds = frozenset(CFG_CODE_KIND_REGISTRY["producer_only"])\n    excluded_code_kinds = frozenset(\n        CFG_CODE_KIND_REGISTRY["excluded_code_like"]\n    )\n    excluded_producer_kinds = frozenset(\n        CFG_CODE_KIND_REGISTRY["excluded_producer_like"]\n    )\n    stable_registered_code_kinds = (\n        stable_thumb_kinds | arm_kinds | mixed_kinds\n    )\n\n    def has_semantic_token(claim: dict[str, Any], token: str) -> bool:\n        return any(\n            token in str(claim.get(field, "")).lower().split("_")\n            for field in ("claim_kind", "primary_class")\n        )\n\n    observed_code_like_kinds = {\n        str(claim.get("claim_kind"))\n        for claim in rows\n        if has_semantic_token(claim, "code")\n        or has_semantic_token(claim, "instruction")\n    }\n    active_staged_thumb_kinds = staged_thumb_kinds & observed_code_like_kinds\n    thumb_kinds = stable_thumb_kinds | active_staged_thumb_kinds\n    registered_code_kinds = stable_registered_code_kinds | active_staged_thumb_kinds\n    expected_code_like_kinds = (\n        stable_registered_code_kinds\n        | excluded_code_kinds\n        | active_staged_thumb_kinds\n    )\n    if observed_code_like_kinds != expected_code_like_kinds:\n        missing = sorted(expected_code_like_kinds - observed_code_like_kinds)\n        extra = sorted(observed_code_like_kinds - expected_code_like_kinds)\n        raise ValueError(\n            "bounded CFG code kind denominator changed: "\n            f"missing={missing}, extra={extra}"\n        )\n\n    observed_producer_like_kinds = {\n        str(claim.get("claim_kind"))\n        for claim in rows\n        if has_semantic_token(claim, "producer")\n    }\n    expected_producer_like_kinds = producer_kinds | excluded_producer_kinds\n    if observed_producer_like_kinds != expected_producer_like_kinds:\n        missing = sorted(expected_producer_like_kinds - observed_producer_like_kinds)\n        extra = sorted(observed_producer_like_kinds - expected_producer_like_kinds)\n        raise ValueError(\n            "bounded CFG producer kind denominator changed: "\n            f"missing={missing}, extra={extra}"\n        )\n\n    by_kind: dict[str, list[dict[str, Any]]] = {}\n    for claim in rows:\n        kind = str(claim.get("claim_kind"))\n        if kind in registered_code_kinds | producer_kinds:\n            by_kind.setdefault(kind, []).append(claim)\n\n    for kind in thumb_kinds - {"boot_interwork_thumb_instruction_bytes"}:\n        if any(claim.get("mode") != "thumb" for claim in by_kind[kind]):\n            raise ValueError(f"bounded CFG Thumb mode changed for {kind}")\n    if any(\n        claim.get("mode") not in {None, "arm"}\n        for kind in arm_kinds\n        for claim in by_kind[kind]\n    ):\n        raise ValueError("bounded CFG ARM mode changed")\n    if any(\n        claim.get("mode") != "thumb"\n        for kind in producer_kinds\n        for claim in by_kind[kind]\n    ):\n        raise ValueError("bounded CFG producer mode changed")\n\n    def kind_bytes(kind: str) -> int:\n        return sum(\n            claim["range"][1] - claim["range"][0]\n            for claim in by_kind[kind]\n        )\n\n    for kind, split in mixed_splits.items():\n        expected = split["arm_bytes"] + split["thumb_bytes"]\n        if kind_bytes(kind) != expected:\n            raise ValueError(f"bounded CFG mixed-mode projection changed for {kind}")\n    if any(\n        claim.get("mode") is not None\n        for claim in by_kind["directsound_pitch_high32_interwork_instruction_bytes"]\n    ):\n        raise ValueError("DirectSound mixed-mode marker changed")\n    if any(\n        claim.get("mode") != "mixed_arm_thumb_relocated"\n        for claim in by_kind["soundmain_relocated_reachable_instruction_bytes"]\n    ):\n        raise ValueError("SoundMain mixed-mode marker changed")\n\n    thumb_bytes = sum(kind_bytes(kind) for kind in thumb_kinds) + sum(\n        split["thumb_bytes"] for split in mixed_splits.values()\n    )\n    arm_bytes = sum(kind_bytes(kind) for kind in arm_kinds) + sum(\n        split["arm_bytes"] for split in mixed_splits.values()\n    )\n    producer_bytes = sum(kind_bytes(kind) for kind in producer_kinds)\n    registry_receipt: Any = CFG_CODE_KIND_REGISTRY\n    if active_staged_thumb_kinds:\n        registry_receipt = {\n            "stable": CFG_CODE_KIND_REGISTRY,\n            "active_staged_thumb_only": sorted(active_staged_thumb_kinds),\n        }\n    registry_sha256 = _sha256(\n        json.dumps(\n            registry_receipt,\n            ensure_ascii=False,\n            sort_keys=True,\n            separators=(",", ":"),\n        ).encode("utf-8")\n    )\n    return {\n        "cfg_reachable_arm_code_bytes": arm_bytes,\n        "cfg_reachable_thumb_code_bytes": thumb_bytes,\n        "cfg_promoted_unknown_bytes": arm_bytes + thumb_bytes + producer_bytes,\n        "cfg_primary_claim_count": sum(\n            len(by_kind[kind]) for kind in registered_code_kinds | producer_kinds\n        ),\n        "cfg_code_claim_kind_count": len(registered_code_kinds),\n        "cfg_code_claim_kind_denominator_sha256": registry_sha256,\n    }\n\n\ndef _checked_repository_file(\n    root: Path,\n    relative: Path,\n    expected_sha256: str,\n    *,\n    expected_size: int | None = None,\n    label: str,\n) -> Path:\n    """Resolve and identity-check one frozen repository file without symlinks."""\n\n    path = (root / relative).absolute()\n    try:\n        resolved = path.resolve(strict=True)\n        resolved.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError(f"{label} is missing or outside the repository") from error\n    if resolved != path or path.is_symlink() or not path.is_file():\n        raise ValueError(f"{label} uses a symlink or is not a file")\n    if expected_size is not None and path.stat().st_size != expected_size:\n        raise ValueError(f"{label} identity changed")\n    if _sha256_file(path) != expected_sha256:\n        raise ValueError(f"{label} identity changed")\n    return path\n\n\ndef _checked_artifact_directory(\n    root: Path,\n    relative: Path,\n    expected_files: set[str],\n    *,\n    label: str,\n) -> Path:\n    """Resolve a frozen artifact and reject foreign members and symlinks."""\n\n    artifact = (root / relative).absolute()\n    try:\n        resolved = artifact.resolve(strict=True)\n        resolved.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError(f"{label} is missing or outside the repository") from error\n    if resolved != artifact or artifact.is_symlink() or not artifact.is_dir():\n        raise ValueError(f"{label} uses a symlink or is not a directory")\n    members = list(artifact.iterdir())\n    if (\n        {member.name for member in members} != expected_files\n        or any(member.is_symlink() or not member.is_file() for member in members)\n    ):\n        raise ValueError(f"{label} file set changed")\n    return artifact\n\n\ndef _validated_range(claim: dict[str, Any], domain_end: int) -> tuple[int, int]:\n    value = claim.get("range")\n    if (\n        not isinstance(value, list)\n        or len(value) != 2\n        or not all(isinstance(item, int) for item in value)\n    ):\n        raise ValueError(f"claim {claim.get(\'id\')!r} has an invalid range")\n    start, end = value\n    if start < 0 or start >= end or end > domain_end:\n        raise ValueError(f"claim {claim.get(\'id\')!r} is outside the ROM domain")\n    return start, end\n\n\ndef atomize_claims(\n    domain_end: int, claims: Iterable[dict[str, Any]]\n) -> list[dict[str, Any]]:\n    """Turn possibly adjacent claims into gap-free, half-open ROM segments."""\n\n    if not isinstance(domain_end, int) or domain_end <= 0:\n        raise ValueError("domain_end must be a positive integer")\n    normalized = list(claims)\n    identifiers = [claim.get("id") for claim in normalized]\n    if any(not isinstance(identifier, str) or not identifier for identifier in identifiers):\n        raise ValueError("every claim must have a non-empty string id")\n    if len(set(identifiers)) != len(identifiers):\n        raise ValueError("claim ids must be unique")\n\n    ranges: dict[str, tuple[int, int]] = {}\n    endpoints = {0, domain_end}\n    for claim in normalized:\n        role = claim.get("role")\n        if role not in {"primary", "secondary"}:\n            raise ValueError(f"claim {claim[\'id\']!r} has an invalid role")\n        if role == "primary" and not isinstance(claim.get("primary_class"), str):\n            raise ValueError(f"primary claim {claim[\'id\']!r} has no class")\n        start, end = _validated_range(claim, domain_end)\n        ranges[claim["id"]] = (start, end)\n        endpoints.update((start, end))\n\n    ordered = sorted(endpoints)\n    segments: list[dict[str, Any]] = []\n    for start, end in zip(ordered, ordered[1:]):\n        active = [\n            claim\n            for claim in normalized\n            if ranges[claim["id"]][0] <= start\n            and end <= ranges[claim["id"]][1]\n        ]\n        primary = sorted(\n            (claim for claim in active if claim["role"] == "primary"),\n            key=lambda claim: claim["id"],\n        )\n        secondary = sorted(\n            (claim for claim in active if claim["role"] == "secondary"),\n            key=lambda claim: claim["id"],\n        )\n        if len(primary) > 1:\n            raise ValueError(\n                "conflicting primary claims at "\n                f"[0x{start:X}, 0x{end:X}): "\n                + ", ".join(claim["id"] for claim in primary)\n            )\n        if primary:\n            segment = {\n                "range": [start, end],\n                "primary_class": primary[0]["primary_class"],\n                "primary_claim_ids": [primary[0]["id"]],\n                "secondary_claim_ids": [claim["id"] for claim in secondary],\n            }\n        else:\n            segment = {\n                "range": [start, end],\n                "primary_class": "unknown",\n                "primary_claim_ids": [],\n                "secondary_claim_ids": [claim["id"] for claim in secondary],\n                "unknown_reason": UNKNOWN_REASON,\n            }\n        segments.append(segment)\n    return segments\n\n\ndef _merge_record_ranges(entries: object, entry_size: object) -> list[tuple[int, int, int]]:\n    if not isinstance(entries, list) or not isinstance(entry_size, int) or entry_size <= 0:\n        return []\n    record_ranges = []\n    for entry in entries:\n        offset = entry.get("_raw_offset") if isinstance(entry, dict) else None\n        if isinstance(offset, int):\n            record_ranges.append((offset, offset + entry_size))\n    record_ranges.sort()\n    merged: list[list[int]] = []\n    for start, end in record_ranges:\n        if merged and start <= merged[-1][1]:\n            merged[-1][1] = max(end, merged[-1][1])\n            merged[-1][2] += 1\n        else:\n            merged.append([start, end, 1])\n    return [(start, end, count) for start, end, count in merged]\n\n\ndef _bank_claims(root: Path, rom: bytes) -> list[dict[str, Any]]:\n    claims: list[dict[str, Any]] = []\n    for path in sorted((root / "sequel/content").glob("*/bank.json")):\n        raw = path.read_bytes()\n        bank = json.loads(raw)\n        slug = path.parent.name\n        ranges = _merge_record_ranges(bank.get("entries"), bank.get("entry_size"))\n        for index, (start, end, records) in enumerate(ranges):\n            if end > len(rom):\n                raise ValueError(f"bank {slug} range exceeds the ROM")\n            claims.append(\n                {\n                    "id": f"bank-{slug}-{index:03d}",\n                    "range": [start, end],\n                    "role": "primary",\n                    "primary_class": "fixed_table",\n                    "claim_kind": "bank_record_bytes",\n                    "bank": slug,\n                    "records": records,\n                    "bytes_sha256": _sha256(rom[start:end]),\n                    "evidence_path": path.relative_to(root).as_posix(),\n                    "evidence_sha256": _sha256(raw),\n                }\n            )\n    return claims\n\n\ndef _lz77_claims(root: Path, rom: bytes) -> list[dict[str, Any]]:\n    references = _aligned_rom_pointer_references(rom)\n    offsets = sorted(\n        offset\n        for offset in _strict_lz77_offsets(rom)\n        if offset % 4 == 0 and offset in references\n    )\n    if len(offsets) != 896:\n        raise ValueError(\n            f"aligned pointer-reachable LZ77 denominator changed: {len(offsets)}"\n        )\n    evidence = root / LZ77_EVIDENCE\n    evidence_sha256 = _sha256_file(evidence)\n    claims = []\n    for offset in offsets:\n        parsed = _parse_lz77(rom, offset, materialize=False)\n        if parsed is None:\n            raise ValueError(f"LZ77 record disappeared at 0x{offset:X}")\n        end, _ = parsed\n        claims.append(\n            {\n                "id": f"lz77-{offset:06x}",\n                "range": [offset, end],\n                "role": "primary",\n                "primary_class": "lz77_resource",\n                "claim_kind": "aligned_pointer_reachable_lz77",\n                "aligned_pointer_reference_count": len(references[offset]),\n                "bytes_sha256": _sha256(rom[offset:end]),\n                "evidence_path": LZ77_EVIDENCE.as_posix(),\n                "evidence_sha256": evidence_sha256,\n            }\n        )\n    return claims\n\n\ndef _unbound_lz77_claims(root: Path, rom: bytes) -> list[dict[str, Any]]:\n    root = Path(root).resolve(strict=True)\n    artifact_dir = (root / UNBOUND_LZ77_ARTIFACT).absolute()\n    try:\n        resolved_artifact_dir = artifact_dir.resolve(strict=True)\n        resolved_artifact_dir.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError("unbound LZ77 artifact is missing or outside the repository") from error\n    if resolved_artifact_dir != artifact_dir or not artifact_dir.is_dir():\n        raise ValueError("unbound LZ77 artifact uses a symlink or is not a directory")\n\n    artifact_paths = list(artifact_dir.iterdir())\n    if {path.name for path in artifact_paths} != {\n        "inventory.json",\n        "manifest.json",\n        "payloads.bin",\n        "streams.lz77.bin",\n    }:\n        raise ValueError("unbound LZ77 artifact file set changed")\n    if any(path.is_symlink() or not path.is_file() for path in artifact_paths):\n        raise ValueError("unbound LZ77 artifact contains a symlink or non-file entry")\n\n    verifier_path = (root / UNBOUND_LZ77_VERIFIER).absolute()\n    try:\n        resolved_verifier = verifier_path.resolve(strict=True)\n        resolved_verifier.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError("unbound LZ77 verifier is missing") from error\n    if resolved_verifier != verifier_path or not verifier_path.is_file():\n        raise ValueError("unbound LZ77 verifier uses a symlink or is not a file")\n    if _sha256_file(verifier_path) != UNBOUND_LZ77_VERIFIER_SHA256:\n        raise ValueError("unbound LZ77 verifier SHA-256 changed")\n\n    manifest_path = artifact_dir / "manifest.json"\n    manifest_raw = manifest_path.read_bytes()\n    if _sha256(manifest_raw) != UNBOUND_LZ77_MANIFEST_SHA256:\n        raise ValueError("unbound LZ77 promotion manifest SHA-256 changed")\n    manifest = json.loads(manifest_raw)\n    expected_files = {\n        "inventory.json": UNBOUND_LZ77_PAYLOAD_SHA256,\n        "payloads.bin": (\n            "7027b4c7ca61cf2b5f92dd3851cefe24bf5b244c7354756504432901055cdd65"\n        ),\n        "streams.lz77.bin": (\n            "2db24f2804ad3d6c11d2cee7cde9a0205e86ae06eab4a02339c7ade130e41505"\n        ),\n    }\n    if (\n        manifest.get("schema") != "git-artifact-promotion-v1"\n        or manifest.get("artifact_id") != "rom-unbound-lz77-inventory-v1"\n        or manifest.get("artifact_schema") != "rom-unbound-lz77-inventory-v1"\n        or manifest.get("artifact_status") != "accepted"\n        or manifest.get("payload_schema") != "rom-unbound-lz77-inventory-v1"\n        or manifest.get("payload_file") != "inventory.json"\n        or manifest.get("files") != expected_files\n        or manifest.get("scope") != UNBOUND_LZ77_EXPECTED_SCOPE\n    ):\n        raise ValueError("unbound LZ77 promotion contract changed")\n    verifier_record = manifest.get("verifier")\n    expected_report = {\n        "schema": "rom-unbound-lz77-inventory-verification-v1",\n        "verified": True,\n        **UNBOUND_LZ77_EXPECTED_SUMMARY,\n        "errors": [],\n    }\n    if (\n        not isinstance(verifier_record, dict)\n        or verifier_record.get("exit_code") != 0\n        or verifier_record.get("verifier_sha256")\n        != UNBOUND_LZ77_VERIFIER_SHA256\n        or verifier_record.get("report") != expected_report\n    ):\n        raise ValueError("unbound LZ77 recorded verification contract changed")\n\n    payload_path = artifact_dir / "inventory.json"\n    payload_raw = payload_path.read_bytes()\n    if _sha256(payload_raw) != UNBOUND_LZ77_PAYLOAD_SHA256:\n        raise ValueError("unbound LZ77 inventory payload SHA-256 changed")\n    payload = json.loads(payload_raw)\n    if (\n        payload.get("schema") != "rom-unbound-lz77-inventory-v1"\n        or payload.get("rom")\n        != {\n            "path": ROM_PATH.as_posix(),\n            "size": len(rom),\n            "sha256": ROM_SHA256,\n        }\n        or payload.get("summary") != UNBOUND_LZ77_EXPECTED_SUMMARY\n        or payload.get("scope") != UNBOUND_LZ77_EXPECTED_SCOPE\n        or payload.get("coverage")\n        != {\n            "path": "sequel/rom-byte-coverage.json",\n            "allowed_primary_classes": ["lz77_syntax_unbound", "unknown"],\n            "hash_pinned": False,\n            "hash_pin_omission_reason": (\n                "coverage incorporates these claims, so a coverage hash would "\n                "create a dependency cycle; the verifier reconstructs its "\n                "gap-free state and allowed classes instead"\n            ),\n        }\n    ):\n        raise ValueError("unbound LZ77 inventory contract changed")\n\n    report = verify_rom_unbound_lz77_inventory(root, artifact_dir)\n    if report != expected_report:\n        raise ValueError(f"unbound LZ77 independent verification failed: {report}")\n\n    records = payload.get("records")\n    if not isinstance(records, list) or len(records) != 41:\n        raise ValueError("unbound LZ77 record denominator changed")\n    claims: list[dict[str, Any]] = []\n    previous_end = -1\n    compressed_cursor = 0\n    decompressed_cursor = 0\n    for index, record in enumerate(records):\n        if not isinstance(record, dict):\n            raise ValueError("unbound LZ77 record is not an object")\n        value = record.get("range")\n        if (\n            not isinstance(value, list)\n            or len(value) != 2\n            or not all(isinstance(item, int) for item in value)\n        ):\n            raise ValueError("unbound LZ77 record range is invalid")\n        start, end = value\n        if start < previous_end or start < 0 or start >= end or end > len(rom):\n            raise ValueError("unbound LZ77 record ranges overlap or leave the ROM")\n        if (\n            record.get("classification") != "lz77_syntax_unbound"\n            or record.get("aligned_pointer_reference_count") != 0\n            or record.get("runtime_reachability_claimed") is not False\n            or record.get("compressed_size") != end - start\n            or record.get("compressed_bundle_offset") != compressed_cursor\n            or record.get("decompressed_bundle_offset") != decompressed_cursor\n        ):\n            raise ValueError("unbound LZ77 record contract changed")\n        compressed_sha256 = record.get("compressed_sha256")\n        if compressed_sha256 != _sha256(rom[start:end]):\n            raise ValueError(f"unbound LZ77 ROM bytes changed at 0x{start:06X}")\n        decompressed_size = record.get("decompressed_size")\n        if not isinstance(decompressed_size, int) or decompressed_size <= 0:\n            raise ValueError("unbound LZ77 decompressed size is invalid")\n        claims.append(\n            {\n                "id": f"unbound-lz77-{index:02d}-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": "lz77_syntax_unbound",\n                "claim_kind": "unbound_strict_lz77_syntax_range",\n                "record_index": index,\n                "aligned_pointer_reference_count": 0,\n                "runtime_reachability_claimed": False,\n                "bytes_sha256": compressed_sha256,\n                "evidence_path": (\n                    UNBOUND_LZ77_ARTIFACT / "inventory.json"\n                ).as_posix(),\n                "evidence_sha256": UNBOUND_LZ77_PAYLOAD_SHA256,\n                "evidence_selector": f"/records/{index}",\n                "promotion_manifest_path": (\n                    UNBOUND_LZ77_ARTIFACT / "manifest.json"\n                ).as_posix(),\n                "promotion_manifest_sha256": UNBOUND_LZ77_MANIFEST_SHA256,\n                "independent_verifier_path": UNBOUND_LZ77_VERIFIER.as_posix(),\n                "independent_verifier_sha256": UNBOUND_LZ77_VERIFIER_SHA256,\n                "limitations": [\n                    "Strict type-0x10 syntax is proven, but consumer identity, runtime reachability, resource role, and graphics semantics are not claimed."\n                ],\n            }\n        )\n        previous_end = end\n        compressed_cursor += end - start\n        decompressed_cursor += decompressed_size\n    if (\n        compressed_cursor\n        != UNBOUND_LZ77_EXPECTED_SUMMARY["selected_compressed_bytes"]\n        or decompressed_cursor\n        != UNBOUND_LZ77_EXPECTED_SUMMARY["selected_decompressed_bytes"]\n    ):\n        raise ValueError("unbound LZ77 selected byte denominator changed")\n    return claims\n\n\ndef _cfg_inventory_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote only baseline-unknown bytes reached by the fixed-root CFG."""\n\n    root = Path(root).resolve(strict=True)\n    baseline_claims = list(existing_claims)\n    if any(\n        claim.get("claim_kind") == "cfg_reachable_instruction_bytes"\n        for claim in baseline_claims\n    ):\n        raise ValueError("CFG inventory claims must be derived from a pre-CFG baseline")\n\n    artifact_dir = (root / CFG_INVENTORY_ARTIFACT).absolute()\n    try:\n        resolved_artifact = artifact_dir.resolve(strict=True)\n        resolved_artifact.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError("CFG inventory artifact is missing or outside the repository") from error\n    if resolved_artifact != artifact_dir or not artifact_dir.is_dir():\n        raise ValueError("CFG inventory artifact uses a symlink or is not a directory")\n    members = list(artifact_dir.iterdir())\n    if (\n        {member.name for member in members}\n        != {"manifest.json", "rom-cfg-inventory.json"}\n        or any(member.is_symlink() or not member.is_file() for member in members)\n    ):\n        raise ValueError("CFG inventory artifact file set changed")\n\n    verifier_path = (root / CFG_INVENTORY_VERIFIER).absolute()\n    try:\n        resolved_verifier = verifier_path.resolve(strict=True)\n        resolved_verifier.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError("CFG inventory verifier is missing") from error\n    if resolved_verifier != verifier_path or not verifier_path.is_file():\n        raise ValueError("CFG inventory verifier uses a symlink or is not a file")\n    if _sha256_file(verifier_path) != CFG_INVENTORY_VERIFIER_SHA256:\n        raise ValueError("CFG inventory verifier SHA-256 changed")\n\n    manifest_path = artifact_dir / "manifest.json"\n    payload_path = artifact_dir / "rom-cfg-inventory.json"\n    manifest_raw = manifest_path.read_bytes()\n    payload_raw = payload_path.read_bytes()\n    if _sha256(manifest_raw) != CFG_INVENTORY_MANIFEST_SHA256:\n        raise ValueError("CFG inventory manifest SHA-256 changed")\n    if _sha256(payload_raw) != CFG_INVENTORY_PAYLOAD_SHA256:\n        raise ValueError("CFG inventory payload SHA-256 changed")\n    manifest = json.loads(manifest_raw)\n    payload = json.loads(payload_raw)\n    expected_rom = {\n        "path": ROM_PATH.as_posix(),\n        "size": len(rom),\n        "sha256": ROM_SHA256,\n    }\n    if (\n        manifest.get("artifact_schema") != "rom-cfg-inventory-v2"\n        or manifest.get("rom") != expected_rom\n        or manifest.get("summary") != CFG_INVENTORY_EXPECTED_SUMMARY\n        or manifest.get("scope") != CFG_INVENTORY_EXPECTED_SCOPE\n        or manifest.get("graph_denominator_sha256")\n        != CFG_INVENTORY_GRAPH_SHA256\n        or manifest.get("files")\n        != {\n            "rom-cfg-inventory.json": {\n                "size": len(payload_raw),\n                "sha256": CFG_INVENTORY_PAYLOAD_SHA256,\n            }\n        }\n        or manifest.get("implementation", {}).get("verifier_sha256")\n        != CFG_INVENTORY_VERIFIER_SHA256\n    ):\n        raise ValueError("CFG inventory promotion contract changed")\n    if (\n        payload.get("schema") != "rom-cfg-inventory-v2"\n        or payload.get("rom") != expected_rom\n        or payload.get("summary") != CFG_INVENTORY_EXPECTED_SUMMARY\n        or payload.get("scope") != CFG_INVENTORY_EXPECTED_SCOPE\n        or payload.get("graph_denominator_sha256")\n        != CFG_INVENTORY_GRAPH_SHA256\n    ):\n        raise ValueError("CFG inventory payload contract changed")\n\n    report = verify_rom_cfg_inventory(root, artifact_dir)\n    if report != CFG_INVENTORY_EXPECTED_REPORT:\n        raise ValueError(f"CFG inventory independent verification failed: {report}")\n\n    baseline_segments = atomize_claims(len(rom), baseline_claims)\n    unknown_ranges = [\n        tuple(segment["range"])\n        for segment in baseline_segments\n        if segment["primary_class"] == "unknown"\n    ]\n    blocks = payload.get("blocks")\n    if not isinstance(blocks, list) or len(blocks) != 7_725:\n        raise ValueError("CFG inventory block denominator changed")\n\n    source_pieces: list[dict[str, Any]] = []\n    unknown_index = 0\n    previous_block_end = -1\n    for block in blocks:\n        if not isinstance(block, dict):\n            raise ValueError("CFG inventory block is not an object")\n        mode = block.get("mode")\n        value = block.get("range")\n        if (\n            mode not in {"arm", "thumb"}\n            or not isinstance(value, list)\n            or len(value) != 2\n            or not all(isinstance(item, int) for item in value)\n        ):\n            raise ValueError("CFG inventory block schema changed")\n        start, end = value\n        block_id = block.get("id")\n        if (\n            block_id != f"block-{mode}-{start:06x}"\n            or start < previous_block_end\n            or start < 0\n            or start >= end\n            or end > len(rom)\n            or block.get("bytes_sha256") != _sha256(rom[start:end])\n            or not isinstance(block.get("instruction_count"), int)\n            or block["instruction_count"] <= 0\n        ):\n            raise ValueError(f"CFG inventory block bytes or identity changed: {block_id}")\n        previous_block_end = end\n        while (\n            unknown_index < len(unknown_ranges)\n            and unknown_ranges[unknown_index][1] <= start\n        ):\n            unknown_index += 1\n        scan_index = unknown_index\n        while (\n            scan_index < len(unknown_ranges)\n            and unknown_ranges[scan_index][0] < end\n        ):\n            unknown_start, unknown_end = unknown_ranges[scan_index]\n            piece_start = max(start, unknown_start)\n            piece_end = min(end, unknown_end)\n            if piece_start < piece_end:\n                source_pieces.append(\n                    {\n                        "mode": mode,\n                        "block_id": block_id,\n                        "range": [piece_start, piece_end],\n                    }\n                )\n            scan_index += 1\n\n    if len(source_pieces) != CFG_PROMOTED_SOURCE_PIECES:\n        raise ValueError(\n            "CFG inventory unknown-intersection denominator changed: "\n            f"{len(source_pieces)}"\n        )\n    merged: list[dict[str, Any]] = []\n    for piece in source_pieces:\n        start, end = piece["range"]\n        if (\n            merged\n            and merged[-1]["mode"] == piece["mode"]\n            and merged[-1]["range"][1] == start\n        ):\n            merged[-1]["range"][1] = end\n            merged[-1]["source_blocks"].append(\n                {"block_id": piece["block_id"], "range": piece["range"]}\n            )\n        else:\n            if merged and start < merged[-1]["range"][1]:\n                raise ValueError("CFG inventory promoted ranges overlap")\n            merged.append(\n                {\n                    "mode": piece["mode"],\n                    "range": [start, end],\n                    "source_blocks": [\n                        {"block_id": piece["block_id"], "range": piece["range"]}\n                    ],\n                }\n            )\n    promoted_bytes = sum(end - start for start, end in (item["range"] for item in merged))\n    if (\n        len(merged) != CFG_PROMOTED_CLAIM_COUNT\n        or promoted_bytes != CFG_PROMOTED_UNKNOWN_BYTES\n        or any(item["mode"] != "thumb" for item in merged)\n    ):\n        raise ValueError(\n            "CFG inventory promoted claim denominator changed: "\n            f"claims={len(merged)}, bytes={promoted_bytes}"\n        )\n\n    claims: list[dict[str, Any]] = []\n    for index, item in enumerate(merged):\n        start, end = item["range"]\n        mode = item["mode"]\n        source_blocks = item["source_blocks"]\n        claims.append(\n            {\n                "id": f"cfg-{mode}-{index:04d}-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": f"armv4t_cfg_reachable_{mode}_code",\n                "claim_kind": "cfg_reachable_instruction_bytes",\n                "mode": mode,\n                "source_block_count": len(source_blocks),\n                "source_blocks": source_blocks,\n                "fixed_root_count": 263,\n                "graph_denominator_sha256": CFG_INVENTORY_GRAPH_SHA256,\n                "promoted_from_primary_class": "unknown",\n                "runtime_reachability_claimed": False,\n                "global_code_map_claimed": False,\n                "bytes_sha256": _sha256(rom[start:end]),\n                "evidence_path": (\n                    CFG_INVENTORY_ARTIFACT / "rom-cfg-inventory.json"\n                ).as_posix(),\n                "evidence_sha256": CFG_INVENTORY_PAYLOAD_SHA256,\n                "evidence_selector": "/blocks",\n                "promotion_manifest_path": (\n                    CFG_INVENTORY_ARTIFACT / "manifest.json"\n                ).as_posix(),\n                "promotion_manifest_sha256": CFG_INVENTORY_MANIFEST_SHA256,\n                "independent_verifier_path": CFG_INVENTORY_VERIFIER.as_posix(),\n                "independent_verifier_sha256": CFG_INVENTORY_VERIFIER_SHA256,\n                "limitations": [\n                    "Only bytes reached from the fixed 263-root denominator and still unknown in the pre-CFG coverage baseline are promoted.",\n                    "Indirect targets, global function discovery, and natural runtime reachability remain unproven.",\n                ],\n            }\n        )\n    return claims\n\n\ndef _cfg_inventory_v3_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote only current unknown bytes proven by the one-generation v3 delta."""\n\n    root = Path(root).resolve(strict=True)\n    baseline_claims = list(existing_claims)\n    v3_kinds = {\n        "cfg_v3_reachable_instruction_bytes",\n        "cfg_v3_indexed_dispatch_table_cell",\n        "cfg_v3_sparse_dispatch_masked_residual_cell",\n    }\n    if any(claim.get("claim_kind") in v3_kinds for claim in baseline_claims):\n        raise ValueError("CFG v3 claims must be derived from a pre-v3 baseline")\n\n    artifact_dir = (root / CFG_V3_INVENTORY_ARTIFACT).absolute()\n    try:\n        resolved_artifact = artifact_dir.resolve(strict=True)\n        resolved_artifact.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError("CFG v3 artifact is missing or outside the repository") from error\n    if resolved_artifact != artifact_dir or not artifact_dir.is_dir():\n        raise ValueError("CFG v3 artifact uses a symlink or is not a directory")\n    members = list(artifact_dir.iterdir())\n    if (\n        {member.name for member in members}\n        != {"manifest.json", "rom-cfg-inventory-v3.json"}\n        or any(member.is_symlink() or not member.is_file() for member in members)\n    ):\n        raise ValueError("CFG v3 artifact file set changed")\n\n    verifier_path = (root / CFG_V3_INVENTORY_VERIFIER).absolute()\n    try:\n        resolved_verifier = verifier_path.resolve(strict=True)\n        resolved_verifier.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError("CFG v3 verifier is missing") from error\n    if resolved_verifier != verifier_path or not verifier_path.is_file():\n        raise ValueError("CFG v3 verifier uses a symlink or is not a file")\n    if _sha256_file(verifier_path) != CFG_V3_INVENTORY_VERIFIER_SHA256:\n        raise ValueError("CFG v3 verifier SHA-256 changed")\n\n    manifest_path = artifact_dir / "manifest.json"\n    payload_path = artifact_dir / "rom-cfg-inventory-v3.json"\n    manifest_raw = manifest_path.read_bytes()\n    payload_raw = payload_path.read_bytes()\n    if _sha256(manifest_raw) != CFG_V3_INVENTORY_MANIFEST_SHA256:\n        raise ValueError("CFG v3 manifest SHA-256 changed")\n    if _sha256(payload_raw) != CFG_V3_INVENTORY_PAYLOAD_SHA256:\n        raise ValueError("CFG v3 payload SHA-256 changed")\n    manifest = json.loads(manifest_raw)\n    payload = json.loads(payload_raw)\n    expected_rom = {\n        "path": ROM_PATH.as_posix(),\n        "size": len(rom),\n        "sha256": ROM_SHA256,\n    }\n    expected_dispatch_summary = {\n        "baseline_indirect_frontier_count": 357,\n        "resolved_frontier_count": 29,\n        "unresolved_baseline_indirect_frontier_count": 328,\n        "ordered_edge_count": 677,\n        "unique_target_count": 290,\n        "ordered_target_vector_sha256": (\n            "ab4572dcb948a49e6172e18f2fd9c482e61ee018c42cf0be77bd0e67f0c86615"\n        ),\n    }\n    if (\n        manifest.get("artifact_schema") != "rom-cfg-inventory-v3"\n        or manifest.get("rom") != expected_rom\n        or manifest.get("base_cfg", {}).get("graph_denominator_sha256")\n        != CFG_INVENTORY_GRAPH_SHA256\n        or manifest.get("static_dispatch_summary") != expected_dispatch_summary\n        or manifest.get("extension_policy") != CFG_V3_EXPECTED_POLICY\n        or manifest.get("extension_summary")\n        != CFG_V3_EXPECTED_EXTENSION_SUMMARY\n        or manifest.get("combined_summary") != CFG_V3_EXPECTED_COMBINED_SUMMARY\n        or manifest.get("graph_denominator_sha256")\n        != CFG_V3_INVENTORY_GRAPH_SHA256\n        or manifest.get("scope") != CFG_V3_EXPECTED_SCOPE\n        or manifest.get("files")\n        != {\n            "rom-cfg-inventory-v3.json": {\n                "size": len(payload_raw),\n                "sha256": CFG_V3_INVENTORY_PAYLOAD_SHA256,\n            }\n        }\n        or manifest.get("implementation", {}).get("verifier_sha256")\n        != CFG_V3_INVENTORY_VERIFIER_SHA256\n    ):\n        raise ValueError("CFG v3 promotion manifest contract changed")\n    static_dispatches = payload.get("static_dispatches")\n    extension = payload.get("extension")\n    if (\n        payload.get("schema") != "rom-cfg-inventory-v3"\n        or payload.get("rom") != expected_rom\n        or payload.get("base_cfg") != manifest.get("base_cfg")\n        or payload.get("extension_policy") != CFG_V3_EXPECTED_POLICY\n        or not isinstance(static_dispatches, dict)\n        or {\n            key: static_dispatches.get(key) for key in expected_dispatch_summary\n        }\n        != expected_dispatch_summary\n        or not isinstance(extension, dict)\n        or extension.get("summary") != CFG_V3_EXPECTED_EXTENSION_SUMMARY\n        or payload.get("combined_summary") != CFG_V3_EXPECTED_COMBINED_SUMMARY\n        or payload.get("graph_denominator_sha256")\n        != CFG_V3_INVENTORY_GRAPH_SHA256\n        or payload.get("scope") != CFG_V3_EXPECTED_SCOPE\n    ):\n        raise ValueError("CFG v3 payload contract changed")\n    report = verify_rom_cfg_inventory_v3(root, artifact_dir)\n    if report != CFG_V3_EXPECTED_REPORT:\n        raise ValueError(f"CFG v3 independent verification failed: {report}")\n\n    baseline_segments = atomize_claims(len(rom), baseline_claims)\n    unknown_ranges = [\n        tuple(segment["range"])\n        for segment in baseline_segments\n        if segment["primary_class"] == "unknown"\n    ]\n\n    blocks = extension.get("blocks")\n    if not isinstance(blocks, list) or len(blocks) != 891:\n        raise ValueError("CFG v3 extension block denominator changed")\n    source_pieces: list[dict[str, Any]] = []\n    unknown_index = 0\n    previous_end = -1\n    for block in blocks:\n        if not isinstance(block, dict):\n            raise ValueError("CFG v3 extension block is not an object")\n        mode = block.get("mode")\n        value = block.get("range")\n        if (\n            mode != "thumb"\n            or not isinstance(value, list)\n            or len(value) != 2\n            or not all(isinstance(item, int) for item in value)\n        ):\n            raise ValueError("CFG v3 extension block schema changed")\n        start, end = value\n        block_id = block.get("id")\n        if (\n            block_id != f"block-{mode}-{start:06x}"\n            or start < previous_end\n            or start < 0\n            or start >= end\n            or end > len(rom)\n            or block.get("bytes_sha256") != _sha256(rom[start:end])\n            or not isinstance(block.get("instruction_count"), int)\n            or block["instruction_count"] <= 0\n        ):\n            raise ValueError(\n                f"CFG v3 extension block bytes or identity changed: {block_id}"\n            )\n        previous_end = end\n        while (\n            unknown_index < len(unknown_ranges)\n            and unknown_ranges[unknown_index][1] <= start\n        ):\n            unknown_index += 1\n        scan_index = unknown_index\n        while scan_index < len(unknown_ranges) and unknown_ranges[scan_index][0] < end:\n            unknown_start, unknown_end = unknown_ranges[scan_index]\n            piece_start = max(start, unknown_start)\n            piece_end = min(end, unknown_end)\n            if piece_start < piece_end:\n                source_pieces.append(\n                    {\n                        "mode": mode,\n                        "block_id": block_id,\n                        "range": [piece_start, piece_end],\n                    }\n                )\n            scan_index += 1\n\n    merged: list[dict[str, Any]] = []\n    for piece in source_pieces:\n        start, end = piece["range"]\n        if merged and merged[-1]["range"][1] == start:\n            merged[-1]["range"][1] = end\n            merged[-1]["source_blocks"].append(\n                {"block_id": piece["block_id"], "range": piece["range"]}\n            )\n        else:\n            if merged and start < merged[-1]["range"][1]:\n                raise ValueError("CFG v3 promoted code ranges overlap")\n            merged.append(\n                {\n                    "mode": piece["mode"],\n                    "range": [start, end],\n                    "source_blocks": [\n                        {"block_id": piece["block_id"], "range": piece["range"]}\n                    ],\n                }\n            )\n    promoted_code_bytes = sum(\n        item["range"][1] - item["range"][0] for item in merged\n    )\n    if (\n        len(source_pieces) != CFG_V3_PROMOTED_SOURCE_PIECES\n        or len(merged) != CFG_V3_PROMOTED_CODE_CLAIM_COUNT\n        or promoted_code_bytes != CFG_V3_PROMOTED_CODE_BYTES\n    ):\n        raise ValueError(\n            "CFG v3 promoted code denominator changed: "\n            f"pieces={len(source_pieces)}, claims={len(merged)}, "\n            f"bytes={promoted_code_bytes}"\n        )\n\n    code_claims = []\n    for index, item in enumerate(merged):\n        start, end = item["range"]\n        code_claims.append(\n            {\n                "id": f"cfg-v3-thumb-{index:04d}-{start:0