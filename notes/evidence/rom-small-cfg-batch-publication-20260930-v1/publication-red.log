ct)\n        or report.get("verified") is not True\n        or report.get("errors") != []\n    ):\n        raise ValueError(\n            "tile-BG LZ77/palette gap independent verification failed: "\n            f"{report}"\n        )\n    report_sha256 = _sha256(\n        json.dumps(\n            report,\n            ensure_ascii=True,\n            separators=(",", ":"),\n            sort_keys=True,\n        ).encode("ascii")\n    )\n    rows = report.get("rows")\n    if (\n        report_sha256 != TILE_BG_LZ77_PALETTE_GAP_REPORT_SHA256\n        or report.get("schema")\n        != "rom-tile-bg-lz77-palette-alignment-gaps-verification-v1"\n        or report.get("promotion_batch") != TILE_BG_LZ77_PALETTE_GAP_BATCH\n        or report.get("primary_class")\n        != TILE_BG_LZ77_PALETTE_GAP_PRIMARY_CLASS\n        or report.get("claim_kind") != TILE_BG_LZ77_PALETTE_GAP_CLAIM_KIND\n        or report.get("gap_count") != TILE_BG_LZ77_PALETTE_GAP_COUNT\n        or report.get("gap_bytes") != TILE_BG_LZ77_PALETTE_GAP_BYTES\n        or report.get("size_counts") != {"1": 31, "2": 25, "3": 28}\n        or report.get("range_vector_sha256")\n        != TILE_BG_LZ77_PALETTE_GAP_RANGE_VECTOR_SHA256\n        or report.get("boundary_vector_sha256")\n        != TILE_BG_LZ77_PALETTE_GAP_BOUNDARY_VECTOR_SHA256\n        or report.get("packed_bytes_sha256")\n        != TILE_BG_LZ77_PALETTE_GAP_PACKED_BYTES_SHA256\n        or report.get("aligned_pointer_reachable_lz77_count") != 896\n        or report.get("tile_descriptor_count") != 79\n        or report.get("tile_palette_entry_count") != 236\n        or report.get("tile_raw_palette_range_count") != 108\n        or report.get("tile_merged_palette_claim_count") != 107\n        or report.get("tile_merged_palette_bytes") != 9_984\n        or report.get("all_zero") is not True\n        or report.get("right_end_align4") is not True\n        or report.get("non_claims") != list(TILE_BG_LZ77_PALETTE_GAP_NON_CLAIMS)\n        or not isinstance(repor