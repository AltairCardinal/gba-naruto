 and one unsupported instruction remain open.",\n                    "Natural runtime reachability and a global code map are not claimed.",\n                ],\n            }\n        )\n\n    producer_records = producer_denominator.get("producers")\n    expected_producers = [\n        (0x73690, 0x6B49C, "f7f704ff"),\n        (0x7425A, 0x851F8, "10f0cdff"),\n        (0x7434E, 0x851F8, "10f053ff"),\n        (0x74448, 0x6B49C, "f7f728f8"),\n        (0x74F2C, 0x689A4, "f3f73afd"),\n    ]\n    if not isinstance(producer_records, list) or len(producer_records) != 5:\n        raise ValueError("CFG proven-root v2 producer denominator changed")\n    producer_claims = []\n    for index, (record, expected) in enumerate(\n        zip(producer_records, expected_producers, strict=True)\n    ):\n        if not isinstance(record, dict):\n            raise ValueError("CFG proven-root v2 producer is not an object")\n        start, target, raw_hex = expected\n        end = start + 4\n        unknown_bytes = sum(\n            max(0, min(end, unknown_end) - max(start, unknown_start))\n            for unknown_start, unknown_end in unknown_ranges\n            if unknown_start < end and start < unknown_end\n        )\n        if (\n            record.get("file_offset") != start\n            or record.get("target_file_offset") != target\n            or record.get("raw_hex") != raw_hex\n            or rom[start:end].hex() != raw_hex\n            or record.get("bytes_sha256") != _sha256(rom[start:end])\n            or unknown_bytes != 4\n        ):\n            raise ValueError(\n                f"CFG proven-root v2 producer claim changed at 0x{start:06X}"\n            )\n        if any(\n            start < claim["range"][1] and claim["range"][0] < end\n            for claim in code_claims\n        ):\n            raise ValueError("CFG proven-root v2 producer overlaps reachable code")\n        producer_claims.append(\n            {\n                "id": f"cfg-proven-roots-v2-producer-{index:02d}-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": "thumb_bl_direct_call_producer",\n                "claim_kind": "cfg_proven_roots_v2_direct_thumb_bl_producer",\n                "mode": "thumb",\n                "target_file_offset": target,\n                "producer_denominator_sha256": (\n                    CFG_PROVEN_ROOTS_V2_PRODUCER_SHA256\n                ),\n                "promoted_from_primary_class": "unknown",\n                "runtime_reachability_claimed": False,\n                "global_code_map_claimed": False,\n                "global_thumb_bl_denominator_claimed": False,\n                "bytes_sha256": _sha256(rom[start:end]),\n                "evidence_path": (\n                    CFG_PROVEN_ROOTS_V2_ARTIFACT\n                    / "rom-cfg-proven-roots-v2.json"\n                ).as_posix(),\n                "evidence_sha256": CFG_PROVEN_ROOTS_V2_PAYLOAD_SHA256,\n                "evidence_selector": f"/producer_denominator/producers/{index}",\n                "promotion_manifest_path": (\n                    CFG_PROVEN_ROOTS_V2_ARTIFACT / "manifest.json"\n                ).as_posix(),\n                "promotion_manifest_sha256": CFG_PROVEN_ROOTS_V2_MANIFEST_SHA256,\n                "independent_verifier_path": CFG_PROVEN_ROOTS_V2_VERIFIER.as_posix(),\n                "independent_verifier_sha256": (\n                    CFG_PROVEN_ROOTS_V2_VERIFIER_SHA256\n                ),\n                "promotion_batch": "cfg-proven-roots-v2",\n                "limitations": [\n                    "This proves one aligned Thumb BL producer targeting the three fixed roots, not natural execution.",\n                    "The denominator is complete only for BL instructions targeting these three roots.",\n                ],\n            }\n        )\n    if (\n        len(producer_claims) != CFG_PROVEN_ROOTS_V2_PRODUCER_CLAIM_COUNT\n        or sum(claim["range"][1] - claim["range"][0] for claim in producer_claims)\n        != CFG_PROVEN_ROOTS_V2_PRODUCER_BYTES\n    ):\n        raise ValueError("CFG proven-root v2 producer promotion denominator changed")\n    return code_claims + producer_claims\n\n\ndef _battle_controller_cfg_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote current-unknown bytes reachable from the corrected dispatcher.\n\n    The dispatcher produces 38 unique Thumb targets inside the corrected\n    controller range [0x732B4, 0x7509C); one of those targets (0x74918)\n    coincides with a frozen v1 producer and is skipped.  The remaining 37\n    targets yield 49 contiguous claim ranges totalling exactly 6172 bytes of\n    currently-unknown reachable code.  The eight direct-call Thumb BL\n    producers already claimed by the v1/v2 producer audits are never\n    re-claimed.\n    """\n\n    root = Path(root).resolve(strict=True)\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError("battle-controller CFG ROM identity changed")\n\n    artifact_dir = (root / BATTLE_CONTROLLER_CFG_ARTIFACT).absolute()\n    try:\n        resolved_artifact = artifact_dir.resolve(strict=True)\n        resolved_artifact.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError(\n            "battle-controller CFG artifact is missing or outside the repository"\n        ) from error\n    if resolved_artifact != artifact_dir or not artifact_dir.is_dir():\n        raise ValueError(\n            "battle-controller CFG artifact uses a symlink or is not a directory"\n        )\n    members = list(artifact_dir.iterdir())\n    if (\n        {member.name for member in members}\n        != {BATTLE_CONTROLLER_CFG_MANIFEST_NAME, BATTLE_CONTROLLER_CFG_PAYLOAD_NAME}\n        or any(member.is_symlink() or not member.is_file() for member in members)\n    ):\n        raise ValueError("battle-controller CFG artifact file set changed")\n\n    verifier_path = (root / BATTLE_CONTROLLER_CFG_VERIFIER).absolute()\n    try:\n        resolved_verifier = verifier_path.resolve(strict=True)\n        resolved_verifier.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError(\n            "battle-controller CFG verifier is missing"\n        ) from error\n    if resolved_verifier != verifier_path or not verifier_path.is_file():\n        raise ValueError(\n            "battle-controller CFG verifier uses a symlink or is not a file"\n        )\n    if _sha256_file(verifier_path) != BATTLE_CONTROLLER_CFG_VERIFIER_SHA256:\n        raise ValueError("battle-controller CFG verifier SHA-256 changed")\n\n    manifest_path = artifact_dir / BATTLE_CONTROLLER_CFG_MANIFEST_NAME\n    payload_path = artifact_dir / BATTLE_CONTROLLER_CFG_PAYLOAD_NAME\n    manifest_raw = manifest_path.read_bytes()\n    payload_raw = payload_path.read_bytes()\n    if _sha256(manifest_raw) != BATTLE_CONTROLLER_CFG_MANIFEST_SHA256:\n        raise ValueError("battle-controller CFG manifest SHA-256 changed")\n    if (\n        len(payload_raw) != BATTLE_CONTROLLER_CFG_PAYLOAD_SIZE\n        or _sha256(payload_raw) != BATTLE_CONTROLLER_CFG_PAYLOAD_SHA256\n    ):\n        raise ValueError("battle-controller CFG payload identity changed")\n    manifest = json.loads(manifest_raw)\n    payload = json.loads(payload_raw)\n    expected_rom = {\n        "path": ROM_PATH.as_posix(),\n        "size": len(rom),\n        "sha256": ROM_SHA256,\n    }\n    expected_controller = {\n        "range": list(BATTLE_CONTROLLER_CFG_CONTROLLER_RANGE),\n    }\n    if (\n        manifest.get("artifact_schema") != "rom-battle-controller-cfg-v1"\n        or manifest.get("rom") != expected_rom\n        or manifest.get("controller", {}).get("range")\n        != expected_controller["range"]\n        or manifest.get("dispatch_summary", {}).get(\n            "mapping_denominator_sha256"\n        ) != BATTLE_CONTROLLER_CFG_DISPATCH_MAPPING_SHA256\n        or manifest.get("root_count") != BATTLE_CONTROLLER_CFG_EXPECTED_ROOT_COUNT\n        or manifest.get("dispatch_summary", {}).get(\n            "nondefault_state_count"\n        ) != BATTLE_CONTROLLER_CFG_EXPECTED_DISPATCH_NONDEFAULT\n        or manifest.get("dispatch_summary", {}).get(\n            "default_state_count"\n        ) != BATTLE_CONTROLLER_CFG_EXPECTED_DISPATCH_DEFAULT\n        or manifest.get("extension_summary") != BATTLE_CONTROLLER_CFG_EXPECTED_SUMMARY\n    ):\n        raise ValueError(\n            "battle-controller CFG promotion manifest contract changed"\n        )\n    if (\n        payload.get("schema") != "rom-battle-controller-cfg-v1"\n        or payload.get("rom") != expected_rom\n        or payload.get("controller", {}).get("range")\n        != expected_controller["range"]\n        or payload.get("dispatcher", {}).get(\n            "mapping_denominator_sha256"\n        ) != BATTLE_CONTROLLER_CFG_DISPATCH_MAPPING_SHA256\n        or len(payload.get("roots", [])) != BATTLE_CONTROLLER_CFG_EXPECTED_ROOT_COUNT\n    ):\n        raise ValueError("battle-controller CFG payload contract changed")\n    report = verify_rom_battle_controller_cfg(root, artifact_dir)\n    if not report.get("verified"):\n        raise ValueError(\n            "battle-controller CFG independent verification failed: "\n            f"{report.get(\'errors\', [])}"\n        )\n    if report.get("summary") != BATTLE_CONTROLLER_CFG_EXPECTED_SUMMARY:\n        raise ValueError("battle-controller CFG verifier summary disagrees")\n\n    baseline_segments = atomize_claims(len(rom), list(existing_claims))\n    unknown_ranges = [\n        tuple(segment["range"])\n        for segment in baseline_segments\n        if segment["primary_class"] == "unknown"\n    ]\n    blocks = payload.get("extension", {}).get("blocks")\n    if not isinstance(blocks, list):\n        raise ValueError("battle-controller CFG blocks missing")\n\n    # Defensive: the eight excluded producer bytes must never appear in the\n    # new CFG\'s reachable set.  This is a structural invariant the exporter\n    # already guarantees; the audit re-checks it from ROM bytes alone.\n    excluded_bytes = {\n        byte\n        for start, end in BATTLE_CONTROLLER_CFG_EXCLUDED_PRODUCER_RANGES\n        for byte in range(start, end)\n    }\n    for block in blocks:\n        block_start, block_end = block["range"]\n        if excluded_bytes & set(range(block_start, block_end)):\n            raise ValueError(\n                "battle-controller CFG reachable block overlaps an excluded "\n                f"producer range: {block}"\n            )\n\n    # Walk each reachable block and intersect it with current-unknown ranges\n    # to produce the per-block promoted pieces.\n    source_pieces: list[dict[str, Any]] = []\n    unknown_index = 0\n    previous_block_end = -1\n    for block in blocks:\n        if not isinstance(block, dict):\n            raise ValueError("battle-controller CFG block is not an object")\n        mode = block.get("mode")\n        value = block.get("range")\n        if (\n            mode != "thumb"\n            or not isinstance(value, list)\n            or len(value) != 2\n            or not all(isinstance(item, int) for item in value)\n        ):\n            raise ValueError("battle-controller CFG block schema changed")\n        start, end = value\n        block_id = block.get("id")\n        if (\n            block_id != f"block-thumb-{start:06x}"\n            or start < previous_block_end\n            or start < 0\n            or start >= end\n            or end > len(rom)\n            or block.get("bytes_sha256") != _sha256(rom[start:end])\n            or not isinstance(block.get("instruction_count"), int)\n            or block["instruction_count"] <= 0\n        ):\n            raise ValueError(\n                f"battle-controller CFG block identity changed: {block_id}"\n            )\n        previous_block_end = end\n        while (\n            unknown_index < len(unknown_ranges)\n            and unknown_ranges[unknown_index][1] <= start\n        ):\n            unknown_index += 1\n        scan_index = unknown_index\n        while scan_index < len(unknown_ranges) and unknown_ranges[scan_index][0] < end:\n            unknown_start, unknown_end = unknown_ranges[scan_index]\n            piece_start = max(start, unknown_start)\n            piece_end = min(end, unknown_end)\n            if piece_start < piece_end:\n                source_pieces.append(\n                    {\n                        "mode": mode,\n                        "block_id": block_id,\n                        "range": [piece_start, piece_end],\n                    }\n                )\n            scan_index += 1\n\n    merged: list[dict[str, Any]] = []\n    for piece in source_pieces:\n        start, end = piece["range"]\n        if (\n            merged\n            and merged[-1]["mode"] == piece["mode"]\n            and merged[-1]["range"][1] == start\n        ):\n            merged[-1]["range"][1] = end\n            merged[-1]["source_blocks"].append(\n                {"block_id": piece["block_id"], "range": piece["range"]}\n            )\n        else:\n            if merged and start < merged[-1]["range"][1]:\n                raise ValueError("battle-controller CFG promoted ranges overlap")\n            merged.append(\n                {\n                    "mode": piece["mode"],\n                    "range": [start, end],\n                    "source_blocks": [\n                        {"block_id": piece["block_id"], "range": piece["range"]}\n                    ],\n                }\n            )\n    promoted_code_bytes = sum(\n        item["range"][1] - item["range"][0] for item in merged\n    )\n    if (\n        len(merged) != BATTLE_CONTROLLER_CFG_PROMOTED_CODE_CLAIM_COUNT\n        or promoted_code_bytes != BATTLE_CONTROLLER_CFG_PROMOTED_CODE_BYTES\n    ):\n        raise ValueError(\n            "battle-controller CFG promoted code denominator changed: "\n            f"claims={len(merged)}, bytes={promoted_code_bytes}"\n        )\n    code_claims = []\n    for index, item in enumerate(merged):\n        start, end = item["range"]\n        code_claims.append(\n            {\n                "id": (\n                    f"battle-controller-cfg-thumb-{index:04d}-{start:06x}"\n                ),\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": (\n                    "armv4t_cfg_battle_controller_reachable_thumb_code"\n                ),\n                "claim_kind": (\n                    "battle_controller_cfg_reachable_instruction_bytes"\n                ),\n                "mode": "thumb",\n                "source_block_count": len(item["source_blocks"]),\n                "source_blocks": item["source_blocks"],\n                "fixed_root_count": BATTLE_CONTROLLER_CFG_EXPECTED_ROOT_COUNT,\n                "dispatcher_mapping_sha256": (\n                    BATTLE_CONTROLLER_CFG_DISPATCH_MAPPING_SHA256\n                ),\n                "controller_range": list(\n                    BATTLE_CONTROLLER_CFG_CONTROLLER_RANGE\n                ),\n                "promoted_from_primary_class": "unknown",\n                "runtime_reachability_claimed": False,\n                "global_code_map_claimed": False,\n                "natural_dispatcher_reachability_claimed": False,\n                "bytes_sha256": _sha256(rom[start:end]),\n                "evidence_path": (\n                    BATTLE_CONTROLLER_CFG_ARTIFACT\n                    / BATTLE_CONTROLLER_CFG_PAYLOAD_NAME\n                ).as_posix(),\n                "evidence_sha256": BATTLE_CONTROLLER_CFG_PAYLOAD_SHA256,\n                "evidence_selector": "/extension/blocks",\n                "promotion_manifest_path": (\n                    BATTLE_CONTROLLER_CFG_ARTIFACT / BATTLE_CONTROLLER_CFG_MANIFEST_NAME\n                ).as_posix(),\n                "promotion_manifest_sha256": BATTLE_CONTROLLER_CFG_MANIFEST_SHA256,\n                "independent_verifier_path": (\n                    BATTLE_CONTROLLER_CFG_VERIFIER.as_posix()\n                ),\n                "independent_verifier_sha256": (\n                    BATTLE_CONTROLLER_CFG_VERIFIER_SHA256\n                ),\n                "promotion_batch": "battle-controller-cfg-v1",\n                "limitations": [\n                    (\n                        "Only the 38 dispatcher targets inside the corrected "\n                        "controller range are roots; one root coincides with a "\n                        "frozen v1 producer and is excluded."\n                    ),\n                    (\n                        "Five frontiers (1 decode failure, 2 indirect PC "\n                        "targets, 2 unsupported instructions) remain open."\n                    ),\n                    (\n                        "Indirect PC targets, BIOS SWI, and out-of-range "\n                        "edges are recorded as opaque; natural runtime "\n                        "reachability is not claimed."\n                    ),\n                ],\n            }\n        )\n    return code_claims\n\n\ndef _cfg_proven_roots_v3_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote only the current-unknown bytes in the closed 0x070DF8 CFG."""\n\n    root = Path(root).resolve(strict=True)\n    baseline_claims = list(existing_claims)\n    claim_kind = "cfg_proven_roots_v3_reachable_instruction_bytes"\n    if any(claim.get("claim_kind") == claim_kind for claim in baseline_claims):\n        raise ValueError("CFG proven-root v3 requires a pre-v3 baseline")\n    if not any(\n        claim.get("claim_kind")\n        == "battle_controller_cfg_reachable_instruction_bytes"\n        for claim in baseline_claims\n    ):\n        raise ValueError("CFG proven-root v3 baseline is missing controller CFG")\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError("CFG proven-root v3 ROM identity changed")\n\n    artifact_dir = (root / CFG_PROVEN_ROOTS_V3_ARTIFACT).absolute()\n    try:\n        resolved_artifact = artifact_dir.resolve(strict=True)\n        resolved_artifact.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError("CFG proven-root v3 artifact is missing") from error\n    if resolved_artifact != artifact_dir or not artifact_dir.is_dir():\n        raise ValueError("CFG proven-root v3 artifact uses a symlink")\n    members = list(artifact_dir.iterdir())\n    if (\n        {member.name for member in members}\n        != {"manifest.json", CFG_PROVEN_ROOTS_V3_PAYLOAD_NAME}\n        or any(member.is_symlink() or not member.is_file() for member in members)\n    ):\n        raise ValueError("CFG proven-root v3 artifact file set changed")\n\n    verifier_path = (root / CFG_PROVEN_ROOTS_V3_VERIFIER).absolute()\n    try:\n        resolved_verifier = verifier_path.resolve(strict=True)\n        resolved_verifier.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError("CFG proven-root v3 verifier is missing") from error\n    if resolved_verifier != verifier_path or not verifier_path.is_file():\n        raise ValueError("CFG proven-root v3 verifier uses a symlink")\n    if _sha256_file(verifier_path) != CFG_PROVEN_ROOTS_V3_VERIFIER_SHA256:\n        raise ValueError("CFG proven-root v3 verifier SHA-256 changed")\n\n    manifest_raw = (artifact_dir / "manifest.json").read_bytes()\n    payload_raw = (artifact_dir / CFG_PROVEN_ROOTS_V3_PAYLOAD_NAME).read_bytes()\n    if _sha256(manifest_raw) != CFG_PROVEN_ROOTS_V3_MANIFEST_SHA256:\n        raise ValueError("CFG proven-root v3 manifest SHA-256 changed")\n    if (\n        len(payload_raw) != CFG_PROVEN_ROOTS_V3_PAYLOAD_SIZE\n        or _sha256(payload_raw) != CFG_PROVEN_ROOTS_V3_PAYLOAD_SHA256\n    ):\n        raise ValueError("CFG proven-root v3 payload identity changed")\n    payload = json.loads(payload_raw)\n    report = verify_rom_cfg_proven_roots_v3(root, artifact_dir)\n    if report != CFG_PROVEN_ROOTS_V3_EXPECTED_REPORT:\n        raise ValueError(\n            f"CFG proven-root v3 independent verification failed: {report}"\n        )\n\n    producers = payload.get("producer_denominator", {}).get("producers")\n    expected_producers = [\n        (0x74192, 0x70DF8, "fcf731fe"),\n        (0x74836, 0x70DF8, "fcf7dffa"),\n    ]\n    if not isinstance(producers, list) or len(producers) != 2:\n        raise ValueError("CFG proven-root v3 producer denominator changed")\n    for record, (start, target, raw_hex) in zip(\n        producers, expected_producers, strict=True\n    ):\n        raw = rom[start : start + 4]\n        if (\n            not isinstance(record, dict)\n            or record.get("file_offset") != start\n            or record.get("target_file_offset") != target\n            or record.get("raw_hex") != raw_hex\n            or raw.hex() != raw_hex\n            or record.get("bytes_sha256") != _sha256(raw)\n        ):\n            raise ValueError(\n                f"CFG proven-root v3 producer changed at 0x{start:06X}"\n            )\n\n    unknown_ranges = [\n        tuple(segment["range"])\n        for segment in atomize_claims(len(rom), baseline_claims)\n        if segment["primary_class"] == "unknown"\n    ]\n    blocks = payload.get("extension", {}).get("blocks")\n    if not isinstance(blocks, list) or len(blocks) != 8:\n        raise ValueError("CFG proven-root v3 block denominator changed")\n    claims: list[dict[str, Any]] = []\n    previous_end = -1\n    for index, block in enumerate(blocks):\n        if not isinstance(block, dict):\n            raise ValueError("CFG proven-root v3 block is not an object")\n        value = block.get("range")\n        if (\n            block.get("mode") != "thumb"\n            or not isinstance(value, list)\n            or len(value) != 2\n            or not all(isinstance(item, int) for item in value)\n        ):\n            raise ValueError("CFG proven-root v3 block schema changed")\n        start, end = value\n        block_id = block.get("id")\n        if (\n            block_id != f"block-thumb-{start:06x}"\n            or start < previous_end\n            or start < 0\n            or start >= end\n            or end > len(rom)\n            or block.get("bytes_sha256") != _sha256(rom[start:end])\n        ):\n            raise ValueError(f"CFG proven-root v3 block changed: {block_id}")\n        previous_end = end\n        pieces = [\n            (max(start, unknown_start), min(end, unknown_end))\n            for unknown_start, unknown_end in unknown_ranges\n            if unknown_start < end and start < unknown_end\n        ]\n        pieces = [(piece_start, piece_end) for piece_start, piece_end in pieces if piece_start < piece_end]\n        if pieces != [(start, end)]:\n            raise ValueError(\n                f"CFG proven-root v3 block is not wholly current-unknown: {block_id}"\n            )\n        claims.append(\n            {\n                "id": f"cfg-proven-roots-v3-thumb-{index:04d}-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": "armv4t_cfg_proven_roots_v3_reachable_thumb_code",\n                "claim_kind": claim_kind,\n                "mode": "thumb",\n                "source_block_count": 1,\n                "source_blocks": [{"block_id": block_id, "range": [start, end]}],\n                "fixed_root_count": 1,\n                "fixed_direct_producer_count": 2,\n                "promoted_from_primary_class": "unknown",\n                "runtime_reachability_claimed": False,\n                "global_code_map_claimed": False,\n                "bytes_sha256": _sha256(rom[start:end]),\n                "evidence_path": (\n                    CFG_PROVEN_ROOTS_V3_ARTIFACT\n                    / CFG_PROVEN_ROOTS_V3_PAYLOAD_NAME\n                ).as_posix(),\n                "evidence_sha256": CFG_PROVEN_ROOTS_V3_PAYLOAD_SHA256,\n                "evidence_selector": f"/extension/blocks/{index}",\n                "promotion_manifest_path": (\n                    CFG_PROVEN_ROOTS_V3_ARTIFACT / "manifest.json"\n                ).as_posix(),\n                "promotion_manifest_sha256": CFG_PROVEN_ROOTS_V3_MANIFEST_SHA256,\n                "independent_verifier_path": CFG_PROVEN_ROOTS_V3_VERIFIER.as_posix(),\n                "independent_verifier_sha256": CFG_PROVEN_ROOTS_V3_VERIFIER_SHA256,\n                "promotion_batch": "cfg-proven-roots-v3",\n                "limitations": [\n                    "Only the closed CFG rooted at the fixed direct-call target 0x070DF8 is promoted.",\n                    "The two producers are provenance only because the controller CFG already classifies them.",\n                    "Natural runtime reachability and a global code map are not claimed.",\n                ],\n            }\n        )\n    promoted_bytes = sum(end - start for start, end in (claim["range"] for claim in claims))\n    if (\n        len(claims) != CFG_PROVEN_ROOTS_V3_PROMOTED_CODE_CLAIM_COUNT\n        or promoted_bytes != CFG_PROVEN_ROOTS_V3_PROMOTED_CODE_BYTES\n    ):\n        raise ValueError(\n            "CFG proven-root v3 promotion denominator changed: "\n            f"claims={len(claims)}, bytes={promoted_bytes}"\n        )\n    return claims\n\n\ndef _cfg_proven_roots_v4_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote current-unknown bytes reached from the fixed 0x07305C root."""\n\n    root = Path(root).resolve(strict=True)\n    baseline_claims = list(existing_claims)\n    claim_kind = "cfg_proven_roots_v4_reachable_instruction_bytes"\n    if any(claim.get("claim_kind") == claim_kind for claim in baseline_claims):\n        raise ValueError("CFG proven-root v4 requires a pre-v4 baseline")\n    if not any(\n        claim.get("claim_kind")\n        == "cfg_proven_roots_v3_reachable_instruction_bytes"\n        for claim in baseline_claims\n    ):\n        raise ValueError("CFG proven-root v4 baseline is missing proven-roots-v3")\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError("CFG proven-root v4 ROM identity changed")\n\n    artifact_dir = (root / CFG_PROVEN_ROOTS_V4_ARTIFACT).absolute()\n    try:\n        resolved_artifact = artifact_dir.resolve(strict=True)\n        resolved_artifact.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError("CFG proven-root v4 artifact is missing") from error\n    if resolved_artifact != artifact_dir or not artifact_dir.is_dir():\n        raise ValueError("CFG proven-root v4 artifact uses a symlink")\n    members = list(artifact_dir.iterdir())\n    if (\n        {member.name for member in members}\n        != {"manifest.json", CFG_PROVEN_ROOTS_V4_PAYLOAD_NAME}\n        or any(member.is_symlink() or not member.is_file() for member in members)\n    ):\n        raise ValueError("CFG proven-root v4 artifact file set changed")\n    verifier_path = (root / CFG_PROVEN_ROOTS_V4_VERIFIER).absolute()\n    try:\n        resolved_verifier = verifier_path.resolve(strict=True)\n        resolved_verifier.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError("CFG proven-root v4 verifier is missing") from error\n    if resolved_verifier != verifier_path or not verifier_path.is_file():\n        raise ValueError("CFG proven-root v4 verifier uses a symlink")\n    if _sha256_file(verifier_path) != CFG_PROVEN_ROOTS_V4_VERIFIER_SHA256:\n        raise ValueError("CFG proven-root v4 verifier SHA-256 changed")\n\n    manifest_raw = (artifact_dir / "manifest.json").read_bytes()\n    payload_raw = (artifact_dir / CFG_PROVEN_ROOTS_V4_PAYLOAD_NAME).read_bytes()\n    if _sha256(manifest_raw) != CFG_PROVEN_ROOTS_V4_MANIFEST_SHA256:\n        raise ValueError("CFG proven-root v4 manifest SHA-256 changed")\n    if (\n        len(payload_raw) != CFG_PROVEN_ROOTS_V4_PAYLOAD_SIZE\n        or _sha256(payload_raw) != CFG_PROVEN_ROOTS_V4_PAYLOAD_SHA256\n    ):\n        raise ValueError("CFG proven-root v4 payload identity changed")\n    payload = json.loads(payload_raw)\n    report = verify_rom_cfg_proven_roots_v4(root, artifact_dir)\n    if report != CFG_PROVEN_ROOTS_V4_EXPECTED_REPORT:\n        raise ValueError(\n            f"CFG proven-root v4 independent verification failed: {report}"\n        )\n\n    producers = payload.get("producer_denominator", {}).get("producers")\n    expected_producers = [\n        (0x73696, "fff7e1fc"),\n        (0x736C4, "fff7cafc"),\n        (0x7444E, "fef705fe"),\n        (0x749CE, "fef745fb"),\n    ]\n    if not isinstance(producers, list) or len(producers) != 4:\n        raise ValueError("CFG proven-root v4 producer denominator changed")\n    for record, (start, raw_hex) in zip(producers, expected_producers, strict=True):\n        raw = rom[start : start + 4]\n        if (\n            not isinstance(record, dict)\n            or record.get("file_offset") != start\n            or record.get("target_file_offset") != 0x7305C\n            or record.get("raw_hex") != raw_hex\n            or raw.hex() != raw_hex\n            or record.get("bytes_sha256") != _sha256(raw)\n        ):\n            raise ValueError(f"CFG proven-root v4 producer changed at 0x{start:06X}")\n\n    unknown_ranges = [\n        tuple(segment["range"])\n        for segment in atomize_claims(len(rom), baseline_claims)\n        if segment["primary_class"] == "unknown"\n    ]\n    blocks = payload.get("extension", {}).get("blocks")\n    if not isinstance(blocks, list) or len(blocks) != 118:\n        raise ValueError("CFG proven-root v4 block denominator changed")\n    claims: list[dict[str, Any]] = []\n    previous_end = -1\n    for index, block in enumerate(blocks):\n        if not isinstance(block, dict):\n            raise ValueError("CFG proven-root v4 block is not an object")\n        value = block.get("range")\n        if (\n            block.get("mode") != "thumb"\n            or not isinstance(value, list)\n            or len(value) != 2\n            or not all(isinstance(item, int) for item in value)\n        ):\n            raise ValueError("CFG proven-root v4 block schema changed")\n        start, end = value\n        block_id = block.get("id")\n        if (\n            block_id != f"block-thumb-{start:06x}"\n            or start < previous_end\n            or start < 0\n            or start >= end\n            or end > len(rom)\n            or block.get("bytes_sha256") != _sha256(rom[start:end])\n        ):\n            raise ValueError(f"CFG proven-root v4 block changed: {block_id}")\n        previous_end = end\n        pieces = [\n            (max(start, unknown_start), min(end, unknown_end))\n            for unknown_start, unknown_end in unknown_ranges\n            if unknown_start < end and start < unknown_end\n        ]\n        pieces = [(a, b) for a, b in pieces if a < b]\n        if pieces != [(start, end)]:\n            raise ValueError(\n                f"CFG proven-root v4 block is not wholly current-unknown: {block_id}"\n            )\n        claims.append(\n            {\n                "id": f"cfg-proven-roots-v4-thumb-{index:04d}-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": "armv4t_cfg_proven_roots_v4_reachable_thumb_code",\n                "claim_kind": claim_kind,\n                "mode": "thumb",\n                "source_block_count": 1,\n                "source_blocks": [{"block_id": block_id, "range": [start, end]}],\n                "fixed_root_count": 1,\n                "fixed_direct_producer_count": 4,\n                "promoted_from_primary_class": "unknown",\n                "runtime_reachability_claimed": False,\n                "global_code_map_claimed": False,\n                "bytes_sha256": _sha256(rom[start:end]),\n                "evidence_path": (\n                    CFG_PROVEN_ROOTS_V4_ARTIFACT / CFG_PROVEN_ROOTS_V4_PAYLOAD_NAME\n                ).as_posix(),\n                "evidence_sha256": CFG_PROVEN_ROOTS_V4_PAYLOAD_SHA256,\n                "evidence_selector": f"/extension/blocks/{index}",\n                "promotion_manifest_path": (\n                    CFG_PROVEN_ROOTS_V4_ARTIFACT / "manifest.json"\n                ).as_posix(),\n                "promotion_manifest_sha256": CFG_PROVEN_ROOTS_V4_MANIFEST_SHA256,\n                "independent_verifier_path": CFG_PROVEN_ROOTS_V4_VERIFIER.as_posix(),\n                "independent_verifier_sha256": CFG_PROVEN_ROOTS_V4_VERIFIER_SHA256,\n                "promotion_batch": "cfg-proven-roots-v4",\n                "limitations": [\n                    "Only current-unknown bytes reached from the fixed 0x07305C root are promoted.",\n                    "Four direct producers are provenance only and are not re-claimed.",\n                    "Six indirect PC targets remain opaque; natural runtime reachability and a global code map are not claimed.",\n                ],\n            }\n        )\n    promoted_bytes = sum(b - a for a, b in (claim["range"] for claim in claims))\n    if (\n        len(claims) != CFG_PROVEN_ROOTS_V4_PROMOTED_CODE_CLAIM_COUNT\n        or promoted_bytes != CFG_PROVEN_ROOTS_V4_PROMOTED_CODE_BYTES\n    ):\n        raise ValueError(\n            "CFG proven-root v4 promotion denominator changed: "\n            f"claims={len(claims)}, bytes={promoted_bytes}"\n        )\n    return claims\n\n\ndef _cfg_proven_roots_v5_claims(\n    root: Path, rom: bytes, existing_claims: Iterable[dict[str, Any]]\n) -> list[dict[str, Any]]:\n    """Promote the 124 current-unknown blocks in the fixed three-root v5 CFG."""\n    root = Path(root).resolve(strict=True); baseline = list(existing_claims)\n    kind = "cfg_proven_roots_v5_reachable_instruction_bytes"\n    if any(c.get("claim_kind") == kind for c in baseline): raise ValueError("v5 requires a pre-v5 baseline")\n    artifact = (root / CFG_PROVEN_ROOTS_V5_ARTIFACT).absolute()\n    if artifact.resolve(strict=True) != artifact or not artifact.is_dir(): raise ValueError("v5 artifact invalid")\n    members = list(artifact.iterdir())\n    if {x.name for x in members} != {"manifest.json", CFG_PROVEN_ROOTS_V5_PAYLOAD_NAME} or any(x.is_symlink() or not x.is_file() for x in members): raise ValueError("v5 artifact file set changed")\n    verifier = (root / CFG_PROVEN_ROOTS_V5_VERIFIER).absolute()\n    if verifier.resolve(strict=True) != verifier or _sha256_file(verifier) != CFG_PROVEN_ROOTS_V5_VERIFIER_SHA256: raise ValueError("v5 verifier identity changed")\n    manifest_raw = (artifact / "manifest.json").read_bytes(); payload_raw = (artifact / CFG_PROVEN_ROOTS_V5_PAYLOAD_NAME).read_bytes()\n    if _sha256(manifest_raw) != CFG_PROVEN_ROOTS_V5_MANIFEST_SHA256 or len(payload_raw) != CFG_PROVEN_ROOTS_V5_PAYLOAD_SIZE or _sha256(payload_raw) != CFG_PROVEN_ROOTS_V5_PAYLOAD_SHA256: raise ValueError("v5 artifact identity changed")\n    report = verify_rom_cfg_proven_roots_v5(root, artifact)\n    if report != CFG_PROVEN_ROOTS_V5_EXPECTED_REPORT: raise ValueError(f"v5 verification failed: {report}")\n    payload = json.loads(payload_raw); producers = payload["producer_denominator"]["producers"]\n    expected = [(0x736DE, 0x6DF88), (0x73702, 0x8A534), (0x73780, 0x8A588)]\n    if [(x.get("file_offset"), x.get("target_file_offset")) for x in producers] != expected: raise ValueError("v5 producers changed")\n    unknown = [tuple(s["range"]) for s in atomize_claims(len(rom), baseline) if s["primary_class"] == "unknown"]\n    blocks = payload["extension"]["blocks"]\n    if len(blocks) != 124: raise ValueError("v5 block denominator changed")\n    claims = []\n    for i, block in enumerate(blocks):\n        start, end = block["range"]; block_id = block["id"]\n        if block.get("mode") != "thumb" or block_id != f"block-thumb-{start:06x}" or block.get("bytes_sha256") != _sha256(rom[start:end]): raise ValueError("v5 block identity changed")\n        pieces = [(max(start,a), min(end,b)) for a,b in unknown if a < end and start < b]\n        pieces = [(a,b) for a,b in pieces if a < b]\n        if pieces != [(start,end)]: raise ValueError(f"v5 block not wholly unknown: {block_id}")\n        claims.append({\n            "id": f"cfg-proven-roots-v5-thumb-{i:04d}-{start:06x}", "range": [start,end], "role": "primary",\n            "primary_class": "armv4t_cfg_proven_roots_v5_reachable_thumb_code", "claim_kind": kind, "mode": "thumb",\n            "source_block_count": 1, "source_blocks": [{"block_id": block_id, "range": [start,end]}],\n            "fixed_root_count": 3, "fixed_direct_producer_count": 3, "promoted_from_primary_class": "unknown",\n            "runtime_reachability_claimed": False, "global_code_map_claimed": False, "bytes_sha256": _sha256(rom[start:end]),\n            "evidence_path": (CFG_PROVEN_ROOTS_V5_ARTIFACT / CFG_PROVEN_ROOTS_V5_PAYLOAD_NAME).as_posix(), "evidence_sha256": CFG_PROVEN_ROOTS_V5_PAYLOAD_SHA256,\n            "evidence_selector": f"/extension/blocks/{i}", "promotion_manifest_path": (CFG_PROVEN_ROOTS_V5_ARTIFACT / "manifest.json").as_posix(),\n            "promotion_manifest_sha256": CFG_PROVEN_ROOTS_V5_MANIFEST_SHA256, "independent_verifier_path": CFG_PROVEN_ROOTS_V5_VERIFIER.as_posix(),\n            "independent_verifier_sha256": CFG_PROVEN_ROOTS_V5_VERIFIER_SHA256, "promotion_batch": "cfg-proven-roots-v5",\n            "limitations": ["Only current-unknown bytes from three fixed direct-call roots are promoted.", "Eight indirect PC targets remain opaque; natural runtime reachability is not claimed."],\n        })\n    if len(claims) != 124 or sum(c["range"][1]-c["range"][0] for c in claims) != 1_252: raise ValueError("v5 promotion denominator changed")\n    return claims\n\n\ndef _cfg_proven_roots_v6_claims(\n    root: Path, rom: bytes, existing_claims: Iterable[dict[str, Any]]\n) -> list[dict[str, Any]]:\n    """Promote only the current-unknown intersection of the fixed v6 CFG."""\n    root = Path(root).resolve(strict=True)\n    baseline = list(existing_claims)\n    kind = "cfg_proven_roots_v6_reachable_instruction_bytes"\n    if any(claim.get("claim_kind") == kind for claim in baseline):\n        raise ValueError("v6 requires a pre-v6 baseline")\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError("v6 ROM identity changed")\n    artifact = (root / CFG_PROVEN_ROOTS_V6_ARTIFACT).absolute()\n    if artifact.resolve(strict=True) != artifact or not artifact.is_dir():\n        raise ValueError("v6 artifact invalid")\n    members = list(artifact.iterdir())\n    if (\n        {item.name for item in members}\n        != {"manifest.json", CFG_PROVEN_ROOTS_V6_PAYLOAD_NAME}\n        or any(item.is_symlink() or not item.is_file() for item in members)\n    ):\n        raise ValueError("v6 artifact file set changed")\n    verifier = (root / CFG_PROVEN_ROOTS_V6_VERIFIER).absolute()\n    if (\n        verifier.resolve(strict=True) != verifier\n        or _sha256_file(verifier) != CFG_PROVEN_ROOTS_V6_VERIFIER_SHA256\n    ):\n        raise ValueError("v6 verifier identity changed")\n    manifest_raw = (artifact / "manifest.json").read_bytes()\n    payload_raw = (artifact / CFG_PROVEN_ROOTS_V6_PAYLOAD_NAME).read_bytes()\n    if (\n        _sha256(manifest_raw) != CFG_PROVEN_ROOTS_V6_MANIFEST_SHA256\n        or len(payload_raw) != CFG_PROVEN_ROOTS_V6_PAYLOAD_SIZE\n        or _sha256(payload_raw) != CFG_PROVEN_ROOTS_V6_PAYLOAD_SHA256\n    ):\n        raise ValueError("v6 artifact identity changed")\n    report = verify_rom_cfg_proven_roots_v6(root, artifact)\n    if report != CFG_PROVEN_ROOTS_V6_EXPECTED_REPORT:\n        raise ValueError(f"v6 verification failed: {report}")\n    payload = json.loads(payload_raw)\n    producers = payload["producer_denominator"]["producers"]\n    expected_producers = [\n        (0x8F474, 0x8ECD0), (0x8F47A, 0x8E118),\n        (0x8F644, 0x8A0F0), (0x8F872, 0x87940),\n        (0x8F9C0, 0x8A0F0), (0x8FA1C, 0x86FEC),\n    ]\n    if [\n        (item.get("file_offset"), item.get("target_file_offset"))\n        for item in producers\n    ] != expected_producers:\n        raise ValueError("v6 producer denominator changed")\n    unknown = [\n        tuple(segment["range"])\n        for segment in atomize_claims(len(rom), baseline)\n        if segment["primary_class"] == "unknown"\n    ]\n    blocks = payload["extension"]["blocks"]\n    if len(blocks) != 2_305:\n        raise ValueError("v6 block denominator changed")\n    claims: list[dict[str, Any]] = []\n    previous_end = -1\n    for block_index, block in enumerate(blocks):\n        start, end = block.get("range", [None, None])\n        block_id = block.get("id")\n        if (\n            block.get("mode") != "thumb"\n            or not isinstance(start, int)\n            or not isinstance(end, int)\n            or start < previous_end\n            or not 0 <= start < end <= len(rom)\n            or block_id != f"block-thumb-{start:06x}"\n            or block.get("bytes_sha256") != _sha256(rom[start:end])\n        ):\n            raise ValueError(f"v6 block identity changed: {block_id}")\n        previous_end = end\n        pieces = [\n            (max(start, a), min(end, b))\n            for a, b in unknown\n            if a < end and start < b\n        ]\n        for piece_index, (piece_start, piece_end) in enumerate(pieces):\n            claims.append({\n                "id": f"cfg-proven-roots-v6-thumb-{block_index:04d}-{piece_index:02d}-{piece_start:06x}",\n                "range": [piece_start, piece_end], "role": "primary",\n                "primary_class": "armv4t_cfg_proven_roots_v6_reachable_thumb_code",\n                "claim_kind": kind, "mode": "thumb", "source_block_count": 1,\n                "source_blocks": [{"block_id": block_id, "range": [start, end]}],\n                "fixed_root_count": 5, "fixed_direct_producer_count": 6,\n                "promoted_from_primary_class": "unknown",\n                "runtime_reachability_claimed": False, "global_code_map_claimed": False,\n                "bytes_sha256": _sha256(rom[piece_start:piece_end]),\n                "evidence_path": (CFG_PROVEN_ROOTS_V6_ARTIFACT / CFG_PROVEN_ROOTS_V6_PAYLOAD_NAME).as_posix(),\n                "evidence_sha256": CFG_PROVEN_ROOTS_V6_PAYLOAD_SHA256,\n                "evidence_selector": f"/extension/blocks/{block_index}",\n                "promotion_manifest_path": (CFG_PROVEN_ROOTS_V6_ARTIFACT / "manifest.json").as_posix(),\n                "promotion_manifest_sha256": CFG_PROVEN_ROOTS_V6_MANIFEST_SHA256,\n                "independent_verifier_path": CFG_PROVEN_ROOTS_V6_VERIFIER.as_posix(),\n                "independent_verifier_sha256": CFG_PROVEN_ROOTS_V6_VERIFIER_SHA256,\n                "promotion_batch": "cfg-proven-roots-v6",\n                "limitations": [\n                    "Only the current-unknown intersection of five fixed direct-call roots is promoted.",\n                    "Six producers and 1,298 already-classified reachable bytes are not re-claimed.",\n                    "Eighty-five indirect PC targets remain opaque; natural runtime reachability and a global code map are not claimed.",\n                ],\n            })\n    if sum(c["range"][1] - c["range"][0] for c in claims) != 25_926:\n        raise ValueError("v6 promotion byte denominator changed")\n    return claims\n\n\ndef _cfg_proven_roots_v7_claims(\n    root: Path, rom: bytes, existing_claims: Iterable[dict[str, Any]]\n) -> list[dict[str, Any]]:\n    """Promote only current-unknown bytes from two fixed dispatchers."""\n    root = Path(root).resolve(strict=True)\n    baseline = list(existing_claims)\n    code_kind = "cfg_proven_roots_v7_reachable_instruction_bytes"\n    table_kind = "cfg_proven_roots_v7_indexed_dispatch_table_cell"\n    if any(\n        claim.get("claim_kind") in {code_kind, table_kind}\n        for claim in baseline\n    ):\n        raise ValueError("v7 requires a pre-v7 baseline")\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError("v7 ROM identity changed")\n    artifact = (root / CFG_PROVEN_ROOTS_V7_ARTIFACT).absolute()\n    if artifact.resolve(strict=True) != artifact or not artifact.is_dir():\n        raise ValueError("v7 artifact invalid")\n    members = list(artifact.iterdir())\n    if {item.name for item in members} != {"manifest.json", CFG_PROVEN_ROOTS_V7_PAYLOAD_NAME} or any(item.is_symlink() or not item.is_file() for item in members):\n        raise ValueError("v7 artifact file set changed")\n    verifier = (root / CFG_PROVEN_ROOTS_V7_VERIFIER).absolute()\n    if verifier.resolve(strict=True) != verifier or _sha256_file(verifier) != CFG_PROVEN_ROOTS_V7_VERIFIER_SHA256:\n        raise ValueError("v7 verifier identity changed")\n    manifest_raw = (artifact / "manifest.json").read_bytes()\n    payload_raw = (artifact / CFG_PROVEN_ROOTS_V7_PAYLOAD_NAME).read_bytes()\n    if _sha256(manifest_raw) != CFG_PROVEN_ROOTS_V7_MANIFEST_SHA256 or len(payload_raw) != CFG_PROVEN_ROOTS_V7_PAYLOAD_SIZE or _sha256(payload_raw) != CFG_PROVEN_ROOTS_V7_PAYLOAD_SHA256:\n        raise ValueError("v7 artifact identity changed")\n    report = verify_rom_cfg_proven_roots_v7(root, artifact)\n    if report != CFG_PROVEN_ROOTS_V7_EXPECTED_REPORT:\n        raise ValueError(f"v7 verification failed: {report}")\n    payload = json.loads(payload_raw)\n    dispatchers = payload["dispatcher_denominator"]\n    if [(item.get("terminal_file_offset"), item.get("entry_count")) for item in dispatchers] != [(0x6E84E, 7), (0x92850, 38)]:\n        raise ValueError("v7 dispatcher denominator changed")\n    unknown = [tuple(segment["range"]) for segment in atomize_claims(len(rom), baseline) if segment["primary_class"] == "unknown"]\n    blocks = payload["extension"]["blocks"]\n    if len(blocks) != 38:\n        raise ValueError("v7 block denominator changed")\n    claims: list[dict[str, Any]] = []\n    previous_end = -1\n    for block_index, block in enumerate(blocks):\n        start, end = block.get("range", [None, None]); block_id = block.get("id")\n        if block.get("mode") != "thumb" or not isinstance(start, int) or not isinstance(end, int) or start < previous_end or not 0 <= start < end <= len(rom) or block_id != f"block-thumb-{start:06x}" or block.get("bytes_sha256") != _sha256(rom[start:end]):\n            raise ValueError(f"v7 block identity changed: {block_id}")\n        previous_end = end\n        pieces = [(max(start, a), min(end, b)) for a, b in unknown if a < end and start < b]\n        for piece_index, (piece_start, piece_end) in enumerate(pieces):\n            claims.append({\n                "id": f"cfg-proven-roots-v7-thumb-{block_index:04d}-{piece_index:02d}-{piece_start:06x}",\n                "range": [piece_start, piece_end], "role": "primary",\n                "primary_class": "armv4t_cfg_proven_roots_v7_reachable_thumb_code",\n                "claim_kind": code_kind, "mode": "thumb", "source_block_count": 1,\n                "source_blocks": [{"block_id": block_id, "range": [start, end]}],\n                "fixed_root_count": 8, "fixed_dispatcher_count": 2,\n                "fixed_dispatch_table_entry_count": 45,\n                "promoted_from_primary_class": "unknown",\n                "runtime_reachability_claimed": False, "global_code_map_claimed": False,\n                "bytes_sha256": _sha256(rom[piece_start:piece_end]),\n                "evidence_path": (CFG_PROVEN_ROOTS_V7_ARTIFACT / CFG_PROVEN_ROOTS_V7_PAYLOAD_NAME).as_posix(),\n                "evidence_sha256": CFG_PROVEN_ROOTS_V7_PAYLOAD_SHA256,\n                "evidence_selector": f"/extension/blocks/{block_index}",\n                "promotion_manifest_path": (CFG_PROVEN_ROOTS_V7_ARTIFACT / "manifest.json").as_posix(),\n                "promotion