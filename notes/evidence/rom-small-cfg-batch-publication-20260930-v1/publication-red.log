gnment_gaps(root)\n    report_sha256 = _sha256(\n        json.dumps(\n            report,\n            ensure_ascii=True,\n            separators=(",", ":"),\n            sort_keys=True,\n        ).encode("ascii")\n    )\n    if (\n        not isinstance(report, dict)\n        or report.get("verified") is not True\n        or report.get("errors") != []\n        or report.get("schema")\n        != "rom-cutscene-obj-palette-definition-alignment-gaps-verification-v1"\n        or report_sha256 != CUTSCENE_OBJ_ALIGNMENT_GAP_REPORT_SHA256\n        or report.get("ranges") != [list(pair) for pair in canonical_ranges]\n        or report.get("gap_count") != 4\n        or report.get("byte_count") != 8\n        or report.get("zero_byte_count") != 8\n        or report.get("left_lz_count") != 4\n        or report.get("right_definition_count") != 4\n        or report.get("range_vector_sha256")\n        != CUTSCENE_OBJ_ALIGNMENT_GAP_RANGE_VECTOR_SHA256\n        or report.get("packed_bytes_sha256")\n        != CUTSCENE_OBJ_ALIGNMENT_GAP_PACKED_BYTES_SHA256\n        or report.get("all_parser_endpoints_exact") is not True\n        or report.get("all_alignment_equations_hold") is not True\n        or not isinstance(report.get("resources"), list)\n        or len(report["resources"]) != 4\n    ):\n        raise ValueError("Cutscene OBJ alignment-gap independent verification changed")\n\n    packed = b"".join(rom[start:end] for start, end in canonical_ranges)\n    if (\n        _sha256(\n            json.dumps(\n                [list(pair) for pair in canonical_ranges], separators=(",", ":")\n            ).encode("ascii")\n        )\n        != CUTSCENE_OBJ_ALIGNMENT_GAP_RANGE_VECTOR_SHA256\n        or len(packed) != 8\n        or packed != b"\\x00" * 8\n        or _sha256(packed) != CUTSCENE_OBJ_ALIGNMENT_GAP_PACKED_BYTES_SHA256\n    ):\n        raise ValueError("Cutscene OBJ alignment-gap byte denominator changed")\n\n    false_claims = {\n        key: False\n        for key in (\n            "padding_claimed",\n            "reserved_space_claimed",\n            "free_space_claimed",\n            "runtime_consumes_padding_claimed",\n            "compiler_authorship_claimed",\n            "generic_lz_alignment_rule_claimed",\n            "all_cutscene_gaps_exhaustive_claimed",\n            "natural_runtime_reachability_claimed",\n            "global_unreachable_claimed",\n            "editing_safety_claimed",\n            "editing_or_relocation_safety_claimed",\n            "editable_claimed",\n            "relocatable_claimed",\n            "safe_allocatable_space_claimed",\n            "allocatable_space_claimed",\n            "adjacent_bytes_claimed",\n            "neighbor_expansion_claimed",\n            "definition_unknown_field_semantics_claimed",\n            "graphics_or_palette_expansion_claimed",\n            "final_pixel_equivalence_claimed",\n            "all_consumers_claimed",\n            "consumer_completeness_claimed",\n        )\n    }\n    claims: list[dict[str, Any]] = []\n    for resource_id, (gap_range, identifier, row, left_owner, right_owner) in enumerate(\n        zip(\n            canonical_ranges,\n            canonical_ids,\n            report["resources"],\n            left_owners,\n            right_owners,\n            strict=True,\n        )\n    ):\n        start, end = gap_range\n        if (\n            row.get("resource_id") != resource_id\n            or row.get("gap_range") != [start, end]\n            or row.get("palette_compressed_range")\n            != list(left_owner_specs[resource_id][1])\n            or row.get("first_definition_range")\n            != list(right_owner_specs[resource_id][1])\n            or left_owner["range"][1] != start\n            or right_owner["range"][0] != end\n        ):\n            raise ValueError("Cutscene OBJ alignment-gap boundary report changed")\n        claims.append(\n            {\n                "id": identifier,\n                "range": [start, end],\n          