ed_artifact_directory(\n        root,\n        DIRECTSOUND_PITCH_ARTIFACT,\n        {\n            "manifest.json",\n            DIRECTSOUND_PITCH_PAYLOAD_NAME,\n            DIRECTSOUND_PITCH_BINARY_NAME,\n        },\n        label="DirectSound pitch artifact",\n    )\n    manifest_path = _checked_repository_file(\n        root,\n        DIRECTSOUND_PITCH_ARTIFACT / "manifest.json",\n        DIRECTSOUND_PITCH_MANIFEST_SHA256,\n        expected_size=DIRECTSOUND_PITCH_MANIFEST_SIZE,\n        label="DirectSound pitch manifest",\n    )\n    payload_path = _checked_repository_file(\n        root,\n        DIRECTSOUND_PITCH_ARTIFACT / DIRECTSOUND_PITCH_PAYLOAD_NAME,\n        DIRECTSOUND_PITCH_PAYLOAD_SHA256,\n        expected_size=DIRECTSOUND_PITCH_PAYLOAD_SIZE,\n        label="DirectSound pitch payload",\n    )\n    binary_path = _checked_repository_file(\n        root,\n        DIRECTSOUND_PITCH_ARTIFACT / DIRECTSOUND_PITCH_BINARY_NAME,\n        DIRECTSOUND_PITCH_BINARY_SHA256,\n        expected_size=DIRECTSOUND_PITCH_BINARY_SIZE,\n        label="DirectSound pitch binary",\n    )\n    for path, expected_sha, label in (\n        (\n            DIRECTSOUND_PITCH_EXPORTER,\n            DIRECTSOUND_PITCH_EXPORTER_SHA256,\n            "DirectSound pitch exporter",\n        ),\n        (\n            DIRECTSOUND_PITCH_VERIFIER,\n            DIRECTSOUND_PITCH_VERIFIER_SHA256,\n            "DirectSound pitch verifier",\n        ),\n        (\n            DIRECTSOUND_PITCH_EXPORTER_TEST,\n            DIRECTSOUND_PITCH_EXPORTER_TEST_SHA256,\n            "DirectSound pitch exporter test",\n        ),\n        (\n            DIRECTSOUND_PITCH_VERIFIER_TEST,\n            DIRECTSOUND_PITCH_VERIFIER_TEST_SHA256,\n            "DirectSound pitch verifier test",\n        ),\n        (\n            DIRECTSOUND_PITCH_BUNDLE_VERIFIER,\n            DIRECTSOUND_PITCH_BUNDLE_VERIFIER_SHA256,\n            "DirectSound pitch bundle verifier",\n        ),\n        (\n            DIRECTSOUND_PITCH_BUNDLE_VERIFIER_TEST,\n            DIRECTSOUND_PITCH_BUNDLE_VERIFIER_TEST_SHA256,\n            "DirectSound pitch bundle verifier test",\n        ),\n    ):\n        _checked_repository_file(root, path, expected_sha, label=label)\n\n    manifest_raw = manifest_path.read_bytes()\n    payload_raw = payload_path.read_bytes()\n    try:\n        manifest = json.loads(manifest_raw)\n        payload = json.loads(payload_raw)\n    except (UnicodeDecodeError, json.JSONDecodeError) as error:\n        raise ValueError("DirectSound pitch artifact JSON is invalid") from error\n    if (\n        not isinstance(manifest, dict)\n        or not isinstance(payload, dict)\n        or manifest_raw != _canonical_json_bytes(manifest)\n        or payload_raw != _canonical_json_bytes(payload)\n    ):\n        raise ValueError("DirectSound pitch artifact JSON is not canonical")\n\n    expected_implementation = {\n        "exporter": {\n            "path": DIRECTSOUND_PITCH_EXPORTER.as_posix(),\n            "sha256": DIRECTSOUND_PITCH_EXPORTER_SHA256,\n        },\n        "exporter_test": {\n            "path": DIRECTSOUND_PITCH_EXPORTER_TEST.as_posix(),\n            "sha256": DIRECTSOUND_PITCH_EXPORTER_TEST_SHA256,\n        },\n        "verifier": {\n            "path": DIRECTSOUND_PITCH_VERIFIER.as_posix(),\n            "sha256": DIRECTSOUND_PITCH_VERIFIER_SHA256,\n        },\n        "verifier_test": {\n            "path": DIRECTSOUND_PITCH_VERIFIER_TEST.as_posix(),\n            "sha256": DIRECTSOUND_PITCH_VERIFIER_TEST_SHA256,\n        },\n    }\n    projection = manifest.get("coverage_projection")\n    if (\n        manifest.get("schema") != "git-artifact-promotion-v1"\n        or manifest.get("artifact_schema") != DIRECTSOUND_PITCH_BATCH\n        or manifest.get("artifact_status") != "accepted"\n        or manifest.get("files")\n        != {\n            DIRECTSOUND_PITCH_BINARY_NAME: {\n                "sha256": DIRECTSOUND_PITCH_BINARY_SHA256,\n                "size": DIRECTSOUND_PITCH_BINARY_SIZE,\n            },\n            DIRECTSOUND_PITCH_PAYLOAD_NAME: {\n                "sha256": DIRECTSOUND_PITCH_PAYLOAD_SHA256,\n                "size": DIRECTSOUND_PITCH_PAYLOAD_SIZE,\n            },\n        }\n        or manifest.get("implementation") != expected_implementation\n        or payload.get("schema") != DIRECTSOUND_PITCH_BATCH\n        or manifest.get("rom") != payload.get("rom")\n        or manifest.get("coverage_baseline") != payload.get("coverage_baseline")\n        or manifest.get("promotion") != payload.get("promotion")\n        or manifest.get("scope") != payload.get("scope")\n        or not isinstance(projection, dict)\n        or projection.get("claim_count") != 5\n        or projection.get("byte_count") != DIRECTSOUND_PITCH_BINARY_SIZE\n        or projection.get("range_vector_sha256")\n        != DIRECTSOUND_PITCH_RANGE_VECTOR_SHA256\n        or projection.get("claim_denominator_sha256")\n        != DIRECTSOUND_PITCH_CLAIM_DENOMINATOR_SHA256\n    ):\n        raise ValueError("DirectSound pitch promotion contract changed")\n\n    try:\n        report = verify_rom_directsound_pitch_lookup_bundle(root, artifact)\n    except Exception as error:\n        raise ValueError(\n            f"DirectSound pitch independent verification failed: {error}"\n        ) from error\n    verification = manifest.get("verification")\n    expected_report = (\n        verification.get("report") if isinstance(verification, dict) else None\n    )\n    if (\n        not isinstance(report, dict)\n        or report.get("schema")\n        != "rom-directsound-pitch-lookup-bundle-verification-v1"\n        or report.get("verified") is not True\n        or report.get("errors") != []\n        or report.get("artifact_bundle_verified") is not True\n        or report.get("legacy_receipt_verified") is not True\n        or report.get("live_coverage_verified") is not False\n        or report.get("artifact_status") != "accepted"\n        or report.get("promotion_bytes") !=