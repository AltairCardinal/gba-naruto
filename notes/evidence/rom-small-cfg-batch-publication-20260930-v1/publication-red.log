2\n        or summary.get("contract_excluded_byte_count") != 5\n        or summary.get("safe_allocatable_space_claimed") is not False\n        or payload.get("files")\n        != {\n            PARSER_BOUND_ZERO_PADDING_BUNDLE_NAME: {\n                "sha256": PARSER_BOUND_ZERO_PADDING_BUNDLE_SHA256,\n                "size": PARSER_BOUND_ZERO_PADDING_BUNDLE_SIZE,\n            }\n        }\n        or payload.get("implementation", {}).get("verifier_sha256")\n        != PARSER_BOUND_ZERO_PADDING_VERIFIER_SHA256\n    ):\n        raise ValueError("parser-bound zero padding payload contract changed")\n\n    report = verify_rom_parser_bound_zero_padding(root, artifact)\n    if report != PARSER_BOUND_ZERO_PADDING_EXPECTED_REPORT:\n        raise ValueError(\n            "parser-bound zero padding independent verification failed: "\n            f"{report}"\n        )\n\n    classified_ranges = payload.get("classified_ranges")\n    if not isinstance(classified_ranges, list) or len(classified_ranges) != 142:\n        raise ValueError("parser-bound zero padding range denominator changed")\n    baseline_unknown_ranges = [\n        tuple(segment["range"])\n        for segment in atomize_claims(len(rom), baseline_claims)\n        if segment["primary_class"] == "unknown"\n    ]\n    claims: list[dict[str, Any]] = []\n    seen_source_ids: set[tuple[str, int]] = set()\n    packed_cursor = 0\n    previous_end = -1\n    for index, record in enumerate(classified_ranges):\n        if not isinstance(record, dict):\n            raise ValueError("parser-bound zero padding record is not an object")\n        value = record.get("range")\n        packed_range = record.get("packed_range")\n        source_kind = record.get("source_kind")\n        range_id = record.get("range_id")\n        if (\n            not isinstance(value, list)\n            or len(value) != 2\n            or not all(isinstance(item, int) for item in value)\n            or not isinstance(range_id, int)\n            or source_kind not in PARSER_BOUND_ZERO_PADDING_CLASS_COUNTS\n        ):\n            raise ValueError("parser-bound zero padding record schema changed")\n        start, end = value\n        size = end - start\n        if (\n            start < previous_end\n            or not 0 <= start < end <= len(rom)\n            or record.get("size") != size\n            or record.get("all_zero") is not True\n            or record.get("safe_allocatable_space_claimed") is not False\n            or record.get("bytes_sha256") != _sha256(rom[start:end])\n            or any(rom[start:end])\n            or packed_range != [packed_cursor, packed_cursor + size]\n            or bundle[packed_cursor : packed_cursor + size] != rom[start:end]\n            or (source_kind, range_id) in seen_source_ids\n        ):\n            raise ValueError("parser-bound zero padding record identity changed")\n        unknown_bytes = sum(\n            max(0, min(end, unknown_end) - max(start, unknown_start))\n            for unknown_start, unknown_end in baseline_unknown_ranges\n            if unknown_start < end and start < unknown_end\n        )\n        if unknown_bytes != size:\n            raise ValueError(\n                "parser-bound zero padding range is not fully current unknown: "\n                f"{value} has {unknown_bytes}/{size} unknown bytes"\n            )\n        seen_source_ids.add((source_kind, range_id))\n        previous_end = end\n        packed_cursor += size\n        claims.append(\n            {\n                "id": f"parser-bound-zero-padding-{index:03d}-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": source_kind,\n                "claim_kind": PARSER_BOUND_ZERO_PADDING_CLAIM_KIND,\n                "source_kind": source_kind,\n                "source_range_id": range_id,\n                "packed_range": list(packed_range),\n                "source_selector": record.get("source_selector"),\n                "promoted_from_primary_class": "unknown",\n                "baseline_unknown_only": True,\n                "safe_allocatable_space_claimed": False,\n                "natural_execution_reachability_claimed": False,\n                "editing_or_relocation_safety_claimed": False,\n                "arbitrary_zero_hole_classification_claimed": False,\n                "bytes_sha256": _sha256(rom[start:end]),\n                "range_denominator_sha256": (\n                    PARSER_BOUND_ZERO_PADDING_RANGE_DENOMINATOR_SHA256\n                ),\n                "accepted_bundle_sha256": (\n                    PARSER_BOUND_ZERO_PADDING_BUNDLE_SHA256\n                ),\n                "evidence_path": (\n                    PARSER_BOUND_ZERO_PADDING_ARTIFACT\n                    / PARSER_BOUND_ZERO_PADDING_PAYLOAD_NAME\n                ).as_posix(),\n                "evidence_sha256": PARSER_BOUND_ZERO_PADDING_PAYLOAD_SHA256,\n                "evidence_selector": f"/classified_ranges/{index}",\n                "promotion_manifest_path": (\n                    PARSER_BOUND_ZERO_PADDING_ARTIFACT / "manifest.json"\n                ).as_posix(),\n                "promotion_manifest_sha256": (\n                    PARSER_BOUND_ZERO_PADDING_MANIFEST_SHA256\n                ),\n                "independent_verifier_path": (\n                    PARSER_BOUND_ZERO_PADDING_VERIFIER.as_posix()\n                ),\n                "independent_verifier_sha256": (\n                    PARSER_BOUND_ZERO_PADDING_VERIFIER_SHA256\n                ),\n                "promotion_batch": PARSER_BOUND_ZERO_PADDING_BATCH,\n                "limitations": [\n                    "Only this complete current-unknown range from the frozen parser-bound contract is classified.",\n                    "Arbitrary zero holes, free or allocatable space, natural execution, editing, and relocation safety are not claimed.",\n                ],\n            }\n        )\n\n    class_counts = {\n        source_kind: sum(\n            claim["source_kind"] == source_kind for claim in claims\n        )\n        for source_kind in PARSER_BOUND_ZERO_PADDING_CLASS_COUNTS\n    }\n    class_bytes = {\n        source_kind: sum(\n            claim["range"][1] - claim["range"][0]\n            for claim in claims\n            if claim["source_kind"] == source_kind\n        )\n        for source_kind in PARSER_BOUND_ZERO_PADDING_CLASS_BYTES\n    }\n    range_denominator = _sha256(\n        json.dumps(\n            [claim["range"] for claim in claims], separators=(",", ":")\n        ).encode("ascii")\n    )\n    if (\n        packed_cursor != PARSER_BOUND_ZERO_PADDING_BUNDLE_SIZE\n        or class_counts != PARSER_BOUND_ZERO_PADDING_CLASS_COUNTS\n        or class_bytes != PARSER_BOUND_ZERO_PADDING_CLASS_BYTES\n        or range_denominator\n        != PARSER_BOUND_ZERO_PADDING_RANGE_DENOMINATOR_SHA256\n    ):\n        raise ValueError(\n            "parser-bound zero padding coverage denominator changed: "\n            f"claims={len(claims)}, bytes={packed_cursor}, "\n            f"counts={class_counts}, class_bytes={class_bytes}, "\n            f"sha256={range_denominator}"\n        )\n    return claims\n\n\ndef _selector_direct_source_record_claims(\n    root: Path,\n    rom: bytes,\n    baseline_claims: list[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote the 46 complete source records only while they remain unknown."""\n\n    root = Path(root).resolve(strict=True)\n    if _sha256(rom) != ROM_SHA256:\n        raise ValueError("selector direct source record ROM SHA-256 changed")\n    if any(\n        claim.get("promotion_batch") == SELECTOR_DIRECT_SOURCE_RECORDS_BATCH\n        for claim in baseline_claims\n    ):\n        raise ValueError("selector direct source record batch is already present")\n\n    artifact = (root / SELECTOR_DIRECT_SOURCE_RECORDS_ARTIFACT).absolute()\n    manifest_path = artifact / "manifest.json"\n    payload_path = artifact / SELECTOR_DIRECT_SOURCE_RECORDS_PAYLOAD_NAME\n    bundle_path = artifact / SELECTOR_DIRECT_SOURCE_RECORDS_BUNDLE_NAME\n    verifier_path = (root / SELECTOR_DIRECT_SOURCE_RECORDS_VERIFIER).absolute()\n\n    def checked_path(path: Path, label: str, *, directory: bool = False) -> Path:\n        try:\n            resolved = path.resolve(strict=True)\n            resolved.relative_to(root)\n        except (OSError, ValueError) as error:\n            raise ValueError(\n                f"selector direct source record {label} path is unsafe"\n            ) from error\n        if path.is_symlink() or resolved != path:\n            raise ValueError(\n                f"selector direct source record {label} path is unsafe"\n            )\n        if directory:\n            if not path.is_dir():\n                raise ValueError(\n                    f"selector direct source record {label} is not a directory"\n                )\n        elif not path.is_file():\n            raise ValueError(\n                f"selector direct source record {label} is not a file"\n            )\n        return resolved\n\n    checked_path(artifact, "artifact", directory=True)\n    members = list(artifact.iterdir())\n    expected_names = {\n        "manifest.json",\n        SELECTOR_DIRECT_SOURCE_RECORDS_PAYLOAD_NAME,\n        SELECTOR_DIRECT_SOURCE_RECORDS_BUNDLE_NAME,\n    }\n    if (\n        {member.name for member in members} != expected_names\n        or any(member.is_symlink() or not member.is_file() for member in members)\n    ):\n        raise ValueError("selector direct source record artifact file denominator changed")\n    checked_path(manifest_path, "manifest")\n    checked_path(payload_path, "payload")\n    checked_path(bundle_path, "bundle")\n    checked_path(verifier_path, "verifier")\n    if _sha256_file(manifest_path) != SELECTOR_DIRECT_SOURCE_RECORDS_MANIFEST_SHA256:\n        raise ValueError("selector direct source record manifest hash changed")\n    if (\n        payload_path.stat().st_size != SELECT