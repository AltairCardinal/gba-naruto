          for claim in claims\n                if claim.get("promotion_batch") == CUTSCENE_OBJ_SOURCE_BATCH\n                and claim.get("primary_class") == primary_class\n            )\n            for primary_class in CUTSCENE_OBJ_SOURCE_CLASS_BYTES\n        },\n        "cutscene_obj_source_class_claim_counts": {\n            primary_class: sum(\n                claim.get("promotion_batch") == CUTSCENE_OBJ_SOURCE_BATCH\n                and claim.get("primary_class") == primary_class\n                for claim in claims\n            )\n            for primary_class in CUTSCENE_OBJ_SOURCE_CLASS_COUNTS\n        },\n        "cutscene_obj_source_range_denominator_sha256": (\n            CUTSCENE_OBJ_SOURCE_RANGE_DENOMINATOR_SHA256\n        ),\n        "positions_aux_dispatch_promotion_batch": POSITIONS_AUX_DISPATCH_BATCH,\n        "positions_aux_dispatch_claim_kind": POSITIONS_AUX_DISPATCH_CLAIM_KIND,\n        "positions_aux_dispatch_bytes": sum(\n            end - start\n            for claim in claims\n            if claim.get("promotion_batch") == POSITIONS_AUX_DISPATCH_BATCH\n            for start, end in [claim["range"]]\n        ),\n        "positions_aux_dispatch_claim_count": sum(\n            claim.get("promotion_batch") == POSITIONS_AUX_DISPATCH_BATCH\n            for claim in claims\n        ),\n        "positions_aux_dispatch_range_denominator_sha256": (\n            POSITIONS_AUX_DISPATCH_RANGE_DENOMINATOR_SHA256\n        ),\n        "battle_sound_selector_promotion_batch": BATTLE_SOUND_SELECTOR_BATCH,\n        "battle_sound_selector_claim_kind": BATTLE_SOUND_SELECTOR_CLAIM_KIND,\n        "battle_sound_selector_bytes": sum(\n            end - start\n            for claim in claims\n            if claim.get("promotion_batch") == BATTLE_SOUND_SELECTOR_BATCH\n            for start, end in [claim["range"]]\n        ),\n        "battle_sound_selector_claim_count": sum(\n            claim.get("promotion_batch") == BATTLE_SOUND_SELECTOR_BATCH\n            for claim in claims\n        ),\n        "battle_sound_selector_table_sha256": (\n            BATTLE_SOUND_SELECTOR_BINARY_SHA256\n        ),\n        "battle_sound_selector_entry_denominator_sha256": (\n            BATTLE_SOUND_SELECTOR_DENOMINATOR_SHA256\n        ),\n        "battle_condition_records_promotion_batch": (\n            BATTLE_CONDITION_RECORDS_BATCH\n        ),\n        "battle_condition_records_claim_kind": (\n            BATTLE_CONDITION_RECORDS_CLAIM_KIND\n        ),\n        "battle_condition_records_table_sha256": (\n            BATTLE_CONDITION_RECORDS_BINARY_SHA256\n        ),\n        "battle_condition_projected_unknown_bytes": sum(\n            end - start\n            for claim in claims\n            if claim.get("promotion_batch") == BATTLE_CONDITION_RECORDS_BATCH\n            for start, end in [claim["range"]]\n        ),\n        "battle_condition_projected_unknown_claim_count": sum(\n            claim.get("promotion_batch") == BATTLE_CONDITION_RECORDS_BATCH\n            for claim in claims\n        ),\n        "battle_condition_prefix_fragment_bytes": sum(\n            end - start\n            for claim in claims\n            if claim.get("promotion_batch") == BATTLE_CONDITION_RECORDS_BATCH\n            and claim.get("primary_class")\n            == BATTLE_CONDITION_PREFIX_PRIMARY_CLASS\n            for start, end in [claim["range"]]\n        ),\n        "battle_condition_prefix_fragment_claim_count": sum(\n            claim.get("promotion_batch") == BATTLE_CONDITION_RECORDS_BATCH\n            and claim.get("primary_class")\n            == BATTLE_CONDITION_PREFIX_PRIMARY_CLASS\n            for claim in claims\n        ),\n        "battle_condition_predicate_fragment_bytes": sum(\n            end - start\n            for claim in claims\n            if claim.get("promotion_batch") == BATTLE_CONDITION_RECORDS_BATCH\n            and claim.get("primary_class")\n            == BATTLE_CONDITION_PREDICATE_PRIMARY_CLASS\n            for start, end in [claim["range"]]\n        ),\n        "battle_condition_predicate_fragment_claim_count": sum(\n            claim.get("promotion_batch") == BATTLE_CONDITION_RECORDS_BATCH\n            and claim.get("primary_class")\n            == BATTLE_CONDITION_PREDICATE_PRIMARY_CLASS\n            for claim in claims\n        ),\n        "battle_condition_projected_range_denominator_sha256": (\n            BATTLE_CONDITION_PROJECTED_RANGE_SHA256\n        ),\n        "battle_condition_projected_packed_bytes_sha256": (\n            BATTLE_CONDITION_PROJECTED_BYTES_SHA256\n        ),\n        "battle_condition_prefix_fragment_range_denominator_sha256": (\n            BATTLE_CONDITION_PREFIX_FRAGMENT_RANGE_SHA256\n        ),\n        "battle_condition_prefix_fragment_packed_bytes_sha256": (\n            BATTLE_CONDITION_PREFIX_FRAGMENT_BYTES_SHA256\n        ),\n        "battle_condition_predicate_fragment_range_denominator_sha256": (\n            BATTLE_CONDITION_PREDICATE_FRAGMENT_RANGE_SHA256\n        ),\n        "battle_condition_predicate_fragment_packed_bytes_sha256": (\n            BATTLE_CONDITION_PREDICATE_FRAGMENT_BYTES_SHA256\n        ),\n        "battle_condition_combined_fragment_range_denominator_sha256": (\n            BATTLE_CONDITION_COMBINED_FRAGMENT_RANGE_SHA256\n        ),\n        "cutscene_obj_alignment_gap_promotion_batch": (\n            CUTSCENE_OBJ_ALIGNMENT_GAP_BATCH\n        ),\n        "cutscene_obj_alignment_gap_claim_kind": (\n            CUTSCENE_OBJ_ALIGNMENT_GAP_CLAIM_KIND\n        ),\n        "cutscene_obj_alignment_gap_bytes": sum(\n            end - start\n            for claim in claims\n            if claim.get("promotion_batch") == CUTSCENE_OBJ_ALIGNMENT_GAP_BATCH\n            for start, end in [claim["range"]]\n        ),\n        "cutscene_obj_alignment_gap_claim_count": sum(\n            claim.get("promotion_batch") == CUTSCENE_OBJ_ALIGNMENT_GAP_BATCH\n            for claim in claims\n        ),\n        "cutscene_obj_alignment_gap_claim_denominator_sha256": (\n            CUTSCENE_OBJ_ALIGNMENT_GAP_CLAIM_DENOMINATOR_SHA256\n        ),\n        "cutscene_obj_alignment_gap_range_vector_sha256": (\n            CUTSCENE_OBJ_ALIGNMENT_GAP_RANGE_VECTOR_SHA256\n        ),\n        "cutscene_obj_alignment_gap_packed_bytes_sha256": (\n            CUTSCENE_OBJ_ALIGNMENT_GAP_PACKED_BYTES_SHA256\n        ),\n        "cutscene_obj_alignment_gap_independent_verifier_report_sha256": (\n            CUTSCENE_OBJ_ALIGNMENT_GAP_REPORT_SHA256\n        ),\n        "parser_bound_zero_padding_promotion_batch": (\n            PARSER_BOUND_ZERO_PADDING_BATCH\n        ),\n        "parser_bound_zero_padding_bytes": sum(\n            end - start\n            for claim in claims\n            if claim.get("promotion_batch") == PARSER_BOUND_ZERO_PADDING_BATCH\n            for start, end in [claim["range"]]\n        ),\n        "parser_bound_zero_padding_claim_count": sum(\n            claim.get("promotion_batch") == PARSER_BOUND_ZERO_PADDING_BATCH\n            for claim in claims\n        ),\n        "parser_bound_zero_padding_class_bytes": {\n            primary_class: sum(\n                claim["range"][1] - claim["range"][0]\n                for claim in claims\n                if claim.get("promotion_batch")\n                == PARSER_BOUND_ZERO_PADDING_BATCH\n                and claim.get("primary_class") == primary_class\n            )\n            for primary_class in PARSER_BOUND_ZERO_PADDING_CLASS_BYTES\n        },\n        "parser_bound_zero_padding_class_claim_counts": {\n            primary_class: sum(\n                claim.get("promotion_batch")\n                == PARSER_BOUND_ZERO_PADDING_BATCH\n                and claim.get("primary_class") == primary_class\n                for claim in claims\n            )\n            for primary_class in PARSER_BOUND_ZERO_PADDING_CLASS_COUNTS\n        },\n        "parser_bound_zero_padding_range_denominator_sha256": (\n            PARSER_BOUND_ZERO_PADDING_RANGE_DENOMINATOR_SHA256\n        ),\n        "claim_count": len(claims),\n        "segment_count": len(segments),\n        "aligned_pointer_reachable_lz77_records": sum(\n            claim["claim_kind"] == "aligned_pointer_reachable_lz77"\n            for claim in claims\n        ),\n        "nonempty_bank_count": len(\n            {\n                claim["bank"]\n                for claim in claims\n                if claim["claim_kind"] == "bank_record_bytes"\n            }\n        ),\n    }\n    return {\n        "schema": SCHEMA,\n        "base_rom": {\n            "path": ROM_PATH.as_posix(),\n            "size": len(rom),\n            "sha256": actual_sha,\n        },\n        "domain": [0, len(rom)],\n        "policy": {\n            "ranges_are_half_open": True,\n            "one_primary_claim_per_byte": True,\n            "secondary_claims_are_explicit": True,\n            "unknown_is_required_not_implicit": True,\n            "padding_is_not_automatically_free_space": True,\n        },\n        "state_inventory_complete": accounted == len(rom),\n        "semantic_classification_complete": totals.get("unknown", 0) == 0,\n        "summary": summary,\n        "claims": claims,\n        "segments": segments,\n        "limitations": [\n            "The fixed-root v2 ARMv4T CFG plus the independently verified one-generation 29-dispatch extension promote only current-unknown instruction and allowed dispatch-table bytes; 328 baseline and 15 newly discovered indirect frontiers remain unresolved, so this is not a global code map and does not prove natural runtime reachability.",\n            "Eight current-unknown cells inside two frozen v3 sparse dispatch tables are classified only as mask-excluded physical residual cells, and nine current-unknown cells inside the two frozen v7 dispatcher tables are classified as selected table cells; neither batch adds reachable instruction bytes or proves natural runtime or target reachability.",\n            "The parser-bound zero-padding artifact classifies exactly 198 current-unknown zero bytes in 142 frozen M4A wave-alignment or chapter-terminal-to-fixed-root ranges; nine rejected ranges and two contract-excluded ranges remain unclaimed, and arbitrary zero holes, free or allocatable space, natural execution, editing, and relocation safety are not proven.",\n            "Six frozen 32-byte raw palette sources totaling 192 bytes are classified only because the exact pointer-LZ77 graphics catalog and an independent backward CpuSet/CpuFastSet verifier bind them to PRAM consumers; the remaining catalog, natural reachability, final-pixel equivalence, parent-record expansion, editing or relocation safety, and allocatable space are not proven.",\n            "The direct-call-proven two-root delta promotes 12946 additional current-unknown Thumb instruction bytes, while three separately classified Thumb BL producers contribute 12 bytes; v2/v3 entries remain opaque stops, 27 indirect targets and one decode failure remain open, and neither natural execution nor a global BL/code denominator is claimed.",\n            "The second direct-call-proven three-root delta promotes 9876 additional current-unknown Thumb instruction bytes, while five separately classified Thumb BL producers contribute 20 bytes; v2/v3/proven-roots-v1 entries remain opaque stops, 27 indirect targets and one unsupported instruction remain open, and neither natural execution nor a global BL/code denominator is claimed.",\n            "The fixed 46-slot profile table classifies parser-bounded records and exact zero alignment gaps, but natural gameplay runtime evidence covers only profile ID 0 and same-table replacement causality.",\n            "The nine fixed consumer text tables classify exactly 2300 pointer-table bytes and 6780 renderer-consumed bytes; the mixed 24-slot UI resource table at 0x005A7FCC is excluded, and inter-record gaps, runtime index bounds, natural execution of every slot, and Unicode decoding remain unclaimed.",\n            "The fixed 45-slot training table has one null slot and 44 interpreter-consumed command scripts totaling 2505 bytes; natural execution of every ID, Unicode decoding, and safe writeback remain unclaimed.",\n            "The fixed 38-slot value-range selector classifies its 152-byte inclusive range map and 862 renderer-consumed text bytes; the pointer table is owned by candidate adjudication, while runtime input bounds, natural execution of every range, Unicode decoding, and safe writeback remain unclaimed.",\n            "The fixed 46-row selector source domain classifies 324 renderer-consumed direct-text bytes; the complete three-way configuration classifies 316 copy-parser text bytes plus 176 configuration bytes. A separate verifier classifies 918 bytes of post-NUL zero padding only for the 84 referenced selector slots, while 17 unreferenced configured slots, the 63-slot physical denominator, natural execution, Unicode decoding, and safe writeback remain unclaimed.",\n            "The same referenced-slot padding artifact classifies 337 bytes of post-NUL zero padding for the 49 chapter speaker labels referenced by accepted script opcodes; unreferenced labels, the NUL/prefix bytes, natural reachability, text semantics, editing safety, and allocatable-space status remain unclaimed.",\n            "The fixed 79-slot battle-message table classifies 1411 renderer-consumed text bytes plus 1329 bytes of verified inter-record zero padding; the pointer table is already fixed_table, while runtime index bounds, natural execution beyond ID 0, Unicode decoding, safe writeback, allocatable-space status, and the preceding 140 bytes remain unclaimed.",\n            "The menu-portrait palette inventory classifies 70 distinct physical 128-byte BGR555 ranges totaling 8960 bytes for 74 catalog resources and 311 fixed logical outputs; equal-content palettes remain separate physical ranges, the shared five-resource alias remains one physical claim, and natural reachability, runtime pixel equivalence, independent alias editing, relocation, graphics bytes, adjacent gaps, and allocatable space remain unclaimed.",\n            MENU_PORTRAIT_LZ77_PALETTE_GAP_COVERAGE_LIMITATION,\n            TILE_BG_LZ77_PALETTE_GAP_COVERAGE_LIMITATION,\n            "The scene-visual source-range inventory classifies 29 complete current-unknown ranges totaling 3257 bytes: two shared OBJ palettes, nine background palettes, nine parser-bounded definition extents, and nine animation extents. The existing 31-byte pack-05 LZ77 primary overlap is preserved without reclassification; other scene sources, natural reachability, final-pixel equivalence, editing or relocation safety, adjacent gaps, and allocatable space remain unclaimed.",\n            "The Cutscene OBJ source-range inventory classifies 28 complete current-unknown ranges totaling 400 bytes for four fixed resource IDs: ten component definition records, four definition pointer tables, ten animation timelines, and four animation pointer tables. The fixed parser stride, terminators, and pointer relationships are verified, while unknown component field semantics, natural runtime reachability, final scene composition, graphics or palette expansion, editing or relocation safety, adjacent gaps, and allocatable space remain unclaimed.",\n            "The positions auxiliary dispatch inventory classifies exactly 144 fixed 64-byte current-unknown cell tables totaling 9,216 bytes. Byte 0 is a dispatch selector and bytes 1/2/3 are only handler-dependent raw operands; runtime group or variant bounds, natural reachability, shared business semantics, padding, adjacent headers or gaps, free or allocatable space, editing, write-back, relocation, and ABI stability remain unclaimed.",\n            "The battle sound selector inventory classifies exactly one 256-byte current-unknown u8 table bound to five direct pointer-literal consumer paths. It does not claim natural index or path reachability, exhaustive computed/RAM/indirect consumers, value or gameplay semantics, playback success, editing, write-back, relocation, or free or allocatable space.",\n            "The battle condition record inventory projects exactly 84 verifier-bound fragments totaling 2,772 current-unknown bytes from the frozen 9,588-byte physical table: 41 raw-prefix fragments and 43 predicate-record fragments. Existing fixed-table and positions-auxiliary owners are preserved; the adjacent 144 zero bytes remain unknown, and natural reachability, business semantics, editing, write-back, relocation, padding, free space, and allocation safety are not claimed.",\n            "A separate Cutscene OBJ boundary verifier classifies exactly four two-byte zero slices totaling eight bytes between independently parsed fixed palette streams and their rooted first definition records under the frozen 4-byte alignment equation. This does not claim padding intent, runtime consumption, a generic LZ alignment rule, exhaustive gaps, natural reachability, neighboring bytes, editing or relocation safety, or allocatable space.",\n            "The fixed BL/BX-pc/ARM-B interwork spine closes one 92-instruction ARM root plus nine consumed literals for 414 bytes; a separate additive claim classifies only the skipped 2-byte C0 46 / Thumb MOV r8,r8 veneer alignment NOP. Full reset-to-root runtime reachability, global unreachability, the sibling veneer, RAM targets, editing or relocation safety, allocatable space, and the surrounding 0x24C..0x9F2E region remain unclaimed.",\n            "The frozen u8-indexed two-u16 lookup classifies only its 144-byte cells-0-through-35 prefix that was unknown in the bound baseline; the remaining 880 logical bytes retain their 44 existing selector direct-source primary owners and are provenance only. Natural reachability, business field semantics, editing, relocation, and allocatable space remain unclaimed.",\n            "The boot Thumb handoff CFG classifies exactly 27 reachable-code ranges totaling 1226 bytes and 22 con