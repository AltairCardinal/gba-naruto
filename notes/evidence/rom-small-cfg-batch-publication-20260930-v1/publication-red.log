wner_range),\n            "role": "primary",\n            "primary_class": "cutscene_obj_definition_records",\n            "claim_kind": "cutscene_obj_source_range",\n            "bytes_sha256": right_record_hashes[resource_id],\n            "artifact_record_index": artifact_index,\n            "resource_id": resource_id,\n            "frame_id": 0,\n            "source_kind": "definition_record",\n            "evidence_path": "artifacts/rom-cutscene-obj-source-ranges-v1/rom-cutscene-obj-source-ranges.json",\n            "evidence_selector": selector,\n            "evidence_sha256": CUTSCENE_OBJ_SOURCE_PAYLOAD_SHA256,\n            "packed_range": list(packed_range),\n            "promotion_batch": CUTSCENE_OBJ_SOURCE_BATCH,\n            "promotion_manifest_path": "artifacts/rom-cutscene-obj-source-ranges-v1/manifest.json",\n            "promotion_manifest_sha256": CUTSCENE_OBJ_SOURCE_MANIFEST_SHA256,\n            "independent_verifier_path": "tools/verify_rom_cutscene_obj_source_ranges.py",\n            "independent_verifier_sha256": CUTSCENE_OBJ_SOURCE_VERIFIER_SHA256,\n            "baseline_unknown_only": True,\n            "promoted_from_primary_class": "unknown",\n            "natural_runtime_reachability_claimed": False,\n            "final_pixel_equivalence_claimed": False,\n            "definition_unknown_field_semantics_claimed": False,\n            "graphics_or_palette_expansion_claimed": False,\n            "editing_or_relocation_safety_claimed": False,\n            "allocatable_space_claimed": False,\n        }\n        if not isinstance(owner, dict) or any(\n            owner.get(key) != value for key, value in expected.items()\n        ):\n            raise ValueError("Cutscene OBJ alignment-gap right owner identity changed")\n        right_owners.append(owner)\n\n    canonical_files = (\n        (\n            CUTSCENE_OBJ_ALIGNMENT_GAP_VERIFIER,\n            "tools/verify_rom_cutscene_obj_palette_definition_alignment_gaps.py",\n            CUTSCENE_OB