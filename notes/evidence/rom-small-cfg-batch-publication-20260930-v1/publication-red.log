   ),\n    )\n    expected_owner_ids = {\n        identifier for identifier, _ in left_owner_specs\n    } | {identifier for identifier, *_ in right_owner_specs}\n    source_ranges = tuple(pair for _, pair in left_owner_specs) + tuple(\n        pair for _, pair, *_ in right_owner_specs\n    )\n    by_id: dict[str, dict[str, Any]] = {}\n    target_primary: list[str] = []\n    target_secondary: list[str] = []\n    extra_source_overlaps: list[str] = []\n    for claim in baseline_claims:\n        if not isinstance(claim, dict):\n            raise ValueError("Cutscene OBJ alignment-gap baseline claim changed")\n        identifier = claim.get("id")\n        if not isinstance(identifier, str) or not identifier:\n            raise ValueError("Cutscene OBJ alignment-gap baseline claim ID changed")\n        if identifier in by_id:\n            raise ValueError("Cutscene OBJ alignment-gap baseline claim IDs are not unique")\n        role = claim.get("role")\n        if role not in {"primary", "secondary"}:\n            raise ValueError("Cutscene OBJ alignment-gap baseline claim role changed")\n        if role == "primary" and not isinstance(claim.get("primary_class"), str):\n            raise ValueError("Cutscene OBJ alignment-gap baseline primary class changed")\n        start, end = _validated_range(claim, len(rom))\n        by_id[identifier] = claim\n        if any(\n            start < gap_end and gap_start < end\n            for gap_start, gap_end in canonical_ranges\n        ):\n            (target_primary if role == "primary" else target_secondary).append(\n                identifier\n            )\n        if identifier not in expected_owner_ids and any(\n            start < source_end and source_start < end\n            for source_start, source_end in source_ranges\n        ):\n            extra_source_overlaps.append(identifier)\n    if target_primary:\n        raise ValueError(\n            "Cutscene OBJ alignment-gap ranges are not fully current unknown; "\n        