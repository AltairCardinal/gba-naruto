est_raw = (artifact / "manifest.json").read_bytes()\n    payload_raw = (artifact / CFG_PROVEN_ROOTS_V17_PAYLOAD).read_bytes()\n    if (\n        len(manifest_raw) != CFG_PROVEN_ROOTS_V17_MANIFEST_SIZE\n        or _sha256(manifest_raw) != CFG_PROVEN_ROOTS_V17_MANIFEST_SHA256\n        or len(payload_raw) != CFG_PROVEN_ROOTS_V17_PAYLOAD_SIZE\n        or _sha256(payload_raw) != CFG_PROVEN_ROOTS_V17_PAYLOAD_SHA256\n    ):\n        raise ValueError("CFG proven-roots v17 artifact identity changed")\n    report = verify_root(root, artifact)\n    if (\n        report.get("verified") is not True\n        or report.get("promotion_bytes") != 2_400\n        or report.get("preserved_unknown_gap_count") != 5\n    ):\n        raise ValueError(f"CFG proven-roots v17 independent verification failed: {report}")\n    payload = json.loads(payload_raw)\n    promotion = payload.get("promotion", {})\n    records = promotion.get("claims")\n    if not isinstance(records, list) or len(records) != 26:\n        raise ValueError("CFG proven-roots v17 claim denominator changed")\n    baseline = list(existing_claims)\n    segments = atomize_claims(len(rom), baseline)\n    starts = [segment["range"][0] for segment in segments]\n\n    def require_unknown(start: int, end: int) -> None:\n        index = bisect.bisect_right(starts, start) - 1\n        if index < 0:\n            raise ValueError("CFG proven-roots v17 escaped coverage")\n        while start < end:\n            segment = segments[index]\n            if segment["range"][0] > start or segment["primary_class"] != "unknown":\n                raise ValueError("CFG proven-roots v17 is not current unknown")\n            start = min(end, segment["range"][1])\n            index += 1\n\n    report_sha = _sha256(_canonical_json_bytes(report))\n    claims = []\n    for index, row in enumerate(records):\n        start, end = row["range"]\n        if start >= end or _sha256(rom[start:end]) != row.get("bytes_sha256"):\n            raise ValueError("CFG 