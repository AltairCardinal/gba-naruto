cords-v1"\n        or payload.get("rom")\n        != {"path": ROM_PATH.as_posix(), "size": len(rom), "sha256": ROM_SHA256}\n        or payload.get("summary")\n        != {\n            "bundle_sha256": SELECTOR_DIRECT_SOURCE_RECORDS_BUNDLE_SHA256,\n            "range_overlap_bytes": 0,\n            "record_bytes": 920,\n            "record_count": 46,\n        }\n        or not isinstance(source_table, dict)\n        or source_table.get("range") != [0x59F5F0, 0x59F988]\n        or source_table.get("record_count") != 46\n        or source_table.get("record_size") != 20\n        or source_table.get("size") != 920\n        or source_table.get("sha256")\n        != SELECTOR_DIRECT_SOURCE_RECORDS_BUNDLE_SHA256\n        or source_table.get("record_vector_sha256")\n        != SELECTOR_DIRECT_SOURCE_RECORDS_EXPECTED_REPORT["record_vector_sha256"]\n        or source_table.get("row_range_vector_sha256")\n        != SELECTOR_DIRECT_SOURCE_RECORDS_RANGE_DENOMINATOR_SHA256\n        or payload.get("scope", {}).get("fixed_46_source_record_denominator_complete")\n        is not True\n        or payload.get("scope", {}).get("byte_2_to_19_semantics_proven") is not False\n        or payload.get("scope", {}).get("complete_63_slot_text_table") is not False\n        or payload.get("scope", {}).get("natural_gameplay_all_rows_reached")\n        is not False\n        or payload.get("scope", {}).get("editing_or_writeback_safety_proven")\n        is not False\n        or payload.get("scope", {}).get("allocatable_space_claimed") is not False\n    ):\n        raise ValueError("selector direct source record payload contract changed")\n\n    try:\n        report = verify_rom_selector_direct_source_records(root, artifact)\n    except Exception as error:\n        raise ValueError(\n            f"selector direct source record independent verification failed: {error}"\n        ) from error\n    if report != SELECTOR_DIRECT_SOURCE_RECORDS_EXPECTED_REPORT:\n        raise ValueError(\n            "selector direct source record independent verification failed: "\n            f"{report}"\n        )\n\n    records = source_table.get("records")\n    if not isinstance(records, list) or len(records) != 46:\n        raise ValueError("selector direct source record denominator changed")\n    bundle = bundle_path.read_bytes()\n    if len(bundle) != 920:\n        raise ValueError("selector direct source record bundle size changed")\n    baseline_segments = atomize_claims(len(rom), baseline_claims)\n    claims: list[dict[str, Any]] = []\n    packed_cursor = 0\n    for index, record in enumerate(records):\n        if not isinstance(record, dict):\n            raise ValueError("selector direct source record is not an object")\n        start, end = _validated_range(record, len(rom))\n        expected_range = [0x59F5F0 + index * 20, 0x59F5F0 + (index + 1) * 20]\n        packed = [index * 20, (index + 1) * 20]\n        raw = rom[start:end]\n        if (\n            [start, end] != expected_range\n            or record.get("source_id") != index\n            or not isinstance(record.get("name_slot_id"), int)\n            or record.get("size") != 20\n            or record.get("raw_hex") != raw.hex()\n            or record.get("raw_sha256") != _sha256(raw)\n            or record.get("packed_range") != packed\n            or bundle[packed[0] : packed[1]] != raw\n        ):\n            raise ValueError(f"selector direct source record changed: {index}")\n\n        known_bytes = sum(\n            max(0, min(end, segment["range"][1]) - max(start, segment["range"][0]))\n            for segment in baseline_segments\n            if segment["primary_class"] != "unknown"\n            and segment["range"][0] < end\n            and start < segment["range"][1]\n        )\n        if known_bytes:\n            raise ValueError(\n                "selector direct source record range is not fully current unknown: "\n                f"source-{index:02d} ({known_bytes} known bytes)"\n            )\n        claims.append(\n            {\n                "id": f"selector-direct-source-record-{index:02d}-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": "selector_direct_source_record",\n                "claim_kind": "selector_direct_source_record_bytes",\n                "promotion_batch": SELECTOR_DIRECT_SOURCE_RECORDS_BATCH,\n                "promoted_from_primary_class": "unknown",\n                "baseline_unknown_only": True,\n                "source_id": index,\n                "name_slot_id": record["name_slot_id"],\n                "bytes_sha256": record["raw_sha256"],\n                "evidence_path": (\n                    SELECTOR_DIRECT_SOURCE_RECORDS_ARTIFACT\n                    / SELECTOR_DIRECT_SOURCE_RECORDS_PAYLOAD_NAME\n                ).as_posix(),\n                "evidence_sha256": SELECTOR_DIRECT_SOURCE_RECORDS_PAYLOAD_SHA256,\n                "evidence_selector": f"/source_table/records/{index}",\n                "promotion_manifest_path": (\n                    SELECTOR_DIRECT_SOURCE_RECORDS_ARTIFACT / "manifest.json"\n                ).as_posix(),\n                "promotion_manifest_sha256": (\n                    SELECTOR_DIRECT_SOURCE_RECORDS_MANIFEST_SHA256\n                ),\n                "independent_verifier_path": (\n                    SELECTOR_DIRECT_SOURCE_RECORDS_VERIFIER.as_posix()\n                ),\n                "independent_verifier_sha256": (\n                    SELECTOR_DIRECT_SOURCE_RECORDS_VERIFIER_SHA256\n                ),\n                "runtime_reachability_claimed": False,\n                "full_record_field_semantics_claimed": False,\n                "editing_or_writeback_safety_proven": False,\n                "allocatable_space_claimed": False,\n                "limitations": [\n                    "Only this complete fixed 20-byte source row is promoted from current unknown.",\n                    "Bytes 2..19 retain no field semantics; runtime reachability and writeback safety are not claimed.",\n                ],\n            }\n        )\n        packed_cursor += end - start\n\n    range_denominator = _sha256(\n        json.dumps(\n            [claim["range"] for claim in claims], separators=(",", ":")\n        ).encode("ascii")\n    )\n    if (\n        len(claims) != 46\n        or packed_cursor != 920\n        or range_denominator\n        != SELECTOR_DIRECT_SOURCE_RECORDS_RANGE_DENOMINATOR_SHA256\n    ):\n        raise ValueError(\n            "selector direct source record coverage denominator changed: "\n            f"claims={len(claims)}, bytes={packed_cursor}, sha256={range_denominator}"\n        )\n    return claims\n\n\ndef _selector_code_window_claims(\n    root: Path,\n    rom: bytes,\n    baseline_claims: list[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote only the still-unknown projection of ten frozen code windows."""\n\n    root = Path(root).resolve(strict=True)\n    if _sha256(rom) != ROM_SHA256:\n        raise ValueError("selector code window ROM SHA-256 changed")\n    if any(\n        claim.get("promotion_batch") == SELECTOR_CODE_WINDOWS_BATCH\n        for claim in baseline_claims\n    ):\n        raise ValueError("selector code window batch is already present")\n\n    artifact = (root / SELECTOR_CODE_WINDOWS_ARTIFACT).absolute()\n    manifest_path = artifact / "manifest.json"\n    payload_path = artifact / SELECTOR_CODE_WINDOWS_PAYLOAD_NAME\n    full_bundle_path = artifact / SELECTOR_CODE_WINDOWS_FULL_BUNDLE_NAME\n    promotion_bundle_path = artifact / SELECTOR_CODE_WINDOWS_PROMOTION_BUNDLE_NAME\n    verifier_path = (root / SELECTOR_CODE_WINDOWS_VERIFIER).absolute()\n\n    def checked_path(path: Path, label: str, *, directory: bool = False) -> Path:\n        try:\n            resolved = path.resolve(strict=True)\n            resolved.relative_to(root)\n        except (OSError, ValueError) as error:\n            raise ValueError(f"selector code window {label} path is unsafe") from error\n        if path.is_symlink() or resolved != path:\n            raise ValueError(f"selector code window {label} path is unsafe")\n        if directory:\n            if not path.is_dir():\n                raise ValueError(f"selector code window {label} is not a directory")\n        elif not path.is_file():\n            raise ValueError(f"selector code window {label} is not a file")\n        return resolved\n\n    checked_path(artifact, "artifact", directory=True)\n    members = list(artifact.iterdir())\n    expected_names = {\n        "manifest.json",\n        SELECTOR_CODE_WINDOWS_PAYLOAD_NAME,\n        SELECTOR_CODE_WINDOWS_FULL_BUNDLE_NAME,\n        SELECTOR_CODE_WINDOWS_PROMOTION_BUNDLE_NAME,\n    }\n    if (\n        {member.name for member in members} != expected_names\n        or any(member.is_symlink() or not member.is_file() for member in members)\n    ):\n        raise ValueError("selector code window artifact file denominator changed")\n    for path, label in (\n        (manifest_path, "manifest"),\n        (payload_path, "payload"),\n        (full_bundle_path, "full bundle"),\n        (promotion_bundle_path, "promotion bundle"),\n        (verifier_path, "verifier"),\n    ):\n        checked_path(path, label)\n    if _sha256_file(manifest_path) != SELECTOR_CODE_WINDOWS_MANIFEST_SHA256:\n        raise ValueError("selector code window manifest hash changed")\n    if (\n        payload_path.stat().st_size != SELECTOR_CODE_WINDOWS_PAYLOAD_SIZE\n        or _sha256_file(payload_path) != SELECTOR_CODE_WINDOWS_PAYLOAD_SHA256\n    ):\n        raise ValueError("selector code window payload identity changed")\n    if (\n        full_bundle_path.stat().st_size != 2_754\n        or _sha256_file(full_bundle_path)\n        != SELECTOR_CODE_WINDOWS_FULL_BUNDLE_SHA256\n        or promotion_bundle_path.stat().st_size != 1_252\n        or _sha256_file(promotion_bundle_path)\n        != SELECTOR_CODE_WINDOWS_PROMOTION_BUNDLE_SHA256\n    ):\n        raise ValueError("selector code window bundle identity changed")\n    if _sha256_file(verifier_path) != SELECTOR_CODE_WINDOWS_VERIFIER_SHA256:\n        raise ValueError("selector code window verifier identity changed")\n\n    try:\n        manifest = json.loads(manifest_path.read_bytes())\n        payload = json.loads(payload_path.read_bytes())\n    except (OSError, json.JSONDecodeError) as error:\n        raise ValueError("selector code window JSON is invalid") from error\n    expected_files = {\n        SELECTOR_CODE_WINDOWS_FULL_BUNDLE_NAME: (\n            SELECTOR_CODE_WINDOWS_FULL_BUNDLE_SHA256\n        ),\n        SELECTOR_CODE_WINDOWS_PAYLOAD_NAME: SELECTOR_CODE_WINDOWS_PAYLOAD_SHA256,\n        SELECTOR_CODE_WINDOWS_PROMOTION_BUNDLE_NAME: (\n            SELECTOR_CODE_WINDOWS_PROMOTION_BUNDLE_SHA256\n        ),\n    }\n    if (\n        not isinstance(manifest, dict)\n        or manifest.get("schema") != "git-artifact-promotion-v1"\n        or manifest.get("artifact_schema") != SELECTOR_CODE_WINDOWS_BATCH\n        or manifest.get("artifact_status") != "accepted"\n        or manifest.get("files") != expected_files\n        or manifest.get("verification", {}).get("report")\n        != SELECTOR_CODE_WINDOWS_EXPECTED_REPORT\n        or manifest.get("verification", {}).get("verifier_sha256")\n        != SELECTOR_CODE_WINDOWS_VERIFIER_SHA256\n    ):\n        raise ValueError("selector code window manifest contract changed")\n\n    expected_summary = {\n        key: value\n        for key, value in SELECTOR_CODE_WINDOWS_EXPECTED_REPORT.items()\n        if key not in {"schema", "artifact_schema", "verified", "errors"}\n    }\n    coverage_contract = payload.get("coverage") if isinstance(payload, dict) else None\n    scope = payload.get("scope") if isinstance(payload, dict) else None\n    source_windows = payload.get("source_windows") if isinstance(payload, dict) else None\n    promotions = payload.get("promotion_ranges") if isinstance(payload, dict) else None\n    if (\n        payload.get("schema") != SELECTOR_CODE_WINDOWS_BATCH\n        or payload.get("rom")\n        != {"path": ROM_PATH.as_posix(), "size": len(rom), "sha256": ROM_SHA256}\n        or payload.get("summary") != expected_summary\n        or not isinstance(coverage_contract, dict)\n        or coverage_contract.get("live_hash_pinned") is not False\n        or coverage_contract.get("baseline_observation", {}).get("sha256")\n        != "d441f702add65e36dce291cfa6e6235e3ee7156cbb7b259ad47255848a581049"\n        or coverage_contract.get("accepted_live_primary_states")\n        != ["unknown", SELECTOR_CODE_WINDOWS_BATCH]\n        or not isinstance(scope, dict)\n        or scope.get("primary_class") != "consumer_code_slice"\n        or scope.get("claim_kind") != "consumer_code_slice"\n        or scope.get("baseline_unknown_only") is not True\n        or scope.get("instruction_only_claimed") is not False\n        or scope.get("runtime_reachability_claimed") is not False\n        or scope.get("safe_editing") is not False\n        or scope.get("allocatable") is not False\n        or scope.get("existing_primary_bytes_preserved") != 1_502\n        or not isinstance(source_windows, list)\n        or len(source_windows) != 10\n        or not isinstance(promotions, list)\n        or len(promotions) != 19\n    ):\n        raise ValueError("selector code window payload contract changed")\n\n    try:\n        report = verify_rom_selector_code_windows(root, artifact)\n    except Exception as error:\n        raise ValueError(\n            f"selector code window independent verification failed: {error}"\n        ) from error\n    if report != SELECTOR_CODE_WINDOWS_EXPECTED_REPORT:\n        raise ValueError(\n            "selector code window independent verification failed: " f"{report}"\n        )\n\n    window_ids = {\n        window.get("id") for window in source_windows if isinstance(window, dict)\n    }\n    if len(window_ids) != 10 or None in window_ids:\n        raise ValueError("selector code window source denominator changed")\n    baseline_segments = atomize_claims(len(rom), baseline_claims)\n    promotion_bundle = promotion_bundle_path.read_bytes()\n    claims: list[dict[str, Any]] = []\n    packed_cursor = 0\n    for index, record in enumerate(promotions):\n        if not isinstance(record, dict):\n            raise ValueError("selector code window promotion is not an object")\n        start, end = _validated_range(record, len(rom))\n        raw = rom[start:end]\n        packed = [packed_cursor, packed_cursor + len(raw)]\n        if (\n            record.get("id") != f"promotion-{index:02d}"\n            or record.get("source_window_id") not in window_ids\n            or record.get("size") != end - start\n            or record.get("raw_sha256") != _sha256(raw)\n            or record.get("packed_range") != packed\n            or record.get("packed_sha256") != _sha256(raw)\n            or record.get("primary_class") != "consumer_code_slice"\n            or record.get("claim_kind") != "consumer_code_slice"\n            or record.get("promotion_batch") != SELECTOR_CODE_WINDOWS_BATCH\n            or record.get("baseline_unknown_only") is not True\n            or record.get("instruction_only_claimed") is not False\n            or record.get("runtime_reachability_claimed") is not False\n            or record.get("safe_editing") is not False\n            or record.get("allocatable") is not False\n            or promotion_bundle[packed[0] : packed[1]] != raw\n        ):\n            raise ValueError(f"selector code window promotion changed: {index}")\n        known_bytes = sum(\n            max(0, min(end, segment["range"][1]) - max(start, segment["range"][0]))\n            for segment in baseline_segments\n            if segment["primary_class"] != "unknown"\n            and segment["range"][0] < end\n            and start < segment["range"][1]\n        )\n        if known_bytes:\n            raise ValueError(\n                "selector code window range is not fully current unknown: "\n                f"promotion-{index:02d} ({known_bytes} known bytes)"\n            )\n        claims.append(\n            {\n                "id": f"selector-code-window-{index:02d}-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": "consumer_code_slice",\n                "claim_kind": "consumer_code_slice",\n                "promotion_batch": SELECTOR_CODE_WINDOWS_BATCH,\n                "promoted_from_primary_class": "unknown",\n                "baseline_unknown_only": True,\n                "source_window_id": record["source_window_id"],\n                "artifact_promotion_id": record["id"],\n                "bytes_sha256": record["raw_sha256"],\n                "packed_range": packed,\n                "evidence_path": (\n                    SELECTOR_CODE_WINDOWS_ARTIFACT\n                    / SELECTOR_CODE_WINDOWS_PAYLOAD_NAME\n                ).as_posix(),\n                "evidence_sha256": SELECTOR_CODE_WINDOWS_PAYLOAD_SHA256,\n                "evidence_selector": f"/promotion_ranges/{index}",\n                "promotion_manifest_path": (\n                    SELECTOR_CODE_WINDOWS_ARTIFACT / "manifest.json"\n                ).as_posix(),\n                "promotion_manifest_sha256": SELECTOR_CODE_WINDOWS_MANIFEST_SHA256,\n                "independent_verifier_path": SELECTOR_CODE_WINDOWS_VERIFIER.as_posix(),\n                "independent_verifier_sha256": (\n                    SELECTOR_CODE_WINDOWS_VERIFIER_SHA256\n                ),\n                "instruction_only_claimed": False,\n                "runtime_reachability_claimed": False,\n                "safe_editing": False,\n                "allocatable": False,\n                "limitations": [\n                    "Only this current-unknown portion of a frozen selector source window is promoted.",\n                    "Pure instruction identity, natural reachability, editing safety, and allocatable space are not claimed.",\n                ],\n            }\n        )\n        packed_cursor += end - start\n\n    denominator = _sha256(\n        json.dumps(\n            [claim["range"] for claim in claims], separators=(",", ":")\n        ).encode("ascii")\n    )\n    if (\n        len(claims) != 19\n        or packed_cursor != 1_252\n        or denominator\n        != SELECTOR_CODE_WINDOWS_PROMOTION_RANGE_DENOMINATOR_SHA256\n        or packed_cursor != len(promotion_bundle)\n    ):\n        raise ValueError(\n            "selector code window coverage denominator changed: "\n            f"claims={len(claims)}, bytes={packed_cursor}, sha256={denominator}"\n        )\n    return claims\n\n\ndef _menu_portrait_palette_claims(\n    root: Path,\n    rom: bytes,\n    baseline_claims: list[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote the 70 verified physical menu-portrait palette ranges."""\n\n    root = Path(root).resolve(strict=True)\n    if _sha256(rom) != ROM_SHA256:\n        raise ValueError("menu portrait palette ROM SHA-256 changed")\n    if any(\n        claim.get("promotion_batch") == MENU_PORTRAIT_PALETTE_BATCH\n        for claim in baseline_claims\n    ):\n        raise ValueError("menu portrait palette batch is already present")\n\n    artifact = (root / MENU_PORTRAIT_PALETTE_ARTIFACT).absolute()\n    manifest_path = artifact / "manifest.json"\n    payload_path = artifact / MENU_PORTRAIT_PALETTE_PAYLOAD_NAME\n    bundle_path = artifact / MENU_PORTRAIT_PALETTE_BUNDLE_NAME\n    verifier_path = (root / MENU_PORTRAIT_PALETTE_VERIFIER).absolute()\n\n    def checked_path(path: Path, label: str, *, directory: bool = False) -> Path:\n        try:\n            resolved = path.resolve(strict=True)\n            resolved.relative_to(root)\n        except (OSError, ValueError) as error:\n            raise ValueError(f"menu portrait palette {label} path is unsafe") from error\n        if path.is_symlink() or resolved != path:\n            raise ValueError(f"menu portrait palette {label} path is unsafe")\n        if directory:\n            if not path.is_dir():\n                raise ValueError(f"menu portrait palette {label} is not a directory")\n        elif not path.is_file():\n            raise ValueError(f"menu portrait palette {label} is not a file")\n        return resolved\n\n    checked_path(artifact, "artifact", directory=True)\n    members = list(artifact.iterdir())\n    expected_names = {\n        "manifest.json",\n        MENU_PORTRAIT_PALETTE_PAYLOAD_NAME,\n        MENU_PORTRAIT_PALETTE_BUNDLE_NAME,\n    }\n    if (\n        {member.name for member in members} != expected_names\n        or any(member.is_symlink() or not member.is_file() for member in members)\n    ):\n        raise ValueError("menu portrait palette artifact file denominator changed")\n    for path, label in (\n        (manifest_path, "manifest"),\n        (payload_path, "payload"),\n        (bundle_path, "bundle"),\n        (verifier_path, "verifier"),\n    ):\n        checked_path(path, label)\n    if _sha256_file(manifest_path) != MENU_PORTRAIT_PALETTE_MANIFEST_SHA256:\n        raise ValueError("menu portrait palette manifest hash changed")\n    if (\n        payload_path.stat().st_size != MENU_PORTRAIT_PALETTE_PAYLOAD_SIZE\n        or _sha256_file(payload_path) != MENU_PORTRAIT_PALETTE_PAYLOAD_SHA256\n    ):\n        raise ValueError("menu portrait palette payload identity changed")\n    if (\n        bundle_path.stat().st_size != 8_960\n        or _sha256_file(bundle_path) != MENU_PORTRAIT_PALETTE_BUNDLE_SHA256\n    ):\n        raise ValueError("menu portrait palette bundle identity changed")\n    if _sha256_file(verifier_path) != MENU_PORTRAIT_PALETTE_VERIFIER_SHA256:\n        raise ValueError("menu portrait palette verifier identity changed")\n\n    try:\n        manifest = json.loads(manifest_path.read_bytes())\n        payload = json.loads(payload_path.read_bytes())\n    except (OSError, json.JSONDecodeError) as error:\n        raise ValueError("menu portrait palette JSON is invalid") from error\n    expected_scope = {\n        "adjacent_gaps_classified": False,\n        "arbitrary_image_writeback": False,\n        "dynamic_caller_input_domain_complete": False,\n        "fixed_length_palette_writeback_verified": True,\n        "fixed_palette_byte_inventory_complete": True,\n        "graphics_bytes_classified_here": False,\n        "natural_gameplay_all_logical_outputs_proven": False,\n        "pointer_rewrite_complete": False,\n        "relocation_complete": False,\n        "runtime_pixel_equivalence": False,\n        "safe_free_space_claimed": False,\n        "source_resource_aliases_complete": True,\n    }\n    expected_files = {\n        MENU_PORTRAIT_PALETTE_PAYLOAD_NAME: MENU_PORTRAIT_PALETTE_PAYLOAD_SHA256,\n        MENU_PORTRAIT_PALETTE_BUNDLE_NAME: MENU_PORTRAIT_PALETTE_BUNDLE_SHA256,\n    }\n    if (\n        not isinstance(manifest, dict)\n        or manifest.get("schema") != "git-artifact-promotion-v1"\n        or manifest.get("artifact_schema") != MENU_PORTRAIT_PALETTE_BATCH\n        or manifest.get("artifact_status") != "accepted"\n        or manifest.get("files") != expected_files\n        or manifest.get("scope") != expected_scope\n        or manifest.get("verifier", {}).get("exit_code") != 0\n        or manifest.get("verifier", {}).get("report")\n        != MENU_PORTRAIT_PALETTE_EXPECTED_REPORT\n        or manifest.get("verifier", {}).get("verifier_sha256")\n        != MENU_PORTRAIT_PALETTE_VERIFIER_SHA256\n        or manifest.get("producer", {}).get("verifier")\n        != {\n            "path": MENU_PORTRAIT_PALETTE_VERIFIER.as_posix(),\n            "sha256": MENU_PORTRAIT_PALETTE_VERIFIER_SHA256,\n        }\n    ):\n        raise ValueError("menu portrait palette manifest contract changed")\n\n    expected_summary = {\n        "alias_group_count": 1,\n        "aliased_logical_output_count": 56,\n        "aliased_resource_count": 5,\n        "bun