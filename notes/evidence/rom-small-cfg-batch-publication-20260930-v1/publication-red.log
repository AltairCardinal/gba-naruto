"),\n        (0x074184, 0x070DD8, "controller"),\n        (0x07445C, 0x06C40C, "provenance_excluded"),\n        (0x075058, 0x06D46C, "controller"),\n    ]\n    producers = payload["producer_denominator"]["producers"]\n    if [\n        (\n            item.get("file_offset"),\n            item.get("target_file_offset"),\n            item.get("provenance"),\n        )\n        for item in producers\n    ] != expected_producers:\n        raise ValueError("v9 producer/provenance denominator changed")\n    if (\n        len(payload.get("roots", [])) != 8\n        or len(payload["extension"].get("opaque_return_exits", [])) != 7\n        or payload["extension"].get("frontiers") != []\n        or len(payload["extension"].get("baseline_cross_edges", [])) != 16\n        or payload["coverage_baseline"].get("current_unknown_bytes") != 628\n        or payload["coverage_baseline"].get("current_known_overlap_bytes") != 0\n    ):\n        raise ValueError("v9 root/closure denominator changed")\n    segments = atomize_claims(len(rom), baseline)\n    unknown = [\n        tuple(segment["range"])\n        for segment in segments\n        if segment["primary_class"] == "unknown"\n    ]\n    blocks = payload["extension"]["blocks"]\n    if len(blocks) != 62:\n        raise ValueError("v9 block denominator changed")\n    claims: list[dict[str, Any]] = []\n    previous_end = -1\n    for block_index, block in enumerate(blocks):\n        start, end = block.get("range", [None, None])\n        block_id = block.get("id")\n        if (\n            block.get("mode") != "thumb"\n            or not isinstance(start, int)\n            or not isinstance(end, int)\n            or start < previous_end\n            or not 0 <= start < end <= len(rom)\n            or block_id != f"block-thumb-{start:06x}"\n            or block.get("bytes_sha256") != _sha256(rom[start:end])\n        ):\n            raise ValueError(f"v9 block identity changed: {block_id}")\n        previous_end = end\n        pieces = [\n            (max(start, unknown_start), min(end, unknown_end))\n            for unknown_start, unknown_end in unknown\n            if unknown_start < end and start < unknown_end\n        ]\n        if pieces != [(start, end)]:\n            raise ValueError(f"v9 block is not fully current unknown: {block_id}")\n        claims.append(\n            {\n                "id": f"cfg-proven-roots-v9-thumb-{block_index:04d}-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": "armv4t_cfg_proven_roots_v9_reachable_thumb_code",\n                "claim_kind": kind,\n                "mode": "thumb",\n                "source_block_count": 1,\n                "source_blocks": [{"block_id": block_id, "range": [start, end]}],\n                "fixed_root_count": 8,\n                "fixed_direct_producer_count": 11,\n                "controller_source_count": 9,\n                "excluded_source_count": 2,\n                "opaque_return_exit_count": 7,\n                "promoted_from_primary_class": "unknown",\n                "runtime_reachability_claimed": False,\n                "global_code_map_claimed": False,\n                "bytes_sha256": _sha256(rom[start:end]),\n                "evidence_path": (\n                    CFG_PROVEN_ROOTS_V9_ARTIFACT\n                    / CFG_PROVEN_ROOTS_V9_PAYLOAD_NAME\n                ).as_posix(),\n                "evidence_sha256": CFG_PROVEN_ROOTS_V9_PAYLOAD_SHA256,\n                "evidence_selector": f"/extension/blocks/{block_index}",\n                "promotion_manifest_path": (\n                    CFG_PROVEN_ROOTS_V9_ARTIFACT / "manifest.json"\n                ).as_posix(),\n                "promotion_manifest_sha256": CFG_PROVEN_ROOTS_V9_MANIFEST_SHA256,\n                "independent_verifier_path": CFG_PROVEN_ROOTS_V9_VERIFIER.as_posix(),\n                "independent_verifier_sha256": CFG_PROVEN_ROOTS_V9_VERIFIER_SHA256,\n                "promotion_batch": "cfg-proven-roots-v9",\n                "limitations": [\n                    "Only the complete current-unknown blocks reached from eight fixed controller-bound direct-call roots are promoted.",\n                    "Nine controller producers were already classified and are not re-claimed; two provenance-excluded producers remain unknown.",\n                    "Seven stack-restored returns are opaque exits; runtime reachability, indirect targets, and a global code map are not claimed.",\n                ],\n            }\n        )\n    if (\n        len(claims) != 62\n        or sum(claim["range"][1] - claim["range"][0] for claim in claims)\n        != 628\n    ):\n        raise ValueError("v9 promotion denominator changed")\n    return claims\n\n\ndef _cfg_proven_roots_v10_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote only the closed v10 target code and consumed literal ranges."""\n\n    root = Path(root).resolve(strict=True)\n    baseline = list(existing_claims)\n    kinds = {\n        CFG_PROVEN_ROOTS_V10_CODE_KIND,\n        CFG_PROVEN_ROOTS_V10_LITERAL_KIND,\n    }\n    if any(\n        claim.get("promotion_batch") == CFG_PROVEN_ROOTS_V10_BATCH\n        or claim.get("claim_kind") in kinds\n        for claim in baseline\n    ):\n        raise ValueError("v10 claims require a pre-v10 baseline; batch is already present")\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError("v10 ROM identity changed")\n\n    artifact = (root / CFG_PROVEN_ROOTS_V10_ARTIFACT).absolute()\n    try:\n        resolved_artifact = artifact.resolve(strict=True)\n        resolved_artifact.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError("v10 artifact is missing or outside the repository") from error\n    if resolved_artifact != artifact or not artifact.is_dir():\n        raise ValueError("v10 artifact uses a symlink or is not a directory")\n    members = list(artifact.iterdir())\n    if (\n        {member.name for member in members}\n        != {"manifest.json", CFG_PROVEN_ROOTS_V10_PAYLOAD_NAME}\n        or any(member.is_symlink() or not member.is_file() for member in members)\n    ):\n        raise ValueError("v10 artifact file set changed")\n\n    verifier = (root / CFG_PROVEN_ROOTS_V10_VERIFIER).absolute()\n    try:\n        resolved_verifier = verifier.resolve(strict=True)\n        resolved_verifier.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError("v10 verifier is missing or outside the repository") from error\n    if resolved_verifier != verifier or not verifier.is_file():\n        raise ValueError("v10 verifier uses a symlink or is not a file")\n    if _sha256_file(verifier) != CFG_PROVEN_ROOTS_V10_VERIFIER_SHA256:\n        raise ValueError("v10 verifier identity changed")\n\n    manifest_path = artifact / "manifest.json"\n    payload_path = artifact / CFG_PROVEN_ROOTS_V10_PAYLOAD_NAME\n    manifest_raw = manifest_path.read_bytes()\n    payload_raw = payload_path.read_bytes()\n    if (\n        len(manifest_raw) != CFG_PROVEN_ROOTS_V10_MANIFEST_SIZE\n        or _sha256(manifest_raw) != CFG_PROVEN_ROOTS_V10_MANIFEST_SHA256\n        or len(payload_raw) != CFG_PROVEN_ROOTS_V10_PAYLOAD_SIZE\n        or _sha256(payload_raw) != CFG_PROVEN_ROOTS_V10_PAYLOAD_SHA256\n    ):\n        raise ValueError("v10 artifact identity changed")\n    try:\n        manifest = json.loads(manifest_raw)\n        payload = json.loads(payload_raw)\n    except json.JSONDecodeError as error:\n        raise ValueError("v10 artifact JSON is invalid") from error\n    if (\n        manifest_raw != _canonical_json_bytes(manifest)\n        or payload_raw != _canonical_json_bytes(payload)\n    ):\n        raise ValueError("v10 artifact JSON is not canonical")\n\n    report = verify_rom_cfg_proven_roots_v10(root, artifact)\n    if report != CFG_PROVEN_ROOTS_V10_EXPECTED_REPORT:\n        raise ValueError(f"v10 independent verification failed: {report}")\n\n    expected_rom = {\n        "path": ROM_PATH.as_posix(),\n        "size": len(rom),\n        "sha256": ROM_SHA256,\n    }\n    expected_files = {\n        CFG_PROVEN_ROOTS_V10_PAYLOAD_NAME: CFG_PROVEN_ROOTS_V10_PAYLOAD_SHA256\n    }\n    if (\n        set(manifest) != CFG_PROVEN_ROOTS_V10_MANIFEST_KEYS\n        or manifest.get("schema") != "git-artifact-promotion-v1"\n        or manifest.get("artifact_schema") != "rom-cfg-proven-roots-v10"\n        or manifest.get("artifact_status") != "accepted"\n        or manifest.get("rom") != expected_rom\n        or manifest.get("files") != expected_files\n        or manifest.get("implementation") != payload.get("implementation")\n        or manifest.get("source") != payload.get("source")\n        or manifest.get("target") != payload.get("target")\n        or manifest.get("upstream") != payload.get("upstream")\n        or manifest.get("promotion") != payload.get("promotion")\n        or manifest.get("coverage_baseline")\n        != CFG_PROVEN_ROOTS_V10_COVERAGE_BASELINE\n        or payload.get("coverage_baseline")\n        != CFG_PROVEN_ROOTS_V10_COVERAGE_BASELINE\n        or manifest.get("scope") != payload.get("scope")\n    ):\n        raise ValueError("v10 promotion manifest contract changed")\n    if (\n        payload.get("schema") != "rom-cfg-proven-roots-v10"\n        or payload.get("rom") != expected_rom\n        or payload.get("implementation", {}).get("verifier_sha256")\n        != CFG_PROVEN_ROOTS_V10_VERIFIER_SHA256\n    ):\n        raise ValueError("v10 payload contract changed")\n\n    verifier_receipt = manifest.get("verifier")\n    producer_receipt = manifest.get("producer")\n    if (\n        not isinstance(verifier_receipt, dict)\n        or verifier_receipt.get("schema")\n        != "rom-cfg-proven-roots-verification-v10"\n        or verifier_receipt.get("verifier_sha256")\n        != CFG_PROVEN_ROOTS_V10_VERIFIER_SHA256\n        or verifier_receipt.get("exit_code") != 0\n        or verifier_receipt.get("report") != CFG_PROVEN_ROOTS_V10_EXPECTED_REPORT\n        or not isinstance(verifier_receipt.get("command"), list)\n        or verifier_receipt["command"][:4]\n        != [\n            "python3",\n            "-I",\n            "-S",\n            CFG_PROVEN_ROOTS_V10_VERIFIER.as_posix(),\n        ]\n        or "--artifact-dir" not in verifier_receipt["command"]\n        or not isinstance(producer_receipt, dict)\n        or producer_receipt.get("implementation") != payload.get("implementation")\n        or not isinstance(producer_receipt.get("command"), list)\n        or producer_receipt["command"][:4]\n        != [\n            "python3",\n            "-I",\n            "-S",\n            "tools/export_rom_cfg_proven_roots_v10.py",\n        ]\n        or "--output-dir" not in producer_receipt["command"]\n    ):\n        raise ValueError("v10 accepted verifier receipt contract changed")\n\n    target = payload.get("target")\n    target_worklist = target.get("worklist") if isinstance(target, dict) else None\n    expected_target_summary = {\n        "decoded_basic_block_count": 7,\n        "decoded_instruction_count": 36,\n        "external_call_edge_count": 0,\n        "external_call_edge_reasons": {},\n        "frontier_count": 0,\n        "reachable_instruction_bytes": 72,\n    }\n    if (\n        not isinstance(target_worklist, dict)\n        or target_worklist.get("envelope") != [0x08B278, 0x08B2C8]\n        or target_worklist.get("envelope_size") != 80\n        or target_worklist.get("summary") != expected_target_summary\n        or target_worklist.get("code_ranges")\n        != [[0x08B278, 0x08B2B0], [0x08B2B4, 0x08B2C4]]\n        or target_worklist.get("literal_range_sha256")\n        != "a7ec3a41a610f7fad5af7f702db7684430e1cc86aa850d89000129426e3c4506"\n        or not isinstance(target_worklist.get("literals"), list)\n        or len(target_worklist["literals"]) != 2\n    ):\n        raise ValueError("v10 target promotion denominator changed")\n    expected_literals = [\n        {\n            "ldr_file_offset": 0x08B294,\n            "ldr_raw_hex": "064a",\n            "literal_range": [0x08B2B0, 0x08B2B4],\n        },\n        {\n            "ldr_file_offset": 0x08B2B8,\n            "ldr_raw_hex": "024a",\n            "literal_range": [0x08B2C4, 0x08B2C8],\n        },\n    ]\n    for literal, expected in zip(target_worklist["literals"], expected_literals, strict=True):\n        if (\n            literal.get("ldr_file_offset") != expected["ldr_file_offset"]\n            or literal.get("ldr_raw_hex") != expected["ldr_raw_hex"]\n            or literal.get("literal_range") != expected["literal_range"]\n            or literal.get("literal_raw_hex") != "fffffdff"\n            or literal.get("value_u32") != 4_294_836_223\n            or literal.get("bytes_sha256")\n            != "a1346ac820ab23b88199fa83fdf291b1da35759d6138899533af1fe1d5cd3043"\n        ):\n            raise ValueError("v10 literal denominator changed")\n\n    source = payload.get("source")\n    if (\n        not isinstance(source, dict)\n        or source.get("root", {}).get("file_offset") != 0x08B2C8\n        or source.get("worklist", {}).get("summary", {}).get(\n            "decoded_instruction_count"\n        )\n        != 264\n        or source.get("worklist", {}).get("summary", {}).get(\n            "decoded_basic_block_count"\n        )\n        != 35\n        or source.get("worklist", {}).get("summary", {}).get(\n            "reachable_instruction_bytes"\n        )\n        != 580\n        or source.get("worklist", {}).get("summary", {}).get(\n            "external_call_edge_count"\n        )\n        != 26\n    ):\n        raise ValueError("v10 source denominator changed")\n\n    baseline_segments = atomize_claims(len(rom), baseline)\n    unknown_bytes = 0\n    known_bytes = 0\n    for segment in baseline_segments:\n        start, end = segment["range"]\n        overlap = max(0, min(end, 0x08B2C8) - max(start, 0x08B278))\n        if not overlap:\n            continue\n        if segment.get("primary_class") == "unknown":\n            unknown_bytes += overlap\n        else:\n            known_bytes += overlap\n    if unknown_bytes != 80 or known_bytes != 0:\n        raise ValueError(\n            "v10 promotion envelope is not fully current unknown: "\n            f"unknown={unknown_bytes}, overlap={known_bytes}"\n        )\n\n    unknown_ranges = [\n        tuple(segment["range"])\n        for segment in baseline_segments\n        if segment.get("primary_class") == "unknown"\n    ]\n\n    def require_unknown(start: int, end: int) -> None:\n        if any(\n            start < known_end and known_start < end\n            for known_start, known_end in [\n                tuple(segment["range"])\n                for segment in baseline_segments\n                if segment.get("primary_class") != "unknown"\n            ]\n        ):\n            raise ValueError("v10 claim overlaps current known bytes")\n        if not any(left <= start and end <= right for left, right in unknown_ranges):\n            raise ValueError("v10 claim is not fully current unknown")\n\n    nonclaims = [\n        "natural_execution_reachability",\n        "global_code_denominator",\n        "global_caller_denominator",\n        "global_indirect_target_denominator",\n        "source_window_all_instructions",\n        "literal_editability",\n        "adjacent_region_code_or_free_space",\n    ]\n    limitations = [\n        "Only the exact closed target-root code ranges and two consumed literal words are classified.",\n        "Source bounded-worklist bytes and all three producer instructions are not re-claimed.",\n        "Natural execution, global code/caller/indirect denominators, literal editability, and adjacent-region code or free-space are not claimed.",\n    ]\n    evidence_path = (\n        CFG_PROVEN_ROOTS_V10_ARTIFACT / CFG_PROVEN_ROOTS_V10_PAYLOAD_NAME\n    ).as_posix()\n    manifest_evidence_path = (\n        CFG_PROVEN_ROOTS_V10_ARTIFACT / "manifest.json"\n    ).as_posix()\n    code_claims: list[dict[str, Any]] = []\n    blocks = target_worklist.get("blocks")\n    if not isinstance(blocks, list) or len(blocks) != 7:\n        raise ValueError("v10 target block denominator changed")\n    for index, value in enumerate(CFG_PROVEN_ROOTS_V10_CODE_RANGES):\n        start, end = value\n        require_unknown(start, end)\n        block = next(\n            (\n                candidate\n                for candidate in blocks\n                if candidate.get("range") == value\n            ),\n            None,\n        )\n        if (\n            not isinstance(block, dict)\n            or block.get("mode") != "thumb"\n            or block.get("id") != f"block-thumb-{start:06x}"\n            or block.get("bytes_sha256") != _sha256(rom[start:end])\n        ):\n            raise ValueError("v10 target code block identity changed")\n        code_claims.append(\n            {\n                "id": f"cfg-proven-roots-v10-thumb-{index:04d}-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": CFG_PROVEN_ROOTS_V10_CODE_CLASS,\n                "claim_kind": CFG_PROVEN_ROOTS_V10_CODE_KIND,\n                "mode": "thumb",\n                "source_block_count": 1,\n                "source_blocks": [{"block_id": block["id"], "range": value}],\n                "fixed_root_count": 1,\n                "fixed_direct_producer_count": 2,\n                "promoted_from_primary_class": "unknown",\n                "runtime_reachability_claimed": False,\n                "global_code_map_claimed": False,\n                "bytes_sha256": _sha256(rom[start:end]),\n                "evidence_path": evidence_path,\n                "evidence_sha256": CFG_PROVEN_ROOTS_V10_PAYLOAD_SHA256,\n                "evidence_selector": f"/target/worklist/blocks/{blocks.index(block)}",\n                "promotion_manifest_path": manifest_evidence_path,\n                "promotion_manifest_sha256": CFG_PROVEN_ROOTS_V10_MANIFEST_SHA256,\n                "independent_verifier_path": CFG_PROVEN_ROOTS_V10_VERIFIER.as_posix(),\n                "independent_verifier_sha256": CFG_PROVEN_ROOTS_V10_VERIFIER_SHA256,\n                "promotion_batch": CFG_PROVEN_ROOTS_V10_BATCH,\n                "nonclaims": nonclaims,\n                "limitations": limitations,\n            }\n        )\n\n    literal_claims: list[dict[str, Any]] = []\n    for index, literal in enumerate(target_worklist["literals"]):\n        start, end = literal["literal_range"]\n        require_unknown(start, end)\n        literal_claims.append(\n            {\n                "id": f"cfg-proven-roots-v10-literal-{index:02d}-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": CFG_PROVEN_ROOTS_V10_LITERAL_CLASS,\n                "claim_kind": CFG_PROVEN_ROOTS_V10_LITERAL_KIND,\n                "mode": "thumb",\n                "ldr_file_offset": literal["ldr_file_offset"],\n                "ldr_raw_hex": literal["ldr_raw_hex"],\n                "literal_raw_hex": literal["literal_raw_hex"],\n                "value_u32": literal["value_u32"],\n                "fixed_root_count": 1,\n                "fixed_direct_producer_count": 2,\n                "promoted_from_primary_class": "unknown",\n                "literal_editability_claimed": False,\n                "runtime_reachability_claimed": False,\n                "global_code_map_claimed": False,\n                "bytes_sha256": _sha256(rom[start:end]),\n                "evidence_path": evidence_path,\n                "evidence_sha256": CFG_PROVEN_ROOTS_V10_PAYLOAD_SHA256,\n                "evidence_selector": f"/target/worklist/literals/{index}",\n                "promotion_manifest_path": manifest_evidence_path,\n                "promotion_manifest_sha256": CFG_PROVEN_ROOTS_V10_MANIFEST_SHA256,\n                "independent_verifier_path": CFG_PROVEN_ROOTS_V10_VERIFIER.as_posix(),\n                "independent_verifier_sha256": CFG_PROVEN_ROOTS_V10_VERIFIER_SHA256,\n                "promotion_batch": CFG_PROVEN_ROOTS_V10_BATCH,\n                "nonclaims": nonclaims,\n                "limitations": limitations,\n            }\n        )\n    claims = code_claims + literal_claims\n    if (\n        len(code_claims) != 7\n        or sum(claim["range"][1] - claim["range"][0] for claim in code_claims) != 72\n        or len(literal_claims) != 2\n        or sum(claim["range"][1] - claim["range"][0] for claim in literal_claims) != 8\n        or len(claims) != 9\n    ):\n        raise ValueError("v10 promotion denominator changed")\n    return claims\n\n\ndef _cfg_proven_roots_v11_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote only the six closed v11 target blocks from current unknown."""\n\n    root = Path(root).resolve(strict=True)\n    baseline = list(existing_claims)\n    if any(\n        claim.get("promotion_batch") == CFG_PROVEN_ROOTS_V11_BATCH\n        or claim.get("claim_kind") == CFG_PROVEN_ROOTS_V11_CODE_KIND\n        for claim in baseline\n    ):\n        raise ValueError("v11 claims require a pre-v11 baseline; batch is already present")\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError("v11 ROM identity changed")\n\n    artifact = (root / CFG_PROVEN_ROOTS_V11_ARTIFACT).absolute()\n    try:\n        resolved_artifact = artifact.resolve(strict=True)\n        resolved_artifact.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError("v11 artifact is missing or outside the repository") from error\n    if resolved_artifact != artifact or not artifact.is_dir():\n        raise ValueError("v11 artifact uses a symlink or is not a directory")\n    members = list(artifact.iterdir())\n    if (\n        {member.name for member in members}\n        != {"manifest.json", CFG_PROVEN_ROOTS_V11_PAYLOAD_NAME}\n        or any(member.is_symlink() or not member.is_file() for member in members)\n    ):\n        raise ValueError("v11 artifact file set changed")\n\n    verifier = (root / CFG_PROVEN_ROOTS_V11_VERIFIER).absolute()\n    try:\n        resolved_verifier = verifier.resolve(strict=True)\n        resolved_verifier.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError("v11 verifier is missing or outside the repository") from error\n    if resolved_verifier != verifier or not verifier.is_file():\n        raise ValueError("v11 verifier uses a symlink or is not a file")\n    if _sha256_file(verifier) != CFG_PROVEN_ROOTS_V11_VERIFIER_SHA256:\n        raise ValueError("v11 verifier identity changed")\n\n    manifest_path = artifact / "manifest.json"\n    payload_path = artifact / CFG_PROVEN_ROOTS_V11_PAYLOAD_NAME\n    manifest_raw = manifest_path.read_bytes()\n    payload_raw = payload_path.read_bytes()\n    if (\n        len(manifest_raw) != CFG_PROVEN_ROOTS_V11_MANIFEST_SIZE\n        or _sha256(manifest_raw) != CFG_PROVEN_ROOTS_V11_MANIFEST_SHA256\n        or len(payload_raw) != CFG_PROVEN_ROOTS_V11_PAYLOAD_SIZE\n        or _sha256(payload_raw) != CFG_PROVEN_ROOTS_V11_PAYLOAD_SHA256\n    ):\n        raise ValueError("v11 artifact identity changed")\n    try:\n        manifest = json.loads(manifest_raw)\n        payload = json.loads(payload_raw)\n    except json.JSONDecodeError as error:\n        raise ValueError("v11 artifact JSON is invalid") from error\n    if (\n        manifest_raw != _canonical_json_bytes(manifest)\n        or payload_raw != _canonical_json_bytes(payload)\n    ):\n        raise ValueError("v11 artifact JSON is not canonical")\n\n    report = verify_rom_cfg_proven_roots_v11(root, artifact)\n    if report != CFG_PROVEN_ROOTS_V11_EXPECTED_REPORT:\n        raise ValueError(f"v11 independent verification failed: {report}")\n\n    expected_rom = {\n        "path": ROM_PATH.as_posix(),\n        "size": len(rom),\n        "sha256": ROM_SHA256,\n    }\n    expected_files = {\n        CFG_PROVEN_ROOTS_V11_PAYLOAD_NAME: CFG_PROVEN_ROOTS_V11_PAYLOAD_SHA256\n    }\n    if (\n        set(manifest) != CFG_PROVEN_ROOTS_V11_MANIFEST_KEYS\n        or manifest.get("schema") != "git-artifact-promotion-v1"\n        or manifest.get("artifact_schema") != "rom-cfg-proven-roots-v11"\n        or manifest.get("artifact_status") != "accepted"\n        or manifest.get("rom") != expected_rom\n        or manifest.get("files") != expected_files\n        or manifest.get("implementation") != payload.get("implementation")\n        or manifest.get("source") != payload.get("source")\n        or manifest.get("target") != payload.get("target")\n        or manifest.get("producer_denominator")\n        != payload.get("producer_denominator")\n        or manifest.get("upstream") != payload.get("upstream")\n        or manifest.get("promotion") != payload.get("promotion")\n        or manifest.get("coverage_baseline")\n        != CFG_PROVEN_ROOTS_V11_COVERAGE_BASELINE\n        or payload.get("coverage_baseline")\n        != CFG_PROVEN_ROOTS_V11_COVERAGE_BASELINE\n        or manifest.get("scope") != payload.get("scope")\n    ):\n        raise ValueError("v11 promotion manifest contract changed")\n    if (\n        payload.get("schema") != "rom-cfg-proven-roots-v11"\n        or payload.get("rom") != expected_rom\n        or payload.get("implementation", {}).get("verifier_sha256")\n        != CFG_PROVEN_ROOTS_V11_VERIFIER_SHA256\n    ):\n        raise ValueError("v11 payload contract changed")\n\n    verifier_receipt = manifest.get("verifier")\n    producer_receipt = manifest.get("producer")\n    if (\n        not isinstance(verifier_receipt, dict)\n        or verifier_receipt.get("schema")\n        != "rom-cfg-proven-roots-verification-v11"\n        or verifier_receipt.get("verifier_sha256")\n        != CFG_PROVEN_ROOTS_V11_VERIFIER_SHA256\n        or verifier_receipt.get("exit_code") != 0\n        or verifier_receipt.get("report") != CFG_PROVEN_ROOTS_V11_EXPECTED_REPORT\n        or not isinstance(verifier_receipt.get("command"), list)\n        or verifier_receipt["command"][:4]\n        != [\n            "python3",\n            "-I",\n            "-S",\n            CFG_PROVEN_ROOTS_V11_VERIFIER.as_posix(),\n        ]\n        or "--artifact-dir" not in verifier_receipt["command"]\n        or not isinstance(producer_receipt, dict)\n        or producer_receipt.get("implementation") != payload.get("implementation")\n        or not isinstance(producer_receipt.get("command"), list)\n        or producer_receipt["command"][:4]\n        != [\n            "python3",\n            "-I",\n            "-S",\n            "tools/export_rom_cfg_proven_roots_v11.py",\n        ]\n        or "--output-dir" not in producer_receipt["command"]\n    ):\n        raise ValueError("v11 accepted verifier receipt contract changed")\n\n    denominator = payload.get("producer_denominator")\n    producers = denominator.get("producers") if isinstance(denominator, dict) else None\n    expected_producers = [\n        (0x08064E, "e2f7b7fe", "accepted_fixed_tick_callback_closure"),\n        (0x08072A, "e2f749fe", "accepted_fixed_tick_callback_closure"),\n        (0x0807E8, "e2f7eafd", "accepted_fixed_tick_callback_closure"),\n        (0x080892, "e2f795fd", "accepted_fixed_tick_callback_closure"),\n        (0x080906, "e2f75bfd", "accepted_fixed_tick_callback_closure"),\n        (0x080956, "e2f733fd", "accepted_fixed_tick_callback_closure"),\n        (0x0809E6, "e2f7ebfc", "accepted_fixed_tick_callback_closure"),\n        (0x080A3A, "e2f7c1fc", "accepted_fixed_tick_callback_closure"),\n        (0x080D7C, "e2f720fb", "excluded_unproven_source"),\n    ]\n    if (\n        not isinstance(denominator, dict)\n        or denominator.get("denominator_sha256")\n        != "c6bf31a08f115718087652e182d97efd33807202785548b5100bda0e8e2d8851"\n        or denominator.get("scan")\n        != {\n            "alignment_bytes": 2,\n            "matching_producer_count": 9,\n            "mode": "thumb",\n            "range": [0, 6_291_456],\n            "target_file_offsets": [0x0633C0],\n        }\n        or not isinstance(producers, list)\n        or len(producers) != 9\n        or [\n            (item.get("file_offset"), item.get("raw_hex"), item.get("status"))\n            for item in producers\n        ]\n        != expected_producers\n        or any(\n            item.get("target_file_offset") != 0x0633C0\n            or item.get("target_gba_address") != "0x080633C0"\n            or item.get("gba_address") != f"0x{0x08000000 + item[\'file_offset\']:08X}"\n            or item.get("bytes_sha256") != _sha256(rom[item["file_offset"]:item["file_offset"] + 4])\n            for item in producers\n        )\n    ):\n        raise ValueError("v11 raw producer denominator changed")\n\n    source = payload.get("source")\n    source_summary = {\n        "decoded_basic_block_count": 92,\n        "decoded_instruction_count": 537,\n        "external_call_edge_count": 28,\n        "frontier_count": 0,\n        "reachable_instruction_bytes": 1_130,\n        "root_count": 8,\n    }\n    accepted_offsets = [value[0] for value in expected_producers[:-1]]\n    closures = source.get("closures") if isinstance(source, dict) else None\n    if (\n        not isinstance(source, dict)\n        or source.get("range") != [0x080554, 0x080A46]\n        or source.get("size") != 1_266\n        or source.get("slice_sha256")\n        != "22aae5132d081d89b9e9315968c1d3d089131b269ae1f5cfa232d1d6d13b8c8a"\n        or source.get("summary") != source_summary\n        or source.get("root_vector_sha256")\n        != "a7713d600741b0dd4c0d7ada7d59086252a9821e33436efced0e23da7c1048b4"\n        or source.get("external_vector_sha256")\n        != "0cb2da1c57effcb48910685b26bcc1331ecf923f34f65b9a0bb27b3be1ccb97b"\n        or source.get("block_range_vector_sha256")\n        != "16b4561b090a9a5cfda78923813e32c7c6c3a37fc8c67fdf7a1a63159cab3304"\n        or not isinstance(closures, list)\n        or len(closures) != 8\n        or [closure.get("accepted_producer_file_offset") for closure in closures]\n        != accepted_offsets\n        or any(closure.get("frontiers") != [] for closure in closures)\n    ):\n        raise ValueError("v11 source closure denominator changed")\n\n    target = payload.get("target")\n    expected_target_ranges = [\n        [0x0633C0, 0x0633D0],\n        [0x0633D0, 0x0633DE],\n        [0x0633DE, 0x0633E8],\n        [0x0633E8, 0x0633EE],\n        [0x0633EE, 0x0633F8],\n        [0x0633F8, 0x0633FE],\n    ]\n    expected_target_summary = {\n        "decoded_basic_block_count": 6,\n        "decoded_instruction_count": 30,\n        "external_call_edge_count": 1,\n        "external_call_edge_reasons": {"opaque_baseline_callee": 1},\n        "frontier_count": 0,\n        "reachable_instruction_bytes": 62,\n    }\n    expected_external_edge = {\n        "edge_kind": "call_target",\n        "reason": "opaque_baseline_callee",\n        "source": {"file_offset": 0x0633EA, "mode": "thumb"},\n        "source_file_offset": 0x0633EA,\n        "target_file_offset": 0x062788,\n        "target_mode": "thumb",\n    }\n    if (\n        not isinstance(target, dict)\n        or target.get("envelope") != [0x0633C0, 0x0633FE]\n        or target.get("envelope_size") != 62\n        or target.get("envelope_sha256")\n        != "bce5dad093cbcf2447728c50288b94fb47140fe452f6846f83b7224220dfb5cd"\n        or target.get("summary") != expected_target_summary\n        or target.get("code_ranges") != expected_target_ranges\n        or target.get("block_range_sha256")\n        != "4cdafc34a251971c6edec8d98dbf812042ccaab70e1ec3ee663976301a5a86c6"\n        or target.get("frontiers") != []\n        or target.get("external_edges") != [expected_external_edge]\n        or target.get("root")\n        != {\n            "entry_raw_hex": "30b5051c",\n            "entry_sha256": "df4b34ae82a0188510cc4ac861082202afc6dda014c718f38abd68912aebdf96",\n            "file_offset": 0x0633C0,\n            "mode": "thumb",\n        }\n        or target.get("return")\n        != {\n            "bx_file_offset": 0x0633FC,\n            "kind": "bx",\n            "mode": "thumb",\n            "prefix_hex": "01bc0047",\n            "prefix_range": [0x0633FA, 0x0633FE],\n            "prefix_sha256": "15a0c45072c4f43ac42d0c62cb597469cb73ae8294c056a31dc8415af2bc0d3c",\n        }\n    ):\n        raise ValueError("v11 target promotion denominator changed")\n\n    promotion = payload.get("promotion")\n    if promotion != {\n        "current_known_overlap_bytes": 0,\n        "envelope": [0x0633C0, 0x0633FE],\n        "envelope_sha256": "bce5dad093cbcf2447728c50288b94fb47140fe452f6846f83b7224220dfb5cd",\n        "promotion_bytes": 62,\n        "promotion_code_bytes": 62,\n        "promotion_literal_bytes": 0,\n    }:\n        raise ValueError("v11 promotion summary changed")\n\n    baseline_segments = atomize_claims(len(rom), baseline)\n    unknown_bytes = 0\n    known_bytes = 0\n    for segment in baseline_segments:\n        start, end = segment["range"]\n        overlap = max(0, min(end, 0x0633FE) - max(start, 0x0633C0))\n        if not overlap:\n            continue\n        if segment.get("primary_class") == "unknown":\n            unknown_bytes += overlap\n        else:\n            known_bytes += overlap\n    if unknown_bytes != 62 or known_bytes != 0:\n        raise ValueError(\n            "v11 promotion envelope is not fully current unknown: "\n            f"unknown={unknown_bytes}, overlap={known_bytes}"\n        )\n\n    unknown_ranges = [\n        tuple(segment["range"])\n        for segment in baseline_segments\n        if segment.get("primary_class") == "unknown"\n    ]\n    known_ranges = [\n        tuple(segment["range"])\n        for segment in baseline_segments\n        if segment.get("primary_class") != "unknown"\n    ]\n\n    def require_unknown(start: int, end: int) -> None:\n        if any(\n            start < known_end and known_start < end\n            for known_start, known_end in known_ranges\n        ):\n            raise ValueError("v11 claim overlaps current known bytes")\n        if not any(left <= start and end <= right for left, right in unknown_ranges):\n            raise ValueError("v11 claim is not fully current unknown")\n        if start < 0x0633C0 or end > 0x0633FE:\n            raise ValueError("v11 claim is outside the promotion envelope")\n\n    blocks = target.get("blocks")\n    if not isinstance(blocks, list) or len(blocks) != 6:\n        raise ValueError("v11 target block denominator changed")\n    nonclaims = [\n        "natural_execution_reachability",\n        "global_code_denominator",\n        "global_caller_denominator",\n        "global_indirect_target_denominator",\n        "excluded_0x080d7c_instruction_status",\n        "source_closure_reclassification",\n        "external_callee_semantics",\n        "adjacent_target_bytes",\n        "edit_relocation_or_free_space",\n    ]\n    limitations = [\n        "Only the six exact closed target blocks in [0x0633C0,0x0633FE) are classified.",\n        "Eight proved source closures and their producer instructions are evidence only and are not re-claimed.",\n        "The ninth raw match at 0x080D7C remains excluded-unproven-source and is not classified as an instruction.",\n        "Natural execution, global code/caller/indirect denominators, adjacent bytes, external semantics, and edit or relocation safety are not claimed.",\n    ]\n    evidence_path = (\n        CFG_PROVEN_ROOTS_V11_ARTIFACT / CFG_PROVEN_ROOTS_V11_PAYLOAD_NAME\n    ).as_posix()\n    manifest_evidence_path = (\n        CFG_PROVEN_ROOTS_V11_ARTIFACT / "manifest.json"\n    ).as_posix()\n    claims: list[dict[str, Any]] = []\n    for index, value in enumerate(CFG_PROVEN_ROOTS_V11_CODE_RANGES):\n        start, end = value\n        require_unknown(start, end)\n        block = next(\n            (candidate for candidate in blocks if candidate.get("range") == value),\n            None,\n        )\n        if (\n            not isinstance(block, dict)\n            or block.get("mode") != "thumb"\n            or block.get("id") != f"block-thumb-{start:06x}"\n            or block.get("bytes_sha256") != _sha256(rom[start:end])\n        ):\n            raise ValueError("v11 target code block identity changed")\n        claims.append(\n            {\n                "id": f"cfg-proven-roots-v11-thumb-{index:04d}-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": CFG_PROVEN_ROOTS_V11_CODE_CLASS,\n                "claim_kind": CFG_PROVEN_ROOTS_V11_CODE_KIND,\n                "mode": "thumb",\n                "source_block_count": 1,\n                "source_blocks": [{"block_id": block["id"], "range": value}],\n                "fixed_root_count": 1,\n                "raw_target_producer_count": 9,\n                "accepted_target_producer_count": 8,\n                "excluded_unproven_source_count": 1,\n                "excluded_unproven_source_file_offset": 0x080D7C,\n                "promoted_from_primary_class": "unknown",\n                "runtime_reachability_claimed": False,\n                "global_code_map_claimed": False,\n                "bytes_sha256": _sha256(rom[start:end]),\n                "evidence_path": evidence_path,\n                "evidence_sha256": CFG_PROVEN_ROOTS_V11_PAYLOAD_SHA256,\n                "evidence_selector": f"/target/code_ranges/{index}",\n                "promotion_manifest_path": manifest_evidence_path,\n                "promotion_manifest_sha256": CFG_PROVEN_ROOTS_V11_MANIFEST_SHA256,\n                "independent_verifier_path": CFG_PROVEN_ROOTS_V11_VERIFIER.as_posix(),\n                "independent_verifier_sha256": CFG_PROVEN_ROOTS_V11_VERIFIER_SHA256,\n                "promotion_batch": CFG_PROVEN_ROOTS_V11_BATCH,\n                "nonclaims": nonclaims,\n                "limitations": limitations,\n            }\n        )\n    if (\n        len(claims) != 6\n        or sum(claim["range"][1] - claim["range"][0] for claim in claims) != 62\n        or any(\n            start <= 0x080D7C < end or start <= 0x062788 < end\n            for start, end in (claim["range"] for claim in claims)\n        )\n    ):\n        raise ValueError("v11 promotion denominator changed")\n    return claims\n\n\ndef _run_cfg_proven_roots_v12_bundle_verifier(\n    root: Path,\n    wrapper_source: bytes,\n    wrapper_display_path: Path,\n) -> dict[str, Any]:\n    bootstrap = (\n        "import hashlib, sys\\n"\n        "source = sys.stdin.buffer.read()\\n"\n        "display = sys.argv[1]\\n"\n        "sys.argv = [display, *sys.argv[2:]]\\n"\n        "namespace = {\'__name__\': \'__main__\', \'__file__\': display, "\n        "\'__package__\': None, "\n        "\'__executing_source_sha256__\': hashlib.sha256(source).hexdigest()}\\n"\n        "exec(compile(source, display, \'exec\', dont_inherit=True, optimize=0), "\n        "namespace, namespace)\\n"\n    )\n    command = [\n        sys.executable,\n        "-I",\n        "-S",\n        "-c",\n        bootstrap,\n        wrapper_display_path.as_posix(),\n        "--root",\n        ".",\n        "--artifact-dir",\n        CFG_PROVEN_ROOTS_V12_ARTIFACT.as_posix(),\n    ]\n    completed = subprocess.run(\n        command,\n        cwd=root,\n        input=wrapper_source,\n        capture_output=True,\n        check=False,\n        timeout=300,\n    )\n    try:\n        stdout = completed.stdout.decode("utf-8")\n        stderr = completed.stderr.decode("utf-8")\n        report = json.loads(stdout)\n    except (UnicodeDecodeError, json.JSONDecodeError) as error:\n        raise ValueError("v12 isolated verifier output is not JSON") from error\n    if not isinstance(report, dict):\n        raise ValueError("v12 isolated verifier report is not an object")\n    if stderr:\n        raise ValueError("v12 isolated verifier emitted stderr")\n    if completed.returncode not in {0, 1}:\n        raise ValueError(\n            f"v12 isolated verifier exited unexpectedly: {completed.returncode}"\n        )\n    return report\n\n\ndef _cfg_proven_roots_v12_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote only the eight frozen v12 code/literal ranges from unknown."""\n\n    root = Path(root).resolve(strict=True)\n    baseline = list(existing_claims)\n    if any(\n        claim.get("promotion_batch") == CFG_PROVEN_ROOTS_V12_BATCH\n        or claim.get("claim_kind")\n        in {CFG_PROVEN_ROOTS_V12_CODE_KIND, CFG_PROVEN_ROOTS_V12_LITERAL_KIND}\n        for claim in baseline\n    ):\n        raise ValueError("v12 claims require a pre-v12 baseline; batch is already present")\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError("v12 ROM identity changed")\n\n    artifact = (root / CFG_PROVEN_ROOTS_V12_ARTIFACT).absolute()\n    try:\n        resolved_artifact = artifact.resolve(strict=True)\n        resolved_artifact.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError("v12 artifact is missing or outside the repository") from error\n    if resolved_artifact != artifact or not artifact.is_dir():\n        raise ValueError("v12 artifact uses a symlink or is not a directory")\n    members = list(artifact.iterdir())\n    if (\n        {member.name for member in members}\n        != {"manifest.json", CFG_PROVEN_ROOTS_V12_PAYLOAD_NAME}\n        or any(member.is_symlink() or not member.is_file() for member in members)\n    ):\n        raise ValueError("v12 artifact file set changed")\n\n    verifier = (root / CFG_PROVEN_ROOTS_V12_VERIFIER).absolute()\n    try:\n        resolved_verifier = verifier.resolve(strict=True)\n        resolved_verifier.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError("v12 verifier is missing or outside the repository") from error\n    if resolved_verifier != verifier or not verifier.is_file():\n        raise ValueError("v12 verifier uses a symlink or is not a file")\n    if _sha256_file(verifier) != CFG_PROVEN_ROOTS_V12_VERIFIER_SHA256:\n        raise ValueError("v12 verifier identity changed")\n\n    bundle_verifier = (root / CFG_PROVEN_ROOTS_V12_BUNDLE_VERIFIER).absolute()\n    try:\n        resolved_bundle_verifier = bundle_verifier.resolve(strict=True)\n        resolved_bundle_verifier.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError(\n            "v12 bundle verifier is missing or outside the repository"\n        ) from error\n    if resolved_bundle_verifier != bundle_verifier or not bundle_verifier.is_file():\n        raise ValueError("v12 bundle verifier uses a symlink or is not a file")\n    bundle_verifier_source = bundle_verifier.read_bytes()\n    if _sha256(bundle_verifier_source) != CFG_PROVEN_ROOTS_V12_BUNDLE_VERIFIER_SHA256:\n        raise ValueError("v12 bundle verifier identity changed")\n\n    manifest_path = artifact / "manifest.json"\n    payload_path = artifact / CFG_PROVEN_ROOTS_V12_PAYLOAD_NAME\n    manifest_raw = manifest_path.read_bytes()\n    payload_raw = payload_path.read_bytes()\n    if (\n        len(manifest_raw) != CFG_PROVEN_ROOTS_V12_MANIFEST_SIZE\n        or _sha256(manifest_raw) != CFG_PROVEN_ROOTS_V12_MANIFEST_SHA256\n        or len(payload_raw) != CFG_PROVEN_ROOTS_V12_PAYLOAD_SIZE\n        or _sha256(payload_raw) != CFG_PROVEN_ROOTS_V12_PAYLOAD_SHA256\n    ):\n        raise ValueError("v12 artifact identity changed")\n    try:\n        manifest = json.loads(manifest_raw)\n        payload = json.loads(payload_raw)\n    except json.JSONDecodeError as error:\n        raise ValueError("v12 artifact JSON is invalid") from error\n    if (\n        manifest_raw != _canonical_json_bytes(manifest)\n        or payload_raw != _canonical_json_bytes(payload)\n    ):\n        raise ValueError("v12 artifact JSON is not canonical")\n\n    report = _run_cfg_proven_roots_v12_bundle_verifier(\n        root,\n        bundle_verifier_source,\n        bundle_verifier,\n    )\n    if report != CFG_PROVEN_ROOTS_V12_BUNDLE_EXPECTED_REPORT:\n        raise ValueError(f"v12 independent verification failed: {report}")\n\n    expected_rom = {\n        "path": ROM_PATH.as_posix(),\n        "size": len(rom),\n        "sha256": ROM_SHA256,\n    }\n    expected_files = {\n        CFG_PROVEN_ROOTS_V12_PAYLOAD_NAME: {\n            "size": CFG_PROVEN_ROOTS_V12_PAYLOAD_SIZE,\n            "sha256": CFG_PROVEN_ROOTS_V12_PAYLOAD_SHA256,\n        }\n    }\n    mirrored_fields = (\n        "upstream",\n        "producer_denominator",\n        "source",\n        "target",\n        "promotion",\n        "implementation",\n        "scope",\n    )\n    if (\n        set(manifest) != CFG_PROVEN_ROOTS_V12_MANIFEST_KEYS\n        or manifest.get("schema") != "git-artifact-promotion-v1"\n        or manifest.get("artifact_schema") != "rom-cfg-proven-roots-v12"\n        or manifest.get("artifact_status") != "accepted"\n        or manifest.get("rom") != expected_rom\n        or manifest.get("files") != expected_files\n        or any(manifest.get(field) != payload.get(field) for field in mirrored_fields)\n        or manifest.get("coverage_baseline")\n        != CFG_PROVEN_ROOTS_V12_COVERAGE_BASELINE\n        or payload.get("coverage_baseline")\n        != CFG_PROVEN_ROOTS_V12_COVERAGE_BASELINE\n    ):\n        raise ValueError("v12 promotion manifest contract changed")\n    if (\n        payload.get("schema") != "rom-cfg-proven-roots-v12"\n        or payload.get("rom") != expected_rom\n        or payload.get("implementation", {}).get("verifier_sha256")\n        != CFG_PROVEN_ROOTS_V12_VERIFIER_SHA256\n    ):\n        raise ValueError("v12 payload contract changed")\n\n    verifier_receipt = manifest.get("verifier")\n    producer_receipt = manifest.get("producer")\n    if (\n        not isinstance(verifier_receipt, dict)\n        or verifier_receipt.get("schema")\n        != "rom-cfg-proven-roots-verification-v12"\n        or verifier_receipt.get("verifier_sha256")\n        != CFG_PROVEN_ROOTS_V12_VERIFIER_SHA256\n        or verifier_receipt.get("exit_code") != 0\n        or verifier_receipt.get("report") != CFG_PROVEN_ROOTS_V12_EXPECTED_REPORT\n        or verifier_receipt.get("command")\n        != [\n            "python3",\n            "-I",\n            "-S",\n            CFG_PROVEN_ROOTS_V12_VERIFIER.as_posix(),\n            "--root",\n            ".",\n            "--artifact-dir",\n            CFG_PROVEN_ROOTS_V12_ARTIFACT.as_posix(),\n        ]\n        or not isinstance(producer_receipt, dict)\n        or producer_receipt.get("implementation") != payload.get("implementation")\n        or producer_receipt.get("command")\n        != [\n            "python3",\n            "-I",\n            "-S",\n            "tools/export_rom_cfg_proven_roots_v12.py",\n            "--root",\n            ".",\n            "--output-dir",\n            CFG_PROVEN_ROOTS_V12_ARTIFACT.as_posix(),\n        ]\n    ):\n        raise ValueError("v12 accepted verifier receipt contract changed")\n\n    producer_raw = rom[0x061416:0x06141A]\n    expected_producer = {\n        "file_offset": 0x061416,\n        "gba_address": "0x08061416",\n        "raw_hex": "03f02ff8",\n        "bytes_sha256": _sha256(producer_raw),\n        "target_file_offset": 0x064478,\n        "target_gba_address": "0x08064478",\n        "kind": "thumb_bl",\n        "status": "accepted_source_producer",\n    }\n    expected_denominator = {\n        "scan": {\n            "mode": "thumb",\n            "alignment_bytes": 2,\n            "range": [0, 6_291_456],\n            "target_file_offsets": [0x064478],\n            "matching_producer_count": 1,\n        },\n        "producers": [expected_producer],\n        "thumb_bl": [expected_producer],\n        "thumb_bl_count": 1,\n        "thumb_b_count": 0,\n        "thumb_bcond_count": 0,\n        "arm_b_bl_count": 0,\n        "aligned_arm_pointer_count": 0,\n        "thumb_pointer_count": 0,\n        "vector_sha256": "ac560a89cc2f786d5af96493ef3676e4f3e87961661426f1d30c5c017210adfa",\n    }\n    if payload.get("producer_denominator") != expected_denominator:\n        raise ValueError("v12 raw producer denominator changed")\n\n    source = payload.get("source")\n    if (\n        not isinstance(source, dict)\n        or source.get("range") != [0x0612BC, 0x0614E4]\n        or source.get("size") != 552\n        or source.get("slice_sha256")\n        != "90568d99bb0ddfba74ce946781049494e117bd2273bd3b69843f7df420506817"\n        or source.get("root")\n        != {\n            "mode": "thumb",\n            "file_offset": 0x0612BC,\n            "entry_raw_hex": "30b52348",\n            "entry_sha256": "99904dcab479f7972fa6f37a6811077635d49a4b8f6743c737fff7126fbd8ecb",\n        }\n        or source.get("summary")\n        != {\n            "root_count": 1,\n            "decoded_instruction_count": 237,\n            "decoded_basic_block_count": 40,\n            "reachable_instruction_bytes": 508,\n            "frontier_count": 0,\n            "external_call_edge_count": 17,\n            "target_producer_edge_count": 1,\n            "opaque_boundary_edge_count": 1,\n        }\n        or source.get("frontiers") != []\n        or source.get("accepted_producer_file_offset") != 0x061416\n        or source.get("opaque_stop")\n        != {\n            "file_offset": 0x0614E4,\n            "coverage_claim_id": "verified-reuse-staged-oam-submit-code-0614e4",\n        }\n        or source.get("reachable_range_vector_sha256")\n        != "4bcf92e722093ef3fce0130a28d7708afc5572859e9cdfb671d47a17d4559624"\n        or source.get("packed_instruction_bytes_sha256")\n        != "45b2ec5ee53d3583d2e641ae5d1190045a541af0877462e2f509304f592fa158"\n        or source.get("semantic_instruction_vector_sha256")\n        != "bede899464bca87e2fde14ff8492eadf4735538963f3c3b8e5895552aec5e576"\n        or source.get("block_range_vector_sha256")\n        != "fb3c471b6695529759b6d18103ee733a1d0b0a9a97bd9a90f62449fbcb07b4f2"\n        or source.get("internal_edge_vector_sha256")\n        != "4135e4f261905b1532bf59e598ac65253bf2461e560d03d2930cf4a3ff30d1f3"\n        or source.get("external_call_vector_sha256")\n        != "79112a1b6ca9a9a02b82283f66ea8ddea7108d3ce200e83d05732d531e03fa8e"\n        or source.get("opaque_boundary_vector_sha256")\n        != "2e2cb02cca25a50a6f0dff30daaae54f9d15f4ffbd40875a0f14f6503d73d734"\n    ):\n        raise ValueError("v12 source closure denominator changed")\n\n    target = payload.get("target")\n    expected_promotion_ranges = sorted(\n        CFG_PROVEN_ROOTS_V12_CODE_RANGES + CFG_PROVEN_ROOTS_V12_LITERAL_RANGES\n    )\n    if (\n        not isinstance(target, dict)\n        or target.get("envelope") != [0x064478, 0x064670]\n        or target.get("envelope_bytes") != 504\n        or target.get("envelope_sha256")\n        != "0ea20a2118080d5a6255aad2e336d95a112937005a61a498f66bf6c120b8957b"\n        or target.get("root")\n        != {\n            "mode": "thumb",\n            "file_offset": 0x064478,\n            "entry_raw_hex": "f0b50006",\n            "entry_sha256": "a33efa7811bffe160f9df32f0892ac99fc8b5458585f096fd2b2359c1a9ac110",\n        }\n        or target.get("summary")\n        != {\n            "decoded_instruction_count": 182,\n            "decoded_basic_block_count": 35,\n            "reachable_instruction_bytes": 372,\n            "frontier_count": 0,\n            "internal_edge_count": 51,\n            "external_call_count": 4,\n            "literal_reference_count": 35,\n            "unique_literal_word_count": 32,\n            "literal_bytes": 128,\n            "promotion_range_count": 8,\n            "promotion_bytes": 500,\n            "hole_bytes": 4,\n        }\n        or target.get("code_ranges") != CFG_PROVEN_ROOTS_V12_CODE_RANGES\n        or target.get("literal_ranges") != CFG_PROVEN_ROOTS_V12_LITERAL_RANGES\n        or target.get("promotion_ranges") != expected_promotion_ranges\n        or target.get("holes") != CFG_PROVEN_ROOTS_V12_HOLES\n        or target.get("structured_return")\n        != {\n            "mode": "thumb",\n            "kind": "bx",\n            "bx_file_offset": 0x06462A,\n            "prefix_range": [0x064628, 0x06462C],\n            "prefix_raw_hex": "01bc0047",\n            "prefix_sha256": "15a0c45072c4f43ac42d0c62cb597469cb73ae8294c056a31dc8415af2bc0d3c",\n        }\n        or target.get("opaque_external_calls")\n        != [\n            [0x0644F2, 0x062510, "call_target"],\n            [0x06452C, 0x062510, "call_target"],\n            [0x064594, 0x0624C0, "call_target"],\n            [0x06459E, 0x09C0E0, "call_target"],\n        ]\n        or target.get("code_range_vector_sha256")\n        != "74f6d97e64d21ea8ff896f1a647ae7effc8a0d90ea0ae55215ff0bf5fa4ba5ce"\n        or target.get("literal_range_vector_sha256")\n        != "9dcc966d9f59ca424241e80638e31910bee375f38e73700cca15e9a25b8ab81c"\n        or target.get("promotion_range_vector_sha256")\n        != "b2b985dee623ffe0c5e3139112d2021bffd3ea0dbd32f8ad90c9fe91b14928cd"\n        or target.get("packed_code_sha256")\n        != "654c2b08bfcf87b16b9c3f211511f1646be306952bca9d220780d9bf374b1a84"\n        or target.get("packed_literals_sha256")\n        != "7e32235d7f70003fe683de30952b77ebe65b67b95766d44041c65b556de00d10"\n        or target.get("packed_promotion_sha256")\n        != "a8043f37679964db642c2d743812d5aab93a7193016d3ffd14d805b9105cf8e8"\n        or target.get("block_range_vector_sha256")\n        != "722fee7509dc5c3da7da974e3dd9854ef7dcef7390372307e141bab5b52a7419"\n        or target.get("internal_edge_vector_sha256")\n        != "339d10d1fd6e3016be13b2734479b27717bf55ac0b8e4cb4b23a0c14783ae076"\n        or target.get("external_call_vector_sha256")\n        != "8149f4918dd3a0548e3cfbd49803c76a71f0948e42dcc17205cfb835c68f8d62"\n        or target.get("semantic_instruction_vector_sha256")\n        != "ce073ae1c13d87e06d2d0d47ce8630662de14584d421e842c5ba85a63de35044"\n        or target.get("literal_binding_vector_sha256")\n        != "5ddad79a99fabe64eb491d42b4f2ec33731e069b7dae00295f5e6b7232338f73"\n    ):\n        raise ValueError("v12 target promotion denominator changed")\n\n    promotion = payload.get("promotion")\n    if promotion != {\n        "batch": CFG_PROVEN_ROOTS_V12_BATCH,\n        "ranges": expected_promotion_ranges,\n        "promotion_range_count": 8,\n        "promotion_bytes": 500,\n        "promotion_code_bytes": 372,\n        "promotion_literal_bytes": 128,\n        "hole_bytes": 4,\n        "unclassified_hole_bytes": 4,\n        "packed_sha256": "a8043f37679964db642c2d743812d5aab93a7193016d3ffd14d805b9105cf8e8",\n        "range_vector_sha256": "b2b985dee623ffe0c5e3139112d2021bffd3ea0dbd32f8ad90c9fe91b14928cd",\n    }:\n        raise ValueError("v12 promotion summary changed")\n\n    baseline_segments = atomize_claims(len(rom), baseline)\n    unknown_ranges = [\n        tuple(segment["range"])\n        for segment in baseline_segments\n        if segment.get("primary_class") == "unknown"\n    ]\n    known_ranges = [\n        tuple(segment["range"])\n        for segment in baseline_segments\n        if segment.get("primary_class") != "unknown"\n    ]\n    envelope_unknown = sum(\n        max(0, min(end, 0x064670) - max(start, 0x064478))\n        for start, end in unknown_ranges\n    )\n    envelope_known = sum(\n        max(0, min(end, 0x064670) - max(start, 0x064478))\n        for start, end in known_ranges\n    )\n    if envelope_unknown != 504 or envelope_known != 0:\n        raise ValueError(\n            "v12 promotion envelope is not fully current unknown: "\n            f"unknown={envelope_unknown}, overlap={envelope_known}"\n        )\n\n    def require_unknown(start: int, end: int) -> None:\n        if any(\n            start < known_end and known_start < end\n            for known_start, known_end in known_ranges\n        ):\n            raise ValueError("v12 claim overlaps current known bytes")\n        if not any(left <= start and end <= right for left, right in unknown_ranges):\n            raise ValueError("v12 claim is not fully current unknown")\n        if start < 0x064478 or end > 0x064670:\n            raise ValueError("v12 claim is outside the promotion envelope")\n\n    nonclaims = [\n        "natural_execution_or_runtime_reachability",\n        "global_code_caller_or_producer_denominator",\n        "global_indirect_computed_or_ram_target_denominator",\n        "opaque_callee_code_abi_or_semantics",\n        "literal_business_meaning",\n        "two_hole_padding_nop_reserved_free_or_allocatable_status",\n        "editing_writeback_relocation_or_gameplay_behavior",\n    ]\n    limitations = [\n        "Only four closed Thumb code ranges and four consumed literal ranges inside [0x064478,0x064670) are classified.",\n        "The accepted source closure and producer instruction are evidence only and are not re-claimed.",\n        "The two two-byte holes [0x0644C2,0x0644C4) and [0x06450A,0x06450C) remain unknown.",\n        "Opaque callees, natural execution, global denominators, adjacent bytes, editing, relocation and free-space safety are not claimed.",\n    ]\n    evidence_path = (\n        CFG_PROVEN_ROOTS_V12_ARTIFACT / CFG_PROVEN_ROOTS_V12_PAYLOAD_NAME\n    ).as_posix()\n    manifest_evidence_path = (\n        CFG_PROVEN_ROOTS_V12_ARTIFACT / "manifest.json"\n    ).as_posix()\n    claims: list[dict[str, Any]] = []\n    for index, value in enumerate(CFG_PROVEN_ROOTS_V12_CODE_RANGES):\n        start, end = value\n        require_unknown(start, end)\n        claims.append(\n            {\n                "id": f"cfg-proven-roots-v12-thumb-{index:04d}-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": CFG_PROVEN_ROOTS_V12_CODE_CLASS,\n                "claim_kind": CFG_PROVEN_ROOTS_V12_CODE_KIND,\n                "mode": "thumb",\n                "fixed_root_count": 1,\n                "raw_target_producer_count": 1,\n                "accepted_target_producer_count": 1,\n                "source_block_count": sum(\n                    block.get("range", [0, 0])[0] >= start\n                    and block.get("range", [0, 0])[1] <= end\n                    for block in target.get("blocks", [])\n                ),\n                "promoted_from_primary_class": "unknown",\n                "runtime_reachability_claimed": False,\n                "global_code_map_claimed": False,\n                "bytes_sha256": _sha256(rom[start:end]),\n                "evidence_path": evidence_path,\n                "evidence_sha256": CFG_PROVEN_ROOTS_V12_PAYLOAD_SHA256,\n                "evidence_selector": f"/target/code_ranges/{index}",\n                "promotion_manifest_path": manifest_evidence_path,\n                "promotion_manifest_sha256": CFG_PROVEN_ROOTS_V12_MANIFEST_SHA256,\n                "independent_verifier_path": (\n                    CFG_PROVEN_ROOTS_V12_BUNDLE_VERIFIER.as_posix()\n                ),\n                "independent_verifier_sha256": (\n                    CFG_PROVEN_ROOTS_V12_BUNDLE_VERIFIER_SHA256\n                ),\n                "promotion_batch": CFG_PROVEN_ROOTS_V12_BATCH,\n                "nonclaims": nonclaims,\n                "limitations": limitations,\n            }\n        )\n    bindings = target.get("literal_projection", {}).get("bindings", [])\n    for index, value in enumerate(CFG_PROVEN_ROOTS_V12_LITERAL_RANGES):\n        start, end = value\n        require_unknown(start, end)\n        claims.append(\n            {\n                "id": f"cfg-proven-roots-v12-literal-{index:04d}-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": CFG_PROVEN_ROOTS_V12_LITERAL_CLASS,\n                "claim_kind": CFG_PROVEN_ROOTS_V12_LITERAL_KIND,\n                "literal_reference_count": sum(\n                    start <= binding[1] < end for binding in bindings\n                ),\n                "promoted_from_primary_class": "unknown",\n                "runtime_reachability_claimed": False,\n                "global_code_map_claimed": False,\n                "bytes_sha256": _sha256(rom[start:end]),\n                "evidence_path": evidence_path,\n                "evidence_sha256": CFG_PROVEN_ROOTS_V12_PAYLOAD_SHA256,\n                "evidence_selector": f"/target/literal_ranges/{index}",\n                "promotion_manifest_path": manifest_evidence_path,\n                "promotion_manifest_sha256": CFG_PROVEN_ROOTS_V12_MANIFEST_SHA256,\n                "independent_verifier_path": (\n                    CFG_PROVEN_ROOTS_V12_BUNDLE_VERIFIER.as_posix()\n                ),\n                "independent_verifier_sha256": (\n                    CFG_PROVEN_ROOTS_V12_BUNDLE_VERIFIER_SHA256\n                ),\n                "promotion_batch": CFG_PROVEN_ROOTS_V12_BATCH,\n                "nonclaims": nonclaims,\n                "limitations": limitations,\n            }\n        )\n    claims.sort(key=lambda claim: claim["range"])\n    if (\n        len(claims) != 8\n        or [claim["range"] for claim in claims] != expected_promotion_ranges\n        or sum(claim["range"][1] - claim["range"][0] for claim in claims) != 500\n        or any(\n            start < hole_end and hole_start < end\n            for start, end in (claim["range"] for claim in claims)\n            for hole_start, hole_end in CFG_PROVEN_ROOTS_V12_HOLES\n        )\n    ):\n        raise ValueError("v12 promotion denominator changed")\n    return claims\n\n\ndef _run_cfg_proven_roots_v13_bundle_verifier(\n    root: Path,\n    wrapper_source: bytes,\n    wrapper_display_path: Path,\n) -> dict[str, Any]:\n    bootstrap = (\n        "import hashlib, sys\\n"\n        "source = sys.stdin.buffer.read()\\n"\n        "display = sys.argv[1]\\n"\n        "sys.argv = [display, *sys.argv[2:]]\\n"\n        "namespace = {\'__name__\': \'__main__\', \'__file__\': display, "\n        "\'__package__\': None, "\n        "\'__executing_source_sha256__\': hashlib.sha256(source).hexdigest()}\\n"\n        "exec(compile(source, display, \'exec\', dont_inherit=True, optimize=0), "\n        "namespace, namespace)\\n"\n    )\n    command = [\n        sys.executable,\n        "-I",\n        "-S",\n        "-c",\n        bootstrap,\n        wrapper_display_path.as_posix(),\n        "--root",\n        ".",\n        "--artifact-dir",\n        CFG_PROVEN_ROOTS_V13_ARTIFACT.as_posix(),\n    ]\n    completed = subprocess.run(\n        command,\n        cwd=root,\n        input=wrapper_source,\n        capture_output=True,\n        check=False,\n        timeout=300,\n    )\n    try:\n        stdout = completed.stdout.decode("utf-8")\n        stderr = completed.stderr.decode("utf-8")\n        report = json.loads(stdout)\n    except (UnicodeDecodeError, json.JSONDecodeError) as error:\n        raise ValueError("v13 isolated verifier output is not JSON") from error\n    if not isinstance(report, dict):\n        raise ValueError("v13 isolated verifier report is not an object")\n    if stderr:\n        raise ValueError("v13 isolated verifier emitted stderr")\n    if completed.returncode not in {0, 1}:\n        raise ValueError(\n            f"v13 isolated verifier exited unexpectedly: {completed.returncode}"\n        )\n    return report\n\n\ndef _cfg_proven_roots_v13_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote only the six frozen v13 code/literal ranges from unknown."""\n\n    root = Path(root).resolve(strict=True)\n    baseline = list(existing_claims)\n    if any(\n        claim.get("promotion_batch") == CFG_PROVEN_ROOTS_V13_BATCH\n        or claim.get("claim_kind")\n        in {CFG_PROVEN_ROOTS_V13_CODE_KIND, CFG_PROVEN_ROOTS_V13_LITERAL_KIND}\n        for claim in baseline\n    ):\n        raise ValueError("v13 claims require a pre-v13 baseline; batch is already present")\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError("v13 ROM identity changed")\n\n    artifact = (root / CFG_PROVEN_ROOTS_V13_ARTIFACT).absolute()\n    try:\n        resolved_artifact = artifact.resolve(strict=True)\n        resolved_artifact.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError("v13 artifact is missing or outside the repository") from error\n    if resolved_artifact != artifact or not artifact.is_dir():\n        raise ValueError("v13 artifact uses a symlink or is not a directory")\n    members = list(artifact.iterdir())\n    if (\n        {member.name for member in members}\n        != {"manifest.json", CFG_PROVEN_ROOTS_V13_PAYLOAD_NAME}\n        or any(member.is_symlink() or not member.is_file() for member in members)\n    ):\n        raise ValueError("v13 artifact file set changed")\n\n    verifier = (root / CFG_PROVEN_ROOTS_V13_VERIFIER).absolute()\n    try:\n        resolved_verifier = verifier.resolve(strict=True)\n        resolved_verifier.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError("v13 verifier is missing or outside the repository") from error\n    if resolved_verifier != verifier or not verifier.is_file():\n        raise ValueError("v13 verifier uses a symlink or is not a file")\n    if _sha256_file(verifier) != CFG_PROVEN_ROOTS_V13_VERIFIER_SHA256:\n        raise ValueError("v13 verifier identity changed")\n\n    bundle_verifier = (root / CFG_PROVEN_ROOTS_V13_BUNDLE_VERIFIER).absolute()\n    try:\n        resolved_bundle_verifier = bundle_verifier.resolve(strict=True)\n        resolved_bundle_verifier.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError(\n            "v13 bundle verifier is missing or outside the repository"\n        ) from error\n    if resolved_bundle_verifier != bundle_verifier or not bundle_verifier.is_file():\n        raise ValueError("v13 bundle verifier uses a symlink or is not a file")\n    bundle_verifier_source = bundle_verifier.read_bytes()\n    if _sha256(bundle_verifier_source) != CFG_PROVEN_ROOTS_V13_BUNDLE_VERIFIER_SHA256:\n        raise ValueError("v13 bundle verifier identity changed")\n\n    manifest_path = artifact / "manifest.json"\n    payload_path = artifact / CFG_PROVEN_ROOTS_V13_PAYLOAD_NAME\n    manifest_raw = manifest_path.read_bytes()\n    payload_raw = payload_path.read_bytes()\n    if (\n        len(manifest_raw) != CFG_PROVEN_ROOTS_V13_MANIFEST_SIZE\n        or _sha256(manifest_raw) != CFG_PROVEN_ROOTS_V13_MANIFEST_SHA256\n        or len(payload_raw) != CFG_PROVEN_ROOTS_V13_PAYLOAD_SIZE\n        or _sha256(payload_raw) != CFG_PROVEN_ROOTS_V13_PAYLOAD_SHA256\n    ):\n        raise ValueError("v13 artifact identity changed")\n    try:\n        manifest = json.loads(manifest_raw)\n        payload = json.loads(payload_raw)\n    except json.JSONDecodeError as error:\n        raise ValueError("v13 artifact JSON is invalid") from error\n    if (\n        manifest_raw != _canonical_json_bytes(manifest)\n        or payload_raw != _canonical_json_bytes(payload)\n    ):\n        raise ValueError("v13 artifact JSON is not canonical")\n\n    report = _run_cfg_proven_roots_v13_bundle_verifier(\n        root,\n        bundle_verifier_source,\n        bundle_verifier,\n    )\n    if report != CFG_PROVEN_ROOTS_V13_BUNDLE_EXPECTED_REPORT:\n        raise ValueError(f"v13 independent verification failed: {report}")\n\n    expected_rom = {\n        "path": ROM_PATH.as_posix(),\n        "size": len(rom),\n        "sha256": ROM_SHA256,\n    }\n    expected_files = {\n        CFG_PROVEN_ROOTS_V13_PAYLOAD_NAME: {\n            "size": CFG_PROVEN_ROOTS_V13_PAYLOAD_SIZE,\n            "sha256": CFG_PROVEN_ROOTS_V13_PAYLOAD_SHA256,\n        }\n    }\n    mirrored_fields = (\n        "upstream",\n        "producer_denominator",\n        "source",\n        "target",\n        "promotion",\n        "implementation",\n        "scope",\n    )\n    if (\n        set(manifest) != CFG_PROVEN_ROOTS_V13_MANIFEST_KEYS\n        or manifest.get("schema") != "git-artifact-promotion-v1"\n        or manifest.get("artifact_schema") != "rom-cfg-proven-roots-v13"\n        or manifest.get("artifact_status") != "accepted"\n        or manifest.get("rom") != expected_rom\n        or manifest.get("files") != expected_files\n        or any(manifest.get(field) != payload.get(field) for field in mirrored_fields)\n        or manifest.get("coverage_baseline")\n        != CFG_PROVEN_ROOTS_V13_COVERAGE_BASELINE\n        or payload.get("coverage_baseline")\n        != CFG_PROVEN_ROOTS_V13_COVERAGE_BASELINE\n    ):\n        raise ValueError("v13 promotion manifest contract changed")\n    if (\n        payload.get("schema") != "rom-cfg-proven-roots-v13"\n        or payload.get("rom") != expected_rom\n        or payload.get("implementation", {}).get("verifier_sha256")\n        != CFG_PROVEN_ROOTS_V13_VERIFIER_SHA256\n    ):\n        raise ValueError("v13 payload contract changed")\n\n    verifier_receipt = manifest.get("verifier")\n    producer_receipt = manifest.get("producer")\n    if (\n        not isinstance(verifier_receipt, dict)\n        or verifier_receipt.get("schema")\n        != "rom-cfg-proven-roots-verification-v13"\n        or verifier_receipt.get("verifier_sha256")\n        != CFG_PROVEN_ROOTS_V13_VERIFIER_SHA256\n        or verifier_receipt.get("exit_code") != 0\n        or verifier_receipt.get("report") != CFG_PROVEN_ROOTS_V13_EXPECTED_REPORT\n        or verifier_receipt.get("command")\n        != [\n            "python3",\n            "-I",\n            "-S",\n            CFG_PROVEN_ROOTS_V13_VERIFIER.as_posix(),\n            "--root",\n            ".",\n            "--artifact-dir",\n            CFG_PROVEN_ROOTS_V13_ARTIFACT.as_posix(),\n        ]\n        or not isinstance(producer_receipt, dict)\n        or producer_receipt.get("implementation") != payload.get("implementation")\n        or producer_receipt.get("command")\n        != [\n            "python3",\n            "-I",\n            "-S",\n            "tools/export_rom_cfg_proven_roots_v13.py",\n            "--root",\n            ".",\n            "--output-dir",\n            CFG_PROVEN_ROOTS_V13_ARTIFACT.as_posix(),\n        ]\n    ):\n        raise ValueError("v13 accepted verifier receipt contract changed")\n\n    producer_raw = rom[0x0614D0:0x0614D4]\n    expected_producer = {\n        "file_offset": 0x0614D0,\n        "gba_address": "0x080614D0",\n        "raw_hex": "03f092fe",\n        "bytes_sha256": _sha256(producer_raw),\n        "target_file_offset": 0x0651F8,\n        "target_gba_address": "0x080651F8",\n        "kind": "thumb_bl",\n        "status": "accepted_source_producer",\n    }\n    expected_denominator = {\n        "aligned_arm_pointer_count": 0,\n        "aligned_arm_pointers": [],\n        "arm_b_bl": [],\n        "arm_b_bl_count": 0,\n        "producer_raw_hex": "03f092fe",\n        "producer_sha256": _sha256(producer_raw),\n        "producers": [expected_producer],\n        "scan": {\n            "alignment_bytes": 2,\n            "matching_producer_count": 1,\n            "mode": "thumb",\n            "range": [0, 6_291_456],\n            "target_file_offsets": [0x0651F8],\n        },\n        "thumb_b": [],\n        "thumb_b_count": 0,\n        "thumb_bcond": [],\n        "thumb_bcond_count": 0,\n        "thumb_bl": [expected_producer],\n        "thumb_bl_count": 1,\n        "thumb_pointer_count": 0,\n        "thumb_pointers": [],\n        "vector": [[0x0614D0, 0x0651F8, "thumb_bl"]],\n        "vector_sha256": (\n            "4c0df27279aa18befd77dbc2c4a4a2997dce603548c2d97879d517aa857d681f"\n        ),\n    }\n    if payload.get("producer_denominator") != expected_denominator:\n        raise ValueError("v13 raw producer denominator changed")\n\n    source = payload.get("source")\n    expected_source_fields = {\n        "range": [0x0612BC, 0x0614E4],\n        "size": 552,\n        "slice_sha256": (\n            "90568d99bb0ddfba74ce946781049494e117bd2273bd3b69843f7df420506817"\n        ),\n        "root": {\n            "entry_raw_hex": "30b52348",\n            "entry_sha256": (\n                "99904dcab479f7972fa6f37a6811077635d49a4b8f6743c737fff7126fbd8ecb"\n            ),\n            "file_offset": 0x0612BC,\n            "mode": "thumb",\n        },\n        "summary": {\n            "decoded_basic_block_count": 40,\n            "decoded_instruction_count": 237,\n            "external_call_edge_count": 17,\n            "frontier_count": 0,\n            "instruction_internal_edge_count": 251,\n            "opaque_boundary_edge_count": 1,\n            "reachable_instruction_bytes": 508,\n            "root_count": 1,\n            "target_producer_edge_count": 1,\n        },\n        "frontiers": [],\n        "accepted_producer_file_offset": 0x0614D0,\n        "opaque_stop": {\n            "coverage_claim_id": "verified-reuse-staged-oam-submit-code-0614e4",\n            "file_offset": 0x0614E4,\n        },\n        "reachable_range_vector_sha256": (\n            "4bcf92e722093ef3fce0130a28d7708afc5572859e9cdfb671d47a17d4559624"\n        ),\n        "packed_instruction_bytes_sha256": (\n            "45b2ec5ee53d3583d2e641ae5d1190045a541af0877462e2f509304f592fa158"\n        ),\n        "semantic_instruction_vector_sha256": (\n            "bede899464bca87e2fde14ff8492eadf4735538963f3c3b8e5895552aec5e576"\n        ),\n        "block_range_vector_sha256": (\n            "fb3c471b6695529759b6d18103ee733a1d0b0a9a97bd9a90f62449fbcb07b4f2"\n        ),\n        "internal_edge_vector_sha256": (\n            "4135e4f261905b1532bf59e598ac65253bf2461e560d03d2930cf4a3ff30d1f3"\n        ),\n        "external_call_vector_sha256": (\n            "f41f0b5d1826f3c8d18a70e2c0959f31052b0a76a7d07b9ba38ffa0de8a3d48d"\n        ),\n        "opaque_boundary_vector_sha256": (\n            "2e2cb02cca25a50a6f0dff30daaae54f9d15f4ffbd40875a0f14f6503d73d734"\n        ),\n    }\n    if not isinstance(source, dict) or any(\n        source.get(key) != value for key, value in expected_source_fields.items()\n    ):\n        raise ValueError("v13 source closure denominator changed")\n\n    target = payload.get("target")\n    expected_promotion_ranges = sorted(\n        CFG_PROVEN_ROOTS_V13_CODE_RANGES + CFG_PROVEN_ROOTS_V13_LITERAL_RANGES\n    )\n    expected_target_fields = {\n        "envelope": [0x0651F8, 0x065384],\n        "envelope_bytes": 396,\n        "envelope_sha256": (\n            "838fd74b07984a3a692f3fb66e72f1b4d6d7c7c5ad791934c3827ca7e968b10e"\n        ),\n        "root": {\n            "entry_raw_hex": "f0b54746",\n            "entry_sha256": (\n                "3e7ec2098933d96de8dc658d119ed3848ccdd7942f96f2a0d015f1e68e3c759b"\n            ),\n            "file_offset": 0x0651F8,\n            "mode": "thumb",\n        },\n        "summary": {\n            "block_internal_edge_count": 36,\n            "decoded_basic_block_count": 25,\n            "decoded_instruction_count": 153,\n            "external_call_edge_count": 3,\n            "frontier_count": 1,\n            "hole_bytes": 4,\n            "instruction_internal_edge_count": 164,\n            "literal_bytes": 80,\n            "literal_reference_count": 21,\n            "promotion_bytes": 392,\n            "promotion_range_count": 6,\n            "reachable_instruction_bytes": 312,\n            "unique_literal_word_count": 20,\n        },\n        "code_ranges": CFG_PROVEN_ROOTS_V13_CODE_RANGES,\n        "literal_ranges": CFG_PROVEN_ROOTS_V13_LITERAL_RANGES,\n        "promotion_ranges": expected_promotion_ranges,\n        "holes": CFG_PROVEN_ROOTS_V13_HOLE_RECORDS,\n        "frontiers": [[0x065368, "indirect_pc_target"]],\n        "structured_return": None,\n        "opaque_external_calls": [\n            [0x065234, 0x0624C0, "call_target"],\n            [0x065258, 0x062510, "call_target"],\n            [0x065344, 0x09C0DC, "call_target"],\n        ],\n        "code_range_vector_sha256": (\n            "1eb89efbb94cb9f1a7ecbcfad992dfeb3ff49c84f918d52b715a87f25fcd89f4"\n        ),\n        "literal_range_vector_sha256": (\n            "f34a55f4703f8b17f969d13aa02fd9aa1b1d1264a52ca8267dbd688ee6658f88"\n        ),\n        "promotion_range_vector_sha256": (\n            "09f8682f0e4bab0db4108820c4034abf45e345e05f9e7bd9c4111cc2054114c0"\n        ),\n        "packed_code_sha256": (\n            "c0fd79364221d43e831d33b5266bad1bc2fefe9249c10313ce06d812bd712bcb"\n        ),\n        "packed_literals_sha256": (\n            "3ad57b1bb869ecd47546e6f220201414fc68c0727742cee023e8feb640e59546"\n        ),\n        "packed_promotion_sha256": (\n            "d7449f4feb51fa169d011c0692d2009090633aa8cf7968064bd36063be491e40"\n        ),\n        "block_range_vector_sha256": (\n            "fae253e64395d30da0ed5988fdaa2f553dd4ac0216de710d543b03e8b57b200e"\n        ),\n        "instruction_internal_edge_vector_sha256": (\n            "27ae4a890679ccafeb65a38f512757c35faf18fe4dd8540581c073468b4eb1d4"\n        ),\n        "block_internal_edge_vector_sha256": (\n            "d71a01f074ed0b403748e311425936768ec5df8ae4971b614e66766c7c685681"\n        ),\n        "external_call_vector_sha256": (\n            "6d9235d9594d1a1124aaef710d1d29f4b2c8edc4f0f56699bc6c0d10561983aa"\n        ),\n        "frontier_vector_sha256": (\n            "76d3c99e0143cccffef136d057794fe0863bb4e775b880b7d632515547b992b8"\n        ),\n        "semantic_instruction_vector_sha256": (\n            "4fe44f3fb076b347b7d641a02a01cd9978880414253ad0664f6c7a870bab449f"\n        ),\n        "literal_binding_vector_sha256": (\n            "4eac0d84e979e591c789d522c21df22d06a8274817d0ca9943c45ea6a2f7ee84"\n        ),\n    }\n    if not isinstance(target, dict) or any(\n        target.get(key) != value for key, value in expected_target_fields.items()\n    ):\n        raise ValueError("v13 target promotion denominator changed")\n    terminal_nodes = [\n        node\n        for node in target.get("nodes", [])\n        if node.get("file_offset") == 0x065368\n    ]\n    if len(terminal_nodes) != 1 or any(\n        terminal_nodes[0].get(key) != value\n        for key, value in {\n            "accepted": True,\n            "conditional": False,\n            "flow_kind": "indirect_branch",\n            "frontiers": [{"reason": "indirect_pc_target"}],\n            "mnemonic": "bx",\n            "mode": "thumb",\n            "op_str": "r0",\n            "size": 2,\n            "successors": [],\n        }.items()\n    ):\n        raise ValueError("v13 bx r0 frontier contract changed")\n\n    promotion = payload.get("promotion")\n    if promotion != {\n        "batch": CFG_PROVEN_ROOTS_V13_BATCH,\n        "hole_bytes": 4,\n        "packed_sha256": (\n            "d7449f4feb51fa169d011c0692d2009090633aa8cf7968064bd36063be491e40"\n        ),\n        "promotion_bytes": 392,\n        "promotion_code_bytes": 312,\n        "promotion_literal_bytes": 80,\n        "promotion_range_count": 6,\n        "range_vector_sha256": (\n            "09f8682f0e4bab0db4108820c4034abf45e345e05f9e7bd9c4111cc2054114c0"\n        ),\n        "ranges": expected_promotion_ranges,\n        "unclassified_hole_bytes": 4,\n    }:\n        raise ValueError("v13 promotion summary changed")\n\n    baseline_segments = atomize_claims(len(rom), baseline)\n    unknown_ranges = [\n        tuple(segment["range"])\n        for segment in baseline_segments\n        if segment.get("primary_class") == "unknown"\n    ]\n    known_ranges = [\n        tuple(segment["range"])\n        for segment in baseline_segments\n        if segment.get("primary_class") != "unknown"\n    ]\n    envelope_unknown = sum(\n        max(0, min(end, 0x065384) - max(start, 0x0651F8))\n        for start, end in unknown_ranges\n    )\n    envelope_known = sum(\n        max(0, min(end, 0x065384) - max(start, 0x0651F8))\n        for start, end in known_ranges\n    )\n    if envelope_unknown != 396 or envelope_known != 0:\n        raise ValueError(\n            "v13 promotion envelope is not fully current unknown: "\n            f"unknown={envelope_unknown}, overlap={envelope_known}"\n        )\n\n    def require_unknown(start: int, end: int) -> None:\n        if any(\n            start < known_end and known_start < end\n            for known_start, known_end in known_ranges\n        ):\n            raise ValueError("v13 claim overlaps current known bytes")\n        if not any(left <= start and end <= right for left, right in unknown_ranges):\n            raise ValueError("v13 claim is not fully current unknown")\n        if start < 0x0651F8 or end > 0x065384:\n            raise ValueError("v13 claim is outside the promotion envelope")\n\n    nonclaims = [\n        "natural_execution_or_runtime_reachability",\n        "global_code_caller_or_producer_denominator",\n        "global_indirect_computed_or_ram_target_denominator",\n        "bx_r0_indirect_target_or_runtime_dispatch_denominator",\n        "opaque_callee_code_abi_or_semantics",\n        "literal_business_meaning",\n        "two_hole_padding_nop_reserved_free_or_allocatable_status",\n        "editing_writeback_relocation_or_gameplay_behavior",\n    ]\n    limitations = [\n        "Only three closed Thumb code ranges and three consumed literal ranges inside [0x0651F8,0x065384) are classified.",\n        "The accepted source closure and producer instruction are evidence only and are not re-claimed.",\n        "The bx r0 instruction at 0x065368 remains one explicit unresolved indirect-PC frontier and is not a structured return claim.",\n        "The two two-byte holes [0x0652DE,0x0652E0) and [0x06536A,0x06536C) remain unknown.",\n        "Opaque callees, natural execution, global denominators, adjacent bytes, editing, relocation and free-space safety are not claimed.",\n    ]\n    evidence_path = (\n        CFG_PROVEN_ROOTS_V13_ARTIFACT / CFG_PROVEN_ROOTS_V13_PAYLOAD_NAME\n    ).as_posix()\n    manifest_evidence_path = (\n        CFG_PROVEN_ROOTS_V13_ARTIFACT / "manifest.json"\n    ).as_posix()\n    claims: list[dict[str, Any]] = []\n    for index, value in enumerate(CFG_PROVEN_ROOTS_V13_CODE_RANGES):\n        start, end = value\n        require_unknown(start, end)\n        claims.append(\n            {\n                "id": f"cfg-proven-roots-v13-thumb-{index:04d}-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": CFG_PROVEN_ROOTS_V13_CODE_CLASS,\n                "claim_kind": CFG_PROVEN_ROOTS_V13_CODE_KIND,\n                "mode": "thumb",\n                "fixed_root_count": 1,\n                "raw_target_producer_count": 1,\n                "accepted_target_producer_count": 1,\n                "source_block_count": sum(\n                    block.get("range", [0, 0])[0] >= start\n                    and block.get("range", [0, 0])[1] <= end\n                    for block in target.get("blocks", [])\n                ),\n                "promoted_from_primary_class": "unknown",\n                "runtime_reachability_claimed": False,\n                "global_code_map_claimed": False,\n                "bytes_sha256": _sha256(rom[start:end]),\n                "evidence_path": evidence_path,\n                "evidence_sha256": CFG_PROVEN_ROOTS_V13_PAYLOAD_SHA256,\n                "evidence_selector": f"/target/code_ranges/{index}",\n                "promotion_manifest_path": manifest_evidence_path,\n                "promotion_manifest_sha256": CFG_PROVEN_ROOTS_V13_MANIFEST_SHA256,\n                "independent_verifier_path": (\n                    CFG_PROVEN_ROOTS_V13_BUNDLE_VERIFIER.as_posix()\n                ),\n                "independent_verifier_sha256": (\n                    CFG_PROVEN_ROOTS_V13_BUNDLE_VERIFIER_SHA256\n                ),\n                "promotion_batch": CFG_PROVEN_ROOTS_V13_BATCH,\n                "nonclaims": nonclaims,\n                "limitations": limitations,\n            }\n        )\n    bindings = target.get("literal_projection", {}).get("bindings", [])\n    for index, value in enumerate(CFG_PROVEN_ROOTS_V13_LITERAL_RANGES):\n        start, end = value\n        require_unknown(start, end)\n        claims.append(\n            {\n                "id": f"cfg-proven-roots-v13-literal-{index:04d}-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": CFG_PROVEN_ROOTS_V13_LITERAL_CLASS,\n                "claim_kind": CFG_PROVEN_ROOTS_V13_LITERAL_KIND,\n                "literal_reference_count": sum(\n                    start <= binding[1] < end for binding in bindings\n                ),\n                "promoted_from_primary_class": "unknown",\n                "runtime_reachability_claimed": False,\n                "global_code_map_claimed": False,\n                "bytes_sha256": _sha256(rom[start:end]),\n                "evidence_path": evidence_path,\n                "evidence_sha256": CFG_PROVEN_ROOTS_V13_PAYLOAD_SHA256,\n                "evidence_selector": f"/target/literal_ranges/{index}",\n                "promotion_manifest_path": manifest_evidence_path,\n                "promotion_manifest_sha256": CFG_PROVEN_ROOTS_V13_MANIFEST_SHA256,\n                "independent_verifier_path": (\n                    CFG_PROVEN_ROOTS_V13_BUNDLE_VERIFIER.as_posix()\n                ),\n                "independent_verifier_sha256": (\n                    CFG_PROVEN_ROOTS_V13_BUNDLE_VERIFIER_SHA256\n                ),\n                "promotion_batch": CFG_PROVEN_ROOTS_V13_BATCH,\n                "nonclaims": nonclaims,\n                "limitations": limitations,\n            }\n        )\n    claims.sort(key=lambda claim: claim["range"])\n    if (\n        len(claims) != 6\n        or [claim["range"] for claim in claims] != expected_promotion_ranges\n        or sum(claim["range"][1] - claim["range"][0] for claim in claims) != 392\n        or any(\n            start < hole_end and hole_start < end\n            for start, end in (claim["range"] for claim in claims)\n            for hole_start, hole_end in CFG_PROVEN_ROOTS_V13_HOLES\n        )\n    ):\n        raise ValueError("v13 promotion denominator changed")\n    return claims\n\n\ndef _run_cfg_proven_roots_v14_bundle_verifier(\n    root: Path,\n    wrapper_source: bytes,\n    wrapper_display_path: Path,\n) -> dict[str, Any]:\n    bootstrap = (\n        "import hashlib, sys\\n"\n        "source = sys.stdin.buffer.read()\\n"\n        "display = sys.argv[1]\\n"\n        "sys.argv = [display, *sys.argv[2:]]\\n"\n        "namespace = {\'__name__\': \'__main__\', \'__file__\': display, "\n        "\'__package__\': None, "\n        "\'__executing_source_sha256__\': hashlib.sha256(source).hexdigest()}\\n"\n        "exec(compile(source, display, \'exec\', dont_inherit=True, optimize=0), "\n        "namespace, namespace)\\n"\n    )\n    command = [\n        sys.executable,\n        "-I",\n        "-S",\n        "-c",\n        bootstrap,\n        wrapper_display_path.as_posix(),\n        "--root",\n        ".",\n        "--artifact-dir",\n        CFG_PROVEN_ROOTS_V14_ARTIFACT.as_posix(),\n    ]\n    completed = subprocess.run(\n        command,\n        cwd=root,\n        input=wrapper_source,\n        capture_output=True,\n        check=False,\n        timeout=300,\n    )\n    try:\n        stdout = completed.stdout.decode("utf-8")\n        stderr = completed.stderr.decode("utf-8")\n        report = json.loads(stdout)\n    except (UnicodeDecodeError, json.JSONDecodeError) as error:\n        raise ValueError("v14 isolated verifier output is not JSON") from error\n    if not isinstance(report, dict):\n        raise ValueError("v14 isolated verifier report is not an object")\n    if stderr:\n        raise ValueError("v14 isolated verifier emitted stderr")\n    if completed.returncode not in {0, 1}:\n        raise ValueError(\n            f"v14 isolated verifier exited unexpectedly: {completed.returncode}"\n        )\n    return report\n\n\ndef _cfg_proven_roots_v14_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote only the four frozen v14 code/literal ranges from unknown."""\n\n    root = Path(root).resolve(strict=True)\n    baseline = list(existing_claims)\n    if any(\n        claim.get("promotion_batch") == CFG_PROVEN_ROOTS_V14_BATCH\n        or claim.get("claim_kind")\n        in {CFG_PROVEN_ROOTS_V14_CODE_KIND, CFG_PROVEN_ROOTS_V14_LITERAL_KIND}\n        for claim in baseline\n    ):\n        raise ValueError("v14 claims require a pre-v14 baseline; batch is already present")\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError("v14 ROM identity changed")\n\n    artifact = _checked_artifact_directory(\n        root,\n        CFG_PROVEN_ROOTS_V14_ARTIFACT,\n        {"manifest.json", CFG_PROVEN_ROOTS_V14_PAYLOAD_NAME},\n        label="v14 artifact",\n    )\n    verifier = _checked_repository_file(\n        root,\n        CFG_PROVEN_ROOTS_V14_VERIFIER,\n        CFG_PROVEN_ROOTS_V14_VERIFIER_SHA256,\n        label="v14 verifier",\n    )\n    bundle_verifier = _checked_repository_file(\n        root,\n        CFG_PROVEN_ROOTS_V14_BUNDLE_VERIFIER,\n        CFG_PROVEN_ROOTS_V14_BUNDLE_VERIFIER_SHA256,\n        label="v14 bundle verifier",\n    )\n    bundle_verifier_source = bundle_verifier.read_bytes()\n    manifest_raw = (artifact / "manifest.json").read_bytes()\n    payload_raw = (artifact / CFG_PROVEN_ROOTS_V14_PAYLOAD_NAME).read_bytes()\n    if (\n        len(manifest_raw) != CFG_PROVEN_ROOTS_V14_MANIFEST_SIZE\n        or _sha256(manifest_raw) != CFG_PROVEN_ROOTS_V14_MANIFEST_SHA256\n        or len(payload_raw) != CFG_PROVEN_ROOTS_V14_PAYLOAD_SIZE\n        or _sha256(payload_raw) != CFG_PROVEN_ROOTS_V14_PAYLOAD_SHA256\n    ):\n        raise ValueError("v14 artifact identity changed")\n    try:\n        manifest = json.loads(manifest_raw)\n        payload = json.loads(payload_raw)\n    except json.JSONDecodeError as error:\n        raise ValueError("v14 artifact JSON is invalid") from error\n    if (\n        manifest_raw != _canonical_json_bytes(manifest)\n        or payload_raw != _canonical_json_bytes(payload)\n    ):\n        raise ValueError("v14 artifact JSON is not canonical")\n\n    report = _run_cfg_proven_roots_v14_bundle_verifier(\n        root,\n        bundle_verifier_source,\n        bundle_verifier,\n    )\n    if report != CFG_PROVEN_ROOTS_V14_BUNDLE_EXPECTED_REPORT:\n        raise ValueError(f"v14 independent verification failed: {report}")\n\n    expected_rom = {\n        "path": ROM_PATH.as_posix(),\n        "size": len(rom),\n        "sha256": ROM_SHA256,\n    }\n    expected_files = {\n        CFG_PROVEN_ROOTS_V14_PAYLOAD_NAME: {\n            "size": CFG_PROVEN_ROOTS_V14_PAYLOAD_SIZE,\n            "sha256": CFG_PROVEN_ROOTS_V14_PAYLOAD_SHA256,\n        }\n    }\n    mirrored_fields = (\n        "upstream",\n        "targets",\n        "promotion",\n        "implementation",\n        "scope",\n    )\n    if (\n        set(manifest) != CFG_PROVEN_ROOTS_V14_MANIFEST_KEYS\n        or manifest.get("schema") != "git-artifact-promotion-v1"\n        or manifest.get("artifact_schema") != "rom-cfg-proven-roots-v14"\n        or manifest.get("artifact_status") != "accepted"\n        or manifest.get("rom") != expected_rom\n        or manifest.get("files") != expected_files\n        or any(manifest.get(field) != payload.get(field) for field in mirrored_fields)\n        or manifest.get("coverage_baseline")\n        != CFG_PROVEN_ROOTS_V14_COVERAGE_BASELINE\n        or payload.get("coverage_baseline")\n        != CFG_PROVEN_ROOTS_V14_COVER