       )\n    except Exception as error:\n        raise ValueError(\n            f"{spec[\'label\']} independent verification failed: {error}"\n        ) from error\n    expected_candidate_identity = {\n        "artifact_status": "candidate",\n        "bundle_sha256": spec["binary_sha256"],\n        "manifest_sha256": spec["candidate_manifest_sha256"],\n        "payload_sha256": spec["payload_sha256"],\n    }\n    if report != {\n        "verified": True,\n        "artifact_status": "accepted",\n        "contract_ok": True,\n        "bundle_sha256": spec["binary_sha256"],\n        "candidate_identity": expected_candidate_identity,\n    }:\n        raise ValueError(\n            f"{spec[\'label\']} independent verification identity changed: {report}"\n        )\n\n    manifest_raw = manifest_path.read_bytes()\n    payload_raw = payload_path.read_bytes()\n    try:\n        manifest = json.loads(manifest_raw)\n        payload = json.loads(payload_raw)\n    except (UnicodeDecodeError, json.JSONDecodeError) as error:\n        raise ValueError(f"{spec[\'label\']} artifact JSON is invalid") from error\n    if (\n        manifest_raw != _canonical_json_bytes(manifest)\n        or payload_raw != _canonical_json_bytes(payload)\n    ):\n        raise ValueError(f"{spec[\'label\']} artifact JSON is not canonical")\n\n    expected_manifest = {\n        "acceptance": {\n            "kind": "independent-candidate-acceptance",\n            "output_artifact": spec["artifact"].as_posix(),\n            "source_candidate_artifact": spec["candidate_path"],\n            "source_candidate_identity": expected_candidate_identity,\n        },\n        "artifact_schema": spec["batch"],\n        "artifact_status": "accepted",\n        "contract_sha256": spec["contract_sha256"],\n        "files": {\n            spec["binary_name"]: {\n                "sha256": spec["binary_sha256"],\n                "size": spec["binary_size"],\n            },\n            spec["payload_name"]: {\n                "sha256": spec["payload_sha256"],\n                "size": spec["payload_size"],\n            },\n        },\n        "schema": "git-artifact-promotion-v1",\n        "verification": {\n            "bundle_sha256": spec["binary_sha256"],\n            "contract_ok": True,\n            "payload_sha256": spec["payload_sha256"],\n            "schema": spec["verifier_schema"],\n            "status": "verified",\n        },\n        "verifier": {\n            "path": spec["verifier"].as_posix(),\n            "sha256": spec["verifier_sha256"],\n        },\n    }\n    if manifest != expected_manifest:\n        raise ValueError(f"{spec[\'label\']} accepted manifest semantics changed")\n\n    expected_rows = [\n        {\n            "bytes": end - start,\n            "kind": kind,\n            "range": [start, end],\n            "sha256": bytes_sha256,\n        }\n        for _identifier, (start, end), kind, bytes_sha256 in claim_specs\n    ]\n    expected_excluded = [\n        {\n            "promoted": False,\n            "range": [start, end],\n            "raw_hex": "00" * (end - start),\n            "semantic_class": "unknown",\n            "sha256": _sha256(rom[start:end]),\n        }\n        for start, end in spec["excluded_ranges"]\n    ]\n    expected_baseline = {\n        "immutable_artifact": {\n            "archive_sha256": CGB_AUDIO_PRE_COVERAGE_ARCHIVE_SHA256,\n            "manifest_sha256": CGB_AUDIO_PRE_COVERAGE_MANIFEST_SHA256,\n            "path": CGB_AUDIO_PRE_COVERAGE_ARTIFACT.as_posix(),\n        },\n        "path": "sequel/rom-byte-coverage.json",\n        "sha256": CGB_AUDIO_PRE_COVERAGE_RAW_SHA256,\n        "size": CGB_AUDIO_PRE_COVERAGE_RAW_SIZE,\n        "summary": CGB_AUDIO_PRE_COVERAGE_SUMMARY,\n    }\n    expected_promotion = {\n        "claim_count": len(expected_rows),\n        "code_bytes": spec["code_bytes"],\n        "literal_bytes": spec["literal_bytes"],\n        "packed_bytes_sha256": spec["binary_sha256"],\n        "range_vector_sha256": spec["range_vector_sha256"],\n        "ranges": expected_rows,\n        "total_bytes": spec["binary_size"],\n    }\n    if (\n        payload.get("schema") != spec["batch"]\n        or payload.get("rom")\n        != {"path": ROM_PATH.as_posix(), "sha256": ROM_SHA256, "size": len(rom)}\n        or payload.get("coverage_baseline") != expected_baseline\n        or payload.get("coverage_baseline_source")\n        != {"artifact": CGB_AUDIO_PRE_COVERAGE_ARTIFACT.as_posix()}\n        or payload.get("coverage_projection") != spec["coverage_projection"]\n        or payload.get("promotion") != expected_promotion\n        or payload.get("promotion_ranges") != expected_rows\n        or payload.get("excluded_ranges") != expected_excluded\n        or payload.get("scope") != spec["scope"]\n    ):\n        raise ValueError(f"{spec[\'label\']} payload semantic denominator changed")\n\n    ranges = [row["range"] for row in expected_rows]\n    range_vector = json.dumps(ranges, separators=(",", ":")).encode("ascii")\n    packed = b"".join(rom[start:end] for start, end in ranges)\n    if (\n        _sha256(range_vector) != spec["range_vector_sha256"]\n        or binary_path.read_bytes() != packed\n        or len(packed) != spec["binary_size"]\n        or _sha256(packed) != spec["binary_sha256"]\n    ):\n        raise ValueError(f"{spec[\'label\']} packed promotion identity changed")\n\n    previous_end = -1\n    for identifier, (start, end), kind, bytes_sha256 in claim_specs:\n        if start < previous_end or _sha256(rom[start:end]) != bytes_sha256:\n            raise ValueError(f"{spec[\'label\']} ROM promotion row changed: {identifier}")\n        previous_end = end\n        if kind.endswith("thumb_code"):\n            expected_id = f"{identifier.split(\'-code-\')[0]}-code-{start:06x}"\n        else:\n            expected_id = f"{identifier.split(\'-literal-\')[0]}-literal-{start:06x}"\n        if identifier != expected_id:\n            raise ValueError(f"{spec[\'label\']} stable claim id changed: {identifier}")\n        if any(\n            other_start < end and start < other_end\n            for other in primary\n            for other_start, other_end in [_validated_range(other, len(rom))]\n        ):\n            raise ValueError(\n                f"{spec[\'label\']} promotion range is not current unknown; "\n                f"baseline overlap found: {identifier}"\n            )\n    for start, end in spec["excluded_ranges"]:\n        if rom[start:end] != b"\\x00" * (end - start):\n            raise ValueError(f"{spec[\'label\']} excluded range bytes changed")\n        if any(\n            other_start < end and start < other_end\n            for other in primary\n            for other_start, other_end in [_validated_range(other, len(rom))]\n        ):\n            raise ValueError(\n                f"{spec[\'label\']} excluded range is not current unknown; "\n                "baseline overlap found"\n            )\n\n    non_claims = {\n        key: value for key, value in spec["scope"].items() if value is False\n    }\n    claims: list[dict[str, Any]] = []\n    packed_offset = 0\n    for index, (identifier, (start, end), kind, bytes_sha256) in enumerate(\n        claim_specs\n    ):\n        size = end - start\n        claims.append(\n            {\n                "id": identifier,\n                "range": [start, end],\n                "gba_range": [0x08000000 + start, 0x08000000 + end],\n                "role": "primary",\n                "primary_class": kind,\n                "claim_kind": kind,\n                "mode": "thumb" if kind.endswith("thumb_code") else None,\n                "promotion_batch": spec["batch"],\n                "promoted_from_primary_class": "unknown",\n                "baseline_unknown_only": True,\n                "artifact_range_id": identifier,\n                "bytes_sha256": bytes_sha256,\n                "packed_range": [packed_offset, packed_offset + size],\n                "packed_bytes_sha256": spec["binary_sha256"],\n                "range_vector_sha256": spec["range_vector_sha256"],\n                "promotion_contract_sha256": spec["contract_sha256"],\n                "promotion_manifest_path": (\n                    spec["artifact"] / "manifest.json"\n                ).as_posix(),\n                "promotion_manifest_sha256": spec["manifest_sha256"],\n                "evidence_path": (\n                    spec["artifact"] / spec["payload_name"]\n                ).as_posix(),\n                "evidence_sha256": spec["payload_sha256"],\n                "evidence_selector": f"/promotion_ranges/{index}",\n                "independent_verifier_path": spec["verifier"].as_posix(),\n                "independent_verifier_sha256": spec["verifier_sha256"],\n                "upstream_exporter_path": spec["exporter"].as_posix(),\n                "upstream_exporter_sha256": spec["exporter_sha256"],\n                "upstream_exporter_test_path": spec[\n                    "exporter_test"\n                ].as_posix(),\n                "upstream_exporter_test_sha256": spec[\n                    "exporter_test_sha256"\n                ],\n                "upstream_verifier_test_path": spec[\n                    "verifier_test"\n                ].as_posix(),\n                "upstream_verifier_test_sha256": spec[\n                    "verifier_test_sha256"\n                ],\n                "immutable_precoverage_artifact": (\n                    CGB_AUDIO_PRE_COVERAGE_ARTIFACT.as_posix()\n                ),\n                "immutable_precoverage_sha256": CGB_AUDIO_PRE_COVERAGE_RAW_SHA256,\n                "non_claims": non_claims,\n                **non_claims,\n                "limitations": [spec["limitation"]],\n            }\n        )\n        packed_offset += size\n    return claims\n\n\ndef _cgb_helper_bounded_cfg_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    return _bounded_cgb_cfg_claims(\n        root,\n        rom,\n        existing_claims,\n        contract_label="helper",\n        verifier=verify_rom_cgb_helper_bounded_cfg,\n    )\n\n\ndef _cgbsound_bounded_cfg_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    return _bounded_cgb_cfg_claims(\n        root,\n        rom,\n        existing_claims,\n        contract_label="cgbsound",\n        verifier=verify_rom_cgbsound_bounded_cfg,\n    )\n\n\ndef _artifact_bound_alignment_gap_claims_impl(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n    *,\n    historical_only: bool,\n) -> list[dict[str, Any]]:\n    """Verify the full denominator and add either historical four or all missing gaps."""\n\n    root = Path(root).resolve(strict=True)\n    baseline = list(existing_claims)\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError("artifact-bound alignment-gap ROM identity changed")\n\n    if not (\n        ARTIFACT_BOUND_ALIGNMENT_GAP_BATCH\n        == "rom-artifact-bound-alignment-gaps-v1"\n        and ARTIFACT_BOUND_ALIGNMENT_GAP_PRIMARY_CLASS\n        == "artifact_bound_4byte_alignment_bytes"\n        and ARTIFACT_BOUND_ALIGNMENT_GAP_CLAIM_KIND\n        == "artifact_bound_alignment_gap_bytes"\n        and len(ARTIFACT_BOUND_ALIGNMENT_GAP_RANGES) == 13\n        and len(ARTIFACT_BOUND_ALIGNMENT_GAP_IDS) == 13\n        and len(ARTIFACT_BOUND_ALIGNMENT_GAP_BOUNDARY_IDS) == 13\n        and len(ARTIFACT_BOUND_ALIGNMENT_GAP_LEFT_OWNER_IDS) == 13\n        and len(ARTIFACT_BOUND_ALIGNMENT_GAP_RIGHT_OWNER_IDS) == 13\n        and len(ARTIFACT_BOUND_ALIGNMENT_GAP_RIGHT_KINDS) == 13\n    ):\n        raise ValueError("artifact-bound alignment-gap contract changed")\n\n    for configured, literal, expected_sha256, label in (\n        (\n            ARTIFACT_BOUND_ALIGNMENT_GAP_VERIFIER,\n            Path("tools/verify_rom_artifact_bound_alignment_gaps.py"),\n            ARTIFACT_BOUND_ALIGNMENT_GAP_VERIFIER_SHA256,\n            "artifact-bound alignment-gap verifier",\n        ),\n        (\n            ARTIFACT_BOUND_ALIGNMENT_GAP_TEST,\n            Path("tests/test_verify_rom_artifact_bound_alignment_gaps.py"),\n            ARTIFACT_BOUND_ALIGNMENT_GAP_TEST_SHA256,\n            "artifact-bound alignment-gap verifier test",\n        ),\n    ):\n        if configured != literal:\n            raise ValueError(f"{label} canonical path changed")\n        _checked_repository_file(root, configured, expected_sha256, label=label)\n\n    identifiers = [claim.get("id") for claim in baseline]\n    if any(not isinstance(identifier, str) or not identifier for identifier in identifiers):\n        raise ValueError("artifact-bound alignment-gap baseline has an invalid id")\n    if len(set(identifiers)) != len(identifiers):\n        raise ValueError("artifact-bound alignment-gap baseline ids are not unique")\n    for claim in baseline:\n        if not isinstance(claim, dict) or claim.get("role") not in {\n            "primary",\n            "secondary",\n        }:\n            raise ValueError("artifact-bound alignment-gap baseline role is invalid")\n        _validated_range(claim, len(rom))\n\n    gap_like = [\n        claim\n        for claim in baseline\n        if claim.get("promotion_batch") == ARTIFACT_BOUND_ALIGNMENT_GAP_BATCH\n        or claim.get("claim_kind") == ARTIFACT_BOUND_ALIGNMENT_GAP_CLAIM_KIND\n        or claim.get("id") in ARTIFACT_BOUND_ALIGNMENT_GAP_IDS\n    ]\n    historical_ids = set(ARTIFACT_BOUND_ALIGNMENT_GAP_IDS[:4])\n    if historical_only:\n        if gap_like:\n            raise ValueError(\n                "artifact-bound alignment-gap claims require a pre-promotion "\n                "baseline; batch is already present"\n            )\n        target_indices = tuple(range(4))\n    else:\n        existing_ids = {claim.get("id") for claim in gap_like}\n        if gap_like and (\n            len(gap_like) != 4 or existing_ids != historical_ids\n        ):\n            raise ValueError(\n                "artifact-bound alignment-gap claims require either an empty "\n                "or exact historical-four baseline; batch is already present"\n            )\n        target_indices = tuple(range(4, 13)) if gap_like else tuple(range(13))\n\n    try:\n        report = verify_rom_artifact_bound_alignment_gaps(root)\n    except Exception as error:\n        raise ValueError(\n            f"artifact-bound alignment-gap independent verification failed: {error}"\n        ) from error\n    if not isinstance(report, dict):\n        raise ValueError(\n            "artifact-bound alignment-gap independent verification changed"\n        )\n    report_sha256 = _sha256(\n        json.dumps(\n            report,\n            ensure_ascii=True,\n            separators=(",", ":"),\n            sort_keys=True,\n        ).encode("ascii")\n    )\n    expected_non_claims = {\n        key: False for key in ARTIFACT_BOUND_ALIGNMENT_GAP_NON_CLAIM_KEYS\n    }\n    gaps = report.get("gaps")\n    if (\n        report.get("schema")\n        != "rom-artifact-bound-alignment-gaps-verification-v1"\n        or report.get("verified") is not True\n        or report.get("errors") != []\n        or report_sha256 != ARTIFACT_BOUND_ALIGNMENT_GAP_REPORT_SHA256\n        or report.get("rom_sha256") != ROM_SHA256\n        or report.get("promotion_batch") != ARTIFACT_BOUND_ALIGNMENT_GAP_BATCH\n        or report.get("primary_class")\n        != ARTIFACT_BOUND_ALIGNMENT_GAP_PRIMARY_CLASS\n        or report.get("claim_kind") != ARTIFACT_BOUND_ALIGNMENT_GAP_CLAIM_KIND\n        or report.get("gap_count") != 13\n        or report.get("byte_count") != 26\n        or report.get("zero_byte_count") != 26\n        or report.get("ranges")\n        != [list(pair) for pair in ARTIFACT_BOUND_ALIGNMENT_GAP_RANGES]\n        or report.get("range_vector_sha256")\n        != ARTIFACT_BOUND_ALIGNMENT_GAP_RANGE_VECTOR_SHA256\n        or report.get("boundary_vector_sha256")\n        != ARTIFACT_BOUND_ALIGNMENT_GAP_BOUNDARY_VECTOR_SHA256\n        or report.get("claim_denominator_sha256")\n        != ARTIFACT_BOUND_ALIGNMENT_GAP_CLAIM_DENOMINATOR_SHA256\n        or report.get("source_file_vector_sha256")\n        != ARTIFACT_BOUND_ALIGNMENT_GAP_SOURCE_FILE_VECTOR_SHA256\n        or report.get("packed_bytes_sha256")\n        != ARTIFACT_BOUND_ALIGNMENT_GAP_PACKED_BYTES_SHA256\n        or report.get("right_kind_counts")\n        != {"consumed_literal_range": 12, "owned_thumb_function": 1}\n        or report.get("source_artifact_count") != 4\n        or report.get("all_alignment_equations_hold") is not True\n        or report.get("all_boundaries_exact") is not True\n        or report.get("non_claims") != expected_non_claims\n        or any(report.get(key) is not False for key in expected_non_claims)\n        or not isinstance(gaps, list)\n        or len(gaps) != 13\n    ):\n        raise ValueError(\n            "artifact-bound alignment-gap independent verification changed"\n        )\n\n    packed = b"".join(\n        rom[start:end] for start, end in ARTIFACT_BOUND_ALIGNMENT_GAP_RANGES\n    )\n    if (\n        packed != b"\\x00" * 26\n        or _sha256(packed) != ARTIFACT_BOUND_ALIGNMENT_GAP_PACKED_BYTES_SHA256\n    ):\n        raise ValueError("artifact-bound alignment-gap byte denominator changed")\n\n    owner_specs = {\n        owner_id: (owner_range, primary_class, claim_kind, bytes_sha256)\n        for owner_id, owner_range, primary_class, claim_kind, bytes_sha256 in (\n            ARTIFACT_BOUND_ALIGNMENT_GAP_OWNER_SPECS\n        )\n    }\n    owner_by_id = {claim["id"]: claim for claim in baseline}\n    required_indices = tuple(range(4)) if historical_only else tuple(range(13))\n    required_owner_ids = {\n        owner_id\n        for index in required_indices\n        for owner_id in (\n            ARTIFACT_BOUND_ALIGNMENT_GAP_LEFT_OWNER_IDS[index],\n            ARTIFACT_BOUND_ALIGNMENT_GAP_RIGHT_OWNER_IDS[index],\n        )\n    }\n    for owner_id in required_owner_ids:\n        owner_spec = owner_specs.get(owner_id)\n        owner = owner_by_id.get(owner_id)\n        if owner_spec is None:\n            raise ValueError(\n                f"artifact-bound alignment-gap owner contract missing: {owner_id}"\n            )\n        owner_range, primary_class, claim_kind, bytes_sha256 = owner_spec\n        expected = {\n            "range": list(owner_range),\n            "role": "primary",\n            "primary_class": primary_class,\n            "claim_kind": claim_kind,\n            "bytes_sha256": bytes_sha256,\n        }\n        if not isinstance(owner, dict) or any(\n            owner.get(key) != value for key, value in expected.items()\n        ):\n            raise ValueError(\n                f"artifact-bound alignment-gap owner identity changed: {owner_id}"\n            )\n        if _sha256(rom[slice(*owner_range)]) != bytes_sha256:\n            raise ValueError(\n                f"artifact-bound alignment-gap owner ROM identity changed: {owner_id}"\n            )\n\n    def build_claim(index: int) -> dict[str, Any]:\n        identifier = ARTIFACT_BOUND_ALIGNMENT_GAP_IDS[index]\n        boundary_id = ARTIFACT_BOUND_ALIGNMENT_GAP_BOUNDARY_IDS[index]\n        start, end = ARTIFACT_BOUND_ALIGNMENT_GAP_RANGES[index]\n        left_owner_id = ARTIFACT_BOUND_ALIGNMENT_GAP_LEFT_OWNER_IDS[index]\n        right_owner_id = ARTIFACT_BOUND_ALIGNMENT_GAP_RIGHT_OWNER_IDS[index]\n        right_kind = ARTIFACT_BOUND_ALIGNMENT_GAP_RIGHT_KINDS[index]\n        row = gaps[index]\n        left_owner = owner_by_id[left_owner_id]\n        right_owner = owner_by_id[right_owner_id]\n        if (\n            not isinstance(row, dict)\n            or row.get("id") != boundary_id\n            or row.get("gap_range") != [start, end]\n            or row.get("gap_size") != 2\n            or row.get("gap_raw_hex") != "0000"\n            or row.get("gap_sha256")\n            != ARTIFACT_BOUND_ALIGNMENT_GAP_BYTES_SHA256\n            or row.get("left_source_id") != left_owner_id\n            or row.get("left_owner_range") != left_owner["range"]\n            or row.get("right_range") != right_owner["range"]\n            or row.get("right_kind") != right_kind\n            or row.get("right_source_id") != right_owner_id\n            or row.get("gap_start_equals_left_owner_end") is not True\n            or row.get("gap_end_equals_align4_left_end") is not True\n            or row.get("right_start_equals_gap_end") is not True\n            or left_owner["range"][1] != start\n            or right_owner["range"][0] != end\n        ):\n            raise ValueError(\n                f"artifact-bound alignment-gap boundary changed: {boundary_id}"\n            )\n        return {\n            "id": identifier,\n            "range": [start, end],\n            "gba_range": [0x08000000 + start, 0x08000000 + end],\n            "role": "primary",\n            "primary_class": ARTIFACT_BOUND_ALIGNMENT_GAP_PRIMARY_CLASS,\n            "claim_kind": ARTIFACT_BOUND_ALIGNMENT_GAP_CLAIM_KIND,\n            "promotion_batch": ARTIFACT_BOUND_ALIGNMENT_GAP_BATCH,\n            "promoted_from_primary_class": "unknown",\n            "baseline_unknown_only": True,\n            "resource_id": index,\n            "boundary_id": boundary_id,\n            "bytes_sha256": ARTIFACT_BOUND_ALIGNMENT_GAP_BYTES_SHA256,\n            "packed_range": [index * 2, index * 2 + 2],\n            "packed_bytes_sha256": (\n                ARTIFACT_BOUND_ALIGNMENT_GAP_PACKED_BYTES_SHA256\n            ),\n            "range_vector_sha256": (\n                ARTIFACT_BOUND_ALIGNMENT_GAP_RANGE_VECTOR_SHA256\n            ),\n            "boundary_vector_sha256": (\n                ARTIFACT_BOUND_ALIGNMENT_GAP_BOUNDARY_VECTOR_SHA256\n            ),\n            "claim_denominator_sha256": (\n                ARTIFACT_BOUND_ALIGNMENT_GAP_CLAIM_DENOMINATOR_SHA256\n            ),\n            "source_file_vector_sha256": (\n                ARTIFACT_BOUND_ALIGNMENT_GAP_SOURCE_FILE_VECTOR_SHA256\n            ),\n            "all_zero": True,\n            "zero_byte_count": 2,\n            "alignment_bytes": 4,\n            "alignment_target": end,\n            "alignment_formula": (\n                f"(0x{start:06X} + 3) & ~3 == 0x{end:06X}"\n            ),\n            "alignment_formula_expression": "(left_end + 3) & ~3",\n            "alignment_gap_bytes": 2,\n            "alignment_gap_is_exact": True,\n            "left_terminal": row["left_terminal"],\n            "previous_owner_id": left_owner_id,\n            "previous_owner_range": left_owner["range"],\n            "previous_owner_role": left_owner["role"],\n            "previous_owner_primary_class": left_owner["primary_class"],\n            "previous_owner_claim_kind": left_owner["claim_kind"],\n            "previous_owner_bytes_sha256": left_owner["bytes_sha256"],\n            "next_owner_id": right_owner_id,\n            "next_owner_range": right_owner["range"],\n            "next_owner_role": right_owner["role"],\n            "next_owner_primary_class": right_owner["primary_class"],\n            "next_owner_claim_kind": right_owner["claim_kind"],\n            "next_owner_bytes_sha256": right_owner["bytes_sha256"],\n            "right_structure_kind": right_kind,\n            "source_artifact_schema": row["source_artifact_schema"],\n            "evidence_path": ARTIFACT_BOUND_ALIGNMENT_GAP_VERIFIER.as_posix(),\n            "evidence_sha256": ARTIFACT_BOUND_ALIGNMENT_GAP_VERIFIER_SHA256,\n            "evidence_selector": f"/gaps/{index}",\n            "independent_verifier_path": (\n                ARTIFACT_BOUND_ALIGNMENT_GAP_VERIFIER.as_posix()\n            ),\n            "independent_verifier_sha256": (\n                ARTIFACT_BOUND_ALIGNMENT_GAP_VERIFIER_SHA256\n            ),\n            "upstream_test_path": ARTIFACT_BOUND_ALIGNMENT_GAP_TEST.as_posix(),\n            "upstream_test_sha256": ARTIFACT_BOUND_ALIGNMENT_GAP_TEST_SHA256,\n            "independent_verifier_report_sha256": (\n                ARTIFACT_BOUND_ALIGNMENT_GAP_REPORT_SHA256\n            ),\n            "non_claims": expected_non_claims,\n            **expected_non_claims,\n            "limitations": [ARTIFACT_BOUND_ALIGNMENT_GAP_COVERAGE_LIMITATION],\n        }\n\n    if gap_like:\n        for index in range(4):\n            existing = owner_by_id.get(ARTIFACT_BOUND_ALIGNMENT_GAP_IDS[index])\n            if existing != build_claim(index):\n                raise ValueError(\n                    "artifact-bound alignment-gap historical claim identity changed"\n                )\n\n    for index in target_indices:\n        gap_start, gap_end = ARTIFACT_BOUND_ALIGNMENT_GAP_RANGES[index]\n        for claim in baseline:\n            claim_start, claim_end = claim["range"]\n            if claim_start < gap_end and gap_start < claim_end:\n                raise ValueError(\n                    "artifact-bound alignment-gap range is not current unknown; "\n                    "baseline overlap found"\n                )\n    return [build_claim(index) for index in target_indices]\n\n\ndef _historical_artifact_bound_alignment_gap_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Restore the four gap claims present in the bounded-artifact baseline."""\n\n    return _artifact_bound_alignment_gap_claims_impl(\n        root,\n        rom,\n        existing_claims,\n        historical_only=True,\n    )\n\n\ndef _artifact_bound_alignment_gap_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Add all missing claims from the independently verified 13-gap denominator."""\n\n    return _artifact_bound_alignment_gap_claims_impl(\n        root,\n        rom,\n        existing_claims,\n        historical_only=False,\n    )\n\n\ndef _renderer_text_padding_claims(root: Path, rom: bytes) -> list[dict[str, Any]]:\n    verifier = root / RENDERER_TEXT_PADDING_VERIFIER\n    if _sha256_file(verifier) != RENDERER_TEXT_PADDING_VERIFIER_SHA256:\n        raise ValueError("renderer text padding verifier changed")\n    report = rebuild_renderer_text_padding(root, rom)\n    if (\n        report.get("verified") is not True\n        or report.get("errors") != []\n        or report.get("padding_range_count") != 548\n        or report.get("padding_bytes") != 12_431\n        or report.get("zero_byte_count") != 12_431\n    ):\n        raise ValueError(f"renderer text padding verification failed: {report}")\n    claims = []\n    for index, item in enumerate(report["ranges"]):\n        start, end = item["range"]\n        claims.append({\n            "id": f"renderer-text-zero-padding-{index:04d}-{start:06x}",\n            "range": [start,end], "role": "primary", "primary_class": "renderer_text_inter_record_zero_padding",\n            "claim_kind": "renderer_text_inter_record_zero_padding", "candidate_ids": item["candidate_ids"],\n            "bytes_sha256": item["bytes_sha256"], "independent_verifier_path": RENDERER_TEXT_PADDING_VERIFIER.as_posix(),\n            "independent_verifier_sha256": RENDERER_TEXT_PADDING_VERIFIER_SHA256,\n            "limitations": ["Only all-zero gaps between adjacent records owned by the same fixed renderer table are classified.", "Zero padding is not claimed to be safely allocatable."],\n        })\n    return claims\n\n\ndef _fixed_consumer_text_padding_claims(\n    root: Path, rom: bytes\n) -> list[dict[str, Any]]:\n    verifier = root / FIXED_CONSUMER_TEXT_PADDING_VERIFIER\n    if _sha256_file(verifier) != FIXED_CONSUMER_TEXT_PADDING_VERIFIER_SHA256:\n        raise ValueError("fixed-consumer text padding verifier changed")\n    report = rebuild_fixed_consumer_text_padding(root, rom)\n    if (\n        report.get("verified") is not True\n        or report.get("errors") != []\n        or report.get("padding_range_count") != 590\n        or report.get("padding_bytes") != 6_738\n        or report.get("zero_byte_count") != 6_738\n    ):\n        raise ValueError(\n            f"fixed-consumer text padding verification failed: {report}"\n        )\n    claims = []\n    for index, item in enumerate(report["ranges"]):\n        start, end = item["range"]\n        claims.append(\n            {\n                "id": f"fixed-consumer-text-zero-padding-{index:04d}-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": "fixed_consumer_text_inter_record_zero_padding",\n                "claim_kind": "fixed_consumer_text_inter_record_zero_padding",\n                "table_ids": item["table_ids"],\n                "bytes_sha256": item["bytes_sha256"],\n                "independent_verifier_path": (\n                    FIXED_CONSUMER_TEXT_PADDING_VERIFIER.as_posix()\n                ),\n                "independent_verifier_sha256": (\n                    FIXED_CONSUMER_TEXT_PADDING_VERIFIER_SHA256\n                ),\n                "limitations": [\n                    "Only all-zero gaps between adjacent records sharing a fixed consumer table are classified.",\n                    "Zero padding is not claimed to be safely allocatable.",\n                ],\n            }\n        )\n    return claims\n\n\ndef _dialogue_font_source_padding_claims(\n    root: Path, rom: bytes\n) -> list[dict[str, Any]]:\n    verifier = root / DIALOGUE_FONT_SOURCE_PADDING_VERIFIER\n    if _sha256_file(verifier) != DIALOGUE_FONT_SOURCE_PADDING_VERIFIER_SHA256:\n        raise ValueError("dialogue font source padding verifier changed")\n    report = rebuild_dialogue_font_source_padding(root, rom)\n    if (\n        report.get("verified") is not True\n        or report.get("errors") != []\n        or report.get("padding_range_count") != 19\n        or report.get("padding_bytes") != 2_848\n        or report.get("zero_byte_count") != 2_848\n        or report.get("excluded_nonzero_gap_count") != 1\n        or report.get("excluded_far_gap_count") != 1\n    ):\n        raise ValueError(\n            f"dialogue font source padding verification failed: {report}"\n        )\n    claims = []\n    for index, item in enumerate(report["ranges"]):\n        start, end = item["range"]\n        claims.append(\n            {\n                "id": f"dialogue-font-source-padding-{index:02d}-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": "dialogue_font_source_inter_entry_zero_padding",\n                "claim_kind": "dialogue_font_source_inter_entry_zero_padding",\n                "left_entry_index": item["left_entry_index"],\n                "right_entry_index": item["right_entry_index"],\n                "bytes_sha256": item["bytes_sha256"],\n                "independent_verifier_path": (\n                    DIALOGUE_FONT_SOURCE_PADDING_VERIFIER.as_posix()\n                ),\n                "independent_verifier_sha256": (\n                    DIALOGUE_FONT_SOURCE_PADDING_VERIFIER_SHA256\n                ),\n                "limitations": [\n                    "Only zero gaps between adjacent fixed SJIS source extents are classified.",\n                    "The nonzero near gap and the far relocation gap remain excluded.",\n                    "Zero padding is not claimed to be safely allocatable.",\n                ],\n            }\n        )\n    return claims\n\n\ndef _lz77_alignment_padding_claims(\n    root: Path, rom: bytes\n) -> list[dict[str, Any]]:\n    verifier = root / LZ77_ALIGNMENT_PADDING_VERIFIER\n    if _sha256_file(verifier) != LZ77_ALIGNMENT_PADDING_VERIFIER_SHA256:\n        raise ValueError("LZ77 alignment padding verifier changed")\n    report = rebuild_lz77_alignment_padding(root, rom)\n    if (\n        report.get("verified") is not True\n        or report.get("errors") != []\n        or report.get("padding_range_count") != 341\n        or report.get("padding_bytes") != 648\n        or report.get("zero_byte_count") != 648\n    ):\n        raise ValueError(f"LZ77 alignment padding verification failed: {report}")\n    claims = []\n    for index, item in enumerate(report["ranges"]):\n        start, end = item["range"]\n        claims.append(\n            {\n                "id": f"lz77-alignment-padding-{index:03d}-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": "lz77_inter_stream_zero_alignment_padding",\n                "claim_kind": "lz77_inter_stream_zero_alignment_padding",\n                "left_stream_offset": item["left_stream_offset"],\n                "right_stream_offset": item["right_stream_offset"],\n                "bytes_sha256": item["bytes_sha256"],\n                "independent_verifier_path": LZ77_ALIGNMENT_PADDING_VERIFIER.as_posix(),\n                "independent_verifier_sha256": LZ77_ALIGNMENT_PADDING_VERIFIER_SHA256,\n                "limitations": [\n                    "Only 1-to-3 zero bytes between a strict parser endpoint and the immediately adjacent fixed aligned pointer-reachable LZ77 stream are classified.",\n                    "Other LZ77 gaps and stream suffixes remain unclassified; padding is not claimed to be safely allocatable.",\n                ],\n            }\n        )\n    return claims\n\n\ndef _battle_presentation_text_padding_claims(\n    root: Path, rom: bytes\n) -> list[dict[str, Any]]:\n    verifier = root / BATTLE_PRESENTATION_TEXT_PADDING_VERIFIER\n    if _sha256_file(verifier) != BATTLE_PRESENTATION_TEXT_PADDING_VERIFIER_SHA256:\n        raise ValueError("battle-presentation text padding verifier changed")\n    report = rebuild_battle_presentation_text_padding(root, rom)\n    if (\n        report.get("verified") is not True\n        or report.get("errors") != []\n        or report.get("padding_range_count") != 78\n        or report.get("padding_bytes") != 1_293\n        or report.get("zero_byte_count") != 1_293\n    ):\n        raise ValueError(\n            f"battle-presentation text padding verification failed: {report}"\n        )\n    claims = []\n    for index, item in enumerate(report["ranges"]):\n        start, end = item["range"]\n        claims.append(\n            {\n                "id": f"battle-presentation-text-padding-{index:02d}-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": "battle_presentation_inter_record_zero_padding",\n                "claim_kind": "battle_presentation_inter_record_zero_padding",\n                "after_message_id": item["after_message_id"],\n                "bytes_sha256": item["bytes_sha256"],\n                "independent_verifier_path": BATTLE_PRESENTATION_TEXT_PADDING_VERIFIER.as_posix(),\n                "independent_verifier_sha256": BATTLE_PRESENTATION_TEXT_PADDING_VERIFIER_SHA256,\n                "limitations": [\n                    "Only zero gaps between adjacent records in the fixed 79-slot battle-presentation message table are classified.",\n                    "Padding is not claimed to be safely allocatable.",\n                ],\n            }\n        )\n    return claims\n\n\ndef _artifact_source_file(artifact_dir: Path, relative: object) -> Path:\n    if not isinstance(relative, str) or not relative:\n        raise ValueError("character battle visual source path is invalid")\n    path = Path(relative)\n    if path.is_absolute() or ".." in path.parts:\n        raise ValueError(\n            f"character battle visual source escapes its artifact: {relative}"\n        )\n    candidate = artifact_dir / path\n    try:\n        resolved = candidate.resolve(strict=True)\n        resolved.relative_to(artifact_dir)\n    except (OSError, ValueError) as error:\n        raise ValueError(\n            f"character battle visual source is missing or escapes its artifact: "\n            f"{relative}"\n        ) from error\n    if resolved != candidate.absolute() or not resolved.is_file():\n        raise ValueError(\n            f"character battle visual source uses a symlink or is not a file: "\n            f"{relative}"\n        )\n    return resolved\n\n\ndef _merged_ranges(ranges: Iterable[tuple[int, int]]) -> list[tuple[int, int]]:\n    merged: list[list[int]] = []\n    for start, end in sorted(ranges):\n        if merged and start <= merged[-1][1]:\n            merged[-1][1] = max(merged[-1][1], end)\n        else:\n            merged.append([start, end])\n    return [(start, end) for start, end in merged]\n\n\ndef _character_battle_visual_claims(\n    root: Path, rom: bytes\n) -> list[dict[str, Any]]:\n    artifact_dir = (root / CHARACTER_BATTLE_VISUAL_ARTIFACT).absolute()\n    try:\n        resolved_artifact_dir = artifact_dir.resolve(strict=True)\n        resolved_artifact_dir.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError("character battle visual artifact is missing") from error\n    if resolved_artifact_dir != artifact_dir or not artifact_dir.is_dir():\n        raise ValueError("character battle visual artifact uses a symlink")\n\n    manifest_path = artifact_dir / "manifest.json"\n    manifest_raw = manifest_path.read_bytes()\n    manifest_sha256 = _sha256(manifest_raw)\n    if manifest_sha256 != CHARACTER_BATTLE_VISUAL_MANIFEST_SHA256:\n        raise ValueError("character battle visual manifest SHA-256 changed")\n    manifest = json.loads(manifest_raw)\n    if manifest.get("schema") != "character-battle-visuals-v1":\n        raise ValueError("character battle visual manifest schema changed")\n    if manifest.get("rom") != {\n        "path": ROM_PATH.as_posix(),\n        "size": len(rom),\n        "sha256": ROM_SHA256,\n    }:\n        raise ValueError("character battle visual ROM identity changed")\n\n    table = manifest.get("table")\n    expected_table = {\n        "gba_start": "0x08596D5C",\n        "gba_end": "0x0859903C",\n        "file_offset": 0x596D5C,\n        "entry_size": 16,\n        "entry_count": 558,\n        "sha256": "baa3f86793e15d0d4abd44fcf10518da15ba0d76588b918838c3660e042e01dc",\n        "row_formula": "(character_id - 1) * 9 + visual_slot",\n    }\n    if table != expected_table:\n        raise ValueError("character battle visual descriptor table changed")\n\n    range_sources: dict[tuple[int, int], dict[str, Any]] = {}\n\n    def add_source(\n        source_kind: str,\n        start: int,\n        size: int,\n        expected_sha256: object,\n        binding: dict[str, Any],\n        source_file: Path | None = None,\n    ) -> None:\n        if source_kind not in CHARACTER_BATTLE_VISUAL_SOURCE_CLASSES:\n            raise ValueError(f"unknown character visual source kind: {source_kind}")\n        end = start + size\n        if start < 0 or size <= 0 or end > len(rom):\n            raise ValueError(\n                f"character battle visual {source_kind} range is outside ROM"\n            )\n        raw = rom[start:end]\n        actual_sha256 = _sha256(raw)\n        if expected_sha256 != actual_sha256:\n            raise ValueError(\n                f"character battle visual {source_kind} ROM hash changed at "\n                f"0x{start:X}"\n            )\n        if source_file is not None and source_file.read_bytes() != raw:\n            raise ValueError(\n                f"character battle visual {source_kind} extracted bytes changed at "\n                f"0x{start:X}"\n            )\n        key = (start, end)\n        existing = range_sources.get(key)\n        if existing is None:\n            range_sources[key] = {\n                "source_kind": source_kind,\n                "bytes_sha256": actual_sha256,\n                "bindings": [binding],\n            }\n        elif (\n            existing["source_kind"] != source_kind\n            or existing["bytes_sha256"] != actual_sha256\n        ):\n            raise ValueError(\n                f"character battle visual range 0x{start:X} has conflicting semantics"\n            )\n        else:\n            existing["bindings"].append(binding)\n\n    table_size = table["entry_size"] * table["entry_count"]\n    add_source(\n        "descriptor_table",\n        table["file_offset"],\n        table_size,\n        table["sha256"],\n        {"table": "character_visual_slot_matrix"},\n    )\n\n    resources = manifest.get("resources")\n    if not isinstance(resources, list) or len(resources) != 250:\n        raise ValueError("character battle visual resource denominator changed")\n    resource_source_kinds = tuple(\n        kind\n        for kind in CHARACTER_BATTLE_VISUAL_SOURCE_CLASSES\n        if kind != "descriptor_table"\n    )\n    for resource_id, resource in enumerate(resources):\n        if not isinstance(resource, dict) or resource.get("resource_id") != resource_id:\n            raise ValueError("character battle visual resource IDs are not exhaustive")\n        for source_kind in resource_source_kinds:\n            source = resource.get(source_kind)\n            if not isinstance(source, dict):\n                raise ValueError(\n                    f"character battle visual resource {resource_id} lacks {source_kind}"\n                )\n            try:\n                pointer = int(source["gba_pointer"], 16)\n            except (KeyError, TypeError, ValueError) as error:\n                raise ValueError(\n                    f"character battle visual resource {resource_id} has an invalid "\n                    f"{source_kind} pointer"\n                ) from error\n            size = source.get("size")\n            if not isinstance(size, int):\n                raise ValueError(\n                    f"character battle visual resource {resource_id} has an invalid "\n                    f"{source_kind} size"\n                )\n            source_file = _artifact_source_file(artifact_dir, source.get("file"))\n            add_source(\n                source_kind,\n                pointer - GBA_ROM_BASE,\n                size,\n                source.get("sha256"),\n                {\n                    "resource_id": resource_id,\n                    "file": source["file"],\n                },\n                source_file,\n            )\n\n    unique_ranges = sorted(range_sources)\n    for (_, previous_end), (start, _) in zip(unique_ranges, unique_ranges[1:]):\n        if start < previous_end:\n            raise ValueError("character battle visual source ranges overlap")\n    if tuple(_merged_ranges(unique_ranges)) != CHARACTER_BATTLE_VISUAL_UNION_RANGES:\n        raise ValueError("character battle visual source union changed")\n\n    source_counts = {\n        source_kind: sum(\n            source["source_kind"] == source_kind\n            for source in range_sources.values()\n        )\n        for source_kind in CHARACTER_BATTLE_VISUAL_SOURCE_CLASSES\n    }\n    source_bytes = {\n        source_kind: sum(\n            end - start\n            for (start, end), source in range_sources.items()\n            if source["source_kind"] == source_kind\n        )\n        for source_kind in CHARACTER_BATTLE_VISUAL_SOURCE_CLASSES\n    }\n    if source_counts != CHARACTER_BATTLE_VISUAL_SOURCE_COUNTS:\n        raise ValueError("character battle visual source count changed")\n    if source_bytes != CHARACTER_BATTLE_VISUAL_SOURCE_BYTES:\n        raise ValueError("character battle visual source byte denominator changed")\n\n    claims = []\n    for (start, end), source in sorted(range_sources.items()):\n        source_kind = source["source_kind"]\n        claims.append(\n            {\n                "id": f"character-battle-visual-{source_kind}-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": CHARACTER_BATTLE_VISUAL_SOURCE_CLASSES[source_kind],\n                "claim_kind": "character_battle_visual_source_range",\n                "source_kind": source_kind,\n                "source_bindings": source["bindings"],\n                "bytes_sha256": source["bytes_sha256"],\n                "evidence_path": (\n                    CHARACTER_BATTLE_VISUAL_ARTIFACT / "manifest.json"\n                ).as_posix(),\n                "evidence_sha256": manifest_sha256,\n            }\n        )\n    return claims\n\n\ndef _m4a_audio_claims(root: Path, rom: bytes) -> list[dict[str, Any]]:\n    manifest_path = (root / M4A_AUDIO_INVENTORY).absolute()\n    try:\n        resolved = manifest_path.resolve(strict=True)\n        resolved.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError("m4a byte inventory is missing or escapes repository") from error\n    if resolved != manifest_path or not resolved.is_file():\n        raise ValueError("m4a byte inventory uses a symlink or is not a file")\n\n    raw = resolved.read_bytes()\n    evidence_sha256 = _sha256(raw)\n    if evidence_sha256 != M4A_AUDIO_INVENTORY_SHA256:\n        raise ValueError("m4a byte inventory SHA-256 changed")\n    manifest = json.loads(raw)\n    verification = verify_m4a_manifest(root, manifest)\n    if not verification.get("verified"):\n        raise ValueError(\n            "m4a byte inventory failed independent verification: "\n            + "; ".join(verification.get("errors", []))\n        )\n    summary = manifest.get("summary")\n    if not isinstance(summary, dict) or summary.get("claim_count") != 842:\n        raise ValueError("m4a byte inventory claim denominator changed")\n    if summary.get("byte_count") != 887_018:\n        raise ValueError("m4a byte inventory byte denominator changed")\n    dense_window = manifest.get("dense_audio_window")\n    if not isinstance(dense_window, dict) or (\n        dense_window.get("unclaimed_bytes") != 318\n        or len(dense_window.get("unclaimed_ranges", [])) != 81\n    ):\n        raise ValueError("m4a byte inventory no longer preserves its unknown gaps")\n\n    inventory_claims = manifest.get("claims")\n    if not isinstance(inventory_claims, list) or len(inventory_claims) != 842:\n        raise ValueError("m4a byte inventory claims are missing")\n    claims = []\n    previous_end = -1\n    for item in inventory_claims:\n        if not isinstance(item, dict):\n            raise ValueError("m4a byte inventory contains an invalid claim")\n        identifier = item.get("id")\n        value = item.get("range")\n        semantic_class = item.get("semantic_class")\n        if (\n            not isinstance(identifier, str)\n            or not isinstance(value, list)\n            or len(value) != 2\n            or not all(isinstance(boundary, int) for boundary in value)\n            or semantic_class not in M4A_AUDIO_SEMANTIC_CLASSES\n        ):\n            raise ValueError("m4a byte inventory claim schema changed")\n        start, end = value\n        if start < previous_end or start < 0 or start >= end or end > len(rom):\n            raise ValueError("m4a byte inventory claim ranges overlap or escape ROM")\n        bytes_sha256 = _sha256(rom[start:end])\n        if item.get("bytes_sha256") != bytes_sha256:\n            raise ValueError(f"m4a byte inventory claim {identifier} hash changed")\n        claims.append(\n            {\n                "id": f"audio-{identifier}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": semantic_class,\n                "claim_kind": "m4a_audio_semantic_range",\n                "inventory_claim_id": identifier,\n                "bytes_sha256": bytes_sha256,\n                "evidence_path": M4A_AUDIO_INVENTORY.as_posix(),\n                "evidence_sha256": evidence_sha256,\n            }\n        )\n        previous_end = end\n    return claims\n\n\ndef _dialogue_font_claims(root: Path, rom: bytes) -> list[dict[str, Any]]:\n    artifact_dir = (root / DIALOGUE_FONT_ARTIFACT).absolute()\n    try:\n        resolved_artifact_dir = artifact_dir.resolve(strict=True)\n        resolved_artifact_dir.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError("dialogue font artifact is missing or escapes repository") from error\n    if resolved_artifact_dir != artifact_dir or not artifact_dir.is_dir():\n        raise ValueError("dialogue font artifact uses a symlink or is not a directory")\n    artifact_members = list(artifact_dir.rglob("*"))\n    if any(member.is_symlink() for member in artifact_members):\n        raise ValueError("dialogue font artifact tree contains a symlink")\n    relative_members = {\n        member.relative_to(artifact_dir).as_posix() for member in artifact_members\n    }\n    if relative_members != DIALOGUE_FONT_ARTIFACT_MEMBERS:\n        raise ValueError("dialogue font artifact member denominator changed")\n\n    verifier_spec = CONSUMER_CODE_ARTIFACTS["dialogue_font"]\n    verifier_path = (root / verifier_spec["verifier"]).absolute()\n    try:\n        resolved_verifier = verifier_path.resolve(strict=True)\n        resolved_verifier.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError("dialogue font verifier is invalid") from error\n    if (\n        resolved_verifier != verifier_path\n        or verifier_path.is_symlink()\n        or not verifier_path.is_file()\n    ):\n        raise ValueError("dialogue font verifier uses a symlink or is not a file")\n    if _sha256_file(verifier_path) != verifier_spec["verifier_sha256"]:\n        raise ValueError("dialogue font verifier changed")\n\n    manifest_path = artifact_dir / "manifest.json"\n    if manifest_path.is_symlink() or not manifest_path.is_file():\n        raise ValueError("dialogue font manifest uses a symlink or is not a file")\n    manifest_raw = manifest_path.read_bytes()\n    evidence_sha256 = _sha256(manifest_raw)\n    if evidence_sha256 != DIALOGUE_FONT_MANIFEST_SHA256:\n        raise ValueError("dialogue font manifest SHA-256 changed")\n\n    verification = verify_dialogue_font_atlases(root, artifact_dir)\n    if verification.get("errors"):\n        raise ValueError(\n            "dialogue font artifact failed independent verification: "\n            + "; ".join(verification["errors"])\n        )\n    expected_verification = {\n        "schema": "dialogue-font-verification-v2",\n        "verified_logical_glyphs": 4_602,\n        "verified_half_tiles": 9_012,\n        "verified_atlases": 4,\n        "verified_layout_consumers": 3,\n        "errors": [],\n    }\n    if verification != expected_verification:\n        raise ValueError("dialogue font verification denominator changed")\n\n    manifest = json.loads(manifest_raw)\n    if manifest.get("schema") != "dialogue-font-atlas-v2":\n        raise ValueError("dialogue font manifest schema changed")\n    if manifest.get("rom") != {\n        "path": ROM_PATH.as_posix(),\n        "size": len(rom),\n        "sha256": ROM_SHA256,\n    }:\n        raise ValueError("dialogue font ROM identity changed")\n    if (\n        manifest.get("logical_glyph_count") != 4_602\n        or manifest.get("unique_source_record_count") != 4_602\n        or manifest.get("logical_alias_count") != 0\n    ):\n        raise ValueError("dialogue font logical glyph denominator changed")\n\n    claims: list[dict[str, Any]] = []\n    source_ranges: list[tuple[int, int]] = []\n    for branch, expected in DIALOGUE_FONT_BRANCHES.items():\n        table = manifest.get(f"{branch}_table")\n        if not isinstance(table, dict):\n            raise ValueError(f"dialogue font {branch} table is missing")\n        if (\n            table.get("entry_count") != expected["entry_count"]\n            or table.get("entry_size") != 8\n            or table.get("logical_glyph_count")\n            != expected["logical_glyph_count"]\n            or table.get("source_bytes_per_glyph")\n            != expected["source_bytes_per_glyph"]\n        ):\n            raise ValueError(f"dialogue font {branch} table denominator changed")\n        table_start = table.get("file_offset")\n        if not isinstance(table_start, int):\n            raise ValueError(f"dialogue font {branch} table offset changed")\n        table_end = table_start + table["entry_count"] * table["entry_size"]\n        if table_start < 0 or table_end > len(rom):\n            raise ValueError(f"dialogue font {branch} table escapes ROM")\n        table_sha256 = _sha256(rom[table_start:table_end])\n        if table.get("sha256") != table_sha256:\n            raise ValueError(f"dialogue font {branch} table hash changed")\n        claims.append(\n            {\n                "id": f"dialogue-font-{branch}-table",\n                "range": [table_start, table_end],\n                "role": "primary",\n                "primary_class": expected["table_class"],\n                "claim_kind": "dialogue_font_source_range",\n                "source_kind": f"{branch}_table",\n                "record_count": table["entry_count"],\n                "bytes_sha256": table_sha256,\n                "evidence_path": (DIALOGUE_FONT_ARTIFACT / "manifest.json").as_posix(),\n                "evidence_sha256": evidence_sha256,\n            }\n        )\n\n        entries = manifest.get(f"{branch}_entries")\n        if not isinstance(entries, list) or len(entries) != expected["entry_count"]:\n            raise ValueError(f"dialogue font {branch} source entry denominator changed")\n        branch_bytes = 0\n        branch_glyphs = 0\n        for index, entry in enumerate(entries):\n            if not isinstance(entry, dict) or entry.get("index") != index:\n                raise ValueError(f"dialogue font {branch} source entries changed")\n            try:\n                source_start = int(entry["source_pointer"], 16) - GBA_ROM_BASE\n                source_end = int(entry["source_end_pointer"], 16) - GBA_ROM_BASE\n            except (KeyError, TypeError, ValueError) as error:\n                raise ValueError(\n                    f"dialogue font {branch} source pointer changed"\n                ) from error\n            range_size = entry.get("range_size")\n            expected_size = (\n                range_size * expected["source_bytes_per_glyph"]\n                if isinstance(range_size, int)\n                else None\n            )\n            if (\n                source_start < 0\n                or source_start >= source_end\n                or source_end > len(rom)\n                or entry.get("source_data_size") != source_end - source_start\n                or expected_size != source_end - source_start\n            ):\n                raise ValueError(f"dialogue font {branch} source range changed")\n            source_sha256 = _sha256(rom[source_start:source_end])\n            if entry.get("source_data_sha256") != source_sha256:\n                raise ValueError(f"dialogue font {branch} source hash changed")\n            source_ranges.append((source_start, source_end))\n            branch_bytes += source_end - source_start\n            branch_glyphs += range_size\n            claims.append(\n                {\n                    "id": f"dialogue-font-{branch}-source-{index:02d}",\n                    "range": [source_start, source_end],\n                    "role": "primary",\n                    "primary_class": expected["source_class"],\n                    "claim_kind": "dialogue_font_source_range",\n                    "source_kind": f"{branch}_2bpp",\n                    "entry_index": index,\n                    "logical_glyph_count": range_size,\n                    "bytes_sha256": source_sha256,\n                    "evidence_path": (\n                        DIALOGUE_FONT_ARTIFACT / "manifest.json"\n                    ).as_posix(),\n                    "evidence_sha256": evidence_sha256,\n                }\n            )\n        if branch_bytes != expected["source_byte_count"]:\n            raise ValueError(f"dialogue font {branch} source byte denominator changed")\n        if branch_glyphs != expected["logical_glyph_count"]:\n            raise ValueError(f"dialogue font {branch} glyph denominator changed")\n\n    for (_, previous_end), (start, _) in zip(\n        sorted(source_ranges), sorted(source_ranges)[1:]\n    ):\n        if start < previous_end:\n            raise ValueError("dialogue font source ranges overlap")\n    if len(claims) != 30:\n        raise ValueError("dialogue font claim denominator changed")\n    return claims\n\n\ndef _boot_framebuffer_claims(root: Path, rom: bytes) -> list[dict[str, Any]]:\n    artifact_dir = (root / BOOT_FRAMEBUFFER_ARTIFACT).absolute()\n    try:\n        resolved_artifact_dir = artifact_dir.resolve(strict=True)\n        resolved_artifact_dir.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError("boot framebuffer artifact is missing or escapes repository") from error\n    if resolved_artifact_dir != artifact_dir or not artifact_dir.is_dir():\n        raise ValueError("boot framebuffer artifact uses a symlink")\n    manifest_path = artifact_dir / "manifest.json"\n    if manifest_path.is_symlink() or not manifest_path.is_file():\n        raise ValueError("boot framebuffer manifest uses a symlink or is not a file")\n    manifest_raw = manifest_path.read_bytes()\n    evidence_sha256 = _sha256(manifest_raw)\n    if evidence_sha256 != BOOT_FRAMEBUFFER_MANIFEST_SHA256:\n        raise ValueError("boot framebuffer manifest SHA-256 changed")\n\n    verification = verify_rom_boot_framebuffers(root, artifact_dir)\n    expected_verification = {\n        "schema": "rom-boot-framebuffers-verification-v1",\n        "verified": True,\n        "claim_count": 14,\n        "byte_count": 155_188,\n        "startup_claim_count": 7,\n        "startup_byte_count": 584,\n        "framebuffer_count": 2,\n        "arm_routine_count": 2,\n        "errors": [],\n    }\n    if verification != expected_verification:\n        raise ValueError(\n            "boot framebuffer artifact failed independent verification: "\n            + "; ".join(verification.get("errors", []))\n        )\n    manifest = json.loads(manifest_raw)\n    if manifest.get("schema") != "rom-boot-framebuffers-v1":\n        raise ValueError("boot framebuffer manifest schema changed")\n    if manifest.get("rom") != {\n        "path": ROM_PATH.as_posix(),\n        "size": len(rom),\n        "sha256": ROM_SHA256,\n    }:\n        raise ValueError("boot framebuffer ROM identity changed")\n    if manifest.get("summary") != {\n        "claim_count": 14,\n        "byte_count": 155_188,\n        "startup_claim_count": 7,\n        "startup_byte_count": 584,\n        "framebuffer_count": 2,\n        "pixels_per_framebuffer": 38_400,\n        "arm_routine_count": 2,\n    }:\n        raise ValueError("boot framebuffer denominator changed")\n\n    items = manifest.get("claims")\n    if not isinstance(items, list) or len(items) != 14:\n        raise ValueError("boot framebuffer claims are missing")\n    claims = []\n    previous_end = -1\n    total = 0\n    for item in items:\n        if not isinstance(item, dict):\n            raise ValueError("boot framebuffer claim schema changed")\n        identifier = item.get("id")\n        value = item.get("range")\n        semantic_class = item.get("semantic_class")\n        if (\n            not isinstance(identifier, str)\n            or not isinstance(value, list)\n            or len(value) != 2\n            or not all(isinstance(boundary, int) for boundary in value)\n            or semantic_class not in BOOT_FRAMEBUFFER_CLASSES\n        ):\n            raise ValueError("boot framebuffer claim schema changed")\n        start, end = value\n        if start < previous_end or start < 0 or start >= end or end > len(rom):\n            raise ValueError("boot framebuffer claims overlap or escape ROM")\n        bytes_sha256 = _sha256(rom[start:end])\n        if item.get("size") != end - start or item.get("sha256") != bytes_sha256:\n            raise ValueError(f"boot framebuffer claim {identifier} changed")\n        claims.append(\n            {\n                "id": f"boot-{identifier}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": semantic_class,\n                "claim_kind": "boot_framebuffer_semantic_range",\n                "inventory_claim_id": identifier,\n                "bytes_sha256": bytes_sha256,\n                "evidence_path": (\n                    BOOT_FRAMEBUFFER_ARTIFACT / "manifest.json"\n                ).as_posix(),\n                "evidence_sha256": evidence_sha256,\n            }\n        )\n        previous_end = end\n        total += end - start\n    if total != 155_188:\n        raise ValueError("boot framebuffer byte denominator changed")\n    return claims\n\n\ndef _direct_cpuset_gpu_claims(\n    root: Path, rom: bytes\n) -> list[dict[str, Any]]:\n    artifact_dir = (root / DIRECT_CPUSET_GPU_ARTIFACT).absolute()\n    try:\n        resolved_artifact_dir = artifact_dir.resolve(strict=True)\n        resolved_artifact_dir.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError("direct CpuSet GPU artifact is missing") from error\n    if resolved_artifact_dir != artifact_dir or not artifact_dir.is_dir():\n        raise ValueError("direct CpuSet GPU artifact uses a symlink")\n\n    verifier_path = root / "tools/verify_rom_direct_cpuset_gpu_inventory.py"\n    if _sha256_file(verifier_path) != DIRECT_CPUSET_GPU_VERIFIER_SHA256:\n        raise ValueError("direct CpuSet GPU verifier SHA-256 changed")\n    manifest_path = artifact_dir / "manifest.json"\n    manifest_raw = manifest_path.read_bytes()\n    evidence_sha256 = _sha256(manifest_raw)\n    if evidence_sha256 != DIRECT_CPUSET_GPU_MANIFEST_SHA256:\n        raise ValueError("direct CpuSet GPU manifest SHA-256 changed")\n    verification = verify_rom_direct_cpuset_gpu_inventory(root, artifact_dir)\n    if verification != {\n        "schema": "rom-direct-cpuset-gpu-inventory-verification-v1",\n        "verified": True,\n        "errors": [],\n        "direct_call_count": 146,\n        "new_source_count": 3,\n    }:\n        raise ValueError(\n            "direct CpuSet GPU artifact failed independent verification: "\n            + "; ".join(verification.get("errors", []))\n        )\n\n    payload_path = artifact_dir / "rom-direct-cpuset-gpu-inventory.json"\n    payload = json.loads(payload_path.read_text(encoding="utf-8"))\n    sources = payload.get("new_sources")\n    if not isinstance(sources, list) or len(sources) != 3:\n        raise ValueError("direct CpuSet GPU source denominator changed")\n    claims = []\n    actual_sources: dict[int, tuple[str, str]] = {}\n    for source in sources:\n        if not isinstance(source, dict):\n            raise ValueError("direct CpuSet GPU source schema changed")\n        try:\n            start = int(source["source_address"], 16) - GBA_ROM_BASE\n        except (KeyError, TypeError, ValueError) as error:\n            raise ValueError("direct CpuSet GPU source address changed") from error\n        size = source.get("size")\n        operations = source.get("operations")\n        if size != 32 or not isinstance(operations, list) or len(operations) != 1:\n            raise ValueError("direct CpuSet GPU source shape changed")\n        operation = operations[0]\n        if not isinstance(operation, dict):\n            raise ValueError("direct CpuSet GPU operation schema changed")\n        callsite = operation.get("callsite")\n        destination = operation.get("destination")\n        if (\n            not isinstance(callsite, str)\n            or not isinstance(destination, str)\n            or operation.get("loader") != "CpuSet"\n            or operation.get("destination_domain") != "PRAM"\n            or operation.get("copy_size") != 32\n            or operation.get("unit_count") != 16\n            or operation.get("control") != "0x00000010"\n        ):\n            raise ValueError("direct CpuSet GPU consumer binding changed")\n        end = start + size\n        if start < 0 or end > len(rom):\n            raise ValueError("direct CpuSet GPU source escapes ROM")\n        bytes_sha256 = _sha256(rom[start:end])\n        if source.get("sha256") != bytes_sha256:\n            raise ValueError("direct CpuSet GPU source hash changed")\n        actual_sources[start] = (callsite, destination)\n        claims.append(\n            {\n                "id": f"direct-cpuset-palette-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": "palette_bgr555",\n                "claim_kind": "direct_cpuset_gpu_source_range",\n                "color_count": 16,\n                "consumer": {\n                    "callsite": callsite,\n                    "loader": "CpuSet",\n                    "destination": destination,\n                    "control": "0x00000010",\n                },\n                "bytes_sha256": bytes_sha256,\n                "evidence_path": (\n                    DIRECT_CPUSET_GPU_ARTIFACT / "manifest.json"\n                ).as_posix(),\n                "evidence_sha256": evidence_sha256,\n            }\n        )\n    if actual_sources != DIRECT_CPUSET_GPU_EXPECTED_SOURCES:\n        raise ValueError("direct CpuSet GPU accepted source set changed")\n    return claims\n\n\ndef _direct_cpuset_bound_palette_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote six verifier-bound 32-byte PRAM palette sources."""\n\n    root = Path(root).resolve(strict=True)\n    baseline_claims = list(existing_claims)\n    if any(\n        claim.get("promotion_batch") == DIRECT_CPUSET_BOUND_PALETTE_BATCH\n        or claim.get("claim_kind") == DIRECT_CPUSET_BOUND_PALETTE_CLAIM_KIND\n        for claim in baseline_claims\n    ):\n        raise ValueError("direct CpuSet bound palette batch is already present")\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError("direct CpuSet bound palette ROM identity changed")\n\n    artifact = (root / DIRECT_CPUSET_GPU_ARTIFACT).absolute()\n    verifier = (root / "tools/verify_rom_direct_cpuset_gpu_inventory.py").absolute()\n    source_catalog = (root / DIRECT_CPUSET_SOURCE_CATALOG).absolute()\n    source_manifest = (root / DIRECT_CPUSET_SOURCE_MANIFEST).absolute()\n    try:\n        resolved_artifact = artifact.resolve(strict=True)\n        resolved_artifact.relative_to(root)\n    except (OSError, ValueError) as error:\n        raise ValueError("direct CpuSet bound palette artifact is unsafe") from error\n    if resolved_artifact != artifact or not artifact.is_dir():\n        raise ValueError("direct CpuSet bound palette artifact is unsafe")\n    expected_members = {\n        "manifest.json",\n        "rom-direct-cpuset-gpu-inventory.json",\n        "new-raw-sources.bin",\n    }\n    members = list(artifact.iterdir())\n    if (\n        {member.name for member in members} != expected_members\n        or any(member.is_symlink() or not member.is_file() for member in members)\n    ):\n        raise ValueError("direct CpuSet bound palette artifact file set changed")\n    for path, label in (\n        (verifier, "verifier"),\n        (source_catalog, "source catalog"),\n        (source_manifest, "source manifest"),\n    ):\n        try:\n            resolved = path.resolve(strict=True)\n            resolved.relative_to(root)\n        except (OSError, ValueError) as error:\n            raise ValueError(f"direct CpuSet bound palette {label} is unsafe") from error\n        if resolved != path or path.is_symlink() or not path.is_file():\n            raise ValueError(f"direct CpuSet bound palette {label} is unsafe")\n\n    manifest_path = artifact / "manifest.json"\n    payload_path = artifact / "rom-direct-cpuset-gpu-inventory.json"\n    manifest_raw = manifest_path.read_bytes()\n    payload_raw = payload_path.read_bytes()\n    if (\n        _sha256(manifest_raw) != DIRECT_CPUSET_GPU_MANIFEST_SHA256\n        or _sha256_file(verifier) != DIRECT_CPUSET_GPU_VERIFIER_SHA256\n        or _sha256_file(source_catalog) != DIRECT_CPUSET_SOURCE_CATALOG_SHA256\n        or _sha256_file(source_manifest) != DIRECT_CPUSET_SOURCE_MANIFEST_SHA256\n    ):\n        raise ValueError("direct CpuSet bound palette evidence identity changed")\n    if b"rom-byte-coverage" in manifest_raw or b"rom-byte-coverage" in payload_raw:\n        raise ValueError("direct CpuSet bound palette evidence self-references coverage")\n\n    report = verify_rom_direct_cpuset_gpu_inventory(root, artifact)\n    expected_report = {\n        "schema": "rom-direct-cpuset-gpu-inventory-verification-v1",\n        "verified": True,\n        "errors": [],\n        "direct_call_count": 146,\n        "new_source_count": 3,\n    }\n    if report != expected_report:\n        raise ValueError(\n            "direct CpuSet bound palette independent verification failed: "\n            + "; ".join(report.get("errors", []))\n        )\n\n    try:\n        payload = json.loads(payload_raw)\n    except json.JSONDecodeError as error:\n        raise ValueError("direct CpuSet bound palette payload is invalid") from error\n    if (\n        payload.get("schema") != "rom-direct-cpuset-gpu-inventory-v1"\n        or payload.get("rom")\n        != {"path": ROM_PATH.as_posix(), "size": len(rom), "sha256": ROM_SHA256}\n        or payload.get("source_catalog")\n        != {\n            "path": DIRECT_CPUSET_SOURCE_CATALOG.as_posix(),\n            "sha256": DIRECT_CPUSET_SOURCE_CATALOG_SHA256,\n            "manifest_path": DIRECT_CPUSET_SOURCE_MANIFEST.as_posix(),\n            "manifest_sha256": DIRECT_CPUSET_SOURCE_MANIFEST_SHA256,\n        }\n    ):\n        raise ValueError("direct CpuSet bound palette payload contract changed")\n    operations = payload.get("already_bound_operations")\n    if not isinstance(operations, list) or len(operations) != 20:\n        raise ValueError("direct CpuSet bound palette operation denominator changed")\n    operations_by_source: dict[int, list[tuple[int, dict[str, Any]]]] = {}\n    for operation_index, operation in enumerate(operations):\n        if not isinstance(operation, dict):\n            raise ValueError("direct CpuSet bound palette operation schema changed")\n        try:\n            start = int(operation["source_address"], 16) - GBA_ROM_BASE\n        except (KeyError, TypeError, ValueError) as error:\n            raise ValueError("direct CpuSet bound palette source address changed") from error\n        operations_by_source.setdefault(start, []).append(\n            (operation_index, operation)\n        )\n\n    baseline_unknown_ranges = [\n        tuple(segment["range"])\n        for segment in atomize_claims(len(rom), baseline_claims)\n        if segment["primary_class"] == "unknown"\n    ]\n    candidate_starts: list[int] = []\n    eligible_starts: list[int] = []\n    preowned_starts: list[int] = []\n    partial_starts: list[tuple[int, int]] = []\n    for start, indexed_operations in sorted(operations_by_source.items()):\n        source_operations = [operation for _, operation in indexed_operations]\n        if (\n            any(\n                operation.get("already_bound") is not True\n                or operation.get("destination_domain") != "PRAM"\n                or operation.get("loader") not in {"CpuSet", "CpuFastSet"}\n                or not isinstance(operation.get("copy_size"), int)\n                or operation["copy_size"] < 32\n                for operation in source_operations\n            )\n            or not any(operation["copy_size"] == 32 for operation in source_operations)\n        ):\n            raise ValueError(\n                "direct CpuSet bound palette candidate consumer contract changed"\n            )\n        candidate_starts.append(start)\n        end = start + 32\n        unknown_bytes = sum(\n            max(0, min(end, unknown_end) - max(start, unknown_start))\n            for unknown_start, unknown_end in baseline_unknown_ranges\n            if unknown_start < end and start < unknown_end\n        )\n        if unknown_bytes == 32:\n            eligible_starts.append(start)\n        elif unknown_bytes == 0:\n            preowned_starts.append(start)\n        else:\n            partial_starts.append((start, unknown_bytes))\n\n    candidate_ranges = [[start, start + 32] for start in candidate_starts]\n    eligible_ranges = [[start, start + 32] for start in eligible_starts]\n    preowned_ranges = [[start, start + 32] for start in preowned_starts]\n    candidate_denominator = _sha256(\n        json.dumps(candidate_ranges, separators=(",", ":")).encode("ascii")\n    )\n    eligible_denominator = _sha256(\n        json.dumps(eligible_ranges, separators=(",", ":")).encode("ascii")\n    )\n    preowned_denominator = _sha256(\n        json.dumps(preowned_ranges, separators=(",", ":")).encode("ascii")\n    )\n    if partial_starts:\n        raise ValueError(\n            "direct CpuSet bound palette candidate is only partially current unknown: "\n            f"{partial_starts}"\n        )\n    if (\n        len(candidate_starts) != 12\n        or set(eligible_starts) != set(DIRECT_CPUSET_BOUND_PALETTE_EXPECTED)\n        or len(preowned_starts) != 6\n        or candidate_denominator\n        != DIRECT_CPUSET_BOUND_PALETTE_CANDIDATE_DENOMINATOR_SHA256\n        or eligible_denominator\n        != DIRECT_CPUSET_BOUND_PALETTE_RANGE_DENOMINATOR_SHA256\n        or preowned_denominator\n        != DIRECT_CPUSET_BOUND_PALETTE_PREOWNED_DENOMINATOR_SHA256\n    ):\n        raise ValueError(\n            "direct CpuSet bound palette source denominator changed: "\n            f"candidates={candidate_starts}, eligible={eligible_starts}, "\n            f"preowned={preowned_starts}"\n        )\n\n    claims: list[dict[str, Any]] = []\n    for index, (start, expected) in enumerate(\n        sorted(DIRECT_CPUSET_BOUND