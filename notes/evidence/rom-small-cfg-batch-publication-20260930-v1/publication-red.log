ition_first_record_pointer": row["first_definition_pointer"],\n                "definition_first_record_range": row["first_definition_range"],\n                "definition_first_record_sha256": row["first_definition_sha256"],\n                "definition_component_stride": row["component_stride_bytes"],\n                "definition_terminator_hex": row[\n                    "first_definition_terminator_hex"\n                ],\n                "definition_record_size": row["first_definition_size"],\n                "previous_owner_id": left_owner["id"],\n                "previous_owner_range": left_owner["range"],\n                "previous_owner_role": left_owner["role"],\n                "previous_owner_primary_class": left_owner["primary_class"],\n                "previous_owner_claim_kind": left_owner["claim_kind"],\n                "previous_owner_evidence_path": left_owner["evidence_path"],\n                "previous_owner_evidence_sha256": left_owner["evidence_sha256"],\n                "previous_owner_aligned_pointer_reference_count": left_owner[\n                    "aligned_pointer_reference_count"\n                ],\n                "next_owner_id": right_owner["id"],\n                "next_owner_range": right_owner["range"],\n                "next_owner_role": right_owner["role"],\n                "next_owner_primary_class": right_owner["primary_class"],\n                "next_owner_claim_kind": right_owner["claim_kind"],\n                "next_owner_evidence_path": right_owner["evidence_path"],\n                "next_owner_evidence_sha256": right_owner["evidence_sha256"],\n                "next_owner_evidence_selector": right_owner["evidence_selector"],\n                "next_owner_promotion_manifest_path": right_owner[\n                    "promotion_manifest_path"\n                ],\n                "next_owner_promotion_manifest_sha256": right_owner[\n                    "promotion_manifest_sha256"\n                ],\n                "next_owner_independent_verifier_path": right_owner[\n                    "independent_verifier_path"\n                ],\n                "next_owner_independent_verifier_sha256": right_owner[\n                    "independent_verifier_sha256"\n                ],\n                "evidence_path": CUTSCENE_OBJ_ALIGNMENT_GAP_VERIFIER.as_posix(),\n                "evidence_sha256": CUTSCENE_OBJ_ALIGNMENT_GAP_VERIFIER_SHA256,\n                "evidence_selector": f"/resources/{resource_id}",\n                "independent_verifier_path": CUTSCENE_OBJ_ALIGNMENT_GAP_VERIFIER.as_posix(),\n                "independent_verifier_sha256": CUTSCENE_OBJ_ALIGNMENT_GAP_VERIFIER_SHA256,\n                "independent_verifier_report_sha256": report_sha256,\n                "upstream_test_path": CUTSCENE_OBJ_ALIGNMENT_GAP_TEST.as_posix(),\n                "upstream_test_sha256": CUTSCENE_OBJ_ALIGNMENT_GAP_TEST_SHA256,\n                "source_manifest_path": CUTSCENE_OBJ_ALIGNMENT_GAP_SOURCE_MANIFEST.as_posix(),\n                "source_manifest_sha256": CUTSCENE_OBJ_SOURCE_MANIFEST_SHA256,\n                "source_payload_path": CUTSCENE_OBJ_ALIGNMENT_GAP_SOURCE_PAYLOAD.as_posix(),\n                "source_payload_sha256": CUTSCENE_OBJ_SOURCE_PAYLOAD_SHA256,\n                "source_verifier_path": CUTSCENE_OBJ_ALIGNMENT_GAP_SOURCE_VERIFIER.as_posix(),\n                "source_verifier_sha256": CUTSCENE_OBJ_SOURCE_VERIFIER_SHA256,\n                **false_claims,\n                "limitations": [\n                    "Only this exact two-byte zero slice between the independently parsed fixed palette stream and the rooted first definition record is classified under the stated 4-byte alignment equation.",\n                    "Padding intent, runtime consumption, generic LZ rules, exhaustive Cutscene gaps, reachability, field semantics, pixels, editing, relocation, allocation and neighboring bytes remain unclaimed.",\n                ],\n            }\n        )\n\n    denominator = _sha256(\n        json.dumps(\n            [\n                {\n                    key: claim[key]\n                    for key in (\n                        "id",\n                        "range",\n                        "resource_id",\n                        "primary_class",\n                        "claim_kind",\n                        "bytes_sha256",\n                        "previous_owner_id",\n                        "next_owner_id",\n                        "evidence_selector",\n                    )\n                }\n                for claim in claims\n            ],\n            ensure_ascii=True,\n            separators=(",", ":"),\n            sort_keys=True,\n        ).encode("ascii")\n    )\n    if (\n        denominator != CUTSCENE_OBJ_ALIGNMENT_GAP_CLAIM_DENOMINATOR_SHA256\n        or len(claims) != 4\n        or sum(claim["range"][1] - claim["range"][0] for claim in claims) != 8\n    ):\n        raise ValueError("Cutscene OBJ alignment-gap claim denominator changed")\n    return claims\n\n\ndef _renderer_text_claims(root: Path, rom: bytes) -> list[dict[str, Any]]:\n    """Classify the independently verified renderer-bounded target union."""\n\n    artifact = (root / RENDERER_TEXT_ARTIFACT).absolute()\n    manifest_path = artifact / "manifest.json"\n    payload_path = (root / RENDERER_TEXT_PAYLOAD).absolute()\n    bundle_path = (root / RENDERER_TEXT_BUNDLE).absolute()\n    verifier_path = (root / RENDERER_TEXT_VERIFIER).absolute()\n    for path, label in (\n        (artifact, "artifact"),\n        (manifest_path, "manifest"),\n        (payload_path, "payload"),\n        (bundle_path, "bundle"),\n        (verifier_path, "verifier"),\n    ):\n        try:\n            resolved = path.resolve(strict=True)\n            resolved.relative_to(root)\n        except (OSError, ValueError) as error:\n            raise ValueError(f"renderer-text {label} is invalid") from error\n        if resolved != path or path.is_symlink():\n            raise ValueError(f"renderer-text {label} uses a symlink")\n    if not artifact.is_dir() or any(path.is_symlink() for path in artifact.rglob("*")):\n        raise ValueError("renderer-text artifact tree is unsafe")\n    actual_files = {\n        path.relative_to(artifact).as_posix()\n        for path in artifact.rglob("*")\n        if path.is_file()\n    }\n    if actual_files != {\n        "manifest.json",\n        payload_path.name,\n        bundle_path.name,\n    }:\n        raise ValueError("renderer-text artifact file set changed")\n    if _sha256_file(manifest_path) != RENDERER_TEXT_MANIFEST_SHA256:\n        raise ValueError("renderer-text manifest changed")\n    if _sha256_file(payload_path) != RENDERER_TEXT_PAYLOAD_SHA256:\n        raise ValueError("renderer-text payload changed")\n    if _sha256_file(bundle_path) != RENDERER_TEXT_BUNDLE_SHA256:\n        raise ValueError("renderer-text bundle changed")\n    if _sha256_file(verifier_path) != RENDERER_TEXT_VERIFIER_SHA256:\n        raise ValueError("renderer-text verifier changed")\n\n    manifest = json.loads(manifest_path.read_bytes())\n    payload = json.loads(payload_path.read_bytes())\n    bundle = bundle_path.read_bytes()\n    if (\n        manifest.get("schema") != "git-artifact-promotion-v1"\n        or manifest.get("artifact_schema") != "rom-renderer-text-inventory-v1"\n        or manifest.get("artifact_status") != "accepted"\n        or manifest.get("files")\n        != {\n            bundle_path.name: RENDERER_TEXT_BUNDLE_SHA256,\n            payload_path.name: RENDERER_TEXT_PAYLOAD_SHA256,\n        }\n    ):\n        raise ValueError("renderer-text promotion binding changed")\n    if (\n        payload.get("schema") != "rom-renderer-text-inventory-v1"\n        or payload.get("rom")\n        != {"path": ROM_PATH.as_posix(), "size": len(rom), "sha256": ROM_SHA256}\n        or payload.get("range_denominator_sha256")\n        != RENDERER_TEXT_RANGE_DENOMINATOR_SHA256\n        or payload.get("files")\n        != {\n            bundle_path.name: {\n                "size": 22_588,\n                "sha256": RENDERER_TEXT_BUNDLE_SHA256,\n            }\n        }\n        or payload.get("summary")\n        != {\n            "pointer_table_count": 11,\n            "pointer_slot_count": 704,\n            "unique_target_count": 625,\n            "renderer_record_count": 625,\n            "renderer_consumed_bytes": 22_588,\n            "target_overlap_bytes": 0,\n            "parse_failure_count": 0,\n            "packed_text_bytes": 22_588,\n        }\n    ):\n        raise ValueError("renderer-text inventory denominator changed")\n    if payload.get("implementation", {}).get("verifier_sha256") != RENDERER_TEXT_VERIFIER_SHA256:\n        raise ValueError("renderer-text implementation binding changed")\n    verifier = manifest.get("verifier", {})\n    if (\n        verifier.get("verifier_sha256") != RENDERER_TEXT_VERIFIER_SHA256\n        or verifier.get("exit_code") != 0\n        or verifier.get("report", {}).get("verified") is not True\n        or verifier.get("report", {}).get("errors") != []\n        or verifier.get("report", {}).get("renderer_record_count") != 625\n        or verifier.get("report", {}).get("renderer_consumed_bytes") != 22_588\n    ):\n        raise ValueError("renderer-text verifier contract changed")\n    report = verify_rom_renderer_text_inventory(root, artifact)\n    if (\n        report.get("verified") is not True\n        or report.get("errors") != []\n        or report.get("unique_target_count") != 625\n        or report.get("renderer_consumed_bytes") != 22_588\n    ):\n        raise ValueError(f"renderer-text independent verifier failed: {report}")\n\n    records = payload.get("records")\n    if not isinstance(records, list) or len(records) != 625:\n        raise ValueError("renderer-text record denominator changed")\n    claims = []\n    packed_cursor = 0\n    previous_end = -1\n    semantic_ranges = []\n    for range_id, record in enumerate(records):\n        if not isinstance(record, dict):\n            raise ValueError("renderer-text record changed")\n        value = record.get("range")\n        packed = record.get("packed_range")\n        if (\n            record.get("range_id") != range_id\n            or not isinstance(value, list)\n            or len(value) != 2\n            or not all(isinstance(item, int) for item in value)\n            or not isinstance(packed, list)\n            or len(packed) != 2\n            or not all(isinstance(item, int) for item in packed)\n        ):\n            raise ValueError("renderer-text record changed")\n        start, end = value\n        packed_start, packed_end = packed\n        if (\n            start < previous_end\n            or not start < end <= len(rom)\n            or record.get("size") != end - start\n            or packed_start != packed_cursor\n            or packed_end - packed_start != end - start\n            or packed_end > len(bundle)\n            or record.get("gba_range")\n            != [f"0x{GBA_ROM_BASE + start:08X}", f"0x{GBA_ROM_BASE + end:08X}"]\n            or record.get("bytes_sha256") != _sha256(rom[start:end])\n            or bundle[packed_start:packed_end] != rom[start:end]\n        ):\n            raise ValueError(f"renderer-text bytes changed: {range_id}")\n        semantic_ranges.append([start, end])\n        claims.append(\n            {\n                "id": f"renderer-text-target-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": "renderer_text_record",\n                "claim_kind": "renderer_text_target_bytes",\n                "candidate_ids": record["candidate_ids"],\n                "bytes_sha256": record["bytes_sha256"],\n                "evidence_path": RENDERER_TEXT_PAYLOAD.as_posix(),\n                "evidence_sha256": RENDERER_TEXT_PAYLOAD_SHA256,\n                "evidence_selector": f"/records/{range_id}",\n                "promotion_manifest_path": (\n               