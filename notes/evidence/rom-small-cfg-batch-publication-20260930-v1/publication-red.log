               raise ValueError("v7 dispatch table pointer changed")\n            cell_records.append(\n                {\n                    "range": [start, start + 4],\n                    "dispatcher_index": dispatcher_index,\n                    "dispatcher_id": dispatcher["dispatcher_id"],\n                    "slot_index": slot_index,\n                    "target_file_offset": target,\n                    "raw_pointer": raw_pointer,\n                }\n            )\n    if len(cell_records) != 45:\n        raise ValueError("v7 dispatch physical cell denominator changed")\n\n    table_claims: list[dict[str, Any]] = []\n    partial_unknown_cells = []\n    for cell in cell_records:\n        start, end = cell["range"]\n        unknown_bytes = sum(\n            max(0, min(end, unknown_end) - max(start, unknown_start))\n            for unknown_start, unknown_end in unknown\n            if unknown_start < end and start < unknown_end\n        )\n        if unknown_bytes == 0:\n            continue\n        if unknown_bytes != 4:\n            partial_unknown_cells.append((start, unknown_bytes))\n            continue\n        table_claims.append(\n            {\n                "id": f"cfg-proven-roots-v7-dispatch-cell-{start:06x}",\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": "thumb_indexed_dispatch_table_cell",\n                "claim_kind": table_kind,\n                "dispatcher_id": cell["dispatcher_id"],\n                "slot_index": cell["slot_index"],\n                "target_file_offset": cell["target_file_offset"],\n                "raw_pointer": cell["raw_pointer"],\n                "dispatch_selected": True,\n                "runtime_reachability_claimed": False,\n                "target_reachability_claimed": False,\n                "global_code_map_claimed": False,\n                "promoted_from_primary_class": "unknown",\n                "bytes_sha256": _sha256(rom[start:end]),\n                "range_denominator_sha256": (\n                    CFG_PROVEN_ROOTS_V7_DISPATCH_TABLE_RANGE_DENOMINATOR_SHA256\n                ),\n                "evidence_path": (\n                    CFG_PROVEN_ROOTS_V7_ARTIFACT\n                    / CFG_PROVEN_ROOTS_V7_PAYLOAD_NAME\n                ).as_posix(),\n                "evidence_sha256": CFG_PROVEN_ROOTS_V7_PAYLOAD_SHA256,\n                "evidence_selector": (\n                    f"/dispatcher_denominator/{cell[\'dispatcher_index\']}"\n                    f"/target_vector/{cell[\'slot_index\']}"\n                ),\n                "promotion_manifest_path": (\n                    CFG_PROVEN_ROOTS_V7_ARTIFACT / "manifest.json"\n                ).as_posix(),\n                "promotion_manifest_sha256": CFG_PROVEN_ROOTS_V7_MANIFEST_SHA256,\n                "independent_verifier_path": CFG_PROVEN_ROOTS_V7_VERIFIER.as_posix(),\n                "independent_verifier_sha256": CFG_PROVEN_ROOTS_V7_VERIFIER_SHA256,\n                "promotion_batch": "cfg-proven-roots-v7",\n                "limitations": [\n                    "This proves one selected cell in the fixed dispatcher denominator, not natural runtime reachability or target semantics.",\n                    "Previously classified cells are not re-claimed and a global code map is not claimed.",\n                ],\n            }\n        )\n    if partial_unknown_cells:\n        raise ValueError(\n            "v7 dispatch cells are only partially unknown: "\n            f"{partial_unknown_cells[:8]}"\n        )\n    table_range_denominator = _sha256(\n        json.dumps(\n            [claim["range"] for claim in table_claims],\n            separators=(",", ":"),\n        ).encode("ascii")\n    )\n    table_bytes = sum(\n        claim["range"][1] - claim["range"][0] for claim in table_claims\n    )\n    if (\n        len(table_claims) != CFG_PROVEN_ROOTS_V7_DISPATCH_TABLE_CELL_COUNT\n        or table_bytes != CFG_PROVEN_ROOTS_V7_DISPATCH_TABLE_BYTES\n