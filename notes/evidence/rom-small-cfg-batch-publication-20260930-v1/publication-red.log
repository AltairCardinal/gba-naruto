gments, but it stays linear in the claim denominator instead of\n    repeatedly constructing every whole-ROM segment for each small packet.\n    """\n\n    normalized = list(existing_claims)\n    identifiers = [claim.get("id") for claim in normalized]\n    if any(not isinstance(value, str) or not value for value in identifiers):\n        raise ValueError("every claim must have a non-empty string id")\n    if len(set(identifiers)) != len(identifiers):\n        raise ValueError("claim ids must be unique")\n    primary = []\n    for claim in normalized:\n        role = claim.get("role")\n        if role not in {"primary", "secondary"}:\n            raise ValueError(f"claim {claim[\'id\']!r} has an invalid role")\n        start, end = _validated_range(claim, domain_end)\n        if role == "primary":\n            if not isinstance(claim.get("primary_class"), str):\n                raise ValueError(f"primary claim {claim[\'id\']!r} has no class")\n            primary.append((start, end, claim["id"]))\n    primary.sort()\n    for left, right in zip(primary, primary[1:]):\n        if right[0] < left[1]:\n            raise ValueError(\n                "conflicting primary claims at "\n                f"[0x{right[0]:X}, 0x{min(left[1], right[1]):X}): "\n                f"{left[2]}, {right[2]}"\n            )\n    starts = [row[0] for row in primary]\n    for value in candidate_ranges:\n        if (\n            not isinstance(value, (list, tuple))\n            or len(value) != 2\n            or not all(isinstance(item, int) for item in value)\n        ):\n            raise ValueError(f"{label} has an invalid projection range")\n        start, end = value\n        if start < 0 or start >= end or end > domain_end:\n            raise ValueError(f"{label} escaped coverage")\n        index = bisect.bisect_right(starts, start) - 1\n        if index >= 0 and primary[index][1] > start:\n            raise ValueError(f"{label} is not current unknown")\n        index += 1\n        if index < len(primary) and primary[index][0] < end:\n            raise ValueError(f"{label} is not current unknown")\n\n\ndef _project_dependency_packet_claims(root, rom, existing_claims, *, spec, verify_root):\n    expected_files = spec.get("files", {"manifest.json", spec["payload"]})\n    artifact = _checked_artifact_directory(root, spec["artifact"], expected_files, label=spec["label"])\n    verifier_path = _checked_repository_file(root, spec["verifier"], spec["verifier_sha"], label=f\'{spec["label"]} verifier\')\n    manifest_raw = (artifact / "manifest.json").read_bytes(); payload_raw = (artifact / spec["payload"]).read_bytes()\n    if (len(manifest_raw), _sha256(manifest_raw), len(payload_raw), _sha256(payload_raw)) != (spec["manifest_size"], spec["manifest_sha"], spec["payload_size"], spec["payload_sha"]):\n        raise ValueError(f\'{spec["label"]} artifact identity changed\')\n    report = verify_root(root, artifact)\n    if report.get("verified") is not True or report.get("promotion_bytes") != spec["promotion_bytes"]:\n        raise ValueError(f\'{spec["label"]} independent verification failed: {report}\')\n    records = json.loads(payload_raw).get("promotion", {}).get("claims")\n    if not isinstance(records, list) or len(records) != spec["claim_count"]:\n        raise ValueError(f\'{spec["label"]} claim denominator changed\')\n    _require_current_unknown_ranges(\n        len(rom),\n        existing_claims,\n        [row.get("range") for row in records],\n        label=spec["label"],\n    )\n    report_sha = _sha256(_canonical_json_bytes(report)); claims = []\n    for index, row in enumerate(records):\n        start, end = row["range"]; expected_hash = row.get(spec["hash_field"])\n        if start >= end or _sha256(rom[start:end]) != expected_hash: raise ValueError(f\'{spec["label"]} range bytes changed\')\n        if "class_for" in spec:\n            primary_class = spec["class_for"](row)\n            claim_kind = spec["kind_for"](row)\n            mode = spec.get("mode_for", lambda ignored: None)(row)\n            if not isinstance(primary_class, str) or not isinstance(claim_kind, str):\n                raise ValueError(f\'{spec["label"]} semantic kind changed\')\n        else:\n            is_code = spec["is_code"](row)\n            if not is_code and not spec["is_literal"](row): raise ValueError(f\'{spec["label"]} semantic kind changed\')\n            primary_class = spec["code_class"] if is_code else spec["literal_class"]\n            claim_kind = spec["code_kind"] if is_code else spec["literal_kind"]\n            mode = "thumb" if is_code else None\n        claims.append({\n            "id": row["id"], "range": [start, end], "role": "primary",\n            "primary_class": primary_class,\n            "claim_kind": claim_kind,\n            "promotion_batch": spec["batch"], "promoted_from_primary_class": "unknown", "baseline_unknown_only": True,\n            "bytes_sha256": expected_hash, "evidence_path": (spec["artifact"] / spec["payload"]).as_posix(), "evidence_sha256": spec["payload_sha"], "evidence_selector": f"/promotion/claims/{index}",\n            "promotion_manifest_path": (spec["artifact"] / "manifest.json").as_posix(), "promotion_manifest_sha256": spec["manifest_sha"],\n            "independent_verifier_path": verifier_path.relative_to(root).as_posix(), "independent_verifier_sha256": spec["verifier_sha"], "independent_verifier_report_sha256": report_sha,\n            "mode": mode, "runtime_reachability_claimed": False, "loaded_value_semantics_claimed": False, "alignment_gap_classification_claimed": False, "editing_writeback_relocation_safe_claimed": False, "free_or_allocatable_space_claimed": False,\n        })\n    claims.sort(key=lambda claim: (claim["range"], claim["id"]))\n    if sum(b-a for claim in claims for a,b in [claim["range"]]) != spec["promotion_bytes"] or any(a["range"][1] > b["range"][0] for a,b in zip(claims,claims[1:])):\n        raise ValueError(f\'{spec["label"]} accounting changed\')