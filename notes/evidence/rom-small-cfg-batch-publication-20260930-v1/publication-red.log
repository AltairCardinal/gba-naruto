  if (\n        not isinstance(targets, list)\n        or len(targets) != 2\n        or [target.get("code_ranges") for target in targets]\n        != [[[0x0624C0, 0x062500]], [[0x062510, 0x062548]]]\n        or [target.get("literal_ranges") for target in targets]\n        != [[[0x062500, 0x062510]], [[0x062548, 0x062560]]]\n        or [len(target.get("producers", [])) for target in targets] != [2, 3]\n        or payload.get("promotion")\n        != {\n            "batch": CFG_PROVEN_ROOTS_V14_BATCH,\n            "ranges": expected_promotion_ranges,\n            "promotion_range_count": 4,\n            "promotion_bytes": 160,\n            "promotion_code_bytes": 120,\n            "promotion_literal_bytes": 40,\n            "hole_bytes": 0,\n            "packed_sha256": (\n                "25f6db2c2844ed30e0ea9ae4315568d0e33047be99e268bb6a9ae28f90fec1a8"\n            ),\n            "range_vector_sha256": (\n                "ed05dacca1ab7200679b3c8754a61ff116ce0bc96bd718d3c80fa1f0b2b2a4ed"\n            ),\n            "unclassified_hole_bytes": 0,\n        }\n    ):\n        raise ValueError("v14 promotion denominator changed")\n\n    baseline_segments = atomize_claims(len(rom), baseline)\n    unknown_ranges = [\n        tuple(segment["range"])\n        for segment in baseline_segments\n        if segment.get("primary_class") == "unknown"\n    ]\n    known_ranges = [\n        tuple(segment["range"])\n        for segment in baseline_segments\n        if segment.get("primary_class") != "unknown"\n    ]\n\n    def require_unknown(start: int, end: int) -> None:\n        if any(\n            start < known_end and known_start < end\n            for known_start, known_end in known_ranges\n        ):\n            raise ValueError("v14 claim overlaps current known bytes")\n        if not any(left <= start and end <= right for left, right in unknown_ranges):\n            raise ValueError("v14 claim is not fully current unknown")\n        if start < 0x0624C0 or end > 0x062560:\n            raise ValueError("v14 claim is outside the promotion envelope")\n\n    nonclaims = payload.get("scope", {}).get("nonclaims")\n    if not isinstance(nonclaims, list) or len(nonclaims) != 8:\n        raise ValueError("v14 nonclaim denominator changed")\n    limitations = [\n        "Only two frozen Thumb code ranges and two consumed literal ranges inside [0x0624C0,0x062560) are classified.",\n        "The five accepted V12/V13 producer instructions are provenance only and are not re-claimed.",\n        "The bx r0 instructions at 0x0624FE and 0x062546 remain explicit unresolved indirect-PC frontiers.",\n        "Natural execution, global denominators, adjacent bytes, editing, relocation and free-space safety are not claimed.",\n    ]\n    evidence_path = (\n        CFG_PROVEN_ROOTS_V14_ARTIFACT / CFG_PROVEN_ROOTS_V14_PAYLOAD_NAME\n    ).as_posix()\n    manifest_evidence_path = (\n        CFG_PROVEN_ROOTS_V14_ARTIFACT / "manifest.json"\n    ).as_posix()\n    claims: list[dict[str, Any]] = []\n    for target_index, target in enumerate(targets):\n        code_range = CFG_PROVEN_ROOTS_V14_CODE_RANGES[target_index]\n        start, end = code_range\n        require_unknown(start, end)\n        claims.append(\n            {\n                "id": (\n                    f"cfg-proven-roots-v14-thumb-{target_index:04d}-{start:06x}"\n                ),\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": CFG_PROVEN_ROOTS_V14_CODE_CLASS,\n                "claim_kind": CFG_PROVEN_ROOTS_V14_CODE_KIND,\n                "mode": "thumb",\n                "fixed_root_count": 2,\n                "target_root_file_offset": target["root"]["file_offset"],\n                "raw_target_producer_count": len(target["producers"]),\n                "accepted_target_producer_count": len(target["producers"]),\n                "source_block_count": len(target["blocks"]),\n                "promoted_from_primary_class": "unknown",\n                "runtime_reachability_claimed": False,\n                "global_code_map_claimed": False,\n                "bytes_sha256": _sha256(rom[start:end]),\n                "evidence_path": evidence_path,\n                "evidence_sha256": CFG_PROVEN_ROOTS_V14_PAYLOAD_SHA256,\n                "evidence_selector": f"/targets/{target_index}/code_ranges/0",\n                "promotion_manifest_path": manifest_evidence_path,\n                "promotion_manifest_sha256": CFG_PROVEN_ROOTS_V14_MANIFEST_SHA256,\n                "independent_verifier_path": (\n                    CFG_PROVEN_ROOTS_V14_BUNDLE_VERIFIER.as_posix()\n                ),\n                "independent_verifier_sha256": (\n                    CFG_PROVEN_ROOTS_V14_BUNDLE_VERIFIER_SHA256\n                ),\n                "promotion_batch": CFG_PROVEN_ROOTS_V14_BATCH,\n                "nonclaims": nonclaims,\n                "limitations": limitations,\n            }\n        )\n        literal_range = CFG_PROVEN_ROOTS_V14_LITERAL_RANGES[target_index]\n        start, end = literal_range\n        require_unknown(start, end)\n        bindings = target.get("literal_projection", {}).get("bindings", [])\n        claims.append(\n            {\n                "id": (\n                    f"cfg-proven-roots-v14-literal-{target_index:04d}-{start:06x}"\n                ),\n                "range": [start, end],\n                "role": "primary",\n                "primary_class": CFG_PROVEN_ROOTS_V14_LITERAL_CLASS,\n                "claim_kind": CFG_PROVEN_ROOTS_V14_LITERAL_KIND,\n                "literal_reference_count": sum(\n                    start <= binding[1] < end for binding in bindings\n                ),\n                "promoted_from_primary_class": "unknown",\n                "runtime_reachability_claimed": False,\n                "global_code_map_claimed": False,\n                "bytes_sha256": _sha256(rom[start:end]),\n                "evidence_path": evidence_path,\n                