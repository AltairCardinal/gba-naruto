id"), str)\n    }\n    padding_by_id = {\n        item.get("padding_id"): item\n        for item in padding\n        if isinstance(item, dict) and isinstance(item.get("padding_id"), str)\n    }\n    if len(record_by_id) != 79 or len(padding_by_id) != 79:\n        raise ValueError("battle-message-text record IDs changed")\n\n    claims: list[dict[str, Any]] = []\n    record_ranges: list[list[int]] = []\n    padding_ranges: list[list[int]] = []\n    classified_ranges: list[list[int]] = []\n    packed_cursor = 0\n    cursor = 0x5A1580\n    for index, item in enumerate(classified):\n        if not isinstance(item, dict):\n            raise ValueError(f"battle-message-text classified item changed: {index}")\n        kind = item.get("kind")\n        range_id = item.get("range_id")\n        value = item.get("range")\n        packed = item.get("packed_range")\n        expected_kind = (\n            "renderer_text_record" if index % 2 == 0 else "inter_record_zero_padding"\n        )\n        if (\n            kind != expected_kind\n            or not isinstance(value, list)\n            or len(value) != 2\n            or not all(isinstance(boundary, int) for boundary in value)\n            or not isinstance(packed, list)\n            or len(packed) != 2\n            or not all(isinstance(boundary, int) for boundary in packed)\n        ):\n            raise ValueError(\n                f"battle-message-text classified schema changed: {index}"\n            )\n        start, end = value\n        packed_start, packed_end = packed\n        raw = rom[start:end]\n        if (\n            not 0 <= start < end <= len(rom)\n            or start != cursor\n            or packed_start != packed_cursor\n            or packed_end - packed_start != end - start\n            or item.get("size") != end - start\n            or item.get("sha256") != _sha256(raw)\n            or bundle[packed_start:packed_end] != raw\n        ):\n            raise ValueError(\n                f"battle-message-text classified bytes changed: {index}"\n            )\n        cursor = end\n        packed_cursor = packed_end\n        classified_ranges.append(value)\n        common = {\n            "range": value,\n            "role": "primary",\n            "bytes_sha256": item["sha256"],\n            "evidence_path": BATTLE_MESSAGE_TEXT_PAYLOAD.as_posix(),\n            "evidence_sha256": BATTLE_MESSAGE_TEXT_PAYLOAD_SHA256,\n            "evidence_selector": f"/classified_ranges/{index}",\n            "promotion_manifest_path": (\n                BATTLE_MESSAGE_TEXT_ARTIFACT / "manifest.json"\n            ).as_posix(),\n            "promotion_manifest_sha256": BATTLE_MESSAGE_TEXT_MANIFEST_SHA256,\n            "independent_verifier_path": BATTLE_MESSAGE_TEXT_VERIFIER.as_posix(),\n            "independent_verifier_sha256": BATTLE_MESSAGE_TEXT_VERIFIER_SHA256,\n            "runtime_reachability_claimed": False,\n        }\n        if kind == "renderer_text_record":\n            record = record_by_id.get(range_id)\n            if (\n                not isinstance(record, dict)\n                or record.get("range") != value\n                or record.get("slot_index") != index // 2\n                or record.get("size") != end - start\n                or record.get("sha256") != item.get("sha256")\n                or rom[end - 1] != 0\n            ):\n                raise ValueError(\n                    f"battle-message-text renderer record changed: {index}"\n                )\n            record_ranges.append(value)\n            claims.append(\n                {\n                    "id": f"battle-message-text-{record[\'slot_index\']:02d}-{start:06x}",\n                    **common,\n                    "primary_class": "battle_message_renderer_text",\n                    "claim_kind": "battle_message_renderer_text_record_bytes",\n                    "record_id": range_id,\n                    "slot_index": record["slot_index"],\n                    "text_semantics_claimed": True,\n                    "unicode_decoding_claimed": False,\n                    "limitations": [\n                        "The fixed pointer and renderer grammar prove this byte record; natural execution of this ID, Unicode decoding, and safe writeback remain unclaimed."\n                    ],\n                }\n            )\n        else:\n            gap = padding_by_id.get(range_id)\n            if (\n                not isinstance(gap, dict)\n                or gap.get("range") != value\n                or gap.get("after_slot_index") != index // 2\n                or gap.get("size") != end - start\n                or gap.get("sha256") != item.get("sha256")\n                or gap.get("all_zero") is not True\n                or gap.get("safe_allocatable_space_claimed") is not False\n                or any(raw)\n            ):\n                raise ValueError(\n                    f"battle-message-text zero padding changed: {index}"\n                )\n            padding_ranges.append(value)\n            claims.append(\n                {\n                    "id": f"battle-message-padding-{gap[\'after_slot_index\']:02d}-{start:06x}",\n                    **common,\n                    "primary_class": "battle_message_inter_record_zero_padding",\n                    "claim_kind": "battle_message_inter_record_zero_padding",\n                    "after_slot_index": gap["after_slot_index"],\n                    "text_semantics_claimed": False,\n                    "safe_allocatable_space_claimed": False,\n                    "limitations": [\n                        "Every byte in this fixed inter-record gap is zero, but the range is not text and is not proven safe allocatable space."\n                    ],\n                }\n            )\n\n    if (\n        cursor != 0x5A2034\n        or packed_cursor != len(bundle)\n        or len(bundle) != 2_740\n        or _sha256(bundle) != BATTLE_MESSAGE_TEXT_BUNDLE_SHA256\n        or _sha256(\n            json.dumps(record_ranges, separators=(",", ":")).encode("ascii")\n        )\n        != BATTLE_MESSAGE_TEXT_RECORD_DENOMINATOR_SHA256\n        or _sha256(\n            json.dumps(padding_ranges, separators=(",", ":")).encode("ascii")\n        )\n        != BATTLE_MESSAGE_TEXT_PADDING_DENOMINATOR_SHA256\n        or _sha256(\n            json.dumps(classified_ranges, separators=(",", ":")).encode("ascii")\n        )\n        != BATTLE_MESSAGE_TEXT_CLASSIFIED_DENOMINATOR_SHA256\n    ):\n        raise ValueError("battle-message-text final denominator changed")\n    return claims\n\n\ndef _boot_interwork_claims(root: Path, rom: bytes) -> list[dict[str, Any]]:\n    """Classify only the fixed interwork spine, closed ARM root, and literals."""\n\n    if _sha256(rom) != ROM_SHA256:\n        raise ValueError("boot-interwork ROM SHA-256 changed")\n    artifact = (root / BOOT_INTERWORK_ARTIFACT).absolute()\n    manifest_path = artifact / "manifest.json"\n    payload_path = (root / BOOT_INTERWORK_PAYLOAD).absolute()\n    exporter_path = (root / BOOT_INTERWORK_EXPORTER).absolute()\n    verifier_path = (root / BOOT_INTERWORK_VERIFIER).absolute()\n    test_path = (root / BOOT_INTERWORK_TEST).absolute()\n    for path, label in (\n        (artifact, "artifact"),\n        (manifest_path, "manifest"),\n        (payload_path, "payload"),\n        (exporter_path, "exporter"),\n        (verifier_path, "verifier"),\n        (test_path, "test"),\n    ):\n        try:\n            resolved = path.resolve(strict=True)\n            resolved.relative_to(root)\n        except (OSError, ValueError) as error:\n            raise ValueError(f"boot-interwork {label} is invalid") from error\n        if resolved != path or path.is_symlink():\n            raise ValueError(f"boot-interwork {label} uses a symlink")\n    members = list(artifact.rglob("*"))\n    if (\n        not artifact.is_dir()\n        or any(path.is_symlink() for path in members)\n        or {\n            path.relative_to(artifact).as_posix()\n            for path in members\n            if path.is_file()\n        }\n        != {"manifest.json", payload_path.name}\n    ):\n        raise ValueError("boot-interwork artifact file denominator changed")\n    for path, digest, label in (\n        (manifest_path, BOOT_INTERWORK_MANIFEST_SHA256, "manifest"),\n        (payload_path, BOOT_INTERWORK_PAYLOAD_SHA256, "payload"),\n        (exporter_path, BOOT_INTERWORK_EXPORTER_SHA256, "exporter"),\n        (verifier_path, BOOT_INTERWORK_VERIFIER_SHA256, "verifier"),\n        (test_path, BOOT_INTERWORK_TEST_SHA256, "test"),\n    ):\n        if _sha256_file(path) != digest:\n            raise ValueError(f"boot-interwork {label} changed")\n\n    manifest = json.loads(manifest_path.read_bytes())\n    payload = json.loads(payload_path.read_bytes())\n    implementation = {\n        "exporter": {\n            "path": BOOT_INTERWORK_EXPORTER.as_posix(),\n            "sha256": BOOT_INTERWORK_EXPORTER_SHA256,\n        },\n        "verifier": {\n            "path": BOOT_INTERWORK_VERIFIER.as_posix(),\n            "sha256": BOOT_INTERWORK_VERIFIER_SHA256,\n        },\n        "test": {\n            "path": BOOT_INTERWORK_TEST.as_posix(),\n            "sha256": BOOT_INTERWORK_TEST_SHA256,\n        },\n    }\n    expected_verification = {\n        "schema": "rom-boot-interwork-verification-v1",\n        "command": [\n            "python3",\n            BOOT_INTERWORK_VERIFIER.as_posix(),\n            "--root",\n            ".",\n            "--artifact-dir",\n            BOOT_INTERWORK_ARTIFACT.as_posix(),\n        ],\n        "verifier_sha256": BOOT_INTERWORK_VERIFIER_SHA256,\n    }\n    if (\n        manifest.get("schema")\n        != "rom-boot-interwork-v1-artifact-manifest-v1"\n        or manifest.get("artifact_schema") != "rom-boot-interwork-v1"\n        or manifest.get("rom")\n        != {"path": ROM_PATH.as_posix(), "size": len(rom), "sha256": ROM_SHA256}\n        or manifest.get("summary") != BOOT_INTERWORK_EXPECTED_SUMMARY\n        or manifest.get("files")\n        != {\n            payload_path.name: {\n                "size": BOOT_INTERWORK_PAYLOAD_SIZE,\n                "sha256": BOOT_INTERWORK_PAYLOAD_SHA256,\n            }\n        }\n        or manifest.get("producer") != implementation\n        or manifest.get("scope") != BOOT_INTERWORK_SCOPE\n        or manifest.get("verification") != expected_verification\n    ):\n        raise ValueError("boot-interwork manifest contract changed")\n    root_record = payload.get("root")\n    if (\n        payload.get("schema") != "rom-boot-interwork-v1"\n        or payload.get("rom")\n        != {"path": ROM_PATH.as_posix(), "size": len(rom), "sha256": ROM_SHA256}\n        or payload.get("summary") != BOOT_INTERWORK_EXPECTED_SUMMARY\n        or payload.get("scope") != BOOT_INTERWORK_SCOPE\n        or payload.get("implementation") != implementation\n        or payload.get("denominators") != BOOT_INTERWORK_DENOMINATORS\n        or not isinstance(root_record, dict)\n        or root_record.get("root_id") != "root-arm-00024c"\n        or root_record.get("file_offset") != 0x24C\n        or root_record.get("mode") != "arm"\n        or root_record.get("traversal_status") != "closed"\n        or root_record.get("reachable_instruction_count") != 92\n        or root_record.get("reachable_instruction_bytes") != 368\n        or root_record.get("reachable_block_count") != 8\n        or root_record.get("frontier_count") != 0\n    ):\n        raise ValueError("boot-interwork payload denominator changed")\n\n    report = verify_rom_boot_interwork(root, artifact)\n    expected_report = {\n        "schema": "rom-boot-interwork-verification-v1",\n        "verified": True,\n        "errors": [],\n        "artifact_schema": "rom-boot-interwork-v1",\n        "summary": BOOT_INTERWORK_EXPECTED_SUMMARY,\n        **BOOT_INTERWORK_DENOMINATORS,\n    }\n    if report != expected_report:\n        raise ValueError(f"boot-interwork independent verifier failed: {report}")\n\n    expected_ranges = [\n        ("arm-root-code", [0x00024C, 0x0003BC], "arm_code"),\n        ("arm-root-literal-pool", [0x0003BC, 0x0003E0], "arm_literal_pool"),\n        ("thumb-direct-caller", [0x061086, 0x06108A], "thumb_code"),\n        ("thumb-bx-pc", [0x09C56C, 0x09C56E], "thumb_interwork_code"),\n        ("arm-root-branch", [0x09C570, 0x09C574], "arm_interwork_code"),\n    ]\n    raw_claims = payload.get("coverage_claims")\n    if not isinstance(raw_claims, list) or len(raw_claims) != len(expected_ranges):\n        raise ValueError("boot-interwork coverage claim denominator changed")\n    claims = []\n    for index, (item, expected) in enumerate(zip(raw_claims, expected_ranges, strict=True)):\n        identifier, value, semantic_class = expected\n        start, end = value\n        raw = rom[start:end]\n        if (\n            not isinstance(item, dict)\n            or item.get("id") != identifier\n            or item.get("range") != value\n            or item.get("size") != end - start\n            or item.get("semantic_class") != semantic_class\n            or item.get("sha256") != _sha256(raw)\n        ):\n            raise ValueError(f"boot-interwork coverage claim changed: {index}")\n        if semantic_class == "arm_literal_pool":\n            primary_class = "boot_interwork_literal_pool"\n            claim_kind = "boot_interwork_literal_pool_bytes"\n        elif semantic_class.startswith("thumb"):\n            primary_class = "boot_interwork_thumb_code"\n            claim_kind = "boot_interwork_thumb_instruction_bytes"\n        else:\n            primary_class = "boot_interwork_arm_code"\n            claim_kind = "boot_interwork_arm_instruction_bytes"\n        claims.append(\n            {\n                "id": f"boot-interwork-{identifier}",\n                "range": value,\n                "role": "primary",\n                "primary_class": primary_class,\n                "claim_kind": claim_kind,\n                "bytes_sha256": item["sha256"],\n                "evidence_path": BOOT_INTERWORK_PAYLOAD.as_posix(),\n                "evidence_sha256": BOOT_INTERWORK_PAYLOAD_SHA256,\n                "evidence_selector": f"/coverage_claims/{index}",\n                "promotion_manifest_path": (\n                    BOOT_INTERWORK_ARTIFACT / "manifest.json"\n                ).as_posix(),\n                "promotion_manifest_sha256": BOOT_INTERWORK_MANIFEST_SHA256,\n                "independent_verifier_path": BOOT_INTERWORK_VERIFIER.as_posix(),\n                "independent_verifier_sha256": BOOT_INTERWORK_VERIFIER_SHA256,\n                "runtime_reachability_claimed": False,\n                "limitations": [\n                    "This is a fixed static interwork/CFG claim; reset-to-root runtime reachability and the surrounding region remain unclaimed."\n                ],\n            }\n        )\n    if (\n        sum(claim["range"][1] - claim["range"][0] for claim in claims) != 414\n        or any(\n            left["range"][1] > right["range"][0]\n            for left, right in zip(claims, claims[1:])\n        )\n        or any(\n            start < 0x09C570 and end > 0x09C56E\n            for start, end in (claim["range"] for claim in claims)\n            if start >= 0x09C56C\n        )\n    ):\n        raise ValueError("boot-interwork final coverage denominator changed")\n    return claims\n\n\ndef _boot_interwork_padding_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote only the two-byte MOV r8,r8 veneer alignment NOP."""\n\n    root = Path(root).resolve(strict=True)\n    baseline_claims = list(existing_claims)\n    if any(\n        claim.get("promotion_batch") == BOOT_INTERWORK_PADDING_BATCH\n        or claim.get("claim_kind") == BOOT_INTERWORK_PADDING_CLAIM_KIND\n        for claim in baseline_claims\n    ):\n        raise ValueError("boot-interwork padding batch is already present")\n    if len(rom) != 6_291_456 or _sha256(rom) != ROM_SHA256:\n        raise ValueError("boot-interwork padding ROM identity changed")\n\n    expected_spine = {\n        "boot-interwork-arm-root-code": (\n            [0x00024C, 0x0003BC],\n            "boot_interwork_arm_code",\n            "boot_interwork_arm_instruction_bytes",\n        ),\n        "boot-interwork-arm-root-literal-pool": (\n            [0x0003BC, 0x0003E0],\n            "boot_interwork_literal_pool",\n            "boot_interwork_literal_pool_bytes",\n        ),\n        "boot-interwork-thumb-direct-caller": (\n            [0x061086, 0x06108A],\n            "boot_interwork_thumb_code",\n            "boot_interwork_thumb_instruction_bytes",\n        ),\n        "boot-interwork-thumb-bx-pc": (\n            [0x09C56C, 0x09C56E],\n            "boot_interwork_thumb_code",\n            "boot_interwork_thumb_instruction_bytes",\n        ),\n        "boot-interwork-arm-root-branch": (\n            [0x09C570, 0x09C574],\n            "boot_interwork_arm_code",\n            "boot_interwork_arm_instruction_bytes",\n        ),\n    }\n    baseline_spine = {\n        claim.get("id"): (\n            claim.get("range"),\n            claim.get("primary_class"),\n            claim.get("claim_kind"),\n        )\n        for claim in baseline_claims\n        if claim.get("id") in expected_spine\n    }\n    if baseline_spine != expected_spine:\n        raise ValueError("boot-interwork padding spine claim denominator changed")\n\n    start, end = BOOT_INTERWORK_PADDING_RANGE\n    overlapping_primary_ids = [\n        str(claim.get("id"))\n        for claim in baseline_claims\n        if claim.get("role") == "primary"\n        and isinstance(claim.get("range"), list)\n        and len(claim["range"]) == 2\n        and all(isinstance(boundary, int) for boundary in claim["range"])\n        and claim["range"][0] < end\n        and start < claim["range"][1]\n    ]\n    if overlapping_primary_ids:\n        raise ValueError(\n            "boot-interwork padding range already has an existing primary claim: "\n            f"{overlapping_primary_ids}"\n        )\n    baseline_segments = atomize_claims(len(rom), baseline_claims)\n    unknown_bytes = sum(\n        max(0, min(end, segment_end) - max(start, segment_start))\n        for segment in baseline_segments\n        if segment["primary_class"] == "unknown"\n        for segment_start, segment_end in [segment["range"]]\n        if segment_start < end and start < segment_end\n    )\n    if unknown_bytes != end - start:\n        raise ValueError(\n            "boot-interwork padding range is not fully current unknown: "\n            f"{unknown_bytes}/{end - start} bytes"\n        )\n    adjacent_segments = [\n        segment\n        for segment in baseline_segments\n        if segment["range"] in ([0x09C56C, 0x09C56E], [0x09C570, 0x09C574])\n    ]\n    if adjacent_segments != [\n        {\n            "range": [0x09C56C, 0x09C56E],\n            "primary_class": "boot_interwork_thumb_code",\n            "primary_claim_ids": ["boot-interwork-thumb-bx-pc"],\n            "secondary_claim_ids": [],\n        },\n        {\n            "range": [0x09C570, 0x09C574],\n            "primary_class": "boot_interwork_arm_code",\n            "primary_claim_ids": ["boot-interwork-arm-root-branch"],\n            "secondary_claim_ids": [],\n        },\n    ]:\n        raise ValueError("boot-interwork padding adjacent owner boundary changed")\n\n    verified_spine = _boot_interwork_claims(root, rom)\n    baseline_verified_spine = [\n        claim for claim in baseline_claims if claim.get("id") in expected_spine\n    ]\n    if baseline_verified_spine != verified_spine:\n        raise ValueError("boot-interwork padding verified spine claims changed")\n\n    payload_path = (root / BOOT_INTERWORK_PAYLOAD).absolute()\n    payload = json.loads(payload_path.read_bytes())\n    producer_chain = payload.get("producer_chain")\n    selectors = [\n        "/producer_chain/interwork_spine/1",\n        "/producer_chain/skipped_padding_range",\n        "/producer_chain/skipped_padding_sha256",\n        "/producer_chain/interwork_spine/2",\n    ]\n    if (\n        not isinstance(producer_chain, dict)\n        or producer_chain.get("skipped_padding_range") != [start, end]\n        or producer_chain.get("skipped_padding_sha256")\n        != BOOT_INTERWORK_PADDING_BYTES_SHA256\n        or producer_chain.get("veneer_range") != [0x09C56C, 0x09C574]\n        or producer_chain.get("veneer_sha256")\n        != "bbf8fd2c580d0ac6a30f6022fb477322a80a12596a521f36877ea2858f6f773b"\n        or not isinstance(producer_chain.get("interwork_spine"), list)\n        or len(producer_chain["interwork_spine"]) != 3\n        or producer_chain["interwork_spine"][1].get("kind") != "thumb_bx_pc"\n        or producer_chain["interwork_spine"][1].get("range")\n        != [0x09C56C, 0x09C56E]\n        or producer_chain["interwork_spine"][1].get("target") != "0x0809C570"\n        or producer_chain["interwork_spine"][2].get("kind") != "arm_b"\n        or producer_chain["interwork_spine"][2].get("range")\n        != [0x09C570, 0x09C574]\n        or payload.get("scope", {}).get("skipped_interwork_padding_classified")\n        is not False\n    ):\n        raise ValueError("boot-interwork padding producer-chain contract changed")\n\n    raw = rom[start:end]\n    halfword = int.from_bytes(raw, "little")\n    if (\n        raw != b"\\xC0\\x46"\n        or halfword != 0x46C0\n        or _sha256(raw) != BOOT_INTERWORK_PADDING_BYTES_SHA256\n        or _sha256(\n            json.dumps([[start, end]], separators=(",", ":")).encode("ascii")\n        )\n        != BOOT_INTERWORK_PADDING_RANGE_DENOMINATOR_SHA256\n    ):\n        raise ValueError("boot-interwork padding encoding changed")\n\n    return [\n        {\n            "id": "boot-interwork-veneer-alignment-nop-09c56e",\n            "range": [start, end],\n            "role": "primary",\n            "primary_class": "boot_interwork_veneer_alignment_nop",\n            "claim_kind": BOOT_INTERWORK_PADDING_CLAIM_KIND,\n            "promotion_batch": BOOT_INTERWORK_PADDING_BATCH,\n            "promoted_from_primary_class": "unknown",\n            "baseline_unknown_only": True,\n            "bytes_sha256": BOOT_INTERWORK_PADDING_BYTES_SHA256,\n            "range_denominator_sha256": (\n                BOOT_INTERWORK_PADDING_RANGE_DENOMINATOR_SHA256\n            ),\n            "packed_bytes_sha256": BOOT_INTERWORK_PADDING_BYTES_SHA256,\n            "all_zero": False,\n            "zero_byte_count": 0,\n            "encoding_halfword_le": halfword,\n            "decoded_instruction": "mov r8, r8",\n            "alignment_padding": True,\n            "bound_spine_executes_padding": False,\n            "evidence_path": BOOT_INTERWORK_PAYLOAD.as_posix(),\n            "evidence_sha256": BOOT_INTERWORK_PAYLOAD_SHA256,\n            "evidence_selectors": selectors,\n            "promotion_manifest_path": (\n                BOOT_INTERWORK_ARTIFACT / "manifest.json"\n            ).as_posix(),\n            "promotion_manifest_sha256": BOOT_INTERWORK_MANIFEST_SHA256,\n            "independent_verifier_path": BOOT_INTERWORK_VERIFIER.as_posix(),\n            "independent_verifier_sha256": BOOT_INTERWORK_VERIFIER_SHA256,\n            "runtime_reachability_claimed": False,\n            "code_reachability_claimed": False,\n            "safe_allocatable_space_claimed": False,\n            "limitations": [\n                "The bound BX-pc to ARM-B spine skips this MOV r8,r8 alignment NOP; natural reachability, global unreachability, sibling veneers, editing, relocation, and allocatable space remain unclaimed."\n            ],\n        }\n    ]\n\n\ndef _runtime_state_handler_table_alignment_gap_claims(\n    root: Path,\n    rom: bytes,\n    existing_claims: Iterable[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    """Promote only the frozen selector/handler-table two-byte gap.\n\n    The logical selector table has mixed current primary ownership, including\n    an independently retained strict-LZ77 subrange.  This helper verifies that\n    exact partition instead of replacing it with one synthetic owner.  It is\n    intentionally disconnected from :func:`build_manifest`.\n    """\n\n    root = Path(root).resolve(strict=True)\n    baseline_claims = list(existing_claims)\n    if any(\n        isinstance(claim, dict)\n        and (\n            claim.get("promotion_batch")\n            == RUNTIME_STATE_HANDLER_TABLE_ALIGNMENT_GAP_BATCH\n            or claim.get("claim_kind")\n            == RUNTIME_STATE_HANDLER_TABLE_ALIGNMENT_GAP_CLAIM_KIND\n            or claim.get("id") == RUNTIME_STATE_HANDLER_TABLE_ALIGNMENT_GAP_CLAIM_ID\n        )\n        for claim in baseline_claims\n    ):\n        raise ValueError(\n            "runtime-state handler-table alignment gap claim is already present"\n        )\n\n    packet_rom_sha256 = (\n        "1198ece781aaf629db1f0c6628b4f9f1849ecc4a2eac6a55d32748c2a459d05b"\n    )\n    canonical_left_partitions = (\n        {\n            "id": "verified-reuse-battle-effect-runtime-state-sequences-53e596",\n            "range": (0x53E596, 0x53E5A8),\n            "primary_class": "battle_effect_runtime_state_sequence_table",\n            "claim_kind": "verified_artifact_reuse_table",\n            "bytes_sha256": "33cc41cb7cb0c2838787501880cfde5d7cc10612c640524b5cbae04ccc14c8bb",\n        },\n        {\n            "id": "unbound-lz77-38-53e5a8",\n            "range": (0x53E5A8, 0x53E5B3),\n            "primary_class": "lz77_syntax_unbound",\n            "claim_kind": "unbound_strict_lz77_syntax_range",\n            "bytes_sha256": "a0260fdd0de7a5ebc31581e6edf83d33efb1159801cbf5a43c6309b61cd2c210",\n        },\n        {\n            "id": "verified-reuse-battle-effect-runtime-state-sequences-53e5b3",\n            "range": (0x53E5B3, 0x53E696),\n            "primary_class": "battle_effect_runtime_state_sequence_table",\n            "claim_kind": "verified_artifact_reuse_table",\n            "bytes_sha256": "ca886661235293ba6fef3f6e29a938c414ced19858c17b2efd26db852f351a77",\n        },\n    )\n    if RUNTIME_STATE_HANDLER_GAP_LEFT_OWNER_PARTITIONS != canonical_left_partitions:\n        raise ValueError(\n            "runtime-state handler-table alignment gap left owner partition contract changed"\n        )\n\n    expected_constants = (\n        (ROM_SHA256, packet_rom_sha256, "shared ROM hash"),\n        (\n            RUNTIME_STATE_HANDLER_TABLE_ALIGNMENT_GAP_BATCH,\n            "rom-runtime-state-handler-table-alignment-gap-coverage-v1",\n            "batch",\n        ),\n        (\n            RUNTIME_STATE_HANDLER_TABLE_ALIGNMENT_GAP_CLAIM_ID,\n            "runtime-state-handler-table-alignment-gap-53e696",\n            "claim ID",\n        ),\n        (\n            RUNTIME_STATE_HANDLER_TABLE_ALIGNMENT_GAP_PRIMARY_CLASS,\n            "runtime_state_sequence_table_to_handler_pair_table_4byte_alignment_gap",\n            "primary class",\n        ),\n        (\n            RUNTIME_STATE_HANDLER_TABLE_ALIGNMENT_GAP_CLAIM_KIND,\n            "runtime_state_handler_table_alignment_gap_bytes",\n            "claim kind",\n        ),\n        (\n            RUNTIME_STATE_HANDLER_TABLE_ALIGNMENT_GAP_RANGE,\n            (0x53E696, 0x53E698),\n            "candidate range",\n        ),\n        (\n            RUNTIME_STATE_HANDLER_TABLE_ALIGNMENT_GAP_GBA_RANGE,\n            (0x0853E696, 0x0853E698),\n            "candidate GBA range",\n        ),\n        (\n            RUNTIME_STATE_HANDLER_TABLE_ALIGNMENT_GAP_BYTES_SHA256,\n            "96a296d224f285c67bee93c30f8a309157f0daa35dc5b87e410b78630a09cfc7",\n            "candidate bytes",\n        ),\n        (\n            RUNTIME_STATE_HANDLER_TABLE_ALIGNMENT_GAP_RANGE_DENOMINATOR_SHA256,\n            "11a9249d8cf1654cfbfa44bf13fa9fafc94677f7f1b075b892319e5e524f275c",\n            "candidate denominator",\n        ),\n        (\n            RUNTIME_STATE_SEQUENCE_TABLE_RANGE,\n            (0x53E596, 0x53E696),\n            "selector table range",\n        ),\n        (RUNTIME_STATE_SEQUENCE_TABLE_ENTRY_COUNT, 256, "selector entry count"),\n        (RUNTIME_STATE_SEQUENCE_TABLE_ENTRY_SIZE, 1, "selector entry size"),\n        (\n            RUNTIME_STATE_SEQUENCE_TABLE_SHA256,\n            "4c1ad8b8ac883eb301132c83258ba1e1216b2e131c9ce9866d0de62956d5a01b",\n            "selector table hash",\n        ),\n        (\n            RUNTIME_STATE_SEQUENCE_TABLE_CONSUMER_RANGE,\n            (0x7F0FC, 0x7F110),\n            "selector consumer range",\n        ),\n        (\n            RUNTIME_STATE_SEQUENCE_TABLE_CONSUMER_SHA256,\n            "7b16c1004bdbf81a55ecdcfc523166059ec2a94c81161063d695e1ca59f6cc56",\n            "selector consumer hash",\n        ),\n        (\n            RUNTIME_STATE_HANDLER_TABLE_RANGE,\n            (0x53E698, 0x53EE98),\n            "handler table range",\n        ),\n        (RUNTIME_STATE_HANDLER_TABLE_RECORD_COUNT, 256, "handler record count"),\n        (RUNTIME_STATE_HANDLER_TABLE_RECORD_SIZE, 8, "handler record size"),\n        (\n            RUNTIME_STATE_HANDLER_TABLE_SHA256,\n            "20e4727cf65dca82626ffc9637cb36561d5851971500b22a282c5a8c65c7c945",\n            "handler table hash",\n        ),\n        (\n            RUNTIME_STATE_HANDLER_TABLE_FIRST_RECORD_RANGE,\n            (0x53E698, 0x53E6A0),\n            "handler first-record range",\n        ),\n        (\n            RUNTIME_STATE_HANDLER_TABLE_FIRST_RECORD_SHA256,\n            "af5570f5a1810b7af78caf4bc70a660f0df51e42baf91d4de5b2328de0e83dfc",\n            "handler first-record hash",\n        ),\n        (\n            RUNTIME_STATE_HANDLER_TABLE_CONSUMER_RANGE,\n            (0x7F934, 0x7F968),\n            "handler consumer range",\n        ),\n        (\n            RUNTIME_STATE_HANDLER_TABLE_CONSUMER_SHA256,\n            "a1dc1b497f2aebb8e2b865adbc7c7a9abb42f13e7f456130f648b619343cb4f9",\n            "handler consumer hash",\n        ),\n    )\n    for actual, expected, label in expected_constants:\n        if actual != expected:\n            raise ValueError(\n                f"runtime-state handler-table alignment gap {label} contract changed"\n            )\n\n    start, end = RUNTIME_STATE_HANDLER_TABLE_ALIGNMENT_GAP_RANGE\n    if (\n        (start + 3) & ~3 != end\n        or end - start != 2\n        or list(RUNTIME_STATE_HANDLER_TABLE_ALIGNMENT_GAP_GBA_RANGE)\n        != [GBA_ROM_BASE + start, GBA_ROM_BASE + end]\n    ):\n        raise ValueError(\n            "runtime-state handler-table alignment gap alignment contract changed"\n        )\n    if len(rom) != 6_291_456 or _sha256(rom) != packet_rom_sha256:\n        raise ValueError("runtime-state handler-table alignment gap ROM identity changed")\n\n    partition_cursor = RUNTIME_STATE_SEQUENCE_TABLE_RANGE[0]\n    for partition in canonical_left_partitions:\n        partition_start, partition_end = partition["range"]\n        if (\n            partition_start != partition_cursor\n            or partition_start >= partition_end\n            or _sha256(rom[partition_start:partition_end])\n            != partition["bytes_sha256"]\n        ):\n            raise ValueError(\n                "runtime-state handler-table alignment gap left owner partition denominator changed"\n            )\n        partition_cursor = partition_end\n    if partition_cursor != RUNTIME_STATE_SEQUENCE_TABLE_RANGE[1]:\n        raise ValueError(\n            "runtime-state handler-table alignment gap left owner partition denominator changed"\n        )\n\n    by_id: dict[str, dict[str, Any]] = {}\n    candidate_primary: list[str] = []\n    candidate_secondary: list[str] = []\n    source_extra_overlap: list[str] = []\n    expected_owner_ids = {item["id"] for item in canonical_left_partitions} | {\n        "bank-map-events-000"\n    }\n    source_ranges = (\n        RUNTIME_STATE_SEQUENCE_TABLE_RANGE,\n        RUNTIME_STATE_HANDLER_TABLE_RANGE,\n    )\n    for claim in baseline_claims:\n        if not isinstance(claim, dict):\n            raise ValueError(\n                "runtime-state handler-table alignment gap baseline claim changed"\n            )\n        identifier = claim.get("id")\n        if not isinstance(identifier, str) or not identifier:\n            raise ValueError(\n                "runtime-state handler-table alignment gap baseline claim ID changed"\n            )\n        if identifier in by_id:\n            raise ValueError(\n                "runtime-state handler-table alignment gap baseline claim IDs are not unique"\n            )\n        role = claim.get("role")\n        if role not in {"primary", "secondary"}:\n            raise ValueError(\n                "runtime-state handler-table alignment gap baseline claim role changed"\n            )\n        if role == "primary" and not isinstance(claim.get("primary_class"), str):\n            raise ValueError(\n                "runtime-state handler-table alignment gap baseline primary class changed"\n            )\n        claim_start, claim_end = _validated_range(claim, len(rom))\n        by_id[identifier] = claim\n        if claim_start < end and start < claim_end:\n            (candidate_primary if role == "primary" else candidate_secondary).append(\n                identifier\n            )\n        if identifier not in expected_owner_ids and any(\n            claim_start < source_end and source_start < claim_end\n            for source_start, source_end in source_ranges\n        ):\n            source_extra_overlap.append(identifier)\n    if candidate_primary:\n        raise ValueError(\n            "runtime-state handler-table alignment gap range is not fully current unknown; "\n            f"existing primary claims: {candidate_primary}"\n        )\n    if candidate_secondary:\n        raise ValueError(\n            "runtime-state handler-table alignment gap range has secondary claim overlap: "\n            f"{candidate_secondary}"\n        )\n    if source_extra_overlap:\n        raise ValueError(\n            "runtime-state handler-table alignment gap source ownership partition changed: "\n            f"{source_extra_overlap}"\n        )\n\n    # Owner identity is compared to the canonical literals, not to the\n    # patchable path constants.  Path-constant drift is diagnosed by the\n    # canonical path gate below rather than being misreported as owner drift.\n    left_manifest_path = (\n        "artifacts/battle-effect-sequence-bindings-v1/manifest.json"\n    )\n    left_verifier_path = "tools/verify_battle_effect_sequence_bindings.py"\n    left_support = {\n        "artifact_id": "battle_effect_sequences",\n        "evidence_path": left_manifest_path,\n        "evidence_selector": "/runtime_state_sequence_table",\n        "evidence_sha256": RUNTIME_STATE_HANDLER_GAP_LEFT_MANIFEST_SHA256,\n        "independent_verifier_path": left_verifier_path,\n        "independent_verifier_sha256": RUNTIME_STATE_HANDLER_GAP_LEFT_VERIFIER_SHA256,\n        "promotion_manifest_path": left_manifest_path,\n        "promotion_manifest_sha256": RUNTIME_STATE_HANDLER_GAP_LEFT_MANIFEST_SHA256,\n    }\n    for partition in canonical_left_partitions:\n        owner = by_id.get(partition["id"])\n        if not isinstance(owner, dict):\n            raise ValueError(\n                "runtime-state handler-table alignment gap left owner partition is missing"\n            )\n        expected = {\n            "range": list(partition["range"]),\n            "role": "primary",\n            "primary_class": partition["primary_class"],\n            "claim_kind": partition["claim_kind"],\n            "bytes_sha256": partition["bytes_sha256"],\n        }\n        if partition["id"].startswith("verified-reuse-"):\n            expected.update(\n                {\n                    "evidence_path": left_manifest_path,\n                    "evidence_selector": "/runtime_state_sequence_table",\n                    "evidence_sha256": RUNTIME_STATE_HANDLER_GAP_LEFT_MANIFEST_SHA256,\n                    "full_source_range": list(RUNTIME_STATE_SEQUENCE_TABLE_RANGE),\n                    "full_source_sha256": RUNTIME_STATE_SEQUENCE_TABLE_SHA256,\n                    "independent_verifier_path": left_verifier_path,\n                    "independent_verifier_sha256": RUNTIME_STATE_HANDLER_GAP_LEFT_VERIFIER_SHA256,\n                    "promotion_batch": "verified-artifact-reuse-v1",\n                    "promotion_manifest_path": left_manifest_path,\n                    "promotion_manifest_sha256": RUNTIME_STATE_HANDLER_GAP_LEFT_MANIFEST_SHA256,\n                    "baseline_unknown_only": True,\n                    "raw_rom_resource_claimed": False,\n                    "runtime_reachability_claimed": False,\n                    "source_spec_id": "battle-effect-runtime-state-sequences",\n                    "supporting_evidence": [left_support],\n                }\n            )\n        else:\n            expected.update(\n                {\n                    "evidence_path": "artifacts/rom-unbound-lz77-inventory-v1/inventory.json",\n                    "evidence_selector": "/records/38",\n                    "evidence_sha256": RUNTIME_STATE_HANDLER_GAP_LZ77_INVENTORY_SHA256,\n                    "independent_verifier_path": "tools/verify_rom_unbound_lz77_inventory.py",\n                    "independent_verifier_sha256": RUNTIME_STATE_HANDLER_GAP_LZ77_VERIFIER_SHA256,\n                    "promotion_manifest_path": "artifacts/rom-unbound-lz77-inventory-v1/manifest.json",\n                    "promotion_manifest_sha256": RUNTIME_STATE_HANDLER_GAP_LZ77_MANIFEST_SHA256,\n                    "record_index": 38,\n                    "aligned_pointer_reference_count": 0,\n                    "runtime_reachability_claimed": False,\n                }\n            )\n        if any(owner.get(key) != value for key, value in expected.items()):\n            raise ValueError(\n                "runtime-state handler-table alignment gap left owner partition identity changed"\n            )\n\n    right_owner = by_id.get("bank-map-events-000")\n    expected_right_owner = {\n        "range": list(RUNTIME_STATE_HANDLER_TABLE_RANGE),\n        "role": "primary",\n        "primary_class": "fixed_table",\n        "claim_kind": "bank_record_bytes",\n        "bank": "map-events",\n        "evidence_path": "sequel/content/map-events/bank.json",\n        "evidence_sha256": RUNTIME_STATE_HANDLER_GAP_RIGHT_BANK_SHA256,\n        "records": RUNTIME_STATE_HANDLER_TABLE_RECORD_COUNT,\n        "bytes_sha256": RUNTIME_STATE_HANDLER_TABLE_SHA256,\n    }\n    if not isinstance(right_owner, dict) or any(\n        right_owner.get(key) != value for key, value in expected_right_owner.items()\n    ):\n        raise ValueError(\n            "runtime-state handler-table alignment gap right owner identity changed"\n        )\n\n    def checked_path(\n        value: Path,\n        canonical: Path,\n        label: str,\n        *,\n        directory: bool = False,\n    ) -> Path:\n        expected = root / canonical\n        candidate = value if value.is_absolute() else root / value\n        if candidate != expected:\n            raise ValueError(\n                f"runtime-state handler-table alignment gap {label} canonical path contract changed"\n            )\n        try:\n            resolved = candidate.resolve(strict=True)\n            resolved.relative_to(root)\n        except (OSError, ValueError) as error:\n            raise ValueError(\n                f"runtime-state handler-table alignment gap {label} is invalid"\n            ) from error\n        if candidate.is_symlink() or resolved != candidate:\n            raise ValueError(\n                f"runtime-state handler-table alignment gap {label} uses a symlink"\n            )\n        if directory:\n            if not candidate.is_dir():\n                raise ValueError(\n                    f"runtime-state handler-table alignment gap {label} is not a directory"\n                )\n            if any(path.is_symlink() for path in candidate.rglob("*")):\n                raise ValueError(\n                    f"runtime-state handler-table alignment gap {label} contains a symlink"\n                )\n        elif not candidate.is_file():\n            raise ValueError(\n                f"runtime-state handler-table alignment gap {label} is not a file"\n            )\n        return candidate\n\n    left_artifact = checked_path(\n        RUNTIME_STATE_HANDLER_GAP_LEFT_ARTIFACT,\n        Path("artifacts/battle-effect-sequence-bindings-v1"),\n        "left artifact",\n        directory=True,\n    )\n    lz77_artifact = checked_path(\n        RUNTIME_STATE_HANDLER_GAP_LZ77_ARTIFACT,\n        Path("artifacts/rom-unbound-lz77-inventory-v1"),\n        "LZ77 artifact",\n        directory=True,\n    )\n    file_specs = (\n        (\n            RUNTIME_STATE_HANDLER_GAP_LEFT_MANIFEST_PATH,\n            Path("artifacts/battle-effect-sequence-bindings-v1/manifest.json"),\n            RUNTIME_STATE_HANDLER_GAP_LEFT_MANIFEST_SHA256,\n            "left manifest",\n        ),\n        (\n            RUNTIME_STATE_HANDLER_GAP_LEFT_VERIFIER,\n            Path("tools/verify_battle_effect_sequence_bindings.py"),\n            RUNTIME_STATE_HANDLER_GAP_LEFT_VERIFIER_SHA256,\n            "left verifier",\n        ),\n        (\n            RUNTIME_STATE_HANDLER_GAP_LEFT_UPSTREAM_TEST,\n            Path("tests/test_export_battle_effect_sequence_bindings.py"),\n            RUNTIME_STATE_HANDLER_GAP_LEFT_UPSTREAM_TEST_SHA256,\n            "left upstream test",\n        ),\n        (\n            RUNTIME_STATE_HANDLER_GAP_LZ77_INVENTORY_PATH,\n            Path("artifacts/rom-unbound-lz77-inventory-v1/inventory.json"),\n            RUNTIME_STATE_HANDLER_GAP_LZ77_INVENTORY_SHA256,\n            "LZ77 inventory",\n        ),\n        (\n            RUNTIME_STATE_HANDLER_GAP_LZ77_MANIFEST_PATH,\n            Path("artifacts/rom-unbound-lz77-inventory-v1/manifest.json"),\n            RUNTIME_STATE_HANDLER_GAP_LZ77_MANIFEST_SHA256,\n            "LZ77 manifest",\n        ),\n        (\n            RUNTIME_STATE_HANDLER_GAP_LZ77_VERIFIER,\n            Path("tools/verify_rom_unbound_lz77_inventory.py"),\n            RUNTIME_STATE_HANDLER_GAP_LZ77_VERIFIER_SHA256,\n            "LZ77 verifier",\n        ),\n        (\n            RUNTIME_STATE_HANDLER_GAP_LZ77_UPSTREAM_TEST,\n            Path("tests/test_rom_unbound_lz77_inventory.py"),\n            RUNTIME_STATE_HANDLER_GAP_LZ77_UPSTREAM_TEST_SHA256,\n            "LZ77 upstream test",\n        ),\n        (\n            RUNTIME_STATE_HANDLER_GAP_RIGHT_BANK_PATH,\n            Path("sequel/content/map-events/bank.json"),\n            RUNTIME_STATE_HANDLER_GAP_RIGHT_BANK_SHA256,\n            "right bank",\n        ),\n        (\n            RUNTIME_STATE_HANDLER_GAP_RIGHT_VERIFIER,\n            Path("tools/verify_disproved_bank_candidates.py"),\n            RUNTIME_STATE_HANDLER_GAP_RIGHT_VERIFIER_SHA256,\n            "right verifier",\n        ),\n        (\n            RUNTIME_STATE_HANDLER_GAP_RIGHT_UPSTREAM_TEST,\n            Path("tests/test_verify_disproved_bank_candidates.py"),\n            RUNTIME_STATE_HANDLER_GAP_RIGHT_UPSTREAM_TEST_SHA256,\n            "right upstream test",\n        ),\n        (\n            RUNTIME_STATE_HANDLER_GAP_RIGHT_HISTORICAL_BANK_PATH,\n            Path("sequel/content/battle-handlers/bank.json"),\n            RUNTIME_STATE_HANDLER_GAP_RIGHT_HISTORICAL_BANK_SHA256,\n            "right historical bank",\n        ),\n        (\n            RUNTIME_STATE_HANDLER_GAP_RIGHT_AUDIT_NOTE_PATH,\n            Path("notes/dynamic-verification-audit.md"),\n            RUNTIME_STATE_HANDLER_GAP_RIGHT_AUDIT_NOTE_SHA256,\n            "right audit note",\n        ),\n    )\n    checked_files: dict[str, Path] = {}\n    for value, canonical, expected_sha, label in file_specs:\n        path = checked_path(value, canonical, label)\n        if _sha256_file(path) != expected_sha:\n            raise ValueError(\n                f"runtime-state handler-table alignment gap {label} evidence changed"\n            )\n        checked_files[label] = path\n    if (\n        checked_files["left manifest"] != left_artifact / "manifest.json"\n        or checked_files["LZ77 inventory"] != lz77_artifact / "inventory.json"\n        or checked_files["LZ77 manifest"] != lz77_artifact / "manifest.json"\n    ):\n        raise ValueError(\n            "runtime-state handler-table alignment gap artifact path identity changed"\n        )\n\n    def read_object(path: Path, label: str) -> dict[str, Any]:\n        try:\n            value = json.loads(path.read_text(encoding="utf-8"))\n        except (OSError, TypeError, ValueError) as error:\n            raise ValueError(\n                f"runtime-state handler-table alignment gap {label} is invalid"\n            ) from error\n        if not isinstance(value, dict):\n            raise ValueError(\n                f"runtime-state handler-table alignment gap {label} is not an object"\n            )\n        return value\n\n    left_document = read_object(checked_files["left manifest"], "left manifest")\n    left_table = left_document.get("runtime_state_sequence_table")\n    left_raw = rom[\n        RUNTIME_STATE_SEQUENCE_TABLE_RANGE[0] : RUNTIME_STATE_SEQUENCE_TABLE_RANGE[1]\n    ]\n    if (\n        not isinstance(left_table, dict)\n        or left_table\n        != {\n            "file_offset": RUNTIME_STATE_SEQUENCE_TABLE_RANGE[0],\n            "gba_address": f"0x{GBA_ROM_BASE + RUNTIME_STATE_SEQUENCE_TABLE_RANGE[0]:08X}",\n            "entry_count": RUNTIME_STATE_SEQUENCE_TABLE_ENTRY_COUNT,\n            "entry_size": RUNTIME_STATE_SEQUENCE_TABLE_ENTRY_SIZE,\n            "sha256": RUNTIME_STATE_SEQUENCE_TABLE_SHA256,\n        }\n        or len(left_raw)\n        != RUNTIME_STATE_SEQUENCE_TABLE_ENTRY_COUNT\n        * RUNTIME_STATE_SEQUENCE_TABLE_ENTRY_SIZE\n        or _sha256(left_raw) != RUNTIME_STATE_SEQUENCE_TABLE_SHA256\n        or _sha256(\n            rom[\n                RUNTIME_STATE_SEQUENCE_TABLE_CONSUMER_RANGE[0] :\n                RUNTIME_STATE_SEQUENCE_TABLE_CONSUMER_RANGE[1]\n            ]\n        )\n        != RUNTIME_STATE_SEQUENCE_TABLE_CONSUMER_SHA256\n    ):\n        raise ValueError(\n            "runtime-state handler-table alignment gap selector table denominator changed"\n        )\n\n    inventory = read_object(checked_files["LZ77 inventory"], "LZ77 inventory")\n    records = inventory.get("records")\n    if not isinstance(records, list) or len(records) <= 38:\n        raise ValueError(\n            "runtime-state handler-table alignment gap LZ77 record denominator changed"\n        )\n    lz77_record = records[38]\n    if not isinstance(lz77_record, dict) or any(\n        lz77_record.get(key) != value\n        for key, value in {\n            "range": [0x53E5A8, 0x53E5B3],\n            "compressed_size": 11,\n            "compressed_sha256": "a0260fdd0de7a5ebc31581e6edf83d33efb1159801cbf5a43c6309b61cd2c210",\n            "classification": "lz77_syntax_unbound",\n            "aligned_pointer_reference_count": 0,\n            "runtime_reachability_claimed": False,\n        }.items()\n    ):\n        raise ValueError(\n            "runtime-state handler-table alignment gap LZ77 record 38 changed"\n        )\n\n    right_document = read_object(checked_files["right bank"], "right bank")\n    right_entries = right_document.get("entries")\n    right_start, right_end = RUNTIME_STATE_HANDLER_TABLE_RANGE\n    if (\n        right_document.get("table_offset") != right_start\n        or right_document.get("entry_count")\n        != RUNTIME_STATE_HANDLER_TABLE_RECORD_COUNT\n        or right_document.get("entry_size") != RUNTIME_STATE_HANDLER_TABLE_RECORD_SIZE\n        or right_document.get("verification") != "runtime_verified"\n        or not isinstance(right_entries, list)\n        or len(right_entries) != RUNTIME_STATE_HANDLER_TABLE_RECORD_COUNT\n    ):\n        raise ValueError(\n            "runtime-state handler-table alignment gap right table denominator changed"\n        )\n    rebuilt_rows: list[bytes] = []\n    for index, entry in enumerate(right_entries):\n        row_start = right_start + index * RUNTIME_STATE_HANDLER_TABLE_RECORD_SIZE\n        if (\n            not isinstance(entry, dict)\n            or entry.get("_index") != index\n            or entry.get("_raw_offset") != row_start\n        ):\n            raise ValueError(\n                f"runtime-state handler-table alignment gap right row {index} identity changed"\n            )\n        primary = entry.get("primary_handler_ptr")\n        secondary = entry.get("secondary_handler_ptr")\n        if (\n            not isinstance(primary, int)\n            or not isinstance(secondary, int)\n            or not 0 <= primary <= 0xFFFFFFFF\n            or not 0 <= secondary <= 0xFFFFFFFF\n        ):\n            raise ValueError(\n                f"runtime-state handler-table alignment gap right row {index} encoding changed"\n            )\n        rebuilt_rows.append(\n            primary.to_bytes(4, "little") + secondary.to_bytes(4, "little")\n        )\n    rebuilt_right = b"".join(rebuilt_rows)\n    first_start, first_end = RUNTIME_STATE_HANDLER_TABLE_FIRST_RECORD_RANGE\n    if (\n        len(rebuilt_right)\n        != RUNTIME_STATE_HANDLER_TABLE_RECORD_COUNT\n        * RUNTIME_STATE_HANDLER_TABLE_RECORD_SIZE\n        or rebuilt_right != rom[right_start:right_end]\n        or _sha256(rebuilt_right) != RUNTIME_STATE_HANDLER_TABLE_SHA256\n        or rebuilt_right[:RUNTIME_STATE_HANDLER_TABLE_RECORD_SIZE] != b"\\x00" * 8\n        or (first_start, first_end)\n        != (right_start, right_start + RUNTIME_STATE_HANDLER_TABLE_RECORD_SIZE)\n        or _sha256(rom[first_start:first_end])\n        != RUNTIME_STATE_HANDLER_TABLE_FIRST_RECORD_SHA256\n        or _sha256(\n            rom[\n                RUNTIME_STATE_HANDLER_TABLE_CONSUMER_RANGE[0] :\n 