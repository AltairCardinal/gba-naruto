# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Node
node_modules/
.vite/

# Build artifacts
# build/ 下是运行时产物（探针截图、存档、日志、探针 JSON），可由 tools/ 脚本重建；
# 2026-10-20 实测本地已累积约 2 GB，不入库。
build/*
build/*.gba
build/*.sav
build/*-report.json
build/battle-config-*.json
build/users/
build/audio/
build/tiles/

# 例外：续作开发 ROM 是 README / docs/content-pipeline.md 明确引用的工作流产物
!build/naruto-sequel-dev.gba
!build/naruto-sequel-dev.rom-source.md
!build/naruto-sequel-build-report.json

# Butano build artifacts
butano-sequel/build/
butano-sequel/build-*/
butano-sequel/*.gba
butano-sequel/*.elf
butano-sequel/*.map
butano-sequel/*.sav

# Generated data
*.db
*.db-wal
*.db-shm

# Tool state
.ralph/
.pi/

# 本地工具链与外部参考素材（非本仓库产物）
.venv/
references/

# 过期音频副本（2026-07-22 实验遗留；Makefile 只用 butano-sequel/audio，
# 无任何工具/测试引用这三个目录；s3m 内容与 audio/ 逐字节相同）
butano-sequel/audio-runtime-bgm/
butano-sequel/audio-runtime-s3m/
butano-sequel/audio-wav-bgm/

# s49 画面保真：原始帧与存档可由 tools/butano/capture_s49_*.py 从 ROM 重建，
# 只把 JSON 收据、说明和差异结论入库
artifacts/s49-fidelity-20261019-v1/**/*.png
artifacts/s49-fidelity-20261019-v1/**/*.ss9
artifacts/s49-fidelity-20261019-v1/**/*.mp4

# mGBA 重建 sentinel ROM（artifacts/macos-mgba-20261019-v1/manifest.json
# 已记录其 SHA-256 与 script_loaded 哨兵，ROM 本体不入库）
artifacts/macos-mgba-20261019-v1/evidence/sentinel-base.gba

# Experiment outputs
rom/experiment-*.gba
rom/experiment-*.sav

# 模拟器状态（非真源：存档与即时状态快照）
rom/base.sav
rom/base.ss2

# Secrets
.env
.env.*
*.key
*.pem
credentials.*

# IDE/OS
.vscode/
.idea/
.DS_Store
Thumbs.db
